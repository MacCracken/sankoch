[package]
name = "sankoch"
version = "${file:VERSION}"
description = "Lossless compression + archive library — LZ4, DEFLATE, zlib, gzip, xz, bzip2, zstd, Brotli (decode), tar"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/sankoch"
language = "cyrius"
cyrius = "6.6.4"

[build]
entry = "src/lib.cyr"
output = "build/sankoch"

# `[lib]` declares the module set `cyrius distlib` concatenates into
# dist/sankoch.cyr — the single-file bundle downstream consumers
# include as `lib/sankoch.cyr` in Cyrius stdlib.
#
# Do not move `modules` under `[build]`. `cyrius build` would prepend
# them before src/lib.cyr, which already chains them via `include`,
# and the binary would double-embed every symbol.
#
# Order matters — matches the include chain in src/lib.cyr.
[lib]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/lz4_decode.cyr",
    "src/lz4.cyr",
    "src/deflate.cyr",
    "src/zlib.cyr",
    "src/gzip.cyr",
    "src/xz.cyr",
    "src/bzip2.cyr",
    "src/zstd.cyr",
    "src/brotli_dict.cyr",
    "src/brotli.cyr",
    "src/tar.cyr",
    "src/zip.cyr",
    "src/zip_methods.cyr",
    "src/stream.cyr",
    "src/runtime.cyr",
    "src/lib.cyr",
]

# `[lib.core]` is the kernel-safe profile (`cyrius distlib core` →
# dist/sankoch-core.cyr). Pure-compute LZ4 block + frame decompress —
# no alloc, no syscalls, no mutex. Consumed by AGNOS initrd loader.
# Encode side, DEFLATE/zlib/gzip, and the alloc-using checksum state
# APIs are deliberately excluded.
[lib.core]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/lz4_decode.cyr",
]

# `[lib.zlib]` is the DEFLATE/zlib-only profile (`cyrius distlib zlib` →
# dist/sankoch-zlib.cyr). Just `zlib_compress` / `zlib_decompress` and their
# closure — types, checksum (adler32), the bit I/O, huffman, lz77, deflate.
# It drops the LZ4 / gzip / xz / bzip2 / streaming codecs, which added most of
# the full bundle's initialised globals across the 2.2.x → 2.4.x line. For a
# consumer that only inflates/deflates zlib streams (git objects: sit's read
# path, thoth's git producer), this keeps the global footprint low enough to
# stay well under a downstream's `max 1024 initialised globals` budget while
# tracking the CURRENT sankoch (security fixes: the ratio-cap decompressor, the
# bzip2 MTF-undo overflow fix — the latter not on this profile's path anyway).
# Order matches the [lib] include chain (single-pass: reference only earlier).
[lib.zlib]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/deflate.cyr",
    "src/zlib.cyr",
    "src/runtime.cyr",
    "src/reset_zlib.cyr",
]

# --- Per-codec DECODE profiles (2.5.1) --------------------------------------
# So a consumer that only needs one archive envelope pulls just that codec's
# closure, not the whole compression library. Each list is the module's
# validated dependency closure in [lib] chain order (runtime last, per
# [lib.zlib]); `cyrius distlib <name>` → dist/sankoch-<name>.cyr. Closures
# verified by compiling <modules> + the codec entry with no undefined sankoch
# symbols (see the 2.5.1 CHANGELOG).
#
# 2.8.0: every alloc-bearing profile ends `runtime.cyr, reset_<name>.cyr` — the
# second file defines that bundle's `_sankoch_reset_tables` over exactly the
# memoizing modules listed above it (rule: src/runtime.cyr). The closure is now
# proven by LINKING: scripts/profile-link-gate.sh builds and runs a probe against
# every profile's committed bundle, and fails on a profile with no probe.

# `[lib.zstd]` — the RFC-8878 zstd decoder, fully self-contained (its own bit
# reader / FSE / Huffman; no checksum/deflate/runtime). The smallest useful
# profile — this is what the installer path (agnova base-system.tar.zst) and
# takumi's zstd source-tarball path want.
[lib.zstd]
modules = [
    "src/types.cyr",
    "src/zstd.cyr",
    "src/runtime.cyr",
    "src/reset_zstd.cyr",
]

# `[lib.bzip2]` — bzip2 decode (BWT + Huffman + MTF). Needs the bzip2 CRC + the
# sankoch alloc/mutex runtime.
[lib.bzip2]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bzip2.cyr",
    "src/runtime.cyr",
    "src/reset_bzip2.cyr",
]

# `[lib.xz]` — .xz (LZMA2) decode. Needs lz77 (match model) + crc32/crc64.
[lib.xz]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/lz77.cyr",
    "src/xz.cyr",
    "src/runtime.cyr",
    "src/reset_xz.cyr",
]

# `[lib.gzip]` — gzip/DEFLATE decode (the deflate closure + crc32). Like
# [lib.zlib] but the gzip envelope instead of zlib.
[lib.gzip]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/deflate.cyr",
    "src/gzip.cyr",
    "src/runtime.cyr",
    "src/reset_gzip.cyr",
]

# `[lib.zip]` — the PKZIP `.zip` container (2.6.0): in-memory reader + writer for
# methods 0 (store) and 8 (DEFLATE). The DEFLATE closure + crc32, with `zip.cyr`
# instead of an envelope module. agnosai's `.agpkg` profile. Deliberately excludes
# `tar.cyr` (and the codecs its `tar_open_auto` dispatches to) — zip.cyr carries its
# own path guard so this profile stays lean.
[lib.zip]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/deflate.cyr",
    "src/zip.cyr",
    "src/runtime.cyr",
    "src/reset_zip.cyr",
]

# `[lib.zipall]` — ZIP with EVERY method sankoch owns (2.6.1): store / DEFLATE plus
# 12 (bzip2), 93 (zstd), 95 (xz), read and write, via `zip_methods.cyr`. Use `[lib.zip]`
# instead when only store + DEFLATE are needed (agnosai) — that profile is a third the
# size because it never pulls the extra codecs. `zip_methods.cyr` is what keeps the two
# apart: `zip.cyr` itself never references xz/bzip2/zstd.
[lib.zipall]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/deflate.cyr",
    "src/xz.cyr",
    "src/bzip2.cyr",
    "src/zstd.cyr",
    "src/zip.cyr",
    "src/zip_methods.cyr",
    "src/runtime.cyr",
    "src/reset_zipall.cyr",
]

# `[lib.tar]` — the sovereign tar cursor + every envelope its `tar_open_auto`
# dispatches to (gzip / xz / bzip2 / zstd). The "extract any tarball" profile
# (takumi source tarballs, agnova rootfs). Excludes only the LZ4 + encode-only
# + stream paths from the full bundle.
[lib.tar]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/deflate.cyr",
    "src/gzip.cyr",
    "src/xz.cyr",
    "src/bzip2.cyr",
    "src/zstd.cyr",
    "src/tar.cyr",
    "src/runtime.cyr",
    "src/reset_tar.cyr",
]

# `[lib.brotli]` — RFC 7932 Brotli DECODE (2.8.0). Self-contained: its own bit reader,
# prefix codes and static dictionary; no checksum or deflate modules. The ~123 KB
# dictionary literal lives in brotli_dict.cyr, which only this profile, [lib.woff] and
# [lib] carry. Needs the sankoch alloc/mutex runtime for its lazy workspace.
[lib.brotli]
modules = [
    "src/types.cyr",
    "src/brotli_dict.cyr",
    "src/brotli.cyr",
    "src/runtime.cyr",
    "src/reset_brotli.cyr",
]

# `[lib.woff]` — web-font containers (2.8.0): WOFF 1.0 (zlib per table) + WOFF2 (Brotli).
# rekha's profile. ONE sankoch bundle per program (src/runtime.cyr), so the two codecs ship
# as one closure: the [lib.zlib] module list plus the Brotli modules. Keep the zlib part in
# step with [lib.zlib].
[lib.woff]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/deflate.cyr",
    "src/zlib.cyr",
    "src/brotli_dict.cyr",
    "src/brotli.cyr",
    "src/runtime.cyr",
    "src/reset_woff.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "fmt",
    "vec",
    "fnptr",
    "thread",
    "assert",
]
