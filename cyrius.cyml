[package]
name = "sankoch"
version = "${file:VERSION}"
description = "Lossless compression library — LZ4, DEFLATE, zlib, gzip"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/sankoch"
language = "cyrius"
cyrius = "6.2.15"

[build]
entry = "src/lib.cyr"
output = "build/sankoch"

# `[lib]` declares the module set `cyrius distlib` concatenates into
# dist/sankoch.cyr — the single-file bundle downstream consumers
# include as `lib/sankoch.cyr` in Cyrius stdlib.
#
# Do not move `modules` under `[build]`. `cyrius build` would prepend
# them before src/lib.cyr, which already chains them via `include`,
# and the binary would double-embed every symbol.
#
# Order matters — matches the include chain in src/lib.cyr.
[lib]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/checksum.cyr",
    "src/bitreader.cyr",
    "src/bitwriter.cyr",
    "src/huffman.cyr",
    "src/lz77.cyr",
    "src/lz4_decode.cyr",
    "src/lz4.cyr",
    "src/deflate.cyr",
    "src/zlib.cyr",
    "src/gzip.cyr",
    "src/stream.cyr",
    "src/lib.cyr",
]

# `[lib.core]` is the kernel-safe profile (`cyrius distlib core` →
# dist/sankoch-core.cyr). Pure-compute LZ4 block + frame decompress —
# no alloc, no syscalls, no mutex. Consumed by AGNOS initrd loader.
# Encode side, DEFLATE/zlib/gzip, and the alloc-using checksum state
# APIs are deliberately excluded.
[lib.core]
modules = [
    "src/types.cyr",
    "src/xxhash32.cyr",
    "src/lz4_decode.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "fmt",
    "vec",
    "fnptr",
    "thread",
    "assert",
]
