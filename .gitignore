# Build output
/build/
# Ignore dist/ CONTENTS (not the dir itself, so the `!` exceptions below can
# re-include the committed distlib consumer bundles — consumers pull them by
# path: the full library, the kernel-safe core profile, and the DEFLATE/zlib
# profile). A `/dist/` dir-exclude would make the `!file` re-includes impossible.
/dist/*
!dist/sankoch.cyr
!dist/sankoch-core.cyr
!dist/sankoch-zlib.cyr
*.core

# Resolved deps (auto-generated by `cyrius deps`) — vendored stdlib stays
lib/*.cyr
!lib/k*.cyr

# Lockfile policy: track when git-deps are present, otherwise omit.
# sankoch has zero git deps so cyrius.lock is not generated; the line
# below is the recipe for when it might be (uncomment to ignore).
# cyrius.lock

# Release / toolchain artifacts
cyrius-*.tar.gz
*.tar.gz
SHA256SUMS

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Environment / secrets
.env
.env.*
*.pem
*.key
