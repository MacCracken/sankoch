# Build output
/build/
# Ignore dist/ CONTENTS (not the dir itself, so the `!` exceptions below can
# re-include the committed distlib consumer bundles — consumers pull them by
# path: the full library, the kernel-safe core profile, and the per-codec
# decode profiles (zlib/zstd/bzip2/xz/gzip/tar). A `/dist/` dir-exclude would
# make the `!file` re-includes impossible. `.deps` sidecars stay ignored — they
# are build metadata, not consumer bundles. Every re-included `.cyr` is gated by
# the dist-drift check in ci.yml; an untracked bundle would slip that gate
# silently (`git diff --quiet` on an untracked path always exits 0).
/dist/*
!dist/sankoch.cyr
!dist/sankoch-core.cyr
!dist/sankoch-zlib.cyr
!dist/sankoch-zstd.cyr
!dist/sankoch-bzip2.cyr
!dist/sankoch-xz.cyr
!dist/sankoch-gzip.cyr
!dist/sankoch-tar.cyr
!dist/sankoch-zip.cyr
*.core

# Resolved deps (auto-generated by `cyrius deps`) — vendored stdlib stays
lib/*.cyr
!lib/k*.cyr

# Lockfile policy: track when git-deps are present, otherwise omit.
# sankoch has zero git deps so cyrius.lock is not generated; the line
# below is the recipe for when it might be (uncomment to ignore).
# cyrius.lock

# Release / toolchain artifacts
cyrius-*.tar.gz
*.tar.gz
SHA256SUMS

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Environment / secrets
.env
.env.*
*.pem
*.key
