fn _fz_allowed(r) {
    if (r == 0 - ERR_CORRUPT_DATA || r == 0 - ERR_UNSUPPORTED_FORMAT || r == 0 - ERR_INVALID_HUFFMAN) { return 1; }
    if (r == 0 - ERR_MATCH_OUT_OF_RANGE || r == 0 - ERR_BUFFER_TOO_SMALL || r == 0 - ERR_OUTPUT_LIMIT) { return 1; }
    return 0;
}

# Decode src[0..n) under every invariant. Returns r.
fn _fz_check(n) {
    var src = _fz_gsrc - n;
    var c = 0;
    while (c < n) { store8(src + c, load8(_fz_src + c)); c = c + 1; }
    _fz_runs = _fz_runs + 1;
    var r = brotli_decompress(src, n, _fz_dst, 65536);
    if (r < 0) {
        if (_fz_allowed(r) == 0) { _fz_bad = _fz_bad + 1; }
    } else {
        if (r > 65536) { _fz_bad = _fz_bad + 1; }
    }
    if (decompress(FORMAT_BROTLI, src, n, _fz_dst2, 65536) != r) { _fz_bad = _fz_bad + 1; }
    if (r >= 0) {
        _fz_ok = _fz_ok + 1;
        if (_fz_guarded(src, n, r, 0) != r) { _fz_bad = _fz_bad + 1; }   # exact cap
        var d = _fz_gdst - r;
        var i = 0;
        while (i < r) {
            if (load8(_fz_dst + i) != load8(d + i)) {
                _fz_bad = _fz_bad + 1;
                i = r;
            }
            i = i + 1;
        }
    }
    if (r > 0) {
        if (_fz_guarded(src, n, r - 1, 0) != 0 - ERR_BUFFER_TOO_SMALL) { _fz_bad = _fz_bad + 1; }
        if (r >= 2) {
            if (_fz_guarded(src, n, r, r - 1) != 0 - ERR_OUTPUT_LIMIT) { _fz_bad = _fz_bad + 1; }
        }
    }
    if (_fz_runs % 97 == 0) {
        var cap = 1 + _fz_rand(4096);
        var rc = brotli_decompress_capped(src, n, _fz_dst2, 65536, cap);
        if (rc > cap || (rc < 0 && _fz_allowed(rc) == 0)) { _fz_bad = _fz_bad + 1; }
    }
    return r;
}

# Copy seed k into the mutation buffer; returns its length.
fn _fz_load(k) {
    var off = load64(&_fz_off + k * 8);
    var len = load64(&_fz_len + k * 8);
    var i = 0;
    while (i < len) {
        store8(_fz_src + i, load8(_fz_pool + off + i));
        i = i + 1;
    }
    return len;
}

fn main() {
    alloc_init();
    crc32_init_table();
    _fz_pool = alloc(4096);
    _fz_src = alloc(4096 + 64);
    _fz_dst = alloc(65536 + 64);
    _fz_dst2 = alloc(65536 + 64);
    _fz_gsrc = _fz_guard_map(4096);
    _fz_gdst = _fz_guard_map(65536 + 64);
    assert(_fz_gsrc != 0 && _fz_gdst != 0, "fuzz_brotli guard pages mapped");
    _fz_seeds();
    assert(_fz_used <= 4096, "fuzz_brotli seed pool fits 4 KB");

    # Seeds decode to their manifest output.
    var k = 0;
    while (k < _fz_nseeds) {
        var n = _fz_load(k);
        var r = _fz_check(n);
        assert(r == load64(&_fz_olen + k * 8), "fuzz_brotli seed decodes to its manifest length");
        assert(r >= 0 && crc32(_fz_dst, r) == load64(&_fz_ocrc + k * 8), "fuzz_brotli seed output CRC-32");
        k = k + 1;
    }
    println("fuzz_brotli: 13 seeds decode to their manifest output");

    # 1. Random buffers.
    _fuzz_seed(2808001);
    var it = 0;
    while (it < 1500) {
        var len = 1 + _fz_rand(1024);
        var i = 0;
        while (i < len) {
            store8(_fz_src + i, _fuzz_next());
            i = i + 1;
        }
        if ((it & 1) == 0) { store8(_fz_src, load8(_fz_pool + load64(&_fz_off + _fz_rand(_fz_nseeds) * 8))); }
        _fz_check(len);
        it = it + 1;
    }
    println("fuzz_brotli: 1500 random-input tests passed");

    # 2. Seed mutations.
    _fuzz_seed(2808002);
    it = 0;
    while (it < 2000) {
        var n2 = _fz_load(_fz_rand(_fz_nseeds));
        var kind = _fz_rand(4);
        if (kind == 0) {                             # 1-8 bit flips
            var f = 1 + _fz_rand(8);
            while (f > 0) {
                var b = _fz_rand(n2 * 8);
                store8(_fz_src + (b >> 3), load8(_fz_src + (b >> 3)) ^ (1 << (b & 7)));
                f = f - 1;
            }
        } elif (kind == 1) {                         # 1-8 byte overwrites
            var w = 1 + _fz_rand(8);
            while (w > 0) {
                store8(_fz_src + _fz_rand(n2), _fuzz_next());
                w = w - 1;
            }
        } elif (kind == 2) {                         # insert 1-4 random bytes
            var ins = 1 + _fz_rand(4);
            var at = _fz_rand(n2 + 1);
            var j = n2 - 1;
            while (j >= at) {
                store8(_fz_src + j + ins, load8(_fz_src + j));
                j = j - 1;
            }
            j = 0;
            while (j < ins) {
                store8(_fz_src + at + j, _fuzz_next());
                j = j + 1;
            }
            n2 = n2 + ins;
        } else {                                     # delete 1-4 bytes
            var del = 1 + _fz_rand(4);
            if (del >= n2) { del = n2 - 1; }
            var at2 = _fz_rand(n2 - del + 1);
            var j2 = at2;
            while (j2 + del < n2) {
                store8(_fz_src + j2, load8(_fz_src + j2 + del));
                j2 = j2 + 1;
            }
            n2 = n2 - del;
        }
        if (n2 > 0) { _fz_check(n2); }
        it = it + 1;
    }
    println("fuzz_brotli: 2000 seed-mutation tests passed");

    # 3. Truncations.
    _fuzz_seed(2808003);
    it = 0;
    while (it < 750) {
        var n3 = _fz_load(_fz_rand(_fz_nseeds));
        var cut = 1 + _fz_rand(n3 - 1);
        var r3 = _fz_check(cut);
        if (r3 != 0 - ERR_CORRUPT_DATA) { _fz_bad = _fz_bad + 1; }   # a strict prefix is never a stream
        it = it + 1;
    }
    println("fuzz_brotli: 750 truncation tests passed");

    # 4. Splices.
    _fuzz_seed(2808004);
    it = 0;
    while (it < 750) {
        var a = _fz_rand(_fz_nseeds);
        var bs = _fz_rand(_fz_nseeds);
        var na = _fz_load(a);
        var pa = 1 + _fz_rand(na);
        var offb = load64(&_fz_off + bs * 8);
        var nb = load64(&_fz_len + bs * 8);
        var sb = _fz_rand(nb);
        var i4 = sb;
        while (i4 < nb) {
            store8(_fz_src + pa + i4 - sb, load8(_fz_pool + offb + i4));
            i4 = i4 + 1;
        }
        _fz_check(pa + nb - sb);
        it = it + 1;
    }
    println("fuzz_brotli: 750 splice tests passed");

    assert(_fz_bad == 0, "fuzz_brotli: every invariant held");
    print_num(_fz_runs);
    syscall(1, 1, " inputs, ", 9);
    print_num(_fz_ok);
    syscall(1, 1, " accepted, ", 11);
    print_num(_fz_bad);
    println(" invariant violations");
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
