    _fz_hex("804ffbfd6fa56f6b331ce74873e460412ad995a4d63666ad3b5db87d1543478e43d7b474cf2f9ee5c8c900");
    _fz_seed_end(6114, 0x2de5a1f9);
    # 5 synth/BlockSwitchMessage.br: 38 B -> 12 B, CRC-32 bf166253
    _fz_hex("1b0b00d1e101c6e0e206040091b270fe7e11166200001c6c99c4000900803b6d020882000000");
    _fz_seed_end(12, 0xbf166253);
    # 6 synth/BlockCountMessage.br: 37 B -> 12 B, CRC-32 bf166253
    _fz_hex("1b0b0011018cc1c50d08002265e1fcfd222cc4000038d832890112000077da041042000000");
    _fz_seed_end(12, 0xbf166253);
