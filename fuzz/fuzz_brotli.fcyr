# sankoch — Brotli (RFC 7932) decoder fuzz harness (2.8.0)
#
# The decoder must never crash, hang, write out of bounds, or return anything but bytes written
# or one of its 0 - ERR_* classes, on any input. Thirteen seeds (3,255 B, embedded as NUL-free hex:
# the cyrius 6.6.4 string-interning hazard) start mutation from valid streams that reach every
# path turning attacker-controlled indices into table addresses: the dictionary and transforms,
# all four context modes, block switching in L / I / D with type / count trees, distance context
# maps with IMTF, NPOSTFIX / NDIRECT, a 65,536-byte overlapping copy, and an adversarial
# 256-tree distance-map IMTF, and an uncompressed meta-block whose length is not a multiple of 8.
# Strategies (about 5,000 decodes):
#   1. 1,500 random buffers of 1..1,024 B (half start with a seed's first byte, so WBITS parses);
#   2. 2,000 seed mutations: 1-8 bit flips, byte overwrites, a 1-4 byte insert or delete;
#   3. 750 random truncations of seeds;
#   4. 750 splices: a prefix of seed A + a suffix of seed B.
# Invariants on every input: r < 0 is an allowed ERR_* class, else 0 <= r <= 65,536;
# decompress(FORMAT_BROTLI) agrees; an accepted input decodes again into a second buffer with the
# same length and bytes; r > 0 fails closed one byte short (ERR_BUFFER_TOO_SMALL) and with
# max_output = r - 1 (ERR_OUTPUT_LIMIT); every 97th input also runs a random max_output cap.
# Out-of-bounds detection: every decode reads src from a copy that ends flush against a PROT_NONE
# page, so a read past src_len faults. An accepted input decodes again at dst_cap = r into a buffer
# that ends flush against a PROT_NONE page with 64 guard bytes before it, and the one-byte-short
# and capped decodes use the same layout: a write past dst_cap faults, one before dst is counted.
# Buffers are allocated once (the arena never frees). Seeds: tests/data/brotli/ (MANIFEST.tsv
# gives each one's output length and CRC-32, re-checked here before fuzzing).
#
# SPDX-License-Identifier: GPL-3.0-only

include "src/lib.cyr"
include "lib/assert.cyr"

var _fuzz_state = 0;

fn _fuzz_seed(s) {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next() {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

# Uniform-ish 0..n-1 from 24 LCG bits.
fn _fz_rand(n) {
    var v = _fuzz_next() | (_fuzz_next() << 8) | (_fuzz_next() << 16);
    return v % n;
}

var _fz_pool = 0;      # decoded seed bytes
var _fz_used = 0;
var _fz_off: i64[16];  # seed k: bytes [off, off + len) of the pool
var _fz_len: i64[16];
var _fz_olen: i64[16]; # expected output length / CRC-32 (MANIFEST.tsv)
var _fz_ocrc: i64[16];
var _fz_nseeds = 0;
var _fz_start = 0;
var _fz_src = 0;       # mutation buffer
var _fz_dst = 0;
var _fz_dst2 = 0;
var _fz_bad = 0;       # invariant violations
var _fz_ok = 0;        # accepted inputs
var _fz_runs = 0;
var _fz_gsrc = 0;      # PROT_NONE page: src copies end flush against it
var _fz_gdst = 0;      # PROT_NONE page: exact-cap outputs end flush against it

# RW pages for n bytes followed by one PROT_NONE page; returns the guard page's address.
fn _fz_guard_map(n) {
    var pages = (n + 4095) & (0 - 4096);
    var m = syscall(SYS_MMAP, 0, pages + 4096, 3, 34, 0 - 1, 0);   # PROT_READ|WRITE, MAP_PRIVATE|ANON
    var nr = 10;                                     # mprotect: x86_64 10, aarch64 226
    if (SYS_LSEEK != 8) { nr = 226; }
    if (m <= 0 || syscall(nr, m + pages, 4096, 0) != 0) { return 0; }
    return m + pages;
}

# Decode src[0..n) into a cap-byte window ending at the dst guard page, max_output mo (0 = none),
# with 64 guard bytes (0xA5) before it; a changed guard byte is a violation.
fn _fz_guarded(src, n, cap, mo) {
    var d = _fz_gdst - cap;
    var i = 0;
    while (i < 64) { store8(d - 64 + i, 0xA5); i = i + 1; }
    var r = 0;
    if (mo == 0) { r = brotli_decompress(src, n, d, cap); }
    else { r = brotli_decompress_capped(src, n, d, cap, mo); }
    i = 0;
    while (i < 64) {
        if (load8(d - 64 + i) != 0xA5) { _fz_bad = _fz_bad + 1; i = 64; }
        i = i + 1;
    }
    return r;
}

fn _fz_hexv(c) {
    if (c >= 97) { return c - 87; }
    return c - 48;
}

fn _fz_hex(h) {
    var i = 0;
    while (load8(h + i) != 0) {
        store8(_fz_pool + _fz_used, (_fz_hexv(load8(h + i)) << 4) | _fz_hexv(load8(h + i + 1)));
        _fz_used = _fz_used + 1;
        i = i + 2;
    }
    return 0;
}

fn _fz_seed_end(olen, ocrc) {
    var k = _fz_nseeds;
    store64(&_fz_off + k * 8, _fz_start);
    store64(&_fz_len + k * 8, _fz_used - _fz_start);
    store64(&_fz_olen + k * 8, olen);
    store64(&_fz_ocrc + k * 8, ocrc);
    _fz_start = _fz_used;
    _fz_nseeds = k + 1;
    return 0;
}

