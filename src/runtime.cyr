# runtime.cyr — sankoch's shared runtime seam: the API lock + the alloc seam.
#
# Extracted from lib.cyr (2.4.9) so a distlib PROFILE can pull the helpers every
# alloc-bearing codec funnels through WITHOUT lib.cyr's format-dispatch API and
# `_sankoch_reset_tables` (which references every codec's lazy globals, incl.
# `_lz4_htab` / gzip / xz / bzip2 — undefined in a lean single-codec profile).
# The full `[lib]` still includes both; `[lib.zlib]` includes just this.
#
# All mutable de/compression state (bit I/O, hash + Huffman tables, symbol
# buffers) lives behind a single mutex so concurrent callers serialize on API
# entry. Lazy init on first use.

var _sankoch_mtx = 0;

# ---------------------------------------------------------------------------
# Arena-reset detection (2.7.10)
#
# Every lazy global in this library — the CRC-32 table, the Huffman tables, the
# LZ77/LZ4 hash tables, and _sankoch_mtx ITSELF — is a raw pointer into the
# stdlib bump arena, memoized behind an `if (ptr == 0)` guard. `alloc_reset()`
# rewinds that arena without telling anyone, so every one of those pointers
# becomes dangling while staying non-zero: the guards see "already built" and
# the library reads and WRITES through memory a different owner now holds.
#
# Measured before this fix: a caller that allocated 32 KB after alloc_reset()
# and then made one ordinary crc32_init_table() call had 16,351 of its own
# bytes overwritten. The mutex is worse — mutex_lock() on re-owned memory.
#
# The detection is exact, and it works because alloc_reset() ZEROES the span it
# rewinds (an information-leak mitigation it already performs). So a canary
# allocated from the arena and stamped with a magic is guaranteed to read back
# as zero after a reset. Checking it costs one load and one compare.
#
# Residual: a caller could reset, take the canary's address for itself, and
# happen to write exactly SANKOCH_ARENA_MAGIC at exactly that offset. That is a
# 1-in-2^64 coincidence and it is the same bargain every guard value in systems
# software makes. It is named here rather than left implicit.
# ---------------------------------------------------------------------------
var _sankoch_canary = 0;
var SANKOCH_ARENA_MAGIC = 0x534E4B4152454E41;   # "SNKARENA"

# Re-arm after a (re)build. Separate from the check so the check stays a
# straight-line fast path.
fn _sankoch_arm_canary(): i64 {
    _sankoch_canary = _sankoch_alloc(8);
    if (_sankoch_canary != 0) { store64(_sankoch_canary, SANKOCH_ARENA_MAGIC); }
    return 0;
}

# Call before touching ANY lazy global. Returns 0 always; its effect is that
# after it returns, every memoized pointer either points at memory sankoch
# still owns or is 0 (so the ordinary lazy-init guards rebuild it).
fn _sankoch_arena_guard(): i64 {
    if (_sankoch_canary == 0) {
        _sankoch_arm_canary();
        return 0;
    }
    if (load64(_sankoch_canary) == SANKOCH_ARENA_MAGIC) { return 0; }
    # The arena was reset under us. Drop every memoized pointer — including the
    # mutex, which is why this must run BEFORE _sankoch_lock touches it — and
    # re-arm so the next call takes the fast path.
    _sankoch_mtx = 0;
    _sankoch_reset_tables();
    _sankoch_canary = 0;
    _sankoch_arm_canary();
    return 0;
}

fn _sankoch_lock(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS userland is single-threaded — no lock needed. No-op here so sankoch
    # never references mutex_* on agnos, making it self-sufficient even for a
    # consumer that doesn't pull thread.cyr. (thread.cyr already self-guards
    # agnos as of cyrius v6.2.3 — routing to thread_agnos.cyr's no-op mutexes —
    # so this is the sankoch-layer counterpart, not a ud2 preventer.) See the
    # cyrius issue 2026-06-12-sankoch-locks-not-agnos-compatible.md.
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # BEFORE the mutex is touched: _sankoch_mtx is itself an arena pointer, so
    # after an alloc_reset() it is dangling and mutex_lock would operate on
    # memory owned by someone else.
    _sankoch_arena_guard();
    if (_sankoch_mtx == 0) {
        _sankoch_mtx = mutex_new();
    }
    mutex_lock(_sankoch_mtx);
    return 0;
    #endif
}

fn _sankoch_unlock(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;     # single-threaded agnos — paired no-op with _sankoch_lock
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    mutex_unlock(_sankoch_mtx);
    return 0;
    #endif
}

# `_sankoch_alloc` is the seam every alloc-bearing constructor in this library
# funnels through. In production it forwards straight to the stdlib `alloc(size)`
# call. The fault-injection counter below lets the tcyr suite simulate an OOM at a
# chosen alloc step, so the defensive return-0 + unlock-on-failure paths added in
# 2.2.1 actually get coverage.
#
# Counter semantics: -1 = production (never fail). Otherwise, the Nth subsequent
# `_sankoch_alloc` call (0-indexed) returns 0 once, and the counter resets to -1 —
# one-shot. Tests set the counter right before invoking an entry point, so
# unrelated allocs don't clear the fault before the targeted call fires.
var _sankoch_alloc_fail_at = 0 - 1;

fn _sankoch_alloc(size): i64 {
    if (_sankoch_alloc_fail_at >= 0) {
        if (_sankoch_alloc_fail_at == 0) {
            _sankoch_alloc_fail_at = 0 - 1;
            return 0;
        }
        _sankoch_alloc_fail_at = _sankoch_alloc_fail_at - 1;
    }
    return alloc(size);
}

# Allocator-threaded form (2.7.7). `a == 0` means the process allocator, which is what
# every existing call site gets, so the bare `_sankoch_alloc` path is byte-identical to
# what it was.
#
# ⚠ This exists because sankoch has **no free**: `zip_open` allocates a context, an entry
# table, one name copy per entry and a symlink ledger — ~12 KB for a 100-entry archive —
# and nothing ever reclaims any of it, including on a malformed archive, which is the
# rate an attacker controls. agnosai filed it as a leak. A `zip_close` would have been
# the obvious answer and the wrong one: on a bump allocator it can only be a no-op that
# reads like a reclaim. Letting the caller supply an arena and `reset_via` it is the
# answer the rest of the ecosystem already uses (bayan's `_a` forms), and it actually
# frees.
fn _sankoch_alloc_via(a, size): i64 {
    if (_sankoch_alloc_fail_at >= 0) {
        if (_sankoch_alloc_fail_at == 0) {
            _sankoch_alloc_fail_at = 0 - 1;
            return 0;
        }
        _sankoch_alloc_fail_at = _sankoch_alloc_fail_at - 1;
    }
    if (a == 0) { return alloc(size); }
    return alloc_via(a, size);
}

# Test-only setter for the fault-injection counter. Public-facing (`_` prefix is
# convention for "internal but exported") because tests live outside src/ and
# need to reach in.
fn _sankoch_alloc_set_fail_at(n): i64 {
    _sankoch_alloc_fail_at = n;
    return 0;
}
