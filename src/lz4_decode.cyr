# sankoch — LZ4 decompress (block + frame), kernel-safe subset
#
# Pure-compute: no alloc, no syscalls, no mutex. Lives in its own
# module so the `[lib.core]` distlib profile (sankoch-core.cyr) can
# pull it in alongside types.cyr + xxhash32.cyr without dragging the
# alloc-using LZ4 encoder in src/lz4.cyr.
#
# Constants for the LZ4 frame format (magic, version, block-max) live
# here so both the decoder (this file) and the encoder (lz4.cyr,
# included later in the chain) can see them. LZ4F_BLOCK_MAX is
# encode-side state but lives with the rest of the enum for
# coherence — the kernel-safe profile carries it as inert data.

enum LZ4F {
    LZ4F_MAGIC = 407708164;   # 0x184D2204 — bytes [04 22 4D 18] read as LE u32
    LZ4F_VERSION = 1;
    LZ4F_BLOCK_MAX = 65536;   # Matches BD byte (0x40 → block max size 64KB)
}

# Decode one LZ4 block into dst, starting at position dp0. A match may reach back to position `lo`:
# dp0 for a standalone or independent block, 0 for an LZ4F linked block, whose history is the frame
# decoded so far. Output past `cap` is ERR_BUFFER_TOO_SMALL; output past `lim` is `lim_err` (the
# 16 MB ceiling for a bare block, the declared block maximum inside a frame). Returns the bytes this
# block produced, or a negative error.
fn _lz4_dec_block(src, src_len, dst, dp0, cap, lo, lim, lim_err): i64 {
    var sp = 0;     # source position
    var dp = dp0;   # destination position

    while (sp < src_len) {
        # Read token
        var token = load8(src + sp);
        sp = sp + 1;

        # Literal length (high nibble)
        var lit_len = (token >> 4) & 15;
        if (lit_len == 15) {
            var extra = 255;
            while (extra == 255) {
                if (sp >= src_len) { return 0 - ERR_CORRUPT_DATA; }
                extra = load8(src + sp);
                sp = sp + 1;
                lit_len = lit_len + extra;
            }
        }

        # Copy literals
        if (dp + lit_len > cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
        if (dp + lit_len > lim) { return 0 - lim_err; }
        if (sp + lit_len > src_len) { return 0 - ERR_CORRUPT_DATA; }
        var i = 0;
        while (i < lit_len) {
            store8(dst + dp, load8(src + sp));
            sp = sp + 1;
            dp = dp + 1;
            i = i + 1;
        }

        # End of block — last sequence has no match
        if (sp >= src_len) {
            return dp - dp0;
        }

        # Match offset (2 bytes, little-endian)
        if (sp + 2 > src_len) { return 0 - ERR_CORRUPT_DATA; }
        var offset = load8(src + sp) + (load8(src + sp + 1) * 256);
        sp = sp + 2;

        if (offset == 0) { return 0 - ERR_CORRUPT_DATA; }
        if (offset > dp - lo) { return 0 - ERR_MATCH_OUT_OF_RANGE; }

        # Match length (low nibble + 4 minimum)
        var match_len = (token & 15) + 4;
        if (match_len == 19) {
            # 15 + 4 = 19 means extended match length
            var extra = 255;
            while (extra == 255) {
                if (sp >= src_len) { return 0 - ERR_CORRUPT_DATA; }
                extra = load8(src + sp);
                sp = sp + 1;
                match_len = match_len + extra;
            }
        }

        # Copy match (byte-by-byte for overlapping matches)
        if (dp + match_len > cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
        if (dp + match_len > lim) { return 0 - lim_err; }
        var match_pos = dp - offset;
        i = 0;
        while (i < match_len) {
            store8(dst + dp, load8(dst + match_pos));
            dp = dp + 1;
            match_pos = match_pos + 1;
            i = i + 1;
        }
    }

    return dp - dp0;
}

# Decompress an LZ4 block.
# src: pointer to compressed data
# src_len: length of compressed data
# dst: pointer to output buffer
# dst_cap: capacity of output buffer
# Returns: decompressed length, or negative error code
fn lz4_decompress(src, src_len, dst, dst_cap): i64 {
    return _lz4_dec_block(src, src_len, dst, 0, dst_cap, 0, DECOMPRESS_MAX_OUTPUT, ERR_OUTPUT_LIMIT);
}

# Little-endian u32 at p.
fn _lz4f_le32(p): i64 {
    return load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24);
}

# Decompress one LZ4 frame (github.com/lz4/lz4 doc/lz4_Frame_format.md). The frame is checked as
# `lz4 -d` checks it (2.8.6): FLG version and reserved bit, BD reserved bits and a block-maximum id of
# 4..7, the header checksum (byte 2 of xxHash32 over the descriptor), each block's size against the
# block maximum (compressed and decoded), the end mark (a frame cut before it is ERR_CORRUPT_DATA,
# not a short success), the declared content checksum and content size, and the optional per-block
# checksums. Linked blocks (FLG bit 5 clear, the LZ4F library default) may match into the frame
# decoded so far. Bytes after the frame are not read: one call decodes one frame.
fn lz4f_decompress(src, src_len, dst, dst_cap): i64 {
    if (src_len < 11) { return 0 - ERR_INVALID_INPUT; }

    # Verify magic
    if (_lz4f_le32(src) != LZ4F_MAGIC) { return 0 - ERR_CORRUPT_DATA; }

    var flg = load8(src + 4);
    var version = (flg >> 6) & 3;
    if (version != LZ4F_VERSION) { return 0 - ERR_UNSUPPORTED_FORMAT; }
    if (((flg >> 1) & 1) != 0) { return 0 - ERR_CORRUPT_DATA; }   # reserved bit
    var linked = 1 - ((flg >> 5) & 1);
    var has_block_checksum = (flg >> 4) & 1;
    var has_content_size = (flg >> 3) & 1;
    var has_content_checksum = (flg >> 2) & 1;
    var has_dict_id = flg & 1;

    var bd = load8(src + 5);
    if ((bd & 0x8F) != 0) { return 0 - ERR_CORRUPT_DATA; }        # reserved bits 7, 3..0
    var bms = (bd >> 4) & 7;
    if (bms < 4) { return 0 - ERR_CORRUPT_DATA; }                 # ids 0..3 are reserved
    var bmax = 1 << (8 + 2 * bms);                                # 64 KiB / 256 KiB / 1 MiB / 4 MiB

    var sp = 6;
    var content_size = 0 - 1;
    if (has_content_size == 1) {
        if (sp + 8 > src_len) { return 0 - ERR_CORRUPT_DATA; }
        content_size = _lz4f_le32(src + sp) | (_lz4f_le32(src + sp + 4) << 32);
        sp = sp + 8;
    }
    if (has_dict_id == 1) { sp = sp + 4; }
    if (sp + 1 > src_len) { return 0 - ERR_CORRUPT_DATA; }
    if (((xxhash32(src + 4, sp - 4) >> 8) & 255) != load8(src + sp)) {
        return 0 - ERR_CHECKSUM_MISMATCH;
    }
    sp = sp + 1;

    # Data blocks, up to the end mark.
    var total = 0;
    loop {
        if (sp + 4 > src_len) { return 0 - ERR_CORRUPT_DATA; }   # truncated: no end mark
        var block_size = _lz4f_le32(src + sp);
        sp = sp + 4;

        if (block_size == 0) { break; }

        var is_uncompressed = (block_size >> 31) & 1;
        block_size = block_size & 2147483647;

        if (block_size > bmax) { return 0 - ERR_CORRUPT_DATA; }
        if (sp + block_size > src_len) { return 0 - ERR_CORRUPT_DATA; }
        var data_start = sp;

        if (is_uncompressed == 1) {
            if (total + block_size > dst_cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
            var i = 0;
            while (i < block_size) {
                store8(dst + total + i, load8(src + sp + i));
                i = i + 1;
            }
            total = total + block_size;
        } else {
            var lo = total;
            if (linked == 1) { lo = 0; }
            var dlen = _lz4_dec_block(src + sp, block_size, dst, total, dst_cap, lo, total + bmax, ERR_CORRUPT_DATA);
            if (dlen < 0) { return dlen; }
            total = total + dlen;
        }

        sp = sp + block_size;

        # Per-block checksum (FLG bit 4): 4-byte xxHash32 of on-wire block data.
        if (has_block_checksum == 1) {
            if (sp + 4 > src_len) { return 0 - ERR_CORRUPT_DATA; }
            if (_lz4f_le32(src + sp) != xxhash32(src + data_start, block_size)) {
                return 0 - ERR_CHECKSUM_MISMATCH;
            }
            sp = sp + 4;
        }
    }

    if (has_content_size == 1 && total != content_size) { return 0 - ERR_CORRUPT_DATA; }

    # Content checksum (FLG bit 2): required once declared.
    if (has_content_checksum == 1) {
        if (sp + 4 > src_len) { return 0 - ERR_CORRUPT_DATA; }
        if (_lz4f_le32(src + sp) != xxhash32(dst, total)) { return 0 - ERR_CHECKSUM_MISMATCH; }
    }

    return total;
}
