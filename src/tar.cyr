# tar.cyr — sovereign tar (POSIX ustar + pre-POSIX v7) reader with a pull-cursor API.
#
# Sankoch is the ecosystem's compression lib; tar is the archive layer that pairs with it, so the
# canonical tar parser lives here — lifted from takumi's proven extract_archive (2.4.x) and made
# sink-agnostic. Each consumer drives the cursor and does its OWN writes: takumi -> filesystem,
# agnova -> ext2. The header-checksum validation, PAX ('x'/'g') and GNU ('L'/'K') long-name
# handling, and ustar prefix are enforced HERE. Path-traversal safety is enforced in TWO layers:
# per-entry ("..", absolute, bad bytes, single-hop symlink depth) AND cross-entry (2.5.9 — a
# ledger that rejects any member written through or onto a symlink an earlier entry planted,
# closing the multi-hop-symlink-chain escape). This guard is DEFENCE IN DEPTH, not a licence to
# extract untrusted archives unguarded: a consumer that follows symlinks on write should still
# use openat2(RESOLVE_BENEATH) / O_NOFOLLOW per component, since a symlink already present in the
# destination (not planted by this archive) is outside what the cursor can see.
#
# Usage:
#   var cur = tar_open_auto(archive, len);       # sniffs gzip/xz/bzip2/zstd, decompresses in RAM
#   if (cur == 0) { /* decompress / open error */ }
#   var r;
#   while ((r = tar_next(cur)) == 1) {
#       var kind = tar_kind(cur);                # TAR_FILE / TAR_DIR / TAR_SYMLINK
#       var path = tar_path(cur);                # NUL-terminated, validated, relative
#       if (kind == TAR_FILE)    { ...write tar_data(cur), tar_size(cur), mode tar_mode(cur)... }
#       if (kind == TAR_SYMLINK) { ...symlink tar_link(cur) -> path... }
#       if (kind == TAR_DIR)     { ...mkdir path... }
#   }
#   if (r < 0) { /* 0 - TAR_ERR_* */ }
#
# SPDX-License-Identifier: GPL-3.0-only

var TAR_FILE = 0;
var TAR_DIR = 1;
var TAR_SYMLINK = 2;

var TAR_ERR_BAD_HEADER = 1;
var TAR_ERR_TRUNCATED = 2;
var TAR_ERR_UNSAFE = 3;
var TAR_ERR_UNSUPPORTED = 4;
var TAR_ERR_DECOMPRESS = 5;
var TAR_ERR_TOO_LARGE = 6;
var TAR_ERR_OOM = 7;   # an allocation failed (e.g. a >2 GiB long-name/PAX field)

var TAR_MAX_OUT = 536870912;   # 512 MiB decompression ceiling (matches takumi SRC_MAX_BYTES)

# Cursor layout (alloc 128): 0 buf, 8 len, 16 pos, 32 px, 40 pg, 48 gnu_name, 56 gnu_link,
# 64 kind, 72 path, 80 mode, 88 mtime, 96 size, 104 data, 112 link.

# --- header field parsers (lifted from takumi source.cyr) ---------------------------------
# Octal field: skip leading spaces/NULs, read octal digits, stop at NUL/space. -1 on a bad digit.
fn _star_octal(ptr, len) {
    var i = 0;
    while (i < len) {
        var c = load8(ptr + i) & 0xFF;
        if (c != 32 && c != 0) { break; }
        i = i + 1;
    }
    var saw = 0;
    var val = 0;
    while (i < len) {
        var c2 = load8(ptr + i) & 0xFF;
        if (c2 == 0 || c2 == 32) { break; }
        if (c2 < 48 || c2 > 55) { return 0 - 1; }
        val = val * 8 + (c2 - 48);
        saw = 1;
        i = i + 1;
    }
    if (saw == 0) { return 0; }
    return val;
}

# Copy up to maxlen bytes from block+off (stop at first NUL) into a fresh NUL-terminated cstr.
fn _star_field_cstr(block, off, maxlen) {
    var n = 0;
    while (n < maxlen) {
        if (load8(block + off + n) == 0) { break; }
        n = n + 1;
    }
    var buf = alloc(n + 1);
    if (buf == 0) { return 0; }   # >2 GiB field or real exhaustion — never memcpy into NULL
    memcpy(buf, block + off, n);
    store8(buf + n, 0);
    return buf;
}

# ustar full path = prefix (345,155) + "/" + name (0,100) when prefix is set.
fn _star_full_path(block) {
    var name = _star_field_cstr(block, 0, 100);
    if (name == 0) { return 0; }
    var prefix = _star_field_cstr(block, 345, 155);
    if (prefix == 0) { return 0; }
    var lp = strlen(prefix);
    if (lp == 0) { return name; }
    var ln = strlen(name);
    var buf = alloc(lp + 1 + ln + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, prefix, lp);
    store8(buf + lp, 47);
    memcpy(buf + lp + 1, name, ln);
    store8(buf + lp + 1 + ln, 0);
    return buf;
}

# Count non-empty, non-"." components of a cstr path.
fn _star_component_count(path) {
    var n = strlen(path);
    var count = 0;
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) { c = load8(path + i) & 0xFF; }
        if (c == 47) {
            var clen = i - start;
            if (clen > 0) {
                var dot = 0;
                if (clen == 1) { if (load8(path + start) == 46) { dot = 1; } }
                if (dot == 0) { count = count + 1; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

# --- path-traversal guards (security core, lifted verbatim) -------------------------------
# Reject empty, absolute, any ".." component, empty interior component (a//b), NUL/control/backslash.
fn _star_path_safe(path) {
    var n = strlen(path);
    if (n == 0) { return 0; }
    if (load8(path) == 47) { return 0; }
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) {
            c = load8(path + i) & 0xFF;
            if (c == 0) { return 0; }
            if (c < 32) { return 0; }
            if (c == 92) { return 0; }
        }
        if (c == 47) {
            var clen = i - start;
            if (clen == 0) {
                if (i != n) { return 0; }
            } else {
                if (clen == 2) {
                    if (load8(path + start) == 46) {
                        if (load8(path + start + 1) == 46) { return 0; }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Symlink target gate (universal part): reject bad bytes; for a RELATIVE target, track depth from
# the link's own directory and reject if a ".." escapes the root. ABSOLUTE targets are byte-checked
# and accepted here — whether to allow them is CONSUMER POLICY (a source-tree extractor like takumi
# rejects them; an OS-rootfs writer like agnova keeps them, since they resolve inside the installed
# root). Consumers that want the strict policy test `load8(tar_link(cur)) == 47` themselves.
fn _star_symlink_safe(link_rel, target) {
    var tn = strlen(target);
    if (tn == 0) { return 0; }
    var i = 0;
    while (i < tn) {
        var c = load8(target + i) & 0xFF;
        if (c == 0) { return 0; }
        if (c < 32) { return 0; }
        if (c == 92) { return 0; }
        i = i + 1;
    }
    if (load8(target) == 47) { return 1; }   # absolute: byte-safe; abs-policy left to the consumer
    var depth = _star_component_count(link_rel) - 1;
    if (depth < 0) { depth = 0; }
    var start = 0;
    i = 0;
    while (i <= tn) {
        var ch = 47;
        if (i < tn) { ch = load8(target + i) & 0xFF; }
        if (ch == 47) {
            var clen = i - start;
            if (clen > 0) {
                var single_dot = 0;
                if (clen == 1) { if (load8(target + start) == 46) { single_dot = 1; } }
                var dotdot = 0;
                if (clen == 2) {
                    if (load8(target + start) == 46) {
                        if (load8(target + start + 1) == 46) { dotdot = 1; }
                    }
                }
                if (single_dot == 1) {
                    depth = depth + 0;
                } else {
                    if (dotdot == 1) {
                        depth = depth - 1;
                        if (depth < 0) { return 0; }
                    } else {
                        depth = depth + 1;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# --- symlink-prefix ledger (2.5.9, closes the H-1 cross-entry traversal hole) -------------
# _star_symlink_safe validates a symlink target one hop at a time and assumes every
# intermediate component is a real directory. It is blind to an EARLIER archive entry
# having planted a symlink at one of those components, so a chain like
#   d/          d/up -> ..          esc -> d/up/..          esc/pwned.txt
# escapes the extraction root while every per-entry check passes (proven: writes to
# ../pwned.txt; GNU tar refuses the same bytes). The cursor kept no cross-entry state.
#
# The fix is a ledger of every symlink path emitted so far; any later entry whose
# DIRECTORY PREFIX (or, for a file/dir, whose own path) is one of those symlinks is
# rejected — exactly the write-through-or-onto-a-symlink operation a safe extractor
# refuses. Tracking EVERY symlink (not just those with absolute/".." targets) is what
# makes it sound: a symlink can never be planted under another symlink (its own prefix
# check rejects it first), so every ledger path has only real-directory ancestors and
# its literal path equals its resolved path — there is no aliasing hole for a benign
# symlink to open. We key on the 64-bit FNV-1a hash of the canonical path (drop "." and
# empty components); a hash collision can only cause an over-reject, never let an escape
# through, so the guard is sound by construction. Open-addressed, grows by doubling, so
# N symlinks + N deep paths cost O(N), not the O(N^2) of a linear scan.
#
# This is deliberately STRICTER than GNU tar: it also refuses to write a member THROUGH
# an in-root symlinked directory (e.g. `lib -> usr/lib` then `lib/foo.so`). Real archives
# never do that — merged-/usr rootfs images write to `usr/lib/foo.so` directly and carry
# `lib -> usr/lib` only as a leaf compat symlink — so the strict rule costs nothing in
# practice while removing the aliasing class entirely.
var _STAR_FNV_OFF = 0xcbf29ce484222325;
var _STAR_FNV_PRIME = 0x100000001b3;

# Allocate a ledger: [+0 capacity][+8 count][+16 buckets-ptr]. 0 = empty bucket.
fn _star_ledger_new() {
    var led = alloc(24);
    if (led == 0) { return 0; }
    var cap = 64;
    var b = alloc(cap * 8);
    if (b == 0) { return 0; }
    var i = 0;
    while (i < cap) { store64(b + i * 8, 0); i = i + 1; }
    store64(led + 0, cap);
    store64(led + 8, 0);
    store64(led + 16, b);
    return led;
}

# Insert hash `h` (0 remapped to 1 so 0 stays the empty sentinel). Grows at load 0.5.
# Returns 0 on success, <0 on OOM.
fn _star_ledger_add(led, h) {
    if (h == 0) { h = 1; }
    var cap = load64(led + 0);
    var cnt = load64(led + 8);
    if ((cnt + 1) * 2 > cap) {
        var ncap = cap * 2;
        var nb = alloc(ncap * 8);
        if (nb == 0) { return 0 - 1; }
        var j = 0;
        while (j < ncap) { store64(nb + j * 8, 0); j = j + 1; }
        var ob = load64(led + 16);
        var k = 0;
        while (k < cap) {
            var v = load64(ob + k * 8);
            if (v != 0) {
                var idx = v & (ncap - 1);
                while (load64(nb + idx * 8) != 0) { idx = (idx + 1) & (ncap - 1); }
                store64(nb + idx * 8, v);
            }
            k = k + 1;
        }
        store64(led + 0, ncap);
        store64(led + 16, nb);
        cap = ncap;
    }
    var b = load64(led + 16);
    var i = h & (cap - 1);
    while (load64(b + i * 8) != 0) {
        if (load64(b + i * 8) == h) { return 0; }   # already present
        i = (i + 1) & (cap - 1);
    }
    store64(b + i * 8, h);
    store64(led + 8, cnt + 1);
    return 0;
}

fn _star_ledger_has(led, h) {
    if (h == 0) { h = 1; }
    var cap = load64(led + 0);
    var b = load64(led + 16);
    var i = h & (cap - 1);
    while (load64(b + i * 8) != 0) {
        if (load64(b + i * 8) == h) { return 1; }
        i = (i + 1) & (cap - 1);
    }
    return 0;
}

# Walk `path` in canonical form (skip "." and empty components). For each proper
# directory prefix, test membership in `led` — return 1 (unsafe) if any prefix is a
# known symlink. Otherwise store the full canonical hash via *full_hash and return 0.
# Two passes so we know which completed component is the last (no per-component alloc).
fn _star_ledger_prefix_unsafe(led, path, full_hash) {
    var n = strlen(path);
    # pass 1: count real (non "."/empty) components
    var total = 0;
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) { c = load8(path + i) & 0xFF; }
        if (c == 47) {
            var clen = i - start;
            if (clen > 0) {
                if (clen != 1 || load8(path + start) != 46) { total = total + 1; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    # pass 2: running FNV over canonical bytes; check each dir prefix (component k<total)
    var h = _STAR_FNV_OFF;
    var seen = 0;
    i = 0;
    start = 0;
    while (i <= n) {
        var c2 = 47;
        if (i < n) { c2 = load8(path + i) & 0xFF; }
        if (c2 == 47) {
            var clen2 = i - start;
            var real = 0;
            if (clen2 > 0) {
                if (clen2 != 1 || load8(path + start) != 46) { real = 1; }
            }
            if (real == 1) {
                if (seen > 0) { h = (h ^ 47) * _STAR_FNV_PRIME; }   # canonical '/' separator
                var j = start;
                while (j < i) { h = (h ^ (load8(path + j) & 0xFF)) * _STAR_FNV_PRIME; j = j + 1; }
                seen = seen + 1;
                if (seen < total) {                                 # a directory prefix
                    if (_star_ledger_has(led, h) == 1) { return 1; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    store64(full_hash, h);
    return 0;
}

# 512-byte all-zero block test (the archive terminator is two of these).
fn _star_zero_block(block) {
    var i = 0;
    while (i < 512) {
        if (load8(block + i) != 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ustar header checksum: sum all 512 bytes with the 8 checksum bytes (148..156) as spaces;
# compare to the stored octal at 148. Works for ustar AND magic-less v7.
fn _star_checksum_ok(block) {
    var stored = _star_octal(block + 148, 8);
    if (stored < 0) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < 512) {
        var c = load8(block + i) & 0xFF;
        if (i >= 148) { if (i < 156) { c = 32; } }
        sum = sum + c;
        i = i + 1;
    }
    if (sum == stored) { return 1; }
    return 0;
}

# gzip trailer ISIZE = uncompressed size mod 2^32 (little-endian).
fn _star_gzip_isize(buf, len) {
    if (len < 4) { return 0 - 1; }
    var p = buf + len - 4;
    var v = (load8(p) & 0xFF) | ((load8(p + 1) & 0xFF) << 8);
    return v | ((load8(p + 2) & 0xFF) << 16) | ((load8(p + 3) & 0xFF) << 24);
}

# --- PAX extended headers ('x' per-file / 'g' global) -------------------------------------
# Override record: +0 path cstr (0=unset), +8 linkpath cstr, +16 size i64 (-1=unset).
fn _star_pax_new() {
    var r = alloc(24);
    if (r == 0) { return 0; }
    store64(r + 0, 0);
    store64(r + 8, 0);
    store64(r + 16, 0 - 1);
    return r;
}

fn _star_pax_reset(r) {
    store64(r + 0, 0);
    store64(r + 8, 0);
    store64(r + 16, 0 - 1);
    return 0;
}

fn _star_pax_cstr(data, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var buf = alloc(n + 1);
    if (buf == 0) { return 0; }   # oversized PAX value — leave the override unset, don't crash
    if (n > 0) { memcpy(buf, data + start, n); }
    store8(buf + n, 0);
    return buf;
}

fn _star_pax_decimal(data, start, end) {
    var i = start;
    var v = 0;
    var saw = 0;
    while (i < end) {
        var c = load8(data + i) & 0xFF;
        if (c < 48 || c > 57) { return 0 - 1; }
        if (v > 922337203685477579) { return 0 - 1; }
        v = v * 10 + (c - 48);
        saw = 1;
        i = i + 1;
    }
    if (saw == 0) { return 0 - 1; }
    return v;
}

fn _star_pax_key_is(data, kstart, klen, lit) {
    if (strlen(lit) != klen) { return 0; }
    return memeq(data + kstart, lit, klen);
}

# Parse PAX "len key=value\n" records into `rec`; lenient (stops at first malformed record).
fn _star_pax_parse(data, len, rec) {
    var i = 0;
    while (i < len) {
        var ds = i;
        var rlen = 0;
        var sawd = 0;
        while (i < len) {
            var c = load8(data + i) & 0xFF;
            if (c < 48 || c > 57) { break; }
            if (rlen > 922337203685477579) { break; }
            rlen = rlen * 10 + (c - 48);
            sawd = 1;
            i = i + 1;
        }
        if (sawd == 0) { break; }
        if (rlen <= 0) { break; }
        if (i >= len) { break; }
        if ((load8(data + i) & 0xFF) != 32) { break; }
        var rec_end = ds + rlen;
        if (rec_end < ds) { break; }
        if (rec_end > len) { break; }
        var kstart = i + 1;
        var eq = 0 - 1;
        var j = kstart;
        while (j < rec_end) {
            if ((load8(data + j) & 0xFF) == 61) { eq = j; break; }
            j = j + 1;
        }
        if (eq >= 0) {
            var klen = eq - kstart;
            var vstart = eq + 1;
            var vend = rec_end - 1;
            if (vend < vstart) { vend = vstart; }
            if (_star_pax_key_is(data, kstart, klen, "path") == 1) {
                store64(rec + 0, _star_pax_cstr(data, vstart, vend));
            } elif (_star_pax_key_is(data, kstart, klen, "linkpath") == 1) {
                store64(rec + 8, _star_pax_cstr(data, vstart, vend));
            } elif (_star_pax_key_is(data, kstart, klen, "size") == 1) {
                var sv = _star_pax_decimal(data, vstart, vend);
                if (sv >= 0) { store64(rec + 16, sv); }
            }
        }
        i = rec_end;
    }
    return 0;
}

# --- public: pull cursor -------------------------------------------------------------------
# Open a cursor over a DECOMPRESSED tar already in memory (buf, len).
fn tar_open(buf, len) {
    var cur = alloc(128);
    if (cur == 0) { return 0; }
    var px = _star_pax_new();
    var pg = _star_pax_new();
    var led = _star_ledger_new();
    if (px == 0 || pg == 0 || led == 0) { return 0; }
    store64(cur + 0, buf);
    store64(cur + 8, len);
    store64(cur + 16, 0);
    store64(cur + 24, led);            # symlink-prefix ledger (2.5.9)
    store64(cur + 32, px);
    store64(cur + 40, pg);
    store64(cur + 48, 0);
    store64(cur + 56, 0);
    return cur;
}

fn tar_kind(cur) { return load64(cur + 64); }
fn tar_path(cur) { return load64(cur + 72); }
fn tar_mode(cur) { return load64(cur + 80); }
fn tar_mtime(cur) { return load64(cur + 88); }
fn tar_size(cur) { return load64(cur + 96); }
fn tar_data(cur) { return load64(cur + 104); }
fn tar_link(cur) { return load64(cur + 112); }

# Advance to the next real entry (consuming PAX/GNU/zero blocks). 1 = entry ready, 0 = end,
# <0 = 0 - TAR_ERR_*. On success the accessors describe the current entry.
fn tar_next(cur) {
    var buf = load64(cur + 0);
    var len = load64(cur + 8);
    var pos = load64(cur + 16);
    var px = load64(cur + 32);
    var pg = load64(cur + 40);
    var zero_run = 0;
    while (pos + 512 <= len) {
        var block = buf + pos;
        if (_star_zero_block(block) == 1) {
            zero_run = zero_run + 1;
            pos = pos + 512;
            if (zero_run >= 2) { store64(cur + 16, pos); return 0; }
            continue;
        }
        zero_run = 0;
        if (_star_checksum_ok(block) != 1) { return 0 - TAR_ERR_BAD_HEADER; }
        var typ = load8(block + 156) & 0xFF;
        var size = _star_octal(block + 124, 12);
        if (size < 0) { return 0 - TAR_ERR_BAD_HEADER; }

        if (typ == 120 || typ == 103) {                # PAX 'x' / 'g'
            pos = pos + 512;
            if (pos + size > len) { return 0 - TAR_ERR_TRUNCATED; }
            if (typ == 120) { _star_pax_parse(buf + pos, size, px); }
            else { _star_pax_parse(buf + pos, size, pg); }
            pos = pos + ((size + 511) / 512) * 512;
            continue;
        }
        if (typ == 76 || typ == 75) {                  # GNU 'L' / 'K' long name
            pos = pos + 512;
            if (pos + size > len) { return 0 - TAR_ERR_TRUNCATED; }
            var lname = _star_field_cstr(buf + pos, 0, size);   # size is attacker-controlled
            if (lname == 0) { return 0 - TAR_ERR_OOM; }         # >2 GiB long name, not a NULL write
            if (typ == 76) { store64(cur + 48, lname); }
            else { store64(cur + 56, lname); }
            pos = pos + ((size + 511) / 512) * 512;
            continue;
        }

        var full = _star_full_path(block);
        if (full == 0) { return 0 - TAR_ERR_OOM; }
        var opath = load64(px + 0);
        if (opath == 0) { opath = load64(pg + 0); }
        if (opath == 0) { opath = load64(cur + 48); }
        if (opath != 0) { full = opath; }
        var esize = size;
        var osz = load64(px + 16);
        if (osz < 0) { osz = load64(pg + 16); }
        if (osz >= 0) { esize = osz; }

        var kind = 0;
        if (typ == 48 || typ == 0) { kind = 0; }
        else { if (typ == 53) { kind = 1; }
            else { if (typ == 50) { kind = 2; }
                else { return 0 - TAR_ERR_UNSUPPORTED; } } }
        if (kind == 0) {                               # v7 dir = trailing '/'
            var fl = strlen(full);
            if (fl > 0) { if (load8(full + fl - 1) == 47) { kind = 1; } }
        }
        if (_star_path_safe(full) != 1) { return 0 - TAR_ERR_UNSAFE; }
        # Cross-entry guard (2.5.9): reject writing through a symlink planted by an
        # earlier entry — the escape _star_symlink_safe's per-entry check cannot see.
        var led = load64(cur + 24);
        var fhash = 0;
        if (_star_ledger_prefix_unsafe(led, full, &fhash) == 1) {
            return 0 - TAR_ERR_UNSAFE;
        }
        # A file/dir written AT a path that is already a risky symlink follows that
        # symlink on write (open(2) O_WRONLY / mkdir resolve the final component), so
        # the leaf must be checked too — not just directory prefixes. (A symlink entry
        # onto an existing symlink is EEXIST, not a follow, so kind 2 is exempt.)
        if (kind != 2) {
            if (_star_ledger_has(led, fhash) == 1) { return 0 - TAR_ERR_UNSAFE; }
        }
        pos = pos + 512;

        store64(cur + 64, kind);
        store64(cur + 72, full);
        store64(cur + 80, _star_octal(block + 100, 8));
        store64(cur + 88, _star_octal(block + 136, 12));
        if (kind == 2) {
            var link = _star_field_cstr(block, 157, 100);
            var olink = load64(px + 8);
            if (olink == 0) { olink = load64(pg + 8); }
            if (olink == 0) { olink = load64(cur + 56); }
            if (olink != 0) { link = olink; }
            if (_star_symlink_safe(full, link) != 1) { return 0 - TAR_ERR_UNSAFE; }
            # Record EVERY symlink, not just risky ones. Because a symlink can never be
            # planted under another symlink (its prefix check above would have rejected
            # it), each ledger path has only real-directory ancestors, so its literal
            # path equals its resolved path — no aliasing hole. Tracking only "risky"
            # targets left exactly such a hole (a benign `a -> .` aliasing a later
            # `a/d -> ..` reachable as `d`). Sound over clever.
            if (_star_ledger_add(led, fhash) < 0) { return 0 - TAR_ERR_OOM; }
            store64(cur + 96, 0);
            store64(cur + 104, 0);
            store64(cur + 112, link);
        } else {
            if (kind == 0) {
                if (esize < 0) { return 0 - TAR_ERR_BAD_HEADER; }
                if (esize > len - pos) { return 0 - TAR_ERR_TRUNCATED; }
                store64(cur + 96, esize);
                store64(cur + 104, buf + pos);
                pos = pos + ((esize + 511) / 512) * 512;
            } else {
                store64(cur + 96, 0);
                store64(cur + 104, 0);
            }
            store64(cur + 112, 0);
        }
        store64(cur + 16, pos);
        _star_pax_reset(px);
        store64(cur + 48, 0);
        store64(cur + 56, 0);
        return 1;
    }
    store64(cur + 16, pos);
    return 0;
}

# Open a cursor over a possibly-compressed archive: sniff gzip/xz/bzip2/zstd by magic, decompress
# into a fresh RAM buffer, and return a cursor over the plain tar. Returns 0 on decompress/open error.
fn tar_open_auto(archive, len) {
    if (len < 4) { return tar_open(archive, len); }
    var b0 = load8(archive) & 0xFF;
    var b1 = load8(archive + 1) & 0xFF;
    var b2 = load8(archive + 2) & 0xFF;
    var b3 = load8(archive + 3) & 0xFF;
    var fmt = 0;
    if (b0 == 0x1F && b1 == 0x8B) { fmt = FORMAT_GZIP; }
    elif (b0 == 0x42 && b1 == 0x5A && b2 == 0x68) { fmt = FORMAT_BZIP2; }
    elif (b0 == 0xFD && b1 == 0x37 && b2 == 0x7A) { fmt = FORMAT_XZ; }
    elif (b0 == 0x28 && b1 == 0xB5 && b2 == 0x2F && b3 == 0xFD) { fmt = FORMAT_ZSTD; }
    if (fmt == 0) { return tar_open(archive, len); }

    if (fmt == FORMAT_ZSTD) {
        var osize = zstd_frame_content_size(archive, len);
        var zcap = osize + 512;
        if (osize <= 0) { zcap = len * 20; if (zcap < 1048576) { zcap = 1048576; } }
        if (zcap > TAR_MAX_OUT) { zcap = TAR_MAX_OUT; }
        var zout = alloc(zcap);
        if (zout == 0) { return 0; }
        var zn = zstd_decompress(archive, len, zout, zcap);
        if (zn < 0) { return 0; }
        return tar_open(zout, zn);
    }

    if (fmt == FORMAT_GZIP) {
        var isize = _star_gzip_isize(archive, len);
        if (isize <= 0) { return 0; }
        if (isize > TAR_MAX_OUT) { return 0; }
        var gcap = isize + 512;
        var gout = alloc(gcap);
        if (gout == 0) { return 0; }
        var gn = gzip_decompress(archive, len, gout, gcap);
        if (gn < 0) { return 0; }
        return tar_open(gout, gn);
    }
    # xz / bzip2 carry no reliable output size: 8x estimate, double on buffer-too-small.
    var cap = len * 8;
    if (cap < 1048576) { cap = 1048576; }
    if (cap > TAR_MAX_OUT) { cap = TAR_MAX_OUT; }
    var done = 0;
    while (done == 0) {
        var out = alloc(cap);
        if (out == 0) { return 0; }
        var dn = 0 - 1;
        if (fmt == FORMAT_XZ) { dn = xz_decompress(archive, len, out, cap); }
        else { dn = bzip2_decompress(archive, len, out, cap); }
        if (dn >= 0) { return tar_open(out, dn); }
        var e = 0 - dn;
        if (e == ERR_BUFFER_TOO_SMALL || e == ERR_OUTPUT_LIMIT) {
            if (cap >= TAR_MAX_OUT) { return 0; }
            cap = cap * 2;
            if (cap > TAR_MAX_OUT) { cap = TAR_MAX_OUT; }
        } else {
            return 0;
        }
    }
    return 0;
}
