# === sankoch -- Brotli static dictionary: geometry + self-check ===
#
# RFC 7932 Appendix A "Static Dictionary Data": 122784 bytes, committed as
# docs/sources/brotli/dictionary.bin.
#   sha256    20e42eb1b511c21806d4d227d07e5dd06877d8ce7b3a817f378f313653f35c70
#   CRC-32    0x5136cb04 (the value RFC 7932 Appendix A states)
#   xxHash32  0x71cccfa8 (seed 0)
#   FNV-1a-64 0xd8a843a9cc932619
# Provenance: RFC 7932 Appendix A; byte-identical to google/brotli v1.2.0
#   c/common/dictionary.bin (MIT -- see docs/sources/brotli/LICENSE.brotli).
#
# THE BYTES ARE NOT IN THIS FILE. cyrius.cyml `[embed] _brotli_dict_bin` (cyrius >= 6.6.19)
# gives every compile in this project `_brotli_dict_bin()` -- the address of the 122784 bytes,
# NUL-terminated -- and `_brotli_dict_bin_len()`, both generated by cyrius from the .bin file at
# build time. A bundle carries them when its `[lib...] embed` names _brotli_dict_bin ([lib],
# [lib.brotli], [lib.woff]). Replacing the dictionary means replacing the .bin; nothing here is
# generated, and nothing must be declared under those two names (cyrius refuses an [embed] NAME
# another declaration owns). Through 2.8.2 this file WAS the literal, written by a Python
# generator that CI re-ran and cmp'ed; 2.8.3 retired both (CHANGELOG [2.8.3]).
#
# What stays here is the RFC geometry and the self-check. A consumer that reads the bytes should
# run _brotli_dict_verify() once (a compiler that mis-addresses a literal is not hypothetical:
# cyrius 6.6.3 read >= 64 KB literals from their 2nd byte); brotli.cyr does, before the first
# dictionary reference, and fails closed with ERR_CHECKSUM_MISMATCH. The 70 NUL bytes in the data
# are safe in a literal since cyrius 6.6.15 (string interning only matches a committed window).
#
# FREESTANDING: no stdlib, no heap, no syscalls, no includes -- integer arithmetic and load8 only.
#
# Module code GPL-3.0-only; dictionary data MIT (google/brotli, docs/sources/brotli/LICENSE.brotli),
# as published in RFC 7932 Appendix A.
#
# SPDX-License-Identifier: GPL-3.0-only AND MIT

# Size / CRC-32 accessors: diagnostics for tests (DCE drops them from consumers).
fn _brotli_dict_size() { return 122784; }
fn _brotli_dict_crc32() { return 0x5136cb04; }
fn _brotli_dict_fnv1a() { return 0xd8a843a9cc932619; }

# RFC 7932 section 8 NDBITS[len] (log2 of the word count per length), len 0..24.
fn _brotli_dict_ndbits(len) {
    if (len < 4) { return 0; }
    if (len > 24) { return 0; }
    return load8("\x0a\x0a\x0b\x0b\x0a\x0a\x0a\x0a\x0a\x09\x09\x08\x07\x07\x08\x07\x07\x06\x06\x05\x05" + len - 4);
}

# RFC 7932 section 8 DOFFSET[len]: start of the length-len words in the data, len 4..24.
fn _brotli_dict_offset(len) {
    if (len < 4) { return 0; }
    if (len > 24) { return 0; }
    if (len == 4) { return 0; }
    if (len == 5) { return 4096; }
    if (len == 6) { return 9216; }
    if (len == 7) { return 21504; }
    if (len == 8) { return 35840; }
    if (len == 9) { return 44032; }
    if (len == 10) { return 53248; }
    if (len == 11) { return 63488; }
    if (len == 12) { return 74752; }
    if (len == 13) { return 87040; }
    if (len == 14) { return 93696; }
    if (len == 15) { return 100864; }
    if (len == 16) { return 104704; }
    if (len == 17) { return 106752; }
    if (len == 18) { return 108928; }
    if (len == 19) { return 113536; }
    if (len == 20) { return 115968; }
    if (len == 21) { return 118528; }
    if (len == 22) { return 119872; }
    if (len == 23) { return 121280; }
    return 122016;
}

# 1 when the 122784 bytes at p hash to _brotli_dict_fnv1a(), else 0.
fn _brotli_dict_verify(p) {
    var h = 0xcbf29ce484222325;
    var i = 0;
    while (i < 122784) {
        h = (h ^ load8(p + i)) * 0x100000001b3;
        i = i + 1;
    }
    if (h == _brotli_dict_fnv1a()) { return 1; }
    return 0;
}
