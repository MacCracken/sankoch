# sankoch — checksum algorithms
# Adler-32 (RFC 1950), CRC-32 (RFC 1952), xxHash32 (for LZ4 frame format).
# Inline implementations — too small to warrant a sigil dependency.
#
# Adler-32 uses scalar optimizations for the inner loop (both batch
# `adler32` and incremental `adler32_update`):
# - Batched modulo: % 65521 once every NMAX (5552) bytes instead of every byte
# - 16-byte unrolled inner loop accumulating s2 in closed form
# - Scalar fallback for the tail
# CRC-32 uses a slice-by-8 table (2.3.4): 8 bytes folded per iteration
# via one little-endian load64 + eight parallel table lookups (~2×
# the old serial byte-at-a-time table). Pure integer, portable across
# every target. On x86_64 with PCLMULQDQ (2.8.5) runs of >= _CRC32_CLMUL_MIN
# bytes are folded 64 bytes at a time with carry-less multiplies instead
# (_crc32_clmul), and the 16-byte remainder + tail finish on the table, so
# the result is bit-identical by construction and checked at first use.
# aarch64, cx and any CPU without PCLMULQDQ keep slice-by-8 (no PMULL path:
# reading HWCAP needs /proc/self/auxv, and src/ does no file I/O).
# Adler-32 stays scalar.

enum Checksum {
    ADLER_MOD = 65521;   # largest prime < 2^16
    ADLER_NMAX = 5552;   # max bytes before s1 can overflow 32 bits: 255*5552 < 2^32
}

# Adler-32: two running sums mod 65521 (largest prime < 2^16).
# Source: RFC 1950, Section 2.2
#
# Optimization: defer the expensive modulo operation.
# Within a block of NMAX bytes, s1 stays < 65521 + 255*5552 < 2^32
# and s2 stays < 65521*5553 + ... < 2^32, so no overflow in 64-bit.
fn adler32(data, len): i64 {
    var s1 = 1;
    var s2 = 0;
    var off = 0;

    while (off < len) {
        # Process up to NMAX bytes before taking modulo
        var block = len - off;
        if (block > ADLER_NMAX) { block = ADLER_NMAX; }
        var end = off + block;

        # Unrolled inner loop: process 16 bytes per iteration
        while (off + 16 <= end) {
            # s2 accumulates 16 copies of s1 plus weighted byte sums
            # s2 += 16*s1 + 16*b0 + 15*b1 + 14*b2 + ... + 1*b15
            var b0 = load8(data + off);
            var b1 = load8(data + off + 1);
            var b2 = load8(data + off + 2);
            var b3 = load8(data + off + 3);
            var b4 = load8(data + off + 4);
            var b5 = load8(data + off + 5);
            var b6 = load8(data + off + 6);
            var b7 = load8(data + off + 7);
            var b8 = load8(data + off + 8);
            var b9 = load8(data + off + 9);
            var b10 = load8(data + off + 10);
            var b11 = load8(data + off + 11);
            var b12 = load8(data + off + 12);
            var b13 = load8(data + off + 13);
            var b14 = load8(data + off + 14);
            var b15 = load8(data + off + 15);

            s2 = s2 + (s1 * 16);
            s2 = s2 + (b0 * 16) + (b1 * 15) + (b2 * 14) + (b3 * 13);
            s2 = s2 + (b4 * 12) + (b5 * 11) + (b6 * 10) + (b7 * 9);
            s2 = s2 + (b8 * 8) + (b9 * 7) + (b10 * 6) + (b11 * 5);
            s2 = s2 + (b12 * 4) + (b13 * 3) + (b14 * 2) + b15;

            s1 = s1 + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7;
            s1 = s1 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15;

            off = off + 16;
        }

        # Scalar tail for remaining bytes in this block
        while (off < end) {
            s1 = s1 + load8(data + off);
            s2 = s2 + s1;
            off = off + 1;
        }

        # Batched modulo — once per NMAX block
        s1 = s1 % ADLER_MOD;
        s2 = s2 % ADLER_MOD;
    }

    return (s2 * 65536) + s1;  # (s2 << 16) | s1
}

# Incremental Adler-32 API — used by zlib streaming.
#
# Layout (24 bytes):
#   +0:  s1 (running; reduced mod 65521 once per NMAX window)
#   +8:  s2 (running; reduced mod 65521 once per NMAX window)
#   +16: n_since_mod (bytes processed since last modulo reduction)

fn adler32_init(): i64 {
    var st = _sankoch_alloc(24);
    if (st == 0) { return 0; }   # 2.2.1: caller checks for alloc failure
    store64(st, 1);        # s1 = 1
    store64(st + 8, 0);    # s2 = 0
    store64(st + 16, 0);
    return st;
}

fn adler32_update(st, data, len): i64 {
    if (len <= 0) { return 0; }
    var s1 = load64(st);
    var s2 = load64(st + 8);
    var n = load64(st + 16);
    var off = 0;
    while (off < len) {
        var block = ADLER_NMAX - n;
        if (block > len - off) { block = len - off; }
        var end = off + block;

        # 16-byte unroll — mirrors the closed-form inner loop in
        # batch adler32(). Safe within a block because block <=
        # ADLER_NMAX - n <= NMAX, so s1/s2 cannot overflow i64.
        while (off + 16 <= end) {
            var b0 = load8(data + off);
            var b1 = load8(data + off + 1);
            var b2 = load8(data + off + 2);
            var b3 = load8(data + off + 3);
            var b4 = load8(data + off + 4);
            var b5 = load8(data + off + 5);
            var b6 = load8(data + off + 6);
            var b7 = load8(data + off + 7);
            var b8 = load8(data + off + 8);
            var b9 = load8(data + off + 9);
            var b10 = load8(data + off + 10);
            var b11 = load8(data + off + 11);
            var b12 = load8(data + off + 12);
            var b13 = load8(data + off + 13);
            var b14 = load8(data + off + 14);
            var b15 = load8(data + off + 15);

            s2 = s2 + (s1 * 16);
            s2 = s2 + (b0 * 16) + (b1 * 15) + (b2 * 14) + (b3 * 13);
            s2 = s2 + (b4 * 12) + (b5 * 11) + (b6 * 10) + (b7 * 9);
            s2 = s2 + (b8 * 8) + (b9 * 7) + (b10 * 6) + (b11 * 5);
            s2 = s2 + (b12 * 4) + (b13 * 3) + (b14 * 2) + b15;

            s1 = s1 + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7;
            s1 = s1 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15;

            off = off + 16;
        }

        # Scalar tail for remaining bytes in this block
        while (off < end) {
            s1 = s1 + load8(data + off);
            s2 = s2 + s1;
            off = off + 1;
        }
        n = n + block;
        if (n >= ADLER_NMAX) {
            s1 = s1 % ADLER_MOD;
            s2 = s2 % ADLER_MOD;
            n = 0;
        }
    }
    store64(st, s1);
    store64(st + 8, s2);
    store64(st + 16, n);
    return 0;
}

fn adler32_final(st): i64 {
    var s1 = load64(st) % ADLER_MOD;
    var s2 = load64(st + 8) % ADLER_MOD;
    return (s2 * 65536) + s1;
}

# CRC-32: table-driven, polynomial 0xEDB88320 (reflected).
# Source: RFC 1952, Section 8
# Table must be initialized once via crc32_init_table().
var crc32_table = 0;  # heap-allocated: slice-by-8 table, 8 × 256 entries × 8 bytes
# PCLMULQDQ fold state (2.8.5). Not arena memory, so alloc_reset() leaves it valid: whether this
# CPU folds with PCLMULQDQ, and the four folding constants the asm reads with movdqu (written by
# crc32_init_table). _crc32_hw is also the test switch: 0 forces the table path, -1 re-probes.
var _crc32_hw = 0 - 1;     # -1: not probed yet; 0: slice-by-8 only; 1: PCLMULQDQ fold
var _crc32_k: i64[4];      # K1 | K2 (4 x 128-bit fold), K3 | K4 (1 x 128-bit fold), low qword first
const _CRC32_CLMUL_MIN = 64;    # the fold's minimum; it beats slice-by-8 from there (44 vs 95 ns at 64 B)

# Initialize the slice-by-8 CRC-32 lookup table (must be called before
# crc32). 2.3.4: grew from a single 256-entry table to eight slices so
# the hot loop folds 8 bytes per iteration (Kadatch & Jenkins). Slice 0
# is the classic reflected-0xEDB88320 table (also used by the scalar
# tail); slices 1..7 are derived. Same CRC output — wire-identical.
fn crc32_init_table(): i64 {
    # This entry point is called directly by consumers (chitra re-inits per PNG
    # decode), so it carries its own arena guard rather than relying on the one
    # in _sankoch_lock.
    _sankoch_arena_guard();
    # The PCLMULQDQ folding constants (2.8.5), written here rather than in the probe so that any
    # path reaching _crc32_fold_hw, including a test forcing _crc32_hw = 1, has them. Not arena
    # memory, and the same values every time, so concurrent callers race harmlessly.
    store64(&_crc32_k, 0x154442bd4);
    store64(&_crc32_k + 8, 0x1c6e41596);
    store64(&_crc32_k + 16, 0x1751997d0);
    store64(&_crc32_k + 24, 0x0ccaa009e);
    if (crc32_table != 0) { return 0; }
    # Built in a local and published last (2.8.6): this entry runs without the lock, and a second
    # thread's first call used to see the pointer while the slices were still being filled and
    # return to compute with a half-built table. Two first callers may both build; one table leaks.
    var t = _sankoch_alloc(16384);   # 8 × 256 × 8
    if (t == 0) { return 0 - ERR_OOM; }
    # Slice 0: standard reflected CRC-32 table.
    var i = 0;
    while (i < 256) {
        var c = i;
        var j = 0;
        while (j < 8) {
            if (c & 1) {
                # 0xEDB88320 = 3988292384
                c = (c >> 1) ^ 3988292384;
            } else {
                c = c >> 1;
            }
            j = j + 1;
        }
        store64(t + i * 8, c);
        i = i + 1;
    }
    # Slices 1..7: table[k][n] = (table[k-1][n] >> 8) ^ table[0][table[k-1][n] & 0xFF].
    var k = 1;
    while (k < 8) {
        var n = 0;
        while (n < 256) {
            var prev = load64(t + ((k - 1) * 256 + n) * 8);
            var v = (prev >> 8) ^ load64(t + (prev & 255) * 8);
            store64(t + (k * 256 + n) * 8, v);
            n = n + 1;
        }
        k = k + 1;
    }
    atomic_fence();   # the slices are visible before the pointer that publishes them
    crc32_table = t;
    return 0;
}

# ---- PCLMULQDQ fold (2.8.5) ----

# CPUID leaf 1 ECX into out[0..8) (x86_64 only; rbx is callee-saved, so it is pushed around cpuid).
fn _crc32_cpuid1(out): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        0x57;                                            # push rdi (callee-saved on Win64; 2.8.6)
        param_load(rdi, 0);
        0x53;                                            # push rbx
        0xb8; 0x01; 0x00; 0x00; 0x00;                    # mov eax, 1
        0x31; 0xc9;                                      # xor ecx, ecx
        0x0f; 0xa2;                                      # cpuid
        0x48; 0x89; 0x0f;                                # mov [rdi], rcx
        0x5b;                                            # pop rbx
        0x5f;                                            # pop rdi
    }
    #endif
    return 0;
}

# The fold (docs/sources/crc32-pclmul/crc32_fold.S, assembled by GNU as and transcribed by
# scripts/crc32-clmul-asm.sh, whose --check verifies these bytes and the math): folds
# data[0 .. len - len % 16) (len >= 64) into a 128-bit remainder at out, with the running
# register crc folded into the first 4 bytes, so that CRC_crc(data) == CRC_0(out || tail).
# Touches xmm0..xmm5 only (Win64 keeps xmm6..15 callee-saved); rdi and rsi, which Win64 also keeps
# callee-saved, are pushed around the block (2.8.6), outside the transcribed bytes.
fn _crc32_clmul(crc, data, len, keys, out): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        0x56;                                            # push rsi
        0x57;                                            # push rdi
        param_load(rdi, 0);
        param_load(rsi, 1);
        param_load(rdx, 2);
        param_load(rcx, 3);
        param_load(r8, 4);
        # BEGIN crc32_fold.S
        0xf3; 0x0f; 0x6f; 0x06;                          # movdqu xmm0,XMMWORD PTR [rsi]
        0xf3; 0x0f; 0x6f; 0x4e; 0x10;                    # movdqu xmm1,XMMWORD PTR [rsi+0x10]
        0xf3; 0x0f; 0x6f; 0x56; 0x20;                    # movdqu xmm2,XMMWORD PTR [rsi+0x20]
        0xf3; 0x0f; 0x6f; 0x5e; 0x30;                    # movdqu xmm3,XMMWORD PTR [rsi+0x30]
        0x66; 0x0f; 0x6e; 0xef;                          # movd xmm5,edi
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0x48; 0x83; 0xc6; 0x40;                          # add rsi,0x40
        0x48; 0x83; 0xea; 0x40;                          # sub rdx,0x40
        0xf3; 0x0f; 0x6f; 0x21;                          # movdqu xmm4,XMMWORD PTR [rcx]
        0x48; 0x83; 0xfa; 0x40;                          # cmp rdx,0x40
        0x0f; 0x82; 0x85; 0x00; 0x00; 0x00;              # jb b6 <crc32_fold+0xb6>
        0x66; 0x0f; 0x6f; 0xe8;                          # movdqa xmm5,xmm0
        0x66; 0x0f; 0x3a; 0x44; 0xc4; 0x00;              # pclmullqlqdq xmm0,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0xf3; 0x0f; 0x6f; 0x2e;                          # movdqu xmm5,XMMWORD PTR [rsi]
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0x66; 0x0f; 0x6f; 0xe9;                          # movdqa xmm5,xmm1
        0x66; 0x0f; 0x3a; 0x44; 0xcc; 0x00;              # pclmullqlqdq xmm1,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xcd;                          # pxor xmm1,xmm5
        0xf3; 0x0f; 0x6f; 0x6e; 0x10;                    # movdqu xmm5,XMMWORD PTR [rsi+0x10]
        0x66; 0x0f; 0xef; 0xcd;                          # pxor xmm1,xmm5
        0x66; 0x0f; 0x6f; 0xea;                          # movdqa xmm5,xmm2
        0x66; 0x0f; 0x3a; 0x44; 0xd4; 0x00;              # pclmullqlqdq xmm2,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xd5;                          # pxor xmm2,xmm5
        0xf3; 0x0f; 0x6f; 0x6e; 0x20;                    # movdqu xmm5,XMMWORD PTR [rsi+0x20]
        0x66; 0x0f; 0xef; 0xd5;                          # pxor xmm2,xmm5
        0x66; 0x0f; 0x6f; 0xeb;                          # movdqa xmm5,xmm3
        0x66; 0x0f; 0x3a; 0x44; 0xdc; 0x00;              # pclmullqlqdq xmm3,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xdd;                          # pxor xmm3,xmm5
        0xf3; 0x0f; 0x6f; 0x6e; 0x30;                    # movdqu xmm5,XMMWORD PTR [rsi+0x30]
        0x66; 0x0f; 0xef; 0xdd;                          # pxor xmm3,xmm5
        0x48; 0x83; 0xc6; 0x40;                          # add rsi,0x40
        0x48; 0x83; 0xea; 0x40;                          # sub rdx,0x40
        0x48; 0x83; 0xfa; 0x40;                          # cmp rdx,0x40
        0x0f; 0x83; 0x7b; 0xff; 0xff; 0xff;              # jae 31 <crc32_fold+0x31>
        0xf3; 0x0f; 0x6f; 0x61; 0x10;                    # movdqu xmm4,XMMWORD PTR [rcx+0x10]
        0x66; 0x0f; 0x6f; 0xe8;                          # movdqa xmm5,xmm0
        0x66; 0x0f; 0x3a; 0x44; 0xc4; 0x00;              # pclmullqlqdq xmm0,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0x66; 0x0f; 0xef; 0xc1;                          # pxor xmm0,xmm1
        0x66; 0x0f; 0x6f; 0xe8;                          # movdqa xmm5,xmm0
        0x66; 0x0f; 0x3a; 0x44; 0xc4; 0x00;              # pclmullqlqdq xmm0,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0x66; 0x0f; 0xef; 0xc2;                          # pxor xmm0,xmm2
        0x66; 0x0f; 0x6f; 0xe8;                          # movdqa xmm5,xmm0
        0x66; 0x0f; 0x3a; 0x44; 0xc4; 0x00;              # pclmullqlqdq xmm0,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0x66; 0x0f; 0xef; 0xc3;                          # pxor xmm0,xmm3
        0x48; 0x83; 0xfa; 0x10;                          # cmp rdx,0x10
        0x72; 0x26;                                      # jb 12f <crc32_fold+0x12f>
        0x66; 0x0f; 0x6f; 0xe8;                          # movdqa xmm5,xmm0
        0x66; 0x0f; 0x3a; 0x44; 0xc4; 0x00;              # pclmullqlqdq xmm0,xmm4
        0x66; 0x0f; 0x3a; 0x44; 0xec; 0x11;              # pclmulhqhqdq xmm5,xmm4
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0xf3; 0x0f; 0x6f; 0x2e;                          # movdqu xmm5,XMMWORD PTR [rsi]
        0x66; 0x0f; 0xef; 0xc5;                          # pxor xmm0,xmm5
        0x48; 0x83; 0xc6; 0x10;                          # add rsi,0x10
        0x48; 0x83; 0xea; 0x10;                          # sub rdx,0x10
        0xeb; 0xd4;                                      # jmp 103 <crc32_fold+0x103>
        0xf3; 0x41; 0x0f; 0x7f; 0x00;                    # movdqu XMMWORD PTR [r8],xmm0
        # END crc32_fold.S
        0x5f;                                            # pop rdi
        0x5e;                                            # pop rsi
    }
    #endif
    return 0;
}

# PCLMULQDQ fold of data[0..len) (len >= 64) from the running register crc: the asm folds the
# 16-byte blocks to a remainder, and the table finishes the remainder and the tail from 0.
fn _crc32_fold_hw(crc, data, len): i64 {
    var x[16];
    _crc32_clmul(crc & 4294967295, data, len, &_crc32_k, &x);
    var done = len - (len & 15);
    return _crc32_fold_table(_crc32_fold_table(0, &x, 16), data + done, len - done);
}

# Decide once per process: PCLMULQDQ present (CPUID.1:ECX bit 1), then a known-answer check of the
# fold against the table on a 1,077-byte pattern, which runs every stage: the 4-block loop (15
# iterations), the lane merge, the 1-block loop (3 iterations) and a 5-byte tail. A CPU or emulator
# that gets it wrong keeps slice-by-8. Two threads probing at once store the same values.
fn _crc32_hw_probe(): i64 {
    var hw = 0;
    #ifdef CYRIUS_ARCH_X86
    var r[16];
    store64(&r, 0);
    _crc32_cpuid1(&r);
    if (((load64(&r) >> 1) & 1) == 1) { hw = 1; }
    #endif
    if (hw == 1) {
        var buf[1080];
        var i = 0;
        while (i < 1077) {
            store8(&buf + i, (i * 131 + 7) & 255);
            i = i + 1;
        }
        if (_crc32_fold_hw(4294967295, &buf, 1077) != _crc32_fold_table(4294967295, &buf, 1077)) { hw = 0; }
    }
    _crc32_hw = hw;
    return hw;
}

# Fold `len` bytes of `data` into the running (pre-inversion) CRC and return it: the PCLMULQDQ fold
# for long runs where the CPU has it, else slice-by-8. Shared by batch + stream (crc32,
# crc32_update, gzip, zip). Assumes crc32_init_table() has populated crc32_table.
fn _crc32_fold(crc, data, len): i64 {
    # x86 only (2.8.6): elsewhere _crc32_clmul is empty, so _crc32_hw forced to 1 (the test switch)
    # used to finish the CRC from an unwritten remainder, silently wrong.
    #ifdef CYRIUS_ARCH_X86
    if (len >= _CRC32_CLMUL_MIN) {
        if (_crc32_hw < 0) { _crc32_hw_probe(); }
        if (_crc32_hw == 1) { return _crc32_fold_hw(crc, data, len); }
    }
    #endif
    return _crc32_fold_table(crc, data, len);
}

# Slice-by-8 core: fold `len` bytes of `data` into the running (pre-
# inversion) CRC and return it. One load64 per 8 bytes — both x86_64 and
# aarch64 are little-endian, so the low/high 32-bit halves of the word
# are exactly the reference's load32_le(buf) / load32_le(buf+4). Assumes
# crc32_init_table() has populated crc32_table.
fn _crc32_fold_table(crc, data, len): i64 {
    var t0 = crc32_table;
    var t1 = crc32_table + 2048;
    var t2 = crc32_table + 4096;
    var t3 = crc32_table + 6144;
    var t4 = crc32_table + 8192;
    var t5 = crc32_table + 10240;
    var t6 = crc32_table + 12288;
    var t7 = crc32_table + 14336;
    var i = 0;
    while (i + 8 <= len) {
        var w = load64(data + i);
        var lo = (crc ^ w) & 4294967295;        # crc XOR low 4 bytes (LE)
        var hi = (w >> 32) & 4294967295;        # high 4 bytes (LE)
        crc = load64(t7 + (lo & 255) * 8)
        ^ load64(t6 + ((lo >> 8) & 255) * 8)
        ^ load64(t5 + ((lo >> 16) & 255) * 8)
        ^ load64(t4 + ((lo >> 24) & 255) * 8)
        ^ load64(t3 + (hi & 255) * 8)
        ^ load64(t2 + ((hi >> 8) & 255) * 8)
        ^ load64(t1 + ((hi >> 16) & 255) * 8)
        ^ load64(t0 + ((hi >> 24) & 255) * 8);
        i = i + 8;
    }
    while (i < len) {
        var index = (crc ^ load8(data + i)) & 255;
        crc = (crc >> 8) ^ load64(t0 + index * 8);
        i = i + 1;
    }
    return crc;
}

# Compute CRC-32 of data[0..len). Call crc32_init_table() first.
fn crc32(data, len): i64 {
    # CRC starts inverted; fold via slice-by-8, then final inversion.
    return (_crc32_fold(4294967295, data, len) ^ 4294967295) & 4294967295;
}

# Incremental CRC-32 API — used by gzip streaming. State is a single
# u64 holding the running (not-yet-inverted) CRC. init sets 0xFFFFFFFF,
# update folds bytes through the same table used by batch crc32, final
# inverts and masks.
#
# Layout (8 bytes):
#   +0: running CRC (pre-inversion)

fn crc32_init(): i64 {
    if (crc32_init_table() < 0) { return 0; }   # 2.3.7: table OOM → null state
    var st = _sankoch_alloc(8);
    if (st == 0) { return 0; }   # 2.2.1: caller checks for alloc failure
    store64(st, 4294967295);   # 0xFFFFFFFF
    return st;
}

fn crc32_update(st, data, len): i64 {
    if (len <= 0) { return 0; }
    store64(st, _crc32_fold(load64(st), data, len));
    return 0;
}

fn crc32_final(st): i64 {
    return (load64(st) ^ 4294967295) & 4294967295;
}

# CRC-64/XZ: table-driven, polynomial 0x42F0E1EBA9EA3693, reflected
# (init = xorout = 0xFFFFFFFFFFFFFFFF, refin = refout = true). The xz
# container (2.4.0) uses this for the block "check" field and the index
# field when the stream's check-type byte is 0x04. The reflected poly is
# 0xC96C5795D7870F42. Cyrius `>>` is a logical shift on i64, so the full
# 64-bit reflected values fold correctly with no sign-extension hazard.
# Byte-at-a-time (256-entry table) — the check field covers uncompressed
# data, but xz decode is not on any consumer's hot path, so the simpler
# table is the right tradeoff over slice-by-8.
# Source: spec "The .xz File Format" §2.1.1.2 / §3.1.2; the poly is
# ECMA-182 (CRC-64/XZ a.k.a. CRC-64/GO-ECMA).
var crc64_table = 0;   # heap-allocated: 256 entries × 8 bytes

fn crc64_init_table(): i64 {
    _sankoch_arena_guard();   # public, no lock: consumers call it directly (2.8.0)
    if (crc64_table == 0) {
        crc64_table = _sankoch_alloc(2048);   # 256 × 8
        if (crc64_table == 0) { return 0 - ERR_OOM; }
    }
    var i = 0;
    while (i < 256) {
        var c = i;
        var j = 0;
        while (j < 8) {
            if (c & 1) {
                c = (c >> 1) ^ 0xC96C5795D7870F42;
            } else {
                c = c >> 1;
            }
            j = j + 1;
        }
        store64(crc64_table + i * 8, c);
        i = i + 1;
    }
    return 0;
}

# Fold `len` bytes into the running (pre-final-XOR) CRC-64. Assumes
# crc64_init_table() has populated crc64_table. Shared by batch + stream.
fn _crc64_fold(crc, data, len): i64 {
    var t = crc64_table;
    var i = 0;
    while (i < len) {
        var index = (crc ^ load8(data + i)) & 255;
        crc = (crc >> 8) ^ load64(t + index * 8);
        i = i + 1;
    }
    return crc;
}

# Compute CRC-64/XZ of data[0..len). Call crc64_init_table() first.
fn crc64(data, len): i64 {
    return _crc64_fold(0xFFFFFFFFFFFFFFFF, data, len) ^ 0xFFFFFFFFFFFFFFFF;
}

# Incremental CRC-64 API — symmetric with the CRC-32 state APIs. State is
# a single u64 holding the running (pre-final-XOR) CRC.
#   +0: running CRC (pre-final XOR)
fn crc64_init(): i64 {
    if (crc64_init_table() < 0) { return 0; }   # table OOM → null state
    var st = _sankoch_alloc(8);
    if (st == 0) { return 0; }
    store64(st, 0xFFFFFFFFFFFFFFFF);
    return st;
}

fn crc64_update(st, data, len): i64 {
    if (len <= 0) { return 0; }
    store64(st, _crc64_fold(load64(st), data, len));
    return 0;
}

fn crc64_final(st): i64 {
    return load64(st) ^ 0xFFFFFFFFFFFFFFFF;
}

# CRC-32/BZIP2: table-driven, polynomial 0x04C11DB7, NON-reflected
# (MSB-first), init = xorout = 0xFFFFFFFF. This is a different CRC from
# the RFC-1952 CRC-32 above (which is the reflected 0xEDB88320 variant):
# bzip2 processes bits most-significant-first and does not reflect the
# result. The .bz2 format (2.4.2) uses it for the per-block and combined
# stream check fields. Check value for "123456789" is 0xFC891918.
var crc32bz_table = 0;   # heap-allocated: 256 entries × 8 bytes

fn crc32_bzip2_init_table(): i64 {
    _sankoch_arena_guard();   # public, no lock: consumers call it directly (2.8.0)
    if (crc32bz_table == 0) {
        crc32bz_table = _sankoch_alloc(2048);   # 256 × 8
        if (crc32bz_table == 0) { return 0 - ERR_OOM; }
    }
    var i = 0;
    while (i < 256) {
        var c = (i << 24) & 0xFFFFFFFF;
        var j = 0;
        while (j < 8) {
            if ((c & 0x80000000) != 0) {
                c = ((c << 1) ^ 0x04C11DB7) & 0xFFFFFFFF;
            } else {
                c = (c << 1) & 0xFFFFFFFF;
            }
            j = j + 1;
        }
        store64(crc32bz_table + i * 8, c);
        i = i + 1;
    }
    return 0;
}

# Compute CRC-32/BZIP2 of data[0..len). Call crc32_bzip2_init_table()
# first. MSB-first fold: crc = (crc << 8) ^ table[(crc>>24 ^ byte) & 0xFF].
fn crc32_bzip2(data, len): i64 {
    var crc = 0xFFFFFFFF;
    var i = 0;
    while (i < len) {
        var idx = ((crc >> 24) ^ load8(data + i)) & 255;
        crc = ((crc << 8) & 0xFFFFFFFF) ^ load64(crc32bz_table + idx * 8);
        i = i + 1;
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

# xxHash32 batch + helpers (`xxhash32`, `_xxh32_round`, `_xxh32_rotl`,
# `XXH32` enum) live in src/xxhash32.cyr — that file is part of the
# `[lib.core]` kernel-safe distlib profile. The incremental state APIs
# below stay here because they alloc.

# Incremental xxHash32 API — used by LZ4F content-checksum streaming.
# State layout (64 bytes):
#   +0:  v1 (stripe accumulator)
#   +8:  v2
#   +16: v3
#   +24: v4
#   +32..48: partial-stripe buffer (16 bytes, byte-addressable)
#   +48: buf_len (0..15)
#   +56: total_len (cumulative bytes seen)
# Stripe accumulators are kept valid from init so the update path can
# flush a completed 16-byte buffer without branching on "first stripe".
# Final distinguishes short path (total_len < 16) from long path by
# checking total_len itself.

fn xxhash32_init(): i64 {
    var m = 4294967295;
    var st = _sankoch_alloc(64);
    if (st == 0) { return 0; }   # 2.2.1: caller checks for alloc failure
    store64(st, (XXH32_PRIME1 + XXH32_PRIME2) & m);   # v1
    store64(st + 8, XXH32_PRIME2);                     # v2
    store64(st + 16, 0);                               # v3
    store64(st + 24, (0 - XXH32_PRIME1) & m);          # v4
    store64(st + 48, 0);                               # buf_len
    store64(st + 56, 0);                               # total_len
    return st;
}

# Process one 16-byte stripe at data_ptr into the state's v1..v4.
fn _xxh32_stripe_into(st, data_ptr): i64 {
    var m = 4294967295;
    var k1 = load8(data_ptr) | (load8(data_ptr + 1) << 8) |
    (load8(data_ptr + 2) << 16) | (load8(data_ptr + 3) << 24);
    var k2 = load8(data_ptr + 4) | (load8(data_ptr + 5) << 8) |
    (load8(data_ptr + 6) << 16) | (load8(data_ptr + 7) << 24);
    var k3 = load8(data_ptr + 8) | (load8(data_ptr + 9) << 8) |
    (load8(data_ptr + 10) << 16) | (load8(data_ptr + 11) << 24);
    var k4 = load8(data_ptr + 12) | (load8(data_ptr + 13) << 8) |
    (load8(data_ptr + 14) << 16) | (load8(data_ptr + 15) << 24);
    store64(st, _xxh32_round(load64(st), k1 & m));
    store64(st + 8, _xxh32_round(load64(st + 8), k2 & m));
    store64(st + 16, _xxh32_round(load64(st + 16), k3 & m));
    store64(st + 24, _xxh32_round(load64(st + 24), k4 & m));
    return 0;
}

fn xxhash32_update(st, data, len): i64 {
    if (len <= 0) { return 0; }
    store64(st + 56, load64(st + 56) + len);
    var buf = st + 32;
    var buf_len = load64(st + 48);
    var off = 0;

    # Fill the partial buffer first.
    if (buf_len > 0) {
        var need = 16 - buf_len;
        var take = need;
        if (take > len) { take = len; }
        var i = 0;
        while (i < take) {
            store8(buf + buf_len + i, load8(data + i));
            i = i + 1;
        }
        buf_len = buf_len + take;
        off = take;
        if (buf_len == 16) {
            _xxh32_stripe_into(st, buf);
            buf_len = 0;
        }
    }

    # Process full 16-byte stripes directly from the input.
    while (off + 16 <= len) {
        _xxh32_stripe_into(st, data + off);
        off = off + 16;
    }

    # Save tail into the partial buffer.
    var tail = len - off;
    if (tail > 0) {
        var i = 0;
        while (i < tail) {
            store8(buf + i, load8(data + off + i));
            i = i + 1;
        }
        buf_len = tail;
    }
    store64(st + 48, buf_len);
    return 0;
}

fn xxhash32_final(st): i64 {
    var m = 4294967295;
    var total = load64(st + 56);
    var buf_len = load64(st + 48);
    var buf = st + 32;

    var h = 0;
    if (total >= 16) {
        h = (_xxh32_rotl(load64(st), 1) +
          _xxh32_rotl(load64(st + 8), 7) +
          _xxh32_rotl(load64(st + 16), 12) +
          _xxh32_rotl(load64(st + 24), 18)) & m;
    } else {
        h = XXH32_PRIME5;
    }
    h = (h + total) & m;

    # 4-byte tail
    var i = 0;
    while (i + 4 <= buf_len) {
        var k = load8(buf + i) | (load8(buf + i + 1) << 8) |
        (load8(buf + i + 2) << 16) | (load8(buf + i + 3) << 24);
        k = k & m;
        h = (h + (k * XXH32_PRIME3) & m) & m;
        h = (_xxh32_rotl(h, 17) * XXH32_PRIME4) & m;
        i = i + 4;
    }

    # Byte tail
    while (i < buf_len) {
        h = (h + (load8(buf + i) * XXH32_PRIME5) & m) & m;
        h = (_xxh32_rotl(h, 11) * XXH32_PRIME1) & m;
        i = i + 1;
    }

    # Avalanche
    h = h ^ (h >> 15);
    h = (h * XXH32_PRIME2) & m;
    h = h ^ (h >> 13);
    h = (h * XXH32_PRIME3) & m;
    h = h ^ (h >> 16);
    return h;
}

# ---------------------------------------------------------------------------
# Arena-reset hook (2.8.0). Zeroes exactly the lazy globals THIS module memoizes —
# every arena pointer, and every "built/ready" flag that gates one, cleared as a
# set — so the next call rebuilds from scratch. Called from the profile's
# `_sankoch_reset_tables` (see the registration rule in src/runtime.cyr) when
# `_sankoch_arena_guard` detects an `alloc_reset()`, and by the OOM sweep.
# Caller-owned per-call state (contexts, cursors, dst pointers) is NOT touched.
# The slice-by-8 CRC-32 table, the CRC-64/XZ table, the bzip2 CRC-32 table.
# ---------------------------------------------------------------------------
fn _checksum_reset_tables(): i64 {
    crc32_table = 0;
    crc64_table = 0;
    crc32bz_table = 0;
    return 0;
}
