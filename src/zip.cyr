# zip.cyr — sovereign PKZIP (.zip) archive container: in-memory reader + writer.
#
# The archive layer that pairs with the codecs, alongside `tar.cyr`. Where tar is a
# forward pull-cursor over a stream, ZIP is random-access: the End Of Central Directory
# record at the tail points at the central directory, which indexes every member. So the
# reader is an INDEX (enumerate / find by name / extract one member), not a cursor.
#
# 2.6.0 scope — the agnosai `.agpkg` filing: methods 0 (store) and 8 (DEFLATE), read and
# write, entirely over in-memory byte buffers (a consumer's file I/O stays on its side).
# Later 2.6.x bites add the other methods, zip64, and streaming.
#
# Path safety mirrors `tar.cyr`: every member name is validated against absolute paths,
# "..", empty interior components and control bytes, so "zip-slip" extraction cannot
# escape the destination. The guard is duplicated rather than shared because the
# `[lib.zip]` distlib profile must not drag in `tar.cyr` (and the codecs its
# `tar_open_auto` dispatches to) — the same tradeoff `zstd.cyr` makes for its bit reader.
#
# Zip-bomb defence is built in: `zip_extract_capped` bounds a member's expansion with the
# shared `ERR_RATIO_LIMIT` machinery, and every extraction verifies the member's CRC-32.
#
# Usage (read):
#   var z = zip_open(buf, len);              # 0 on a malformed archive
#   var n = zip_count(z);
#   var i = zip_find(z, "manifest.json");    # -1 if absent
#   var out = alloc(zip_entry_size(z, i));
#   var got = zip_extract(z, i, out, cap);   # <0 = 0 - ERR_*
#
# Usage (write):
#   var w = zip_writer_init(dst, dst_cap);
#   zip_add(w, "manifest.json", data, len, ZIP_DEFLATE);
#   var total = zip_writer_finish(w);        # archive byte length, or <0
#
# SPDX-License-Identifier: GPL-3.0-only

var ZIP_STORE = 0;      # compression method 0 — stored verbatim
var ZIP_DEFLATE = 8;    # compression method 8 — RFC 1951
# 2.6.1 methods. The payload for each is the codec's OWN standalone stream (a `.bz2`,
# `.zst` or `.xz` file body), so a member can be handed straight to the reference tool.
# Handled by `zip_extract_any` / `zip_add_any` in `zip_methods.cyr`.
var ZIP_BZIP2 = 12;     # compression method 12 — bzip2
var ZIP_ZSTD = 93;      # compression method 93 — Zstandard (APPNOTE 6.3.7)
var ZIP_XZ = 95;        # compression method 95 — .xz (LZMA2)

# Signatures (little-endian on the wire).
var ZIP_SIG_LOCAL = 0x04034b50;
var ZIP_SIG_CD = 0x02014b50;
var ZIP_SIG_EOCD = 0x06054b50;
# Zip64 (2.6.2). When a field does not fit its 16/32-bit slot the writer stores the
# all-ones sentinel and the true value moves to the Zip64 EOCD record (archive-level) or
# the Zip64 extended-information extra field, header ID 0x0001 (per-member).
var ZIP_SIG_Z64_EOCD = 0x06064b50;
var ZIP_SIG_Z64_LOC = 0x07064b50;
var ZIP_Z64_U16 = 0xFFFF;
var ZIP_Z64_U32 = 0xFFFFFFFF;
var ZIP_Z64_EXTRA_ID = 1;

# Reader context (alloc 40): +0 buf, +8 len, +16 entry count, +24 entry table,
#                            +32 symlink ledger (2.6.4).
# Entry record (64 bytes): +0 name cstr, +8 method, +16 crc32, +24 csize,
#                          +32 usize, +40 local-header offset,
#                          +48 Unix mode (0 = absent), +56 mtime (Unix seconds).
# Reader context size. Named in 2.7.7 — it was a bare `alloc(40)` at the one call site,
# which is exactly the shape that goes wrong when a field is added. It grew to 48 in the
# same release, for the allocator at +40.
var ZIP_R_CTX = 48;
var ZIP_ENT_SIZE = 64;

# Per-entry metadata (2.6.3), matching what reference writers emit:
#   * "version made by" high byte 3 = Unix, which is what makes the external-attributes
#     field meaningful as a Unix mode;
#   * external attributes high 16 bits = the mode (type bits included);
#   * symlink = mode & S_IFMT == S_IFLNK, with the target stored as the member's content.
var ZIP_MADE_UNIX = 3;
var ZIP_S_IFMT = 0xF000;
var ZIP_S_IFREG = 0x8000;
var ZIP_S_IFDIR = 0x4000;
var ZIP_S_IFLNK = 0xA000;

# --- open failure discrimination (2.7.7) -------------------------------------------
#
# `zip_open` answers a bare 0 for two dozen distinct reasons — truncated, multi-disk,
# bad central directory, an ENCRYPTED member, or OOM. A consumer could not tell "these
# bytes are not a zip" from "we ran out of memory", which agnosai hit while porting
# `.agpkg`: it had to report every failure as one error variant and record the encrypted
# case as a deliberate divergence, because there was nothing to branch on.
#
# The globals-compat shape is bayan's (`bayan_json_last_error`): `zip_open` still
# returns 0, and the reason is available immediately after. `_zip_fail` sets it and
# returns 0 in one expression so the call sites stay one line each.
#
# ⚠ Set on FAILURE only. A successful `zip_open` leaves the previous value in place, so
# read it only after a 0 — the same contract bayan documents.
var _zip_last_error = 0;

# Why the last `zip_open` returned 0, as a negative shared `ERR_*`, or 0 if none has
# failed yet.
fn zip_last_error() {
    return _zip_last_error;
}

fn _zip_fail(code) {
    _zip_last_error = code;
    return 0;
}

# --- bounded little-endian field reads ---------------------------------------------
fn _zip_le16(p) {
    return (load8(p) & 0xFF) | ((load8(p + 1) & 0xFF) << 8);
}

fn _zip_le32(p) {
    return (load8(p) & 0xFF) | ((load8(p + 1) & 0xFF) << 8)
    | ((load8(p + 2) & 0xFF) << 16) | ((load8(p + 3) & 0xFF) << 24);
}

fn _zip_le64(p) {
    return (load8(p) & 0xFF) | ((load8(p + 1) & 0xFF) << 8)
    | ((load8(p + 2) & 0xFF) << 16) | ((load8(p + 3) & 0xFF) << 24)
    | ((load8(p + 4) & 0xFF) << 32) | ((load8(p + 5) & 0xFF) << 40)
    | ((load8(p + 6) & 0xFF) << 48) | ((load8(p + 7) & 0xFF) << 56);
}

fn _zip_put16(p, v) {
    store8(p, v & 0xFF); store8(p + 1, (v >> 8) & 0xFF);
    return 0;
}

fn _zip_put32(p, v) {
    store8(p, v & 0xFF); store8(p + 1, (v >> 8) & 0xFF);
    store8(p + 2, (v >> 16) & 0xFF); store8(p + 3, (v >> 24) & 0xFF);
    return 0;
}

fn _zip_put64(p, v) {
    _zip_put32(p, v & ZIP_Z64_U32);
    _zip_put32(p + 4, (v >> 32) & ZIP_Z64_U32);
    return 0;
}

# Scan a member's extra field for the Zip64 extended-information record (ID 0x0001) and
# pull the values whose base fields carried the all-ones sentinel. The order inside the
# record is FIXED — uncompressed size, compressed size, local-header offset, disk number
# — and each is present ONLY if its base field was a sentinel, so the parse must be
# driven by which sentinels were seen, not by the record's length alone. Writes the
# recovered values into outv[0..2] (usize, csize, lho). Returns 0, or -1 if the record is
# malformed / too short for what the sentinels demanded (2.6.2).
fn _zip_z64_extra(base, elen, need_u, need_c, need_o, outv) {
    var p = 0;
    while (p + 4 <= elen) {
        var id = _zip_le16(base + p);
        var dsz = _zip_le16(base + p + 2);
        if (p + 4 + dsz > elen) { return 0 - 1; }        # field runs past the extra area
        if (id == ZIP_Z64_EXTRA_ID) {
            var q = p + 4;
            var end = p + 4 + dsz;
            if (need_u == 1) {
                if (q + 8 > end) { return 0 - 1; }
                store64(outv + 0, _zip_le64(base + q));
                q = q + 8;
            }
            if (need_c == 1) {
                if (q + 8 > end) { return 0 - 1; }
                store64(outv + 8, _zip_le64(base + q));
                q = q + 8;
            }
            if (need_o == 1) {
                if (q + 8 > end) { return 0 - 1; }
                store64(outv + 16, _zip_le64(base + q));
                q = q + 8;
            }
            return 0;
        }
        p = p + 4 + dsz;
    }
    return 0 - 1;   # sentinels present but no Zip64 record to resolve them
}

# --- path-traversal guard (zip-slip) — mirrors tar.cyr's _star_path_safe ------------
# Reject empty, absolute, any ".." component, empty interior component (a//b), and
# NUL / control / backslash bytes. A trailing '/' (the directory-entry convention) is
# allowed. Backslash is rejected because Windows-produced archives use it as a
# separator, and a consumer joining such a name onto a POSIX root can escape.
fn _zip_path_safe(name) {
    var n = strlen(name);
    if (n == 0) { return 0; }
    if (load8(name) == 47) { return 0; }        # absolute
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) {
            c = load8(name + i) & 0xFF;
            if (c == 0) { return 0; }
            if (c < 32) { return 0; }
            if (c == 92) { return 0; }          # backslash
        }
        if (c == 47) {
            var clen = i - start;
            if (clen == 0) {
                if (i != n) { return 0; }       # empty interior component (a//b)
            } else {
                if (clen == 2) {
                    if (load8(name + start) == 46) {
                        if (load8(name + start + 1) == 46) { return 0; }   # ".."
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# --- symlink ledger (2.6.4) ----------------------------------------------------------
# `_zip_path_safe` validates one member name in isolation: it rejects "..", absolute paths
# and bad bytes. It cannot see that a DIFFERENT member is a symlink whose target escapes,
# and that this member's path runs THROUGH it. 2.6.3 gave ZIP symlinks (S_IFLNK + target as
# content), which reopened exactly the hole the 2.5.9 audit found in the tar cursor:
#
#     esc            -> symlink, target ".."      (points above the extraction root)
#     esc/pwned.txt  -> a plain file
#
# Both members pass every per-entry check, so a consumer writing them by name creates the
# symlink and then writes through it, landing outside the root. `bsdtar` refuses this
# ("Cannot extract through symlink") and so does Info-ZIP `unzip`.
#
# The guard mirrors tar's, with one deliberate difference: ZIP is RANDOM-ACCESS, so a
# consumer may extract members in any order and "an earlier entry planted it" is not a
# safe framing. The ledger is therefore ARCHIVE-GLOBAL — any member whose directory prefix
# is a symlink ANYWHERE in the archive is refused, regardless of index order.
#
# Tracking EVERY symlink (not only those with escaping targets) is what makes it sound: a
# symlink can never sit under another symlink, because that member's own prefix check
# rejects it, so each ledger path has only real-directory ancestors and its literal path
# equals its resolved path — no aliasing hole for a benign symlink to open.
#
# Keys are the 64-bit FNV-1a hash of the canonical path (drop "." and empty components).
# A hash collision can only cause an over-reject, never let an escape through, so the guard
# is sound by construction.
var _ZIP_FNV_OFF = 0xcbf29ce484222325;
var _ZIP_FNV_PRIME = 0x100000001b3;

# Ledger: [+0 capacity][+8 count][+16 buckets]. 0 = empty bucket.
fn _zip_led_new_a(a, n) {
    var cap = 64;
    while (cap < n * 4) { cap = cap * 2; }
    var led = _sankoch_alloc_via(a, 24);
    if (led == 0) { return 0; }
    var b = _sankoch_alloc_via(a, cap * 8);
    if (b == 0) { return 0; }
    var i = 0;
    while (i < cap) { store64(b + i * 8, 0); i = i + 1; }
    store64(led + 0, cap);
    store64(led + 8, 0);
    store64(led + 16, b);
    return led;
}

fn _zip_led_new(n) {
    var cap = 64;
    while (cap < n * 4) { cap = cap * 2; }
    var led = _sankoch_alloc(24);
    if (led == 0) { return 0; }
    var b = _sankoch_alloc(cap * 8);
    if (b == 0) { return 0; }
    var i = 0;
    while (i < cap) { store64(b + i * 8, 0); i = i + 1; }
    store64(led + 0, cap);
    store64(led + 8, 0);
    store64(led + 16, b);
    return led;
}

fn _zip_led_add(led, h) {
    if (h == 0) { h = 1; }
    var cap = load64(led + 0);
    var b = load64(led + 16);
    var i = h & (cap - 1);
    while (load64(b + i * 8) != 0) {
        if (load64(b + i * 8) == h) { return 0; }
        i = (i + 1) & (cap - 1);
    }
    store64(b + i * 8, h);
    store64(led + 8, load64(led + 8) + 1);
    return 0;
}

fn _zip_led_has(led, h) {
    if (h == 0) { h = 1; }
    var cap = load64(led + 0);
    var b = load64(led + 16);
    var i = h & (cap - 1);
    while (load64(b + i * 8) != 0) {
        if (load64(b + i * 8) == h) { return 1; }
        i = (i + 1) & (cap - 1);
    }
    return 0;
}

# Canonical FNV-1a of `path` (skipping "." and empty components). Returns the full-path
# hash; when `led` is non-zero, also tests every proper DIRECTORY prefix against it and
# returns -1 if any prefix is a known symlink.
fn _zip_path_hash(path, led) {
    var n = strlen(path);
    var total = 0;
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 47;
        if (i < n) { c = load8(path + i) & 0xFF; }
        if (c == 47) {
            var clen = i - start;
            if (clen > 0) {
                if (clen != 1 || load8(path + start) != 46) { total = total + 1; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    var h = _ZIP_FNV_OFF;
    var seen = 0;
    i = 0;
    start = 0;
    while (i <= n) {
        var c2 = 47;
        if (i < n) { c2 = load8(path + i) & 0xFF; }
        if (c2 == 47) {
            var clen2 = i - start;
            var real = 0;
            if (clen2 > 0) {
                if (clen2 != 1 || load8(path + start) != 46) { real = 1; }
            }
            if (real == 1) {
                if (seen > 0) { h = (h ^ 47) * _ZIP_FNV_PRIME; }
                var j = start;
                while (j < i) { h = (h ^ (load8(path + j) & 0xFF)) * _ZIP_FNV_PRIME; j = j + 1; }
                seen = seen + 1;
                if (seen < total) {
                    if (led != 0) {
                        if (_zip_led_has(led, h) == 1) { return 0 - 1; }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return h;
}

# Copy `n` bytes at src into a fresh NUL-terminated cstr. 0 on allocation failure.
fn _zip_cstr_a(a, src, n) {
    var b = _sankoch_alloc_via(a, n + 1);
    if (b == 0) { return 0; }
    var i = 0;
    while (i < n) { store8(b + i, load8(src + i)); i = i + 1; }
    store8(b + n, 0);
    return b;
}

fn _zip_cstr(src, n) {
    var b = _sankoch_alloc(n + 1);
    if (b == 0) { return 0; }
    var i = 0;
    while (i < n) { store8(b + i, load8(src + i)); i = i + 1; }
    store8(b + n, 0);
    return b;
}

# --- MS-DOS <-> Unix time (2.6.3) --------------------------------------------------
# ZIP stores modification time as an MS-DOS date/time pair: time bits 0-4 seconds/2,
# 5-10 minute, 11-15 hour; date bits 0-4 day, 5-8 month, 9-15 year-1980. Consumers want
# Unix seconds (tar parity), so convert both ways with the standard proleptic-Gregorian
# day count — integer only, no floating point anywhere.
fn _zip_days_from_civil(y, m, d) {
    var yy = y;
    if (m <= 2) { yy = yy - 1; }
    var era = yy / 400;
    if (yy < 0) { era = (yy - 399) / 400; }
    var yoe = yy - era * 400;                       # [0, 399]
    var mp = (m + 9) % 12;                          # March = 0
    var doy = (153 * mp + 2) / 5 + d - 1;           # [0, 365]
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

# Inverse: civil date from days-since-epoch, written into out[0..2] as y, m, d.
fn _zip_civil_from_days(z, out) {
    var zz = z + 719468;
    var era = zz / 146097;
    if (zz < 0) { era = (zz - 146096) / 146097; }
    var doe = zz - era * 146097;                                  # [0, 146096]
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y = yoe + era * 400;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);            # [0, 365]
    var mp = (5 * doy + 2) / 153;                                 # [0, 11]
    var d = doy - (153 * mp + 2) / 5 + 1;                         # [1, 31]
    var m = mp + 3;
    if (mp >= 10) { m = mp - 9; }
    if (m <= 2) { y = y + 1; }
    store64(out + 0, y); store64(out + 8, m); store64(out + 16, d);
    return 0;
}

# MS-DOS date+time -> Unix seconds. Returns 0 for the "unset" 1980-01-01 00:00 stamp the
# writer uses when a caller supplies no mtime, so an absent time reads as absent.
fn _zip_dos_to_unix(dtime, ddate) {
    var day = ddate & 31;
    var mon = (ddate >> 5) & 15;
    var yr = ((ddate >> 9) & 127) + 1980;
    if (day < 1 || mon < 1 || mon > 12) { return 0; }
    var sec = (dtime & 31) * 2;
    var mi = (dtime >> 5) & 63;
    var hr = (dtime >> 11) & 31;
    if (yr == 1980 && mon == 1 && day == 1 && dtime == 0) { return 0; }
    return _zip_days_from_civil(yr, mon, day) * 86400 + hr * 3600 + mi * 60 + sec;
}

# Unix seconds -> MS-DOS date+time, written into out[0]=dtime, out[1]=ddate. Times before
# the 1980 epoch (or 0 = unset) clamp to the 1980-01-01 floor the format allows.
fn _zip_unix_to_dos(t, out) {
    if (t <= 0) { store64(out + 0, 0); store64(out + 8, 0x21); return 0; }
    var days = t / 86400;
    var rem = t - days * 86400;
    var ymd[24];
    _zip_civil_from_days(days, &ymd);
    var y = load64(&ymd + 0);
    var m = load64(&ymd + 8);
    var d = load64(&ymd + 16);
    if (y < 1980) { store64(out + 0, 0); store64(out + 8, 0x21); return 0; }
    if (y > 2107) { y = 2107; }                     # the 7-bit year field's ceiling
    var hr = rem / 3600;
    var mi = (rem - hr * 3600) / 60;
    var sec = rem - hr * 3600 - mi * 60;
    store64(out + 0, (hr << 11) | (mi << 5) | (sec / 2));
    store64(out + 8, ((y - 1980) << 9) | (m << 5) | d);
    return 0;
}

# --- reader --------------------------------------------------------------------------
# Locate the End Of Central Directory record. It sits at the tail but may be followed by
# a variable-length comment (up to 65535 bytes), so scan backward for the signature and
# take the LAST plausible one whose declared comment length reaches exactly the end.
fn _zip_find_eocd(buf, len) {
    if (len < 22) { return 0 - 1; }
    var maxback = 65535 + 22;
    if (maxback > len) { maxback = len; }
    var p = len - 22;
    var floor_ = len - maxback;
    while (p >= floor_) {
        if (_zip_le32(buf + p) == ZIP_SIG_EOCD) {
            var clen = _zip_le16(buf + p + 20);
            if (p + 22 + clen == len) { return p; }
        }
        p = p - 1;
    }
    return 0 - 1;
}

# Parse the archive index into allocations taken from `a` (2.7.7).
#
# Everything the reader owns — the context, the entry table, one NUL-terminated name copy
# per entry and the symlink ledger — comes from `a`, so a caller that hands in an arena
# can `reset_via` the whole reader in one call. `a == 0` uses the process allocator and
# is exactly what `zip_open` did before this existed.
#
# ⚠ `buf` is NOT copied. It is stored raw and re-read by every `zip_extract*`, so it must
# outlive the reader — and if `a` is an arena, resetting it invalidates the reader but
# not `buf`. Entry NAMES are the exception: they are copied, so they survive `buf`.
#
# Returns 0 on a malformed archive, with the reason in `zip_last_error()`.
fn zip_open_a(a, buf, len) {
    if (len <= 0) { return _zip_fail(0 - ERR_INVALID_INPUT); }
    var eocd = _zip_find_eocd(buf, len);
    if (eocd < 0) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
    # Multi-disk (spanned) archives are a non-goal — reject rather than mis-read.
    if (_zip_le16(buf + eocd + 4) != 0) { return _zip_fail(0 - ERR_UNSUPPORTED_FORMAT); }
    if (_zip_le16(buf + eocd + 6) != 0) { return _zip_fail(0 - ERR_UNSUPPORTED_FORMAT); }
    var count = _zip_le16(buf + eocd + 10);
    var cd_size = _zip_le32(buf + eocd + 12);
    var cd_off = _zip_le32(buf + eocd + 16);

    # Zip64 (2.6.2): a locator immediately precedes the EOCD when the archive exceeds any
    # 16/32-bit field. Its record carries the true entry count / directory size + offset,
    # so an archive with >65,535 members or a >4 GB directory reads correctly instead of
    # being truncated to whatever fit the sentinel.
    if (eocd >= 20) {
        var loc = eocd - 20;
        if (_zip_le32(buf + loc) == ZIP_SIG_Z64_LOC) {
            var z64 = _zip_le64(buf + loc + 8);
            # Subtraction form (2.6.4): z64 is a fully attacker-controlled i64, so `z64 + 56`
            # can overflow to a negative value and slip past a `> len` compare — a 42-byte
            # archive drove `buf + z64` (~2^63) to a SIGSEGV. Bound z64 to [0, len] first,
            # then check the remaining span without adding. Short-circuit order is
            # load-bearing: `z64 > len` establishes z64 <= len before `len - z64`.
            if (z64 < 0 || z64 > len || len - z64 < 56) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
            if (_zip_le32(buf + z64) != ZIP_SIG_Z64_EOCD) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
            # multi-disk: non-goal
            if (_zip_le32(buf + z64 + 16) != 0) { return _zip_fail(0 - ERR_UNSUPPORTED_FORMAT); }
            if (_zip_le32(buf + z64 + 20) != 0) { return _zip_fail(0 - ERR_UNSUPPORTED_FORMAT); }
            count = _zip_le64(buf + z64 + 32);
            cd_size = _zip_le64(buf + z64 + 40);
            cd_off = _zip_le64(buf + z64 + 48);
        }
    }
    if (cd_off < 0 || cd_size < 0) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
    # Subtraction form (2.6.4): cd_off/cd_size are Zip64 i64 fields; `cd_off + cd_size`
    # can overflow negative past a `> len` compare, and cd_end below would then be a wild
    # value the CD-walk guards accept. Both are known >= 0 here.
    if (cd_off > len || cd_size > len - cd_off) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
    if (count < 0) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
    # An entry table must fit memory before we try to build it.
    if (count > cd_size / 46) { return _zip_fail(0 - ERR_CORRUPT_DATA); }   # each CD header is >= 46 bytes

    var ctx = _sankoch_alloc_via(a, ZIP_R_CTX);
    if (ctx == 0) { return _zip_fail(0 - ERR_OOM); }
    var table = 0;
    if (count > 0) {
        table = _sankoch_alloc_via(a, count * ZIP_ENT_SIZE);
        if (table == 0) { return _zip_fail(0 - ERR_OOM); }
    }

    var p = cd_off;
    var cd_end = cd_off + cd_size;
    var i = 0;
    while (i < count) {
        if (p + 46 > cd_end) { return _zip_fail(0 - ERR_CORRUPT_DATA); }   # header fits the directory
        if (_zip_le32(buf + p) != ZIP_SIG_CD) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
        var flags = _zip_le16(buf + p + 8);
        if ((flags & 1) != 0) { return _zip_fail(0 - ERR_UNSUPPORTED_FORMAT); }   # encrypted — non-goal
        var method = _zip_le16(buf + p + 10);
        var crc = _zip_le32(buf + p + 16);
        var csize = _zip_le32(buf + p + 20);
        var usize = _zip_le32(buf + p + 24);
        var nlen = _zip_le16(buf + p + 28);
        var elen = _zip_le16(buf + p + 30);
        var clen = _zip_le16(buf + p + 32);
        var lho = _zip_le32(buf + p + 42);
        if (p + 46 + nlen + elen + clen > cd_end) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
        # Zip64 per-member fields (2.6.2): resolve any all-ones sentinel from the
        # extended-information extra field before the bounds checks below use them.
        var need_u = 0; var need_c = 0; var need_o = 0;
        if (usize == ZIP_Z64_U32) { need_u = 1; }
        if (csize == ZIP_Z64_U32) { need_c = 1; }
        if (lho == ZIP_Z64_U32) { need_o = 1; }
        if (need_u == 1 || need_c == 1 || need_o == 1) {
            var ov[24];
            if (_zip_z64_extra(buf + p + 46 + nlen, elen, need_u, need_c, need_o, &ov) < 0) {
                return _zip_fail(0 - ERR_CORRUPT_DATA);
            }
            if (need_u == 1) { usize = load64(&ov + 0); }
            if (need_c == 1) { csize = load64(&ov + 8); }
            if (need_o == 1) { lho = load64(&ov + 16); }
        }
        # local header in-bounds (2.6.4 overflow-safe)
        if (lho < 0 || lho > len || len - lho < 30) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
        if (csize < 0 || usize < 0) { return _zip_fail(0 - ERR_CORRUPT_DATA); }
        # Per-entry metadata (2.6.3). The external-attributes field only carries a Unix
        # mode when "version made by" says Unix (high byte 3); anything else (a DOS or
        # NTFS writer) leaves it as MS-DOS attribute bits, which would be nonsense as a
        # mode — so report 0 rather than a fabricated one.
        var madeby = _zip_le16(buf + p + 4);
        var extattr = _zip_le32(buf + p + 38);
        var mode = 0;
        if ((madeby >> 8) == ZIP_MADE_UNIX) { mode = (extattr >> 16) & 0xFFFF; }
        var mtime = _zip_dos_to_unix(_zip_le16(buf + p + 12), _zip_le16(buf + p + 14));

        var name = _zip_cstr_a(a, buf + p + 46, nlen);
        if (name == 0) { return _zip_fail(0 - ERR_OOM); }
        var e = table + i * ZIP_ENT_SIZE;
        store64(e + 0, name);
        store64(e + 8, method);
        store64(e + 16, crc);
        store64(e + 24, csize);
        store64(e + 32, usize);
        store64(e + 40, lho);
        store64(e + 48, mode);
        store64(e + 56, mtime);
        p = p + 46 + nlen + elen + clen;
        i = i + 1;
    }

    # Archive-global symlink ledger (2.6.4). Built after the whole directory is parsed, so
    # the guard is independent of the order a consumer extracts in — which matters because
    # ZIP is random-access, unlike tar's forward cursor.
    var led = _zip_led_new_a(a, count + 1);
    if (led == 0) { return _zip_fail(0 - ERR_OOM); }
    var si = 0;
    while (si < count) {
        var se = table + si * ZIP_ENT_SIZE;
        if ((load64(se + 48) & ZIP_S_IFMT) == ZIP_S_IFLNK) {
            var sh = _zip_path_hash(load64(se + 0), 0);
            if (sh != (0 - 1)) { _zip_led_add(led, sh); }
        }
        si = si + 1;
    }

    store64(ctx + 0, buf);
    store64(ctx + 8, len);
    store64(ctx + 16, count);
    store64(ctx + 24, table);
    store64(ctx + 32, led);
    store64(ctx + 40, a);
    return ctx;
}

# Parse the archive index. Returns a reader context, or 0 if the archive is malformed —
# `zip_last_error()` says why (2.7.7). Allocates from the process allocator; use
# `zip_open_a` to place the reader in an arena you can reclaim.
fn zip_open(buf, len) {
    return zip_open_a(0, buf, len);
}

# The allocator the reader was opened with, or 0 for the process allocator.
fn zip_allocator(z) { return load64(z + 40); }

# How many members the archive declares.
#
# ⚠ No null guard, deliberately: `zip_count(0)` faults rather than answering 0, because
# a 0 would be indistinguishable from an empty archive and the caller would walk on. The
# contract is "check `zip_open`'s answer first", and it is stated here so it is a choice
# rather than an omission.
fn zip_count(z) { return load64(z + 16); }

fn _zip_ent(z, i) {
    if (i < 0 || i >= load64(z + 16)) { return 0; }
    return load64(z + 24) + i * ZIP_ENT_SIZE;
}

fn zip_entry_name(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0; }
    return load64(e + 0);
}

fn zip_entry_method(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0 - 1; }
    return load64(e + 8);
}

fn zip_entry_crc(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0 - 1; }
    return load64(e + 16);
}

fn zip_entry_csize(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0 - 1; }
    return load64(e + 24);
}

fn zip_entry_size(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0 - 1; }
    return load64(e + 32);
}

# Unix mode from the external attributes, or 0 when the archive was not written by a
# Unix-flavoured tool (2.6.3). Includes the file-type bits, like tar_mode.
fn zip_entry_mode(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0; }
    return load64(e + 48);
}

# Modification time in Unix seconds, or 0 if the member carries no usable stamp.
fn zip_entry_mtime(z, i) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0; }
    return load64(e + 56);
}

# A symlink member: mode says S_IFLNK and the member's CONTENT is the target path
# (extract it to read the target — the same shape tar_link exposes).
fn zip_entry_is_symlink(z, i) {
    var m = zip_entry_mode(z, i);
    if ((m & ZIP_S_IFMT) == ZIP_S_IFLNK) { return 1; }
    return 0;
}

# A member whose name ends in '/' is the directory convention (zero-length, stored).
fn zip_entry_is_dir(z, i) {
    var nm = zip_entry_name(z, i);
    if (nm == 0) { return 0; }
    var n = strlen(nm);
    if (n == 0) { return 0; }
    if (load8(nm + n - 1) == 47) { return 1; }
    return 0;
}

# Index of the member named `name`, or -1. Exact byte match.
# The index of the FIRST member named `name`, or -1.
#
# ⚠ FIRST, not last. A ZIP may legally carry the same name twice; readers that key an
# archive by name (Rust's `zip` crate, Python's `zipfile`) answer with the LAST such
# record, because inserting into a map replaces the value. A consumer reproducing one of
# those has to walk the indices itself. Stated because both answers are defensible and
# the difference is invisible until an adversarial archive arrives.
#
# 2.7.7: `strlen(name)` is computed ONCE. It used to be called three times per entry
# inside the scan, so resolving N names against an N-member archive re-scanned the
# needle O(N^2) times.
fn zip_find(z, name) {
    var n = load64(z + 16);
    var want = strlen(name);
    var i = 0;
    while (i < n) {
        var nm = zip_entry_name(z, i);
        if (nm != 0) {
            if (strlen(nm) == want) {
                if (memeq(nm, name, want) == 1) { return i; }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Extract member `i` into dst[0..dst_cap). Returns the uncompressed length, or a
# negative shared ERR_*. `max_ratio` bounds expansion (0 = the caller accepts the
# declared size); the member's CRC-32 is always verified. The member name is
# path-checked here so a consumer that writes by name cannot be zip-slipped even if it
# never calls the accessor itself.
# Shared member plumbing (2.6.1). Validates the member, locates its payload and applies
# the destination + ratio bounds, writing [data_offset, csize, usize] into the 3-word
# `outv`. Returns 0, or a negative ERR_*. Split out so `zip_methods.cyr` can add the
# other compression methods without duplicating any of the validation — that module is
# excluded from the lean `[lib.zip]` profile, which must not pull xz/bzip2/zstd in.
fn _zip_prepare(z, i, dst_cap, max_ratio, outv) {
    var e = _zip_ent(z, i);
    if (e == 0) { return 0 - ERR_INVALID_INPUT; }
    var buf = load64(z + 0);
    var len = load64(z + 8);
    var name = load64(e + 0);
    if (_zip_path_safe(name) != 1) { return 0 - ERR_UNSAFE_PATH; }
    # Cross-member guard (2.6.4): refuse a member written THROUGH a symlink that another
    # member declares — the escape no per-entry name check can see. A file or directory
    # written ONTO a symlink path is refused too (open(2)/mkdir resolve the final
    # component); a symlink member may legitimately be its own path.
    var led = load64(z + 32);
    if (led != 0) {
        var ph = _zip_path_hash(name, led);
        if (ph == (0 - 1)) { return 0 - ERR_UNSAFE_PATH; }
        if ((load64(e + 48) & ZIP_S_IFMT) != ZIP_S_IFLNK) {
            if (_zip_led_has(led, ph) == 1) { return 0 - ERR_UNSAFE_PATH; }
        }
    }

    var csize = load64(e + 24);
    var usize = load64(e + 32);
    var lho = load64(e + 40);

    # The local header repeats the name/extra lengths, which may differ from the central
    # directory's — the data begins after the LOCAL copy.
    # Overflow-safe bounds (2.6.4): lho/csize are Zip64 i64 fields; additive checks can
    # wrap past `> len`. lho already gated in zip_open, re-checked here defensively.
    if (lho < 0 || lho > len || len - lho < 30) { return 0 - ERR_CORRUPT_DATA; }
    if (_zip_le32(buf + lho) != ZIP_SIG_LOCAL) { return 0 - ERR_CORRUPT_DATA; }
    var lnlen = _zip_le16(buf + lho + 26);
    var lelen = _zip_le16(buf + lho + 28);
    var data = lho + 30 + lnlen + lelen;   # lnlen/lelen are u16, so this cannot overflow
    if (data < 0 || csize < 0 || data > len || len - data < csize) { return 0 - ERR_CORRUPT_DATA; }
    if (usize > dst_cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
    if (max_ratio > 0) {
        # Bound expansion the same way the codec ratio cap does: a member declaring more
        # than max_ratio x its compressed size is a bomb regardless of what it decodes to.
        if (csize == 0) {
            if (usize > 0) { return 0 - ERR_RATIO_LIMIT; }
        } else {
            if (usize / csize > max_ratio) { return 0 - ERR_RATIO_LIMIT; }
        }
    }
    store64(outv + 0, data);
    store64(outv + 8, csize);
    store64(outv + 16, usize);
    return 0;
}

# Shared post-check: the decoded length must match the declared size and the member's
# CRC-32 must verify. Every extraction path goes through this.
fn _zip_verify(z, i, dst, got, usize) {
    if (got != usize) { return 0 - ERR_CORRUPT_DATA; }
    var e = _zip_ent(z, i);
    if (e == 0) { return 0 - ERR_INVALID_INPUT; }
    if (crc32_init_table() < 0) { return 0 - ERR_OOM; }
    if ((crc32(dst, got) & 0xFFFFFFFF) != (load64(e + 16) & 0xFFFFFFFF)) {
        return 0 - ERR_CHECKSUM_MISMATCH;
    }
    return got;
}

# Extract member `i`. Handles the methods `zip.cyr` itself carries — 0 (store) and
# 8 (DEFLATE). Methods 12 / 93 / 95 need the bzip2 / zstd / xz decoders, which live
# behind `zip_extract_any` in `zip_methods.cyr` so the lean profile stays lean.
fn zip_extract_capped(z, i, dst, dst_cap, max_ratio) {
    var v[24];
    var pr = _zip_prepare(z, i, dst_cap, max_ratio, &v);
    if (pr < 0) { return pr; }
    var buf = load64(z + 0);
    var data = load64(&v + 0);
    var csize = load64(&v + 8);
    var usize = load64(&v + 16);
    var method = load64(_zip_ent(z, i) + 8);

    var got = 0;
    if (method == ZIP_STORE) {
        if (csize != usize) { return 0 - ERR_CORRUPT_DATA; }
        var k = 0;
        while (k < usize) { store8(dst + k, load8(buf + data + k)); k = k + 1; }
        got = usize;
    } elif (method == ZIP_DEFLATE) {
        # Raw DEFLATE (no zlib envelope) is what ZIP method 8 carries.
        if (max_ratio > 0) {
            got = deflate_decompress_with_ratio_cap(buf + data, csize, dst, dst_cap, max_ratio);
        } else {
            got = deflate_decompress(buf + data, csize, dst, dst_cap);
        }
        if (got < 0) { return got; }
    } else {
        return 0 - ERR_UNSUPPORTED_FORMAT;   # see zip_extract_any (zip_methods.cyr)
    }
    return _zip_verify(z, i, dst, got, usize);
}

# Extract with no ratio bound (the member's declared size still bounds the write).
fn zip_extract(z, i, dst, dst_cap) {
    return zip_extract_capped(z, i, dst, dst_cap, 0);
}

# --- writer ---------------------------------------------------------------------------
# Writer context (alloc 56): +0 dst, +8 dst_cap, +16 write pos, +24 entry count,
#                            +32 CD record list, +40 sticky error, +48 record capacity.
# Each CD record (ZIP_ENT_SIZE bytes) mirrors the reader's entry plus the local-header
# offset, so `zip_writer_finish` emits the directory without re-reading what it wrote.
# NOTE: every slot is 8-byte spaced — an earlier draft put the capacity at +44, which
# overlapped the error word at +40 and ran past the allocation.
# With Zip64 (2.6.2) the entry count is a u64 in the Zip64 EOCD record, so the old
# u16 ceiling is gone. The cap that remains is practical: the record table and the
# archive itself must fit the caller's buffer.
var ZIP_MAX_ENTRIES = 16777216;
var ZIP_REC_INIT = 64;         # initial record capacity; doubles on demand

# Emit a member's local file header at `hdr` (name already validated) and append its
# central-directory record. Shared by `zip_add` and `zip_add_any` so header layout —
# including Zip64 — has exactly one implementation (2.6.2).
#
# Zip64, local header: needed only when the UNCOMPRESSED size exceeds 32 bits. That is
# knowable before compressing (a compressed member is never larger than its input plus a
# little framing), which is what lets the payload offset be fixed up front.
fn _zip_local_z64(ulen) {
    if (ulen > ZIP_Z64_U32) { return 1; }
    return 0;
}

# Bytes the local header occupies for `nlen`-byte name (30 fixed + name + optional
# 20-byte Zip64 extra: 4-byte header + two u64s).
fn _zip_local_size(nlen, ulen) {
    if (_zip_local_z64(ulen) == 1) { return 30 + nlen + 20; }
    return 30 + nlen;
}

fn _zip_emit_local(dst, hdr, name, nlen, crc, csize, ulen, method, vneed, mtime) {
    var z64 = _zip_local_z64(ulen);
    var elen = 0;
    if (z64 == 1) { elen = 20; }
    _zip_put32(dst + hdr + 0, ZIP_SIG_LOCAL);
    _zip_put16(dst + hdr + 4, vneed);
    _zip_put16(dst + hdr + 6, 0);             # flags: none (no data descriptor)
    _zip_put16(dst + hdr + 8, method);
    var dt[16];
    _zip_unix_to_dos(mtime, &dt);
    _zip_put16(dst + hdr + 10, load64(&dt + 0));    # mod time  (2.6.3)
    _zip_put16(dst + hdr + 12, load64(&dt + 8));    # mod date
    _zip_put32(dst + hdr + 14, crc);
    if (z64 == 1) {
        _zip_put32(dst + hdr + 18, ZIP_Z64_U32);
        _zip_put32(dst + hdr + 22, ZIP_Z64_U32);
    } else {
        _zip_put32(dst + hdr + 18, csize);
        _zip_put32(dst + hdr + 22, ulen);
    }
    _zip_put16(dst + hdr + 26, nlen);
    _zip_put16(dst + hdr + 28, elen);
    var j = 0;
    while (j < nlen) { store8(dst + hdr + 30 + j, load8(name + j)); j = j + 1; }
    if (z64 == 1) {
        # Zip64 extended information: uncompressed size then compressed size. The local
        # record carries exactly these two — the header offset is a central-directory
        # concern.
        var ex = hdr + 30 + nlen;
        _zip_put16(dst + ex + 0, ZIP_Z64_EXTRA_ID);
        _zip_put16(dst + ex + 2, 16);
        _zip_put64(dst + ex + 4, ulen);
        _zip_put64(dst + ex + 12, csize);
    }
    return 0;
}

# Append the central-directory record for a member the writer already emitted.
#
# The name is COPIED, not aliased (2.6.2). The record outlives the `zip_add` call — the
# central directory is not emitted until `zip_writer_finish` — so holding the caller's
# pointer made correctness depend on that buffer staying alive AND unmodified until then.
# A caller that formats names into one reusable buffer (the natural way to add thousands
# of members) silently got the LAST name on every entry, with valid CRCs and a
# reference-tool-clean archive hiding it. Copying is the only safe contract.
fn _zip_record(w, name, method, crc, csize, ulen, hdr, mode, mtime) {
    var count = load64(w + 24);
    var recs = load64(w + 32);
    var reccap = load64(w + 48);
    if (count >= reccap) {
        var ncap = reccap * 2;
        var nrecs = _sankoch_alloc_via(load64(w + 64), ncap * ZIP_ENT_SIZE);
        if (nrecs == 0) { store64(w + 40, 0 - ERR_OOM); return 0 - ERR_OOM; }
        var b = 0;
        while (b < count * ZIP_ENT_SIZE) { store8(nrecs + b, load8(recs + b)); b = b + 1; }
        store64(w + 32, nrecs);
        store64(w + 48, ncap);
        recs = nrecs;
    }
    var namecopy = _zip_cstr_a(load64(w + 64), name, strlen(name));
    if (namecopy == 0) { store64(w + 40, 0 - ERR_OOM); return 0 - ERR_OOM; }
    var r = recs + count * ZIP_ENT_SIZE;
    store64(r + 0, namecopy);
    store64(r + 8, method);
    store64(r + 16, crc);
    store64(r + 24, csize);
    store64(r + 32, ulen);
    store64(r + 40, hdr);
    store64(r + 48, mode);
    store64(r + 56, mtime);
    store64(w + 24, count + 1);
    return 0;
}

# --- destination sizing (2.7.7) ----------------------------------------------------
#
# The writer never allocates: `dst` is the caller's, every write bounds-checks against
# `dst_cap`, and the answer to "too small" is `ERR_BUFFER_TOO_SMALL` rather than growth.
# Until now there was no way to ask how big the buffer needed to be, so a consumer had
# two options — guess and retry, or re-derive the record layout. agnosai's `.agpkg`
# writer did the latter, reproducing the 30/46/22-byte header arithmetic and the Zip64
# extra sizes in its own source, which is a consumer maintaining a copy of this file's
# internals.
#
# Retrying is worse than it sounds: there is no resize, a partially written `dst` is not
# reusable, and a retry re-runs `zip_writer_init` and re-COMPRESSES every member.
#
# ⚠ **This is an upper bound, and it is only computable because DEFLATE degrades to
# STORE when it does not shrink** (`zip_add_meta`: `cl > 0 && cl < len`). The stored
# payload is therefore never larger than its input, and everything else is fixed-size
# headers. If that fallback ever went away, so would this function's contract.
#
# Per member: 30-byte local header + name, plus a 20-byte Zip64 extra when the size
# needs one; the payload, at most its uncompressed length; and a 46-byte central
# directory record + name, plus up to 28 bytes of Zip64 extra (4-byte header + three
# u64s). The name appears in BOTH headers, hence twice.
#
# Archive: a 22-byte EOCD, plus a 56-byte Zip64 EOCD and its 20-byte locator when
# anything overflows. All three are counted unconditionally — 98 bytes of slack on an
# archive that does not need them is not worth a second, conditional entry point.
var ZIP_BOUND_PER_MEMBER = 124;    # 30 local + 20 z64 extra + 46 CD + 28 CD z64 extra
var ZIP_BOUND_TRAILER = 98;        # 56 zip64 EOCD + 20 locator + 22 EOCD

# The largest archive `count` members can produce, given the total bytes of their names
# and of their uncompressed payloads. Size `dst` to this and no write can fail for
# space. Returns a byte count, or `0 - ERR_INVALID_INPUT` on a negative argument.
fn zip_bound(count, total_name_bytes, total_payload_bytes) {
    if (count < 0 || total_name_bytes < 0 || total_payload_bytes < 0) {
        return 0 - ERR_INVALID_INPUT;
    }
    return ZIP_BOUND_TRAILER + count * ZIP_BOUND_PER_MEMBER
    + total_name_bytes * 2 + total_payload_bytes;
}

# The same for one member, so a caller accumulating as it goes does not have to track
# three running totals. `zip_bound(n, names, payloads)` and the sum of
# `zip_bound_member(nlen_i, ulen_i)` plus `ZIP_BOUND_TRAILER` agree exactly.
fn zip_bound_member(nlen, ulen) {
    if (nlen < 0 || ulen < 0) { return 0 - ERR_INVALID_INPUT; }
    return ZIP_BOUND_PER_MEMBER + nlen * 2 + ulen;
}

# Start an archive in `dst`, with the writer's own bookkeeping taken from `a` (2.7.7).
#
# The context, the growable record table and one name copy per member all come from `a`,
# so an arena reclaims the writer in one `reset_via`. `dst` itself is always the
# caller's and is never allocated here. `a == 0` uses the process allocator.
#
# ⚠ Size `dst` with `zip_bound` — this writer never grows it.
fn zip_writer_init_a(a, dst, dst_cap) {
    if (dst_cap < 22) { return 0; }        # no room for even an empty archive's EOCD
    var w = _sankoch_alloc_via(a, ZIP_W_CTX);
    if (w == 0) { return 0; }
    var recs = _sankoch_alloc_via(a, ZIP_REC_INIT * ZIP_ENT_SIZE);
    if (recs == 0) { return 0; }
    store64(w + 0, dst);
    store64(w + 8, dst_cap);
    store64(w + 16, 0);
    store64(w + 24, 0);
    store64(w + 32, recs);
    store64(w + 40, 0);
    store64(w + 48, ZIP_REC_INIT);
    store64(w + 56, 0);   # no streamed member open (2.6.3)
    store64(w + 64, a);   # allocator for the record table and name copies (2.7.7)
    return w;
}

fn zip_writer_init(dst, dst_cap) {
    if (dst_cap < 22) { return 0; }        # no room for even an empty archive's EOCD
    var w = _sankoch_alloc(ZIP_W_CTX);
    if (w == 0) { return 0; }
    var recs = _sankoch_alloc(ZIP_REC_INIT * ZIP_ENT_SIZE);
    if (recs == 0) { return 0; }
    store64(w + 0, dst);
    store64(w + 8, dst_cap);
    store64(w + 16, 0);
    store64(w + 24, 0);
    store64(w + 32, recs);
    store64(w + 40, 0);
    store64(w + 48, ZIP_REC_INIT);
    store64(w + 56, 0);   # no streamed member open (2.6.3)
    store64(w + 64, 0);   # process allocator (2.7.7)
    return w;
}

# Append one member. `method` is ZIP_STORE or ZIP_DEFLATE; DEFLATE falls back to STORE
# when compression does not actually shrink the data (what reference writers do, and it
# keeps a pathological input from inflating the archive). Returns 0, or a negative ERR_*.
# Append one member with explicit Unix metadata (2.6.3). `mode` is a Unix mode including
# the file-type bits (0 = omit metadata entirely, which keeps the DOS-only shape 2.6.0
# wrote); `mtime` is Unix seconds (0 = unset). A SYMLINK is `mode` with S_IFLNK and the
# target path as `data` — the same convention bsdtar/Info-ZIP use, so the member round-
# trips through reference tools as a symlink.
#
# `method` is ZIP_STORE or ZIP_DEFLATE; DEFLATE falls back to STORE when compression does
# not shrink the member, so a pathological input cannot inflate the archive.
fn zip_add_meta(w, name, data, len, method, mode, mtime) {
    if (load64(w + 40) != 0) { return load64(w + 40); }
    if (_zip_streaming(w) == 1) { return 0 - ERR_INVALID_INPUT; }   # a streamed member is open (2.6.4)
    if (len < 0) { return 0 - ERR_INVALID_INPUT; }
    if (_zip_path_safe(name) != 1) { return 0 - ERR_UNSAFE_PATH; }
    # The name-length field is a hard u16 (ZIP has no Zip64 extension for it); a longer
    # name truncates in _zip_put16 while the full bytes are still copied, self-desyncing
    # the central directory into an archive no reader accepts. Refuse (2.6.4).
    if (strlen(name) > ZIP_Z64_U16) { return 0 - ERR_INVALID_INPUT; }
    var count = load64(w + 24);
    if (count >= ZIP_MAX_ENTRIES) { return 0 - ERR_OUTPUT_LIMIT; }

    var dst = load64(w + 0);
    var cap = load64(w + 8);
    var pos = load64(w + 16);
    var nlen = strlen(name);

    if (crc32_init_table() < 0) { return 0 - ERR_OOM; }
    var crc = crc32(data, len) & ZIP_Z64_U32;

    # Compress into the archive buffer directly, after the local header we are about to
    # write, so there is no separate staging allocation on the hot path.
    var hdr = pos;
    var body = hdr + _zip_local_size(nlen, len);
    if (body > cap) { store64(w + 40, 0 - ERR_BUFFER_TOO_SMALL); return 0 - ERR_BUFFER_TOO_SMALL; }
    var stored_method = ZIP_STORE;
    var csize = 0;
    if (method == ZIP_DEFLATE && len > 0) {
        var room = cap - body;
        var cl = deflate_compress(data, len, dst + body, room);
        if (cl > 0 && cl < len) {
            stored_method = ZIP_DEFLATE;
            csize = cl;
        }
    }
    if (stored_method == ZIP_STORE) {
        if (body + len > cap) { store64(w + 40, 0 - ERR_BUFFER_TOO_SMALL); return 0 - ERR_BUFFER_TOO_SMALL; }
        var k = 0;
        while (k < len) { store8(dst + body + k, load8(data + k)); k = k + 1; }
        csize = len;
    }

    _zip_emit_local(dst, hdr, name, nlen, crc, csize, len, stored_method, 20, mtime);
    var rr = _zip_record(w, name, stored_method, crc, csize, len, hdr, mode, mtime);
    if (rr < 0) { return rr; }
    store64(w + 16, body + csize);
    return 0;
}

# Append a member with no Unix metadata (the 2.6.0 shape).
fn zip_add(w, name, data, len, method) {
    return zip_add_meta(w, name, data, len, method, 0, 0);
}

# --- streaming write (2.6.3) ----------------------------------------------------------
# Mirrors the codec `*_enc_*` shape: begin a member, feed it in chunks, end it. The member
# is written with the general-purpose bit-3 flag and a trailing DATA DESCRIPTOR, which is
# exactly what the format provides for a producer that does not know a member's size or
# CRC until it has seen all of it. (sankoch's own reader already handled such archives —
# it takes sizes from the central directory — so this completes the pair.)
#
# In-progress state lives at the tail of the writer context, so a writer that never
# streams pays nothing: +56 name copy, +64 local-header offset, +72 payload offset,
# +80 method, +88 CRC state, +96 uncompressed running length, +104 inner encoder ctx,
# +112 mode, +120 mtime.
# Writer context — 128 bytes, and every slot is spoken for. Written down in 2.7.7 after
# adding the allocator at +64 required grepping `w + N` across two files to find the one
# gap; a wrong guess would have silently aliased the streaming encoder's state.
#
#   +0   dst              +8   dst_cap          +16  pos            +24  member count
#   +32  record table     +40  sticky error     +48  record cap     +56  streaming flag
#   +64  allocator (2.7.7)
#   --- streamed-member state, live only between zip_enc_begin and zip_enc_end ---
#   +72  payload offset   +80  method           +88  crc32 state    +96  bytes written
#   +104 inner encoder    +112 mode             +120 mtime
var ZIP_W_CTX = 128;

fn _zip_streaming(w) {
    if (load64(w + 56) != 0) { return 1; }
    return 0;
}

# Release an ABANDONED open member (2.6.4). A streamed DEFLATE member holds _sankoch_mtx
# from zip_enc_begin's deflate_enc_init until deflate_enc_finish — the sole unlock site —
# so any path that walks away from an open DEFLATE member on an error MUST funnel through
# here first, or the mutex leaks and the next sankoch call in the process deadlocks. NO-OP
# for STORE (no lock held) and only when a member is actually open, so it never
# double-unlocks. Clears the streaming state either way.
fn _zip_abandon(w) {
    if (load64(w + 56) == 0) { return 0; }
    if (load64(w + 80) == ZIP_DEFLATE) {
        var inner = load64(w + 104);
        if (inner != 0) { deflate_enc_finish(inner); }   # ignore result; this is the unlock
    }
    store64(w + 56, 0);
    store64(w + 104, 0);
    return 0;
}

# Begin a streamed member. Only one may be open at a time. `method` is ZIP_STORE or
# ZIP_DEFLATE; `mode`/`mtime` follow zip_add_meta's convention (0 = omit).
fn zip_enc_begin(w, name, method, mode, mtime) {
    if (load64(w + 40) != 0) { return load64(w + 40); }
    if (_zip_streaming(w) == 1) { return 0 - ERR_INVALID_INPUT; }   # member already open
    if (_zip_path_safe(name) != 1) { return 0 - ERR_UNSAFE_PATH; }
    if (strlen(name) > ZIP_Z64_U16) { return 0 - ERR_INVALID_INPUT; }   # u16 name field (2.6.4)
    if (method != ZIP_STORE && method != ZIP_DEFLATE) { return 0 - ERR_UNSUPPORTED_FORMAT; }
    if (load64(w + 24) >= ZIP_MAX_ENTRIES) { return 0 - ERR_OUTPUT_LIMIT; }

    var dst = load64(w + 0);
    var cap = load64(w + 8);
    var hdr = load64(w + 16);
    var nlen = strlen(name);
    # Streamed members never carry a Zip64 local extra: the size is unknown here, and the
    # data descriptor is where the true value goes.
    var body = hdr + 30 + nlen;
    if (body > cap) { store64(w + 40, 0 - ERR_BUFFER_TOO_SMALL); return 0 - ERR_BUFFER_TOO_SMALL; }

    var namecopy = _zip_cstr_a(load64(w + 64), name, strlen(name));
    if (namecopy == 0) { store64(w + 40, 0 - ERR_OOM); return 0 - ERR_OOM; }
    var st = crc32_init();
    if (st == 0) { store64(w + 40, 0 - ERR_OOM); return 0 - ERR_OOM; }

    # Local header: bit 3 set, sizes + CRC zero — the data descriptor carries the truth.
    var dt[16];
    _zip_unix_to_dos(mtime, &dt);
    _zip_put32(dst + hdr + 0, ZIP_SIG_LOCAL);
    _zip_put16(dst + hdr + 4, 20);
    _zip_put16(dst + hdr + 6, 8);              # general purpose bit 3 -> data descriptor
    _zip_put16(dst + hdr + 8, method);
    _zip_put16(dst + hdr + 10, load64(&dt + 0));
    _zip_put16(dst + hdr + 12, load64(&dt + 8));
    _zip_put32(dst + hdr + 14, 0);             # crc      (in the descriptor)
    _zip_put32(dst + hdr + 18, 0);             # csize    (in the descriptor)
    _zip_put32(dst + hdr + 22, 0);             # usize    (in the descriptor)
    _zip_put16(dst + hdr + 26, nlen);
    _zip_put16(dst + hdr + 28, 0);
    var j = 0;
    while (j < nlen) { store8(dst + hdr + 30 + j, load8(name + j)); j = j + 1; }

    var inner = 0;
    if (method == ZIP_DEFLATE) {
        inner = deflate_enc_init(6, dst + body, cap - body);
        if (inner == 0) { store64(w + 40, 0 - ERR_OOM); return 0 - ERR_OOM; }
    }
    store64(w + 56, namecopy);
    store64(w + 64, hdr);
    store64(w + 72, body);
    store64(w + 80, method);
    store64(w + 88, st);
    store64(w + 96, 0);
    store64(w + 104, inner);
    store64(w + 112, mode);
    store64(w + 120, mtime);
    return 0;
}

# Feed the open member another chunk. Returns 0, or a negative ERR_*.
fn zip_enc_write(w, data, len) {
    if (load64(w + 40) != 0) { return load64(w + 40); }
    if (_zip_streaming(w) == 0) { return 0 - ERR_INVALID_INPUT; }
    if (len < 0) { return 0 - ERR_INVALID_INPUT; }
    if (len == 0) { return 0; }
    crc32_update(load64(w + 88), data, len);
    store64(w + 96, load64(w + 96) + len);
    if (load64(w + 80) == ZIP_DEFLATE) {
        var r = deflate_enc_write(load64(w + 104), data, len);
        if (r < 0) {
            store64(w + 40, r);
            _zip_abandon(w);   # deflate_enc_write's error left the lock held — release it (2.6.4)
            return r;
        }
        return 0;
    }
    # STORE: copy straight into the archive after the header.
    var dst = load64(w + 0);
    var cap = load64(w + 8);
    var at = load64(w + 72) + load64(w + 96) - len;
    if (at + len > cap) { store64(w + 40, 0 - ERR_BUFFER_TOO_SMALL); return 0 - ERR_BUFFER_TOO_SMALL; }
    var k = 0;
    while (k < len) { store8(dst + at + k, load8(data + k)); k = k + 1; }
    return 0;
}

# Close the open member: flush the encoder, emit the data descriptor, record the entry.
fn zip_enc_end(w) {
    if (load64(w + 40) != 0) {
        _zip_abandon(w);   # sticky error on an open DEFLATE member: release before reporting (2.6.4)
        return load64(w + 40);
    }
    if (_zip_streaming(w) == 0) { return 0 - ERR_INVALID_INPUT; }
    var dst = load64(w + 0);
    var cap = load64(w + 8);
    var hdr = load64(w + 64);
    var body = load64(w + 72);
    var method = load64(w + 80);
    var ulen = load64(w + 96);
    var crc = crc32_final(load64(w + 88)) & ZIP_Z64_U32;

    var csize = 0;
    if (method == ZIP_DEFLATE) {
        var fin = deflate_enc_finish(load64(w + 104));
        if (fin < 0) { store64(w + 40, fin); return fin; }
        csize = fin;
    } else {
        csize = ulen;
    }

    # Data descriptor: the optional 0x08074b50 signature (reference writers emit it, and
    # readers that scan for descriptors rely on it) + crc, csize, usize.
    var pos = body + csize;
    if (pos + 16 > cap) { store64(w + 40, 0 - ERR_BUFFER_TOO_SMALL); return 0 - ERR_BUFFER_TOO_SMALL; }
    _zip_put32(dst + pos + 0, 0x08074b50);
    _zip_put32(dst + pos + 4, crc);
    _zip_put32(dst + pos + 8, csize);
    _zip_put32(dst + pos + 12, ulen);
    pos = pos + 16;

    var rr = _zip_record(w, load64(w + 56), method, crc, csize, ulen, hdr,
      load64(w + 112), load64(w + 120));
    if (rr < 0) { return rr; }
    store64(w + 16, pos);
    store64(w + 56, 0);      # no member open
    return 0;
}

# Emit the central directory + EOCD (plus the Zip64 records when anything overflows a
# 16/32-bit field). Returns the archive's total byte length, or <0.
fn zip_writer_finish(w) {
    if (load64(w + 40) != 0) { return load64(w + 40); }
    # A half-written streamed member would leave a local header with no descriptor and no
    # directory entry — refuse rather than emit a corrupt archive (2.6.3). Release its
    # encoder lock on the way out so the refusal does not deadlock the library (2.6.4).
    if (_zip_streaming(w) == 1) { _zip_abandon(w); return 0 - ERR_INVALID_INPUT; }
    var dst = load64(w + 0);
    var cap = load64(w + 8);
    var pos = load64(w + 16);
    var count = load64(w + 24);
    var recs = load64(w + 32);

    var cd_off = pos;
    var i = 0;
    while (i < count) {
        var r = recs + i * ZIP_ENT_SIZE;
        var name = load64(r + 0);
        var nlen = strlen(name);
        var csize = load64(r + 24);
        var ulen = load64(r + 32);
        var hdr = load64(r + 40);
        # A central record needs Zip64 when either size OR the local-header offset
        # overflows 32 bits — the offset is why a >4 GB archive needs it even when every
        # individual member is small.
        var nu = 0; var nc = 0; var no = 0;
        if (ulen > ZIP_Z64_U32) { nu = 1; }
        if (csize > ZIP_Z64_U32) { nc = 1; }
        if (hdr > ZIP_Z64_U32) { no = 1; }
        var elen = 0;
        if (nu == 1 || nc == 1 || no == 1) { elen = 4 + (nu + nc + no) * 8; }
        if (pos + 46 + nlen + elen > cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
        var mode = load64(r + 48);
        var mtime = load64(r + 56);
        # "version made by" high byte 3 (Unix) is what makes the external-attributes
        # field readable as a mode; only claim it when we actually have one (2.6.3).
        var madeby = 20;
        if (mode != 0) { madeby = (ZIP_MADE_UNIX << 8) | 20; }
        var dtc[16];
        _zip_unix_to_dos(mtime, &dtc);
        _zip_put32(dst + pos + 0, ZIP_SIG_CD);
        _zip_put16(dst + pos + 4, madeby);        # version made by
        _zip_put16(dst + pos + 6, 20);            # version needed
        _zip_put16(dst + pos + 8, 0);             # flags
        _zip_put16(dst + pos + 10, load64(r + 8));
        _zip_put16(dst + pos + 12, load64(&dtc + 0));   # mod time
        _zip_put16(dst + pos + 14, load64(&dtc + 8));   # mod date
        _zip_put32(dst + pos + 16, load64(r + 16));
        if (nc == 1) { _zip_put32(dst + pos + 20, ZIP_Z64_U32); } else { _zip_put32(dst + pos + 20, csize); }
        if (nu == 1) { _zip_put32(dst + pos + 24, ZIP_Z64_U32); } else { _zip_put32(dst + pos + 24, ulen); }
        _zip_put16(dst + pos + 28, nlen);
        _zip_put16(dst + pos + 30, elen);
        _zip_put16(dst + pos + 32, 0);            # comment
        _zip_put16(dst + pos + 34, 0);            # disk number
        _zip_put16(dst + pos + 36, 0);            # internal attrs
        _zip_put32(dst + pos + 38, (mode << 16) & ZIP_Z64_U32);   # external attrs = Unix mode
        if (no == 1) { _zip_put32(dst + pos + 42, ZIP_Z64_U32); } else { _zip_put32(dst + pos + 42, hdr); }
        var j = 0;
        while (j < nlen) { store8(dst + pos + 46 + j, load8(name + j)); j = j + 1; }
        if (elen > 0) {
            # Fixed order, each present only if its base field is a sentinel — this must
            # mirror _zip_z64_extra's read order exactly.
            var ex = pos + 46 + nlen;
            _zip_put16(dst + ex + 0, ZIP_Z64_EXTRA_ID);
            _zip_put16(dst + ex + 2, elen - 4);
            var q = ex + 4;
            if (nu == 1) { _zip_put64(dst + q, ulen); q = q + 8; }
            if (nc == 1) { _zip_put64(dst + q, csize); q = q + 8; }
            if (no == 1) { _zip_put64(dst + q, hdr); q = q + 8; }
        }
        pos = pos + 46 + nlen + elen;
        i = i + 1;
    }
    var cd_size = pos - cd_off;

    # Zip64 EOCD record + locator, emitted whenever the plain EOCD cannot express the
    # archive: >65,535 members, or a directory whose size/offset overflows 32 bits.
    var need64 = 0;
    if (count > ZIP_Z64_U16) { need64 = 1; }
    if (cd_size > ZIP_Z64_U32 || cd_off > ZIP_Z64_U32) { need64 = 1; }
    if (need64 == 1) {
        if (pos + 56 + 20 + 22 > cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
        var z64 = pos;
        _zip_put32(dst + z64 + 0, ZIP_SIG_Z64_EOCD);
        _zip_put64(dst + z64 + 4, 44);            # size of this record minus 12
        _zip_put16(dst + z64 + 12, 45);           # version made by (4.5 = zip64)
        _zip_put16(dst + z64 + 14, 45);           # version needed
        _zip_put32(dst + z64 + 16, 0);            # this disk
        _zip_put32(dst + z64 + 20, 0);            # disk with CD start
        _zip_put64(dst + z64 + 24, count);
        _zip_put64(dst + z64 + 32, count);
        _zip_put64(dst + z64 + 40, cd_size);
        _zip_put64(dst + z64 + 48, cd_off);
        pos = pos + 56;
        _zip_put32(dst + pos + 0, ZIP_SIG_Z64_LOC);
        _zip_put32(dst + pos + 4, 0);             # disk with the zip64 EOCD
        _zip_put64(dst + pos + 8, z64);
        _zip_put32(dst + pos + 16, 1);            # total disks
        pos = pos + 20;
    }

    if (pos + 22 > cap) { return 0 - ERR_BUFFER_TOO_SMALL; }
    _zip_put32(dst + pos + 0, ZIP_SIG_EOCD);
    _zip_put16(dst + pos + 4, 0);                 # this disk
    _zip_put16(dst + pos + 6, 0);                 # disk with CD start
    var ecount = count;
    if (ecount > ZIP_Z64_U16) { ecount = ZIP_Z64_U16; }
    _zip_put16(dst + pos + 8, ecount);
    _zip_put16(dst + pos + 10, ecount);
    var esize = cd_size;
    if (esize > ZIP_Z64_U32) { esize = ZIP_Z64_U32; }
    var eoff = cd_off;
    if (eoff > ZIP_Z64_U32) { eoff = ZIP_Z64_U32; }
    _zip_put32(dst + pos + 12, esize);
    _zip_put32(dst + pos + 16, eoff);
    _zip_put16(dst + pos + 20, 0);                # comment length
    pos = pos + 22;
    return pos;
}
