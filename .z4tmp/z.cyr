fn _sl(s){var i=0;while(load8(s+i)!=0){i=i+1;}return i;}
fn _p(s){syscall(1,1,s,_sl(s));return 0;}
fn _pi(v){if(v==0){_p("0");return 0;}var b[24];var i=24;var n=v;while(n>0){i=i-1;store8(&b+i,48+(n%10));n=n/10;}syscall(1,1,&b+i,24-i);return 0;}
fn go(inp,lv,tag){var fd=syscall(2,inp,0,0);if(fd<0){return 0;}var cap=8388608;var src=_sankoch_alloc(cap);var t=0;while(1==1){var r=syscall(0,fd,src+t,cap-t);if(r<=0){break;}t=t+r;}syscall(3,fd);var dst=_sankoch_alloc(cap+65536);var o=zstd_compress_level(src,t,dst,cap+65536,lv);_p(tag);_p(" out=");_pi(o);_p("\n");return 0;}
fn main(){go("/home/macro/Repos/sankoch/.z4tmp/records.bin",6,"rec_L6");go("/home/macro/Repos/sankoch/.z4tmp/records.bin",9,"rec_L9");go("/home/macro/Repos/sankoch/.z4tmp/src.bin",9,"src_L9");return 0;}
