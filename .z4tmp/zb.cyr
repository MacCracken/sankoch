include "src/lib.cyr"
fn _sl(s){var i=0;while(load8(s+i)!=0){i=i+1;}return i;}
fn _p(s){syscall(1,1,s,_sl(s));return 0;}
fn _pi(v){if(v==0){_p("0");return 0;}var b[24];var i=24;var n=v;while(n>0){i=i-1;store8(&b+i,48+(n%10));n=n/10;}syscall(1,1,&b+i,24-i);return 0;}
fn run(inp,lv){var fd=syscall(2,inp,0,0);if(fd<0){_p("open fail\n");return 0;}var cap=8388608;var src=_sankoch_alloc(cap);var t=0;while(1==1){var r=syscall(0,fd,src+t,cap-t);if(r<=0){break;}t=t+r;}syscall(3,fd);var dst=_sankoch_alloc(cap+65536);var o=zstd_compress_level(src,t,dst,cap+65536,lv);_p("  L");_pi(lv);_p(": in=");_pi(t);_p(" out=");_pi(o);
  # write to file for zstd -d roundtrip
  var of=syscall(2,"/home/macro/Repos/sankoch/.z4tmp/s.zst",577,420);var w=0;while(w<o){var k=syscall(1,of,dst+w,o-w);if(k<=0){break;}w=w+k;}syscall(3,of);
  _p("\n");return 0;}
fn main(){run("/home/macro/Repos/sankoch/.z4tmp/records.bin",6);run("/home/macro/Repos/sankoch/.z4tmp/records.bin",9);return 0;}
