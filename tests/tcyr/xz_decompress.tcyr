# sankoch — xz / LZMA — decompress (real `xz` fixtures, corruption)
#
# Part of the split test suite (see _harness.tcyr). Run with:
#   cyrius test tests/tcyr/xz_decompress.tcyr

include "tests/tcyr/_harness.tcyr"

# uncompressed LZMA2 chunk, crc64 (80 compressed -> 16 bytes)
fn test_xz_uncompressed_chunk() {
    var comp = alloc(80);
    store8(comp + 0, 253); store8(comp + 1, 55); store8(comp + 2, 122); store8(comp + 3, 88);
    store8(comp + 4, 90); store8(comp + 5, 0); store8(comp + 6, 0); store8(comp + 7, 4);
    store8(comp + 8, 230); store8(comp + 9, 214); store8(comp + 10, 180); store8(comp + 11, 70);
    store8(comp + 12, 4); store8(comp + 13, 192); store8(comp + 14, 20); store8(comp + 15, 16);
    store8(comp + 16, 33); store8(comp + 17, 1); store8(comp + 18, 22); store8(comp + 19, 0);
    store8(comp + 20, 0); store8(comp + 21, 0); store8(comp + 22, 0); store8(comp + 23, 0);
    store8(comp + 24, 0); store8(comp + 25, 0); store8(comp + 26, 0); store8(comp + 27, 0);
    store8(comp + 28, 65); store8(comp + 29, 32); store8(comp + 30, 69); store8(comp + 31, 31);
    store8(comp + 32, 1); store8(comp + 33, 0); store8(comp + 34, 15); store8(comp + 35, 72);
    store8(comp + 36, 101); store8(comp + 37, 108); store8(comp + 38, 108); store8(comp + 39, 111);
    store8(comp + 40, 44); store8(comp + 41, 32); store8(comp + 42, 120); store8(comp + 43, 122);
    store8(comp + 44, 32); store8(comp + 45, 119); store8(comp + 46, 111); store8(comp + 47, 114);
    store8(comp + 48, 108); store8(comp + 49, 100); store8(comp + 50, 33); store8(comp + 51, 0);
    store8(comp + 52, 13); store8(comp + 53, 195); store8(comp + 54, 37); store8(comp + 55, 144);
    store8(comp + 56, 68); store8(comp + 57, 132); store8(comp + 58, 80); store8(comp + 59, 28);
    store8(comp + 60, 0); store8(comp + 61, 1); store8(comp + 62, 48); store8(comp + 63, 16);
    store8(comp + 64, 188); store8(comp + 65, 147); store8(comp + 66, 119); store8(comp + 67, 226);
    store8(comp + 68, 31); store8(comp + 69, 182); store8(comp + 70, 243); store8(comp + 71, 125);
    store8(comp + 72, 1); store8(comp + 73, 0); store8(comp + 74, 0); store8(comp + 75, 0);
    store8(comp + 76, 0); store8(comp + 77, 4); store8(comp + 78, 89); store8(comp + 79, 90);
    var out = alloc(16);
    var dlen = xz_decompress(comp, 80, out, 16);
    assert(dlen == 16, "xz_uncompressed_chunk dlen");
    var exp = alloc(16);
    store8(exp + 0, 72); store8(exp + 1, 101); store8(exp + 2, 108); store8(exp + 3, 108);
    store8(exp + 4, 111); store8(exp + 5, 44); store8(exp + 6, 32); store8(exp + 7, 120);
    store8(exp + 8, 122); store8(exp + 9, 32); store8(exp + 10, 119); store8(exp + 11, 111);
    store8(exp + 12, 114); store8(exp + 13, 108); store8(exp + 14, 100); store8(exp + 15, 33);
    var i = 0;
    while (i < 16) {
        assert(load8(out + i) == load8(exp + i), "xz_uncompressed_chunk byte");
        i = i + 1;
    }
    return 0;
}

