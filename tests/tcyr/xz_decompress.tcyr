# empty stream (32 compressed -> 0 bytes)
fn test_xz_empty() {
    var comp = alloc(32);
    store8(comp + 0, 253); store8(comp + 1, 55); store8(comp + 2, 122); store8(comp + 3, 88);
    store8(comp + 4, 90); store8(comp + 5, 0); store8(comp + 6, 0); store8(comp + 7, 1);
    store8(comp + 8, 105); store8(comp + 9, 34); store8(comp + 10, 222); store8(comp + 11, 54);
    store8(comp + 12, 0); store8(comp + 13, 0); store8(comp + 14, 0); store8(comp + 15, 0);
    store8(comp + 16, 28); store8(comp + 17, 223); store8(comp + 18, 68); store8(comp + 19, 33);
    store8(comp + 20, 144); store8(comp + 21, 66); store8(comp + 22, 153); store8(comp + 23, 13);
    store8(comp + 24, 1); store8(comp + 25, 0); store8(comp + 26, 0); store8(comp + 27, 0);
    store8(comp + 28, 0); store8(comp + 29, 1); store8(comp + 30, 89); store8(comp + 31, 90);
    var out = alloc(1);
    var dlen = xz_decompress(comp, 32, out, 1);
    assert(dlen == 0, "xz_empty dlen");
    return 0;
}

# check=none (92 compressed -> 36 bytes)
fn test_xz_check_none() {
    var comp = alloc(92);
    store8(comp + 0, 253); store8(comp + 1, 55); store8(comp + 2, 122); store8(comp + 3, 88);
    store8(comp + 4, 90); store8(comp + 5, 0); store8(comp + 6, 0); store8(comp + 7, 0);
    store8(comp + 8, 255); store8(comp + 9, 18); store8(comp + 10, 217); store8(comp + 11, 65);
    store8(comp + 12, 4); store8(comp + 13, 192); store8(comp + 14, 40); store8(comp + 15, 36);
    store8(comp + 16, 33); store8(comp + 17, 1); store8(comp + 18, 22); store8(comp + 19, 0);
    store8(comp + 20, 0); store8(comp + 21, 0); store8(comp + 22, 0); store8(comp + 23, 0);
    store8(comp + 24, 0); store8(comp + 25, 0); store8(comp + 26, 0); store8(comp + 27, 0);
    store8(comp + 28, 97); store8(comp + 29, 114); store8(comp + 30, 166); store8(comp + 31, 89);
    store8(comp + 32, 1); store8(comp + 33, 0); store8(comp + 34, 35); store8(comp + 35, 110);
    store8(comp + 36, 111); store8(comp + 37, 32); store8(comp + 38, 105); store8(comp + 39, 110);
    store8(comp + 40, 116); store8(comp + 41, 101); store8(comp + 42, 103); store8(comp + 43, 114);
    store8(comp + 44, 105); store8(comp + 45, 116); store8(comp + 46, 121); store8(comp + 47, 32);
    store8(comp + 48, 99); store8(comp + 49, 104); store8(comp + 50, 101); store8(comp + 51, 99);
    store8(comp + 52, 107); store8(comp + 53, 32); store8(comp + 54, 111); store8(comp + 55, 110);
    store8(comp + 56, 32); store8(comp + 57, 116); store8(comp + 58, 104); store8(comp + 59, 105);
    store8(comp + 60, 115); store8(comp + 61, 32); store8(comp + 62, 112); store8(comp + 63, 97);
    store8(comp + 64, 121); store8(comp + 65, 108); store8(comp + 66, 111); store8(comp + 67, 97);
    store8(comp + 68, 100); store8(comp + 69, 33); store8(comp + 70, 33); store8(comp + 71, 0);
    store8(comp + 72, 0); store8(comp + 73, 1); store8(comp + 74, 60); store8(comp + 75, 36);
    store8(comp + 76, 5); store8(comp + 77, 40); store8(comp + 78, 118); store8(comp + 79, 111);
    store8(comp + 80, 6); store8(comp + 81, 114); store8(comp + 82, 158); store8(comp + 83, 122);
    store8(comp + 84, 1); store8(comp + 85, 0); store8(comp + 86, 0); store8(comp + 87, 0);
    store8(comp + 88, 0); store8(comp + 89, 0); store8(comp + 90, 89); store8(comp + 91, 90);
    var out = alloc(36);
    var dlen = xz_decompress(comp, 92, out, 36);
    assert(dlen == 36, "xz_check_none dlen");
    var exp = alloc(36);
    store8(exp + 0, 110); store8(exp + 1, 111); store8(exp + 2, 32); store8(exp + 3, 105);
    store8(exp + 4, 110); store8(exp + 5, 116); store8(exp + 6, 101); store8(exp + 7, 103);
    store8(exp + 8, 114); store8(exp + 9, 105); store8(exp + 10, 116); store8(exp + 11, 121);
    store8(exp + 12, 32); store8(exp + 13, 99); store8(exp + 14, 104); store8(exp + 15, 101);
    store8(exp + 16, 99); store8(exp + 17, 107); store8(exp + 18, 32); store8(exp + 19, 111);
    store8(exp + 20, 110); store8(exp + 21, 32); store8(exp + 22, 116); store8(exp + 23, 104);
    store8(exp + 24, 105); store8(exp + 25, 115); store8(exp + 26, 32); store8(exp + 27, 112);
    store8(exp + 28, 97); store8(exp + 29, 121); store8(exp + 30, 108); store8(exp + 31, 111);
    store8(exp + 32, 97); store8(exp + 33, 100); store8(exp + 34, 33); store8(exp + 35, 33);
    var i = 0;
    while (i < 36) {
        assert(load8(out + i) == load8(exp + i), "xz_check_none byte");
        i = i + 1;
    }
    return 0;
}

# binary seq, crc64 (140 compressed -> 400 bytes)
fn test_xz_binary_crc64() {
    var comp = alloc(140);
    store8(comp + 0, 253); store8(comp + 1, 55); store8(comp + 2, 122); store8(comp + 3, 88);
    store8(comp + 4, 90); store8(comp + 5, 0); store8(comp + 6, 0); store8(comp + 7, 4);
    store8(comp + 8, 230); store8(comp + 9, 214); store8(comp + 10, 180); store8(comp + 11, 70);
    store8(comp + 12, 4); store8(comp + 13, 192); store8(comp + 14, 76); store8(comp + 15, 144);
    store8(comp + 16, 3); store8(comp + 17, 33); store8(comp + 18, 1); store8(comp + 19, 22);
