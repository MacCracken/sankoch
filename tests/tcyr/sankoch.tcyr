# ================================================================
# 2.2.1 — defensive alloc() failure handling (INFO-01 closeout).
# Each `*_enc_init` entry point now checks every alloc's return and
# releases `_sankoch_mtx` before propagating 0 to the caller. The
# fault-injection harness (`_sankoch_alloc_set_fail_at(n)`) makes
# the Nth subsequent alloc return 0 once. Tests warm up the lazy
# globals first, then inject failure at a known offset.
# ================================================================

# Warm up lazy globals shared across all encoder paths so the
# subsequent fault-injection counters target only the per-call
# allocs. Idempotent; safe to call multiple times.
fn _alloc_fail_warmup() {
    var dst = alloc(256);
    var c = deflate_enc_init(6, dst, 256);
    deflate_enc_finish(c);
    c = zlib_enc_init(6, dst, 256);
    zlib_enc_finish(c);
    c = gzip_enc_init(6, dst, 256);
    gzip_enc_finish(c);
    c = lz4f_enc_init(dst, 256);
    lz4f_enc_finish(c);
    return 0;
}

# 2.3.7: lazy-global OOM sweep. `_sankoch_reset_tables()` zeroes every
# lazy table pointer so the injected fault hits a first-call lazy-init
# (not a per-call ctx alloc). For each fault offset the public API must
# return a clean result — never crash, and never deadlock: a path that
# OOMs without releasing the mutex would HANG the next iteration's lock,
# so completing the sweep is itself the no-deadlock proof.
fn _oom_compress_path(fmt, level, limit) {
    var src = alloc(256);
    var i = 0;
    while (i < 256) { store8(src + i, 65 + (i % 26)); i = i + 1; }
    var dst = alloc(2048);
    var n = 0;
    while (n < limit) {
        _sankoch_reset_tables();
        _sankoch_alloc_set_fail_at(n);
        var r = compress_level(fmt, src, 256, dst, 2048, level);
        _sankoch_alloc_set_fail_at(0 - 1);   # clear any unspent fault
        # Valid length (>0) or clean negative error — never 0 for a
        # 256-byte input (0 would be a silent mis-handled failure).
        assert(r != 0, "oom compress sweep: clean result");
        n = n + 1;
    }
    return 0;
}

fn test_oom_compress_sweep() {
    # DEFLATE L6 is the deepest path: lz77 + huffman tables + len/dist
    # lookups + dynamic workspace + hcl_ws + dh_ws. L1 hits the fixed
    # path. GZIP adds the CRC-32 table; LZ4 the match hash table.
    _oom_compress_path(FORMAT_DEFLATE, 6, 36);
    _oom_compress_path(FORMAT_DEFLATE, 1, 20);
    _oom_compress_path(FORMAT_GZIP, 6, 36);
    _oom_compress_path(FORMAT_LZ4, 6, 8);
    # Recovery: fresh tables, no fault → normal compress works + decodes.
    _sankoch_reset_tables();
    var src = alloc(256);
    var i = 0;
    while (i < 256) { store8(src + i, 65 + (i % 26)); i = i + 1; }
    var dst = alloc(2048);
    var clen = compress_level(FORMAT_GZIP, src, 256, dst, 2048, 6);
    assert(clen > 0, "oom sweep recovers (compress)");
    var out = alloc(256);
    assert(gzip_decompress(dst, clen, out, 256) == 256, "oom sweep recovers (roundtrip)");
    return 0;
}

fn test_oom_decompress_sweep() {
    # Build valid streams (warm), then reset + sweep the fault across the
    # decode lazy-init sites (huffman tables, _ddec workspace, fixed
    # tables, br_init, CRC table for gzip).
    var src = alloc(256);
    var i = 0;
    while (i < 256) { store8(src + i, 65 + (i % 26)); i = i + 1; }
    var gz = alloc(2048);
    var gzlen = compress_level(FORMAT_GZIP, src, 256, gz, 2048, 6);
    assert(gzlen > 0, "oom dec sweep: build gzip");
    var df = alloc(2048);
    var dflen = compress_level(FORMAT_DEFLATE, src, 256, df, 2048, 6);
    assert(dflen > 0, "oom dec sweep: build deflate");

    var out = alloc(256);
    var n = 0;
    while (n < 30) {
        _sankoch_reset_tables();
        _sankoch_alloc_set_fail_at(n);
        var r = decompress(FORMAT_GZIP, gz, gzlen, out, 256);
        _sankoch_alloc_set_fail_at(0 - 1);
        assert(r != 0, "oom gzip decompress sweep: clean result");
        n = n + 1;
    }
    n = 0;
    while (n < 30) {
        _sankoch_reset_tables();
        _sankoch_alloc_set_fail_at(n);
        var r2 = decompress(FORMAT_DEFLATE, df, dflen, out, 256);
        _sankoch_alloc_set_fail_at(0 - 1);
        assert(r2 != 0, "oom deflate decompress sweep: clean result");
        n = n + 1;
    }
    # Recovery.
    _sankoch_reset_tables();
    assert(decompress(FORMAT_GZIP, gz, gzlen, out, 256) == 256, "oom sweep recovers (decompress)");
    return 0;
}

fn test_alloc_fail_deflate_ctx() {
    _alloc_fail_warmup();
    var dst = alloc(256);
    # Fail at alloc #0 — the DENC_CTX_SIZE alloc inside deflate_enc_init_dict.
    _sankoch_alloc_set_fail_at(0);
    var ctx = deflate_enc_init(6, dst, 256);
    assert(ctx == 0, "deflate enc_init returns 0 when ctx alloc fails");
    # Lock must be released — a fresh init succeeds.
    var ctx2 = deflate_enc_init(6, dst, 256);
    assert(ctx2 != 0, "deflate enc_init succeeds after prior alloc fail (lock released)");
    deflate_enc_finish(ctx2);
    return 0;
}

fn test_alloc_fail_deflate_window() {
    _alloc_fail_warmup();
    var dst = alloc(256);
    # Fail at alloc #1 — the DENC_WINDOW_CAP alloc.
    _sankoch_alloc_set_fail_at(1);
    var ctx = deflate_enc_init(6, dst, 256);
    assert(ctx == 0, "deflate enc_init returns 0 when window alloc fails");
    var ctx2 = deflate_enc_init(6, dst, 256);
    assert(ctx2 != 0, "deflate enc_init succeeds after window-fail (lock released)");
    deflate_enc_finish(ctx2);
    return 0;
}

fn test_alloc_fail_deflate_bw() {
    _alloc_fail_warmup();
    var dst = alloc(256);
    # Fail at alloc #2 — bw_init's internal alloc(40).
    _sankoch_alloc_set_fail_at(2);
    var ctx = deflate_enc_init(6, dst, 256);
    assert(ctx == 0, "deflate enc_init returns 0 when bw_init alloc fails");
    var ctx2 = deflate_enc_init(6, dst, 256);
    assert(ctx2 != 0, "deflate enc_init succeeds after bw-fail (lock released)");
    deflate_enc_finish(ctx2);
    return 0;
}

fn test_alloc_fail_zlib_ctx() {
    _alloc_fail_warmup();
    var dst = alloc(256);
    # zlib_enc_init's first alloc that's its own (not deflate_enc_init_dict's
    # 3) is at offset 3 — the 32-byte zlib ctx. By this point deflate
    # has already taken the lock and succeeded; zlib's own alloc fail
    # must release the lock that deflate took.
    _sankoch_alloc_set_fail_at(3);
    var ctx = zlib_enc_init(6, dst, 256);
    assert(ctx == 0, "zlib enc_init returns 0 when zlib ctx alloc fails");
    var ctx2 = zlib_enc_init(6, dst, 256);
    assert(ctx2 != 0, "zlib enc_init succeeds after zlib-ctx-fail (lock released)");
    zlib_enc_finish(ctx2);
    return 0;
}

fn test_alloc_fail_zlib_adler() {
    _alloc_fail_warmup();
    var dst = alloc(256);
    # Offset 4 — zlib's adler32_init (after deflate's 3 + zlib's ctx).
    _sankoch_alloc_set_fail_at(4);
    var ctx = zlib_enc_init(6, dst, 256);
    assert(ctx == 0, "zlib enc_init returns 0 when adler32_init alloc fails");
    var ctx2 = zlib_enc_init(6, dst, 256);
    assert(ctx2 != 0, "zlib enc_init succeeds after adler-fail (lock released)");
    zlib_enc_finish(ctx2);
    return 0;
}

fn test_alloc_fail_gzip_ctx() {
    _alloc_fail_warmup();
    var dst = alloc(256);
    # Same offset structure as zlib — deflate's 3 first, then gzip's ctx at 3.
    _sankoch_alloc_set_fail_at(3);
    var ctx = gzip_enc_init(6, dst, 256);
    assert(ctx == 0, "gzip enc_init returns 0 when gzip ctx alloc fails");
    var ctx2 = gzip_enc_init(6, dst, 256);
    assert(ctx2 != 0, "gzip enc_init succeeds after gzip-ctx-fail (lock released)");
    gzip_enc_finish(ctx2);
    return 0;
}

