fn test_zdec_bad_fcheck() {
    # Hand-crafted: CMF=0x78, FLG=0x02 → (0x78*256 + 0x02) % 31 = 1, not 0.
    var src = alloc(8);
    store8(src + 0, 120); store8(src + 1, 2);  # bad FCHECK
    var dst = alloc(8);
    var ctx = zlib_dec_init(dst, 8);
    assert(ctx != 0, "bad FCHECK init");
    var rc = zlib_dec_write(ctx, src, 2);
    var fin = zlib_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad FCHECK rejected");
    return 0;
}

fn test_zdec_fdict_rejected() {
    # Use zlib_enc_init_dict to produce a FDICT-bearing stream; the
    # bite-4 streaming decoder rejects FDICT with -ERR_UNSUPPORTED_FORMAT.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var dict = alloc(3);
    store8(dict + 0, 97); store8(dict + 1, 98); store8(dict + 2, 99);
    var c = alloc(64);
    var enc = zlib_enc_init_dict(6, c, 64, dict, 3);
    assert(enc != 0, "FDICT compress init");
    assert(zlib_enc_write(enc, src, 5) >= 0, "FDICT compress write");
    var clen = zlib_enc_finish(enc);
    assert(clen > 0, "FDICT compress finish");

    var d = alloc(16);
    var ctx = zlib_dec_init(d, 16);
    assert(ctx != 0, "FDICT decode init");
    var rc = zlib_dec_write(ctx, c, clen);
    var fin = zlib_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "FDICT rejected");
    return 0;
}

fn test_zdec_bad_trailer() {
    # Compress, then corrupt the final 4 bytes (Adler-32 trailer).
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = zlib_compress_level(src, 5, c, 64, 6);
    assert(clen > 5, "bad trailer compress");
    store8(c + clen - 1, load8(c + clen - 1) ^ 1);

    var d = alloc(16);
    var ctx = zlib_dec_init(d, 16);
    assert(ctx != 0, "bad trailer init");
    var rc = zlib_dec_write(ctx, c, clen);
    var fin = zlib_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad Adler-32 rejected");
    return 0;
}

fn test_gdec_short_roundtrip() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = gzip_compress_level(src, 5, c, 64, 6);
    assert(clen > 0, "gdec short compress");

    var d = alloc(16);
    var ctx = gzip_dec_init(d, 16);
    assert(ctx != 0, "gdec short init");
    var rc = gzip_dec_write(ctx, c, clen);
    assert(rc >= 0, "gdec short write");
    var n = gzip_dec_finish(ctx);
    assert(n == 5, "gdec short len");
    var i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "gdec short content");
        i = i + 1;
    }
    return 0;
}

fn test_gdec_byte_at_a_time() {
    var src = alloc(20);
    var k = 0;
    while (k < 20) {
        store8(src + k, 97 + (k % 10));
        k = k + 1;
    }
    var c = alloc(64);
    var clen = gzip_compress_level(src, 20, c, 64, 6);
    assert(clen > 0, "gdec BAAT compress");

    var d = alloc(32);
    var ctx = gzip_dec_init(d, 32);
    assert(ctx != 0, "gdec BAAT init");
    var i = 0;
    while (i < clen) {
        assert(gzip_dec_write(ctx, c + i, 1) >= 0, "gdec BAAT write");
        i = i + 1;
    }
    var n = gzip_dec_finish(ctx);
    assert(n == 20, "gdec BAAT len");
    i = 0;
    while (i < 20) {
        assert(load8(d + i) == load8(src + i), "gdec BAAT content");
        i = i + 1;
    }
    return 0;
}

fn test_gdec_1kb_chunked() {
    var src = alloc(1024);
    var k = 0;
    while (k < 1024) {
        store8(src + k, 65 + (k % 26));
        k = k + 1;
    }
    var c = alloc(2048);
    var clen = gzip_compress_level(src, 1024, c, 2048, 6);
    assert(clen > 0, "gdec 1kb compress");

    var d = alloc(1024);
    var ctx = gzip_dec_init(d, 1024);
    assert(ctx != 0, "gdec 1kb init");
    var off = 0;
    while (off < clen) {
        var step = 16;
        if (off + step > clen) { step = clen - off; }
        assert(gzip_dec_write(ctx, c + off, step) >= 0, "gdec 1kb chunk");
        off = off + step;
    }
    var n = gzip_dec_finish(ctx);
    assert(n == 1024, "gdec 1kb len");
    var i = 0;
    while (i < 1024) {
        assert(load8(d + i) == load8(src + i), "gdec 1kb content");
        i = i + 1;
    }
    return 0;
}

fn test_gdec_bad_magic() {
    var src = alloc(2);
    store8(src + 0, 30);   # not 0x1F
    store8(src + 1, 139);
    var dst = alloc(8);
    var ctx = gzip_dec_init(dst, 8);
    assert(ctx != 0, "bad magic init");
    var rc = gzip_dec_write(ctx, src, 2);
    var fin = gzip_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad magic rejected");
    return 0;
}

fn test_gdec_reserved_flg() {
    # LOW-02 (2.1.3): FLG reserved bits 5-7 must be zero.
    var src = alloc(4);
    store8(src + 0, 31); store8(src + 1, 139); store8(src + 2, 8);
    store8(src + 3, 32);  # FLG = 0x20 — reserved bit 5 set
    var dst = alloc(8);
    var ctx = gzip_dec_init(dst, 8);
    assert(ctx != 0, "reserved FLG init");
    var rc = gzip_dec_write(ctx, src, 4);
    var fin = gzip_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "gdec reserved FLG rejected");
    return 0;
}

fn test_gdec_bad_crc_trailer() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = gzip_compress_level(src, 5, c, 64, 6);
    assert(clen > 8, "bad CRC compress");
    # Trailer is the last 8 bytes; corrupt the CRC-32 (bytes [clen-8..clen-4]).
    store8(c + clen - 8, load8(c + clen - 8) ^ 1);

    var d = alloc(16);
    var ctx = gzip_dec_init(d, 16);
    assert(ctx != 0, "bad CRC init");
    var rc = gzip_dec_write(ctx, c, clen);
    var fin = gzip_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad CRC rejected");
    return 0;
}

fn test_gdec_bad_isize() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = gzip_compress_level(src, 5, c, 64, 6);
    assert(clen > 8, "bad ISIZE compress");
    # ISIZE is bytes [clen-4..clen]; corrupt one of them.
    store8(c + clen - 1, load8(c + clen - 1) ^ 1);

    var d = alloc(16);
    var ctx = gzip_dec_init(d, 16);
    assert(ctx != 0, "bad ISIZE init");
    var rc = gzip_dec_write(ctx, c, clen);
    var fin = gzip_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad ISIZE rejected");
    return 0;
}

fn test_gdec_fname_field() {
    # Hand-craft a gzip stream with FNAME set: header byte 3 = FLG=8
    # (FNAME bit), then "myfile\0" before the deflate payload. Splice
    # against a normal gzip_compress payload for the deflate + trailer.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var base = alloc(64);
    var baselen = gzip_compress_level(src, 5, base, 64, 6);
    assert(baselen > 18, "fname base compress");

    # Build modified stream: copy 10-byte header (with FLG=8), insert
    # "name\0" (5 bytes), then copy the deflate + trailer from baselen-8 onward.
    var c = alloc(96);
    var i = 0;
    while (i < 10) { store8(c + i, load8(base + i)); i = i + 1; }
    store8(c + 3, 8);                              # FLG = FNAME
    store8(c + 10, 110); store8(c + 11, 97); store8(c + 12, 109);
    store8(c + 13, 101); store8(c + 14, 0);        # "name\0"
    var deflate_off = 10;
    var deflate_len = baselen - 10;
    var j = 0;
    while (j < deflate_len) {
        store8(c + 15 + j, load8(base + deflate_off + j));
        j = j + 1;
    }
    var clen = 15 + deflate_len;

    var d = alloc(16);
    var ctx = gzip_dec_init(d, 16);
    assert(ctx != 0, "fname decode init");
    var rc = gzip_dec_write(ctx, c, clen);
    assert(rc >= 0, "fname decode write");
    var n = gzip_dec_finish(ctx);
    assert(n == 5, "fname decode len");
    i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "fname decode content");
        i = i + 1;
    }
    return 0;
}

fn test_gdec_fhcrc_field() {
    # 2.3.5: gzip stream with FHCRC set (FLG=2). FHCRC = low 16 bits of
    # crc32 over the 10-byte header (RFC 1952 — not CRC-16-IBM). Splice
    # the deflate + trailer from a gzip_compress base. Both batch and
    # streaming must validate it, and reject a corrupted FHCRC byte.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var base = alloc(64);
    var baselen = gzip_compress_level(src, 5, base, 64, 6);
    assert(baselen > 18, "fhcrc base compress");

    var c = alloc(96);
    var i = 0;
    while (i < 10) { store8(c + i, load8(base + i)); i = i + 1; }
    store8(c + 3, 2);                      # FLG = FHCRC
    crc32_init_table();
    var hc = crc32(c, 10) & 65535;
    store8(c + 10, hc & 255);
    store8(c + 11, (hc >> 8) & 255);
    var deflate_len = baselen - 10;
    var j = 0;
    while (j < deflate_len) {
        store8(c + 12 + j, load8(base + 10 + j));
        j = j + 1;
    }
    var clen = 12 + deflate_len;

    # Batch decode.
    var db = alloc(16);
    assert(gzip_decompress(c, clen, db, 16) == 5, "fhcrc batch len");
    i = 0;
    while (i < 5) { assert(load8(db + i) == load8(src + i), "fhcrc batch content"); i = i + 1; }

    # Streaming decode.
    var d = alloc(16);
    var ctx = gzip_dec_init(d, 16);
    assert(ctx != 0, "fhcrc decode init");
    assert(gzip_dec_write(ctx, c, clen) >= 0, "fhcrc decode write");
    assert(gzip_dec_finish(ctx) == 5, "fhcrc decode len");
    i = 0;
    while (i < 5) { assert(load8(d + i) == load8(src + i), "fhcrc decode content"); i = i + 1; }

    # Corrupt the FHCRC low byte — both paths must reject.
    store8(c + 10, load8(c + 10) ^ 1);
    var db2 = alloc(16);
    assert(gzip_decompress(c, clen, db2, 16) < 0, "fhcrc batch rejects corruption");
    var d2 = alloc(16);
    var ctx2 = gzip_dec_init(d2, 16);
    var rc2 = gzip_dec_write(ctx2, c, clen);
    var fin2 = gzip_dec_finish(ctx2);
    assert(rc2 < 0 || fin2 < 0, "fhcrc stream rejects corruption");
    return 0;
}

fn test_gdec_concatenated_members() {
    # 2.3.5: two gzip members concatenated. The streaming decoder must
    # decode both (resetting the inner DEFLATE at the boundary) and
    # produce the concatenation — matching batch gzip_decompress.
    var p1 = alloc(5);   # "Hello"
    store8(p1 + 0, 72); store8(p1 + 1, 101); store8(p1 + 2, 108);
    store8(p1 + 3, 108); store8(p1 + 4, 111);
    var p2 = alloc(6);   # "World!"
    store8(p2 + 0, 87); store8(p2 + 1, 111); store8(p2 + 2, 114);
    store8(p2 + 3, 108); store8(p2 + 4, 100); store8(p2 + 5, 33);

    var m1 = alloc(64);
    var m1len = gzip_compress_level(p1, 5, m1, 64, 6);
    var m2 = alloc(64);
    var m2len = gzip_compress_level(p2, 6, m2, 64, 6);
    assert(m1len > 0, "concat m1 compress");
    assert(m2len > 0, "concat m2 compress");

    var c = alloc(160);
    var i = 0;
    while (i < m1len) { store8(c + i, load8(m1 + i)); i = i + 1; }
    var j = 0;
    while (j < m2len) { store8(c + m1len + j, load8(m2 + j)); j = j + 1; }
    var clen = m1len + m2len;

    # Batch cross-check (already supports concatenation).
    var db = alloc(16);
    assert(gzip_decompress(c, clen, db, 16) == 11, "concat batch len");

    # Streaming decode (whole input).
    var d = alloc(16);
    var ctx = gzip_dec_init(d, 16);
    assert(ctx != 0, "concat init");
    assert(gzip_dec_write(ctx, c, clen) >= 0, "concat write");
    assert(gzip_dec_finish(ctx) == 11, "concat len");
    i = 0;
    while (i < 5) { assert(load8(d + i) == load8(p1 + i), "concat content m1"); i = i + 1; }
    i = 0;
    while (i < 6) { assert(load8(d + 5 + i) == load8(p2 + i), "concat content m2"); i = i + 1; }

    # Streaming byte-at-a-time — exercises the member boundary across chunks.
    var d2 = alloc(16);
    var ctx2 = gzip_dec_init(d2, 16);
    assert(ctx2 != 0, "concat baat init");
    var k = 0;
    while (k < clen) {
        assert(gzip_dec_write(ctx2, c + k, 1) >= 0, "concat baat write");
        k = k + 1;
    }
    assert(gzip_dec_finish(ctx2) == 11, "concat baat len");
    i = 0;
    while (i < 11) { assert(load8(d2 + i) == load8(d + i), "concat baat content"); i = i + 1; }

    # Corrupt member 2's trailer CRC — the streaming decoder must reject.
    store8(c + m1len + m2len - 5, load8(c + m1len + m2len - 5) ^ 1);
    var d3 = alloc(16);
    var ctx3 = gzip_dec_init(d3, 16);
    var rc3 = gzip_dec_write(ctx3, c, clen);
    var fin3 = gzip_dec_finish(ctx3);
    assert(rc3 < 0 || fin3 < 0, "concat rejects corrupt 2nd member");
    return 0;
}

# ================================================================
# 2.3.0 bite-5: streaming LZ4F decoder
# ================================================================

fn test_ldec_short_roundtrip() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = lz4f_compress(src, 5, c, 64);
    assert(clen > 0, "ldec short compress");

    var d = alloc(16);
    var ctx = lz4f_dec_init(d, 16);
    assert(ctx != 0, "ldec short init");
    assert(lz4f_dec_write(ctx, c, clen) >= 0, "ldec short write");
    var n = lz4f_dec_finish(ctx);
    assert(n == 5, "ldec short len");
    var i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "ldec short content");
        i = i + 1;
    }
    return 0;
}

fn test_ldec_byte_at_a_time() {
    var src = alloc(20);
    var k = 0;
    while (k < 20) {
        store8(src + k, 97 + (k % 10));
        k = k + 1;
    }
    var c = alloc(64);
    var clen = lz4f_compress(src, 20, c, 64);
    assert(clen > 0, "ldec BAAT compress");

    var d = alloc(32);
    var ctx = lz4f_dec_init(d, 32);
    assert(ctx != 0, "ldec BAAT init");
    var i = 0;
    while (i < clen) {
        assert(lz4f_dec_write(ctx, c + i, 1) >= 0, "ldec BAAT write");
        i = i + 1;
    }
    var n = lz4f_dec_finish(ctx);
    assert(n == 20, "ldec BAAT len");
    i = 0;
    while (i < 20) {
        assert(load8(d + i) == load8(src + i), "ldec BAAT content");
        i = i + 1;
    }
    return 0;
}

fn test_ldec_64kb_single_block() {
    # Exactly LZ4F_BLOCK_MAX bytes — exercises the block-boundary
    # transition (block fully buffered, next block follows).
    var src = alloc(65536);
    var k = 0;
    while (k < 65536) {
        store8(src + k, 65 + (k % 26));
        k = k + 1;
    }
    var c = alloc(131072);
    var clen = lz4f_compress(src, 65536, c, 131072);
    assert(clen > 0, "ldec 64K compress");

    var d = alloc(65536);
    var ctx = lz4f_dec_init(d, 65536);
    assert(ctx != 0, "ldec 64K init");
    assert(lz4f_dec_write(ctx, c, clen) >= 0, "ldec 64K write");
    var n = lz4f_dec_finish(ctx);
    assert(n == 65536, "ldec 64K len");
    var i = 0;
    while (i < 65536) {
        assert(load8(d + i) == load8(src + i), "ldec 64K content");
        i = i + 1;
    }
    return 0;
}

fn test_ldec_128kb_multi_block() {
    # 128 KB input → 2 blocks per the encoder's 64KB chunking. Tests
    # the back-to-back BLOCK_SIZE → BLOCK_DATA → BLOCK_SIZE transitions.
    var src = alloc(131072);
    var k = 0;
    while (k < 131072) {
        store8(src + k, 65 + (k % 26));
        k = k + 1;
    }
    var c = alloc(262144);
    var clen = lz4f_compress(src, 131072, c, 262144);
    assert(clen > 0, "ldec 128K compress");

    var d = alloc(131072);
    var ctx = lz4f_dec_init(d, 131072);
    assert(ctx != 0, "ldec 128K init");
    var off = 0;
    while (off < clen) {
        var step = 256;
        if (off + step > clen) { step = clen - off; }
        assert(lz4f_dec_write(ctx, c + off, step) >= 0, "ldec 128K chunk");
        off = off + step;
    }
    var n = lz4f_dec_finish(ctx);
    assert(n == 131072, "ldec 128K len");
    var i = 0;
    while (i < 131072) {
        assert(load8(d + i) == load8(src + i), "ldec 128K content");
        i = i + 1;
    }
    return 0;
}

fn test_ldec_uncompressed_block_roundtrip() {
    # 128 KB of high-entropy bytes — encoder emits uncompressed blocks
    # (lz4f's per-chunk fallback when the compressed size would exceed
    # the raw input). Tests the BLOCK_DATA uncompressed path.
    var src = alloc(131072);
    var seed = 0x9E3779B1;
    var k = 0;
    while (k < 131072) {
        seed = (seed * 1664525 + 1013904223) & 4294967295;
        store8(src + k, seed & 255);
        k = k + 1;
    }
    var c = alloc(262144);
    var clen = lz4f_compress(src, 131072, c, 262144);
    assert(clen > 0, "ldec uncomp compress");

    var d = alloc(131072);
    var ctx = lz4f_dec_init(d, 131072);
    assert(ctx != 0, "ldec uncomp init");
    assert(lz4f_dec_write(ctx, c, clen) >= 0, "ldec uncomp write");
    var n = lz4f_dec_finish(ctx);
    assert(n == 131072, "ldec uncomp len");
    var i = 0;
    while (i < 131072) {
        assert(load8(d + i) == load8(src + i), "ldec uncomp content");
        i = i + 1;
    }
    return 0;
}

fn test_ldec_bad_magic() {
    var src = alloc(4);
    store8(src + 0, 5); store8(src + 1, 34); store8(src + 2, 77); store8(src + 3, 24);
    var dst = alloc(8);
    var ctx = lz4f_dec_init(dst, 8);
    assert(ctx != 0, "ldec bad magic init");
    var rc = lz4f_dec_write(ctx, src, 4);
    var fin = lz4f_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "ldec bad magic rejected");
    return 0;
}

fn test_ldec_bad_version() {
    # Magic + FLG with version field = 0 (must be 1). Build a stream
    # with FLG bits 6-7 = 00 → byte 0x04.
    var src = alloc(5);
    store8(src + 0, 4); store8(src + 1, 34); store8(src + 2, 77); store8(src + 3, 24);
    store8(src + 4, 4);   # FLG: version=0
    var dst = alloc(8);
    var ctx = lz4f_dec_init(dst, 8);
    assert(ctx != 0, "ldec bad version init");
    var rc = lz4f_dec_write(ctx, src, 5);
    var fin = lz4f_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "ldec bad version rejected");
    return 0;
}

fn test_ldec_bd_invalid_rejected() {
    # BD = 0x00 → block-max-ID = 0, which is reserved/invalid per the
    # LZ4 frame spec (only 4..7 are legal). 2.3.3 accepts 4..7 but must
    # still reject < 4.
    var src = alloc(6);
    store8(src + 0, 4); store8(src + 1, 34); store8(src + 2, 77); store8(src + 3, 24);
    store8(src + 4, 100);   # FLG = sankoch-style (version=1, content cksum on)
    store8(src + 5, 0);     # BD = 0x00 → block-max-ID 0, invalid
    var dst = alloc(8);
    var ctx = lz4f_dec_init(dst, 8);
    assert(ctx != 0, "ldec BD invalid init");
    var rc = lz4f_dec_write(ctx, src, 6);
    var fin = lz4f_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "ldec BD < 4 rejected");
    return 0;
}

# 2.3.3 — round-trip a frame at a configured block-max ID through both
# the streaming decoder and the batch decoder. block_max_id ∈ {5,6,7}
# exercises the decoder's grown block buffer (>64K). Returns 0.
fn _lz4f_bm_rt(block_max_id, n) {
    var src = alloc(n);
    var k = 0;
    while (k < n) {
        store8(src + k, 65 + (k % 26));   # compressible repeating pattern
        k = k + 1;
    }
    var c = alloc(n + 65536);
    var ec = lz4f_enc_init_ex(c, n + 65536, block_max_id, 0);
    assert(ec != 0, "bm rt enc init");
    assert(lz4f_enc_write(ec, src, n) >= 0, "bm rt enc write");
    var clen = lz4f_enc_finish(ec);
    assert(clen > 0, "bm rt enc finish");

    # Streaming decode.
    var d = alloc(n);
    var ctx = lz4f_dec_init(d, n);
    assert(ctx != 0, "bm rt dec init");
    assert(lz4f_dec_write(ctx, c, clen) >= 0, "bm rt dec write");
    var sn = lz4f_dec_finish(ctx);
    assert(sn == n, "bm rt stream len");
    var i = 0;
    while (i < n) {
        assert(load8(d + i) == load8(src + i), "bm rt stream content");
        i = i + 1;
    }

    # Batch decode.
    var d2 = alloc(n);
    var bn = lz4f_decompress(c, clen, d2, n);
    assert(bn == n, "bm rt batch len");
    i = 0;
    while (i < n) {
        assert(load8(d2 + i) == load8(src + i), "bm rt batch content");
        i = i + 1;
    }
    return 0;
}

fn test_lz4f_blockmax_256k_single() {
    # 100K input in a 256K-max frame → one block > 64K (grown buffer).
    return _lz4f_bm_rt(5, 100000);
}

fn test_lz4f_blockmax_256k_multi() {
    # 300K input in a 256K-max frame → 256K block + 44K block.
    return _lz4f_bm_rt(5, 300000);
}

fn test_lz4f_blockmax_1m() {
    # 1M-max frame, single 200K block (exercises the 1M buffer alloc).
    return _lz4f_bm_rt(6, 200000);
}

fn test_lz4f_blockmax_4m() {
    # 4M-max frame, single 200K block (exercises the 4M buffer alloc).
    return _lz4f_bm_rt(7, 200000);
}

# 2.3.3 — per-block checksum round-trip + corruption rejection. Encodes
# with FLG bit 4 set; both decoders must validate the per-block xxHash32
# and reject a flipped block-data byte. Returns 0.
fn _lz4f_bc_rt(block_max_id, n) {
    var src = alloc(n);
    var k = 0;
    while (k < n) {
        store8(src + k, 65 + (k % 26));
        k = k + 1;
    }
    var cap = n + 65536;
    var c = alloc(cap);
    var ec = lz4f_enc_init_ex(c, cap, block_max_id, 1);   # block_checksum = 1
    assert(ec != 0, "bc rt enc init");
    assert(lz4f_enc_write(ec, src, n) >= 0, "bc rt enc write");
    var clen = lz4f_enc_finish(ec);
    assert(clen > 0, "bc rt enc finish");

    # Streaming decode — block checksum validated before emit.
    var d = alloc(n);
    var ctx = lz4f_dec_init(d, n);
    assert(ctx != 0, "bc rt dec init");
    assert(lz4f_dec_write(ctx, c, clen) >= 0, "bc rt dec write");
    var sn = lz4f_dec_finish(ctx);
    assert(sn == n, "bc rt stream len");
    var i = 0;
    while (i < n) {
        assert(load8(d + i) == load8(src + i), "bc rt stream content");
        i = i + 1;
    }

    # Batch decode — per-block checksum validated.
    var d2 = alloc(n);
    var bn = lz4f_decompress(c, clen, d2, n);
    assert(bn == n, "bc rt batch len");
    i = 0;
    while (i < n) {
        assert(load8(d2 + i) == load8(src + i), "bc rt batch content");
        i = i + 1;
    }

    # Corrupt a block-data byte (past the 7-byte header + 4-byte size).
    # Both decoders must reject via per-block checksum mismatch.
    store8(c + 15, load8(c + 15) ^ 1);
    var d3 = alloc(n);
    var ctx2 = lz4f_dec_init(d3, n);
    assert(ctx2 != 0, "bc rt corrupt init");
    var rc = lz4f_dec_write(ctx2, c, clen);
    var fin = lz4f_dec_finish(ctx2);
    assert(rc < 0 || fin < 0, "bc rt stream rejects corruption");
    assert(lz4f_decompress(c, clen, d3, n) < 0, "bc rt batch rejects corruption");
    return 0;
}

fn test_lz4f_blockcksum_64k() {
    # Default 64K block-max with per-block checksum (multi-block).
    return _lz4f_bc_rt(4, 150000);
}

fn test_lz4f_blockcksum_256k() {
    # 256K block-max with per-block checksum (multi-block).
    return _lz4f_bc_rt(5, 300000);
}

fn test_ldec_bad_content_checksum() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = lz4f_compress(src, 5, c, 64);
    assert(clen > 4, "ldec bad cc compress");
    # Trailer (last 4 bytes) is the content checksum; flip a bit.
    store8(c + clen - 1, load8(c + clen - 1) ^ 1);

    var d = alloc(16);
    var ctx = lz4f_dec_init(d, 16);
    assert(ctx != 0, "ldec bad cc init");
    var rc = lz4f_dec_write(ctx, c, clen);
    var fin = lz4f_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "ldec bad content checksum rejected");
    return 0;
}

# ================================================================
# 2.3.0 bite-6: stream.cyr incremental decompress dispatch
# ================================================================

fn _bite6_compress_hello(format, dst, dst_cap): i64 {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    if (format == FORMAT_DEFLATE) { return deflate_compress(src, 5, dst, dst_cap); }
    if (format == FORMAT_ZLIB)    { return zlib_compress(src, 5, dst, dst_cap); }
    if (format == FORMAT_GZIP)    { return gzip_compress(src, 5, dst, dst_cap); }
    if (format == FORMAT_LZ4F)    { return lz4f_compress(src, 5, dst, dst_cap); }
    return 0 - ERR_UNSUPPORTED_FORMAT;
}

fn test_stream_dec_inc_deflate() {
    var c = alloc(64);
    var clen = _bite6_compress_hello(FORMAT_DEFLATE, c, 64);
    assert(clen > 0, "sdi deflate compress");

    var d = alloc(16);
    var ctx = stream_decompress_init_inc(FORMAT_DEFLATE, d, 16);
    assert(ctx != 0, "sdi deflate init");
    assert(stream_write(ctx, c, clen) >= 0, "sdi deflate write");
    var n = stream_decompress_finish_inc(ctx);
    assert(n == 5, "sdi deflate len");
    assert(load8(d + 0) == 72 && load8(d + 4) == 111, "sdi deflate content");
    return 0;
}

fn test_stream_dec_inc_zlib() {
    var c = alloc(64);
    var clen = _bite6_compress_hello(FORMAT_ZLIB, c, 64);
    assert(clen > 0, "sdi zlib compress");

    var d = alloc(16);
    var ctx = stream_decompress_init_inc(FORMAT_ZLIB, d, 16);
    assert(ctx != 0, "sdi zlib init");
    assert(stream_write(ctx, c, clen) >= 0, "sdi zlib write");
    var n = stream_decompress_finish_inc(ctx);
    assert(n == 5, "sdi zlib len");
    return 0;
}

fn test_stream_dec_inc_gzip() {
    var c = alloc(64);
    var clen = _bite6_compress_hello(FORMAT_GZIP, c, 64);
    assert(clen > 0, "sdi gzip compress");

    var d = alloc(16);
    var ctx = stream_decompress_init_inc(FORMAT_GZIP, d, 16);
    assert(ctx != 0, "sdi gzip init");
    assert(stream_write(ctx, c, clen) >= 0, "sdi gzip write");
    var n = stream_decompress_finish_inc(ctx);
    assert(n == 5, "sdi gzip len");
    return 0;
}

fn test_stream_dec_inc_lz4f() {
    var c = alloc(64);
    var clen = _bite6_compress_hello(FORMAT_LZ4F, c, 64);
    assert(clen > 0, "sdi lz4f compress");

    var d = alloc(16);
    var ctx = stream_decompress_init_inc(FORMAT_LZ4F, d, 16);
    assert(ctx != 0, "sdi lz4f init");
    assert(stream_write(ctx, c, clen) >= 0, "sdi lz4f write");
    var n = stream_decompress_finish_inc(ctx);
    assert(n == 5, "sdi lz4f len");
    return 0;
}

fn test_stream_dec_inc_byte_at_a_time() {
    # 20-byte gzip stream fed one byte per stream_write call to drive
    # the inner gzip_dec_* state machine across every transition.
    var src = alloc(20);
    var k = 0;
    while (k < 20) {
        store8(src + k, 97 + (k % 10));
        k = k + 1;
    }
    var c = alloc(64);
    var clen = gzip_compress(src, 20, c, 64);
    assert(clen > 0, "sdi BAAT compress");

    var d = alloc(32);
    var ctx = stream_decompress_init_inc(FORMAT_GZIP, d, 32);
    assert(ctx != 0, "sdi BAAT init");
    var i = 0;
    while (i < clen) {
        assert(stream_write(ctx, c + i, 1) >= 0, "sdi BAAT write");
        i = i + 1;
    }
    var n = stream_decompress_finish_inc(ctx);
    assert(n == 20, "sdi BAAT len");
    i = 0;
    while (i < 20) {
        assert(load8(d + i) == load8(src + i), "sdi BAAT content");
        i = i + 1;
    }
    return 0;
}

fn test_stream_dec_inc_raw_lz4_rejected() {
    # FORMAT_LZ4 (raw block) has no streaming decoder; init must
    # return 0 instead of trying to route to one.
    var d = alloc(16);
    var ctx = stream_decompress_init_inc(FORMAT_LZ4, d, 16);
    assert(ctx == 0, "sdi LZ4 raw rejected");
    return 0;
}

fn test_stream_dec_inc_mode_mismatch() {
    # Finish-function dispatch must reject ctxs in the wrong mode.
    # 1. Legacy finish on an INC ctx → error.
    var d = alloc(16);
    var ictx = stream_decompress_init_inc(FORMAT_GZIP, d, 16);
    assert(ictx != 0, "mode mismatch INC init");
    assert(stream_decompress_finish(ictx, d, 16) == 0 - ERR_INVALID_INPUT,
    "legacy finish on INC ctx");
    # Drain the inner so the lock is released cleanly.
    stream_decompress_finish_inc(ictx);

    # 2. INC finish on a legacy ctx → error.
    var lctx = stream_decompress_init(FORMAT_GZIP);
    assert(stream_decompress_finish_inc(lctx) == 0 - ERR_INVALID_INPUT,
    "INC finish on legacy ctx");

    # 3. INC finish on a compress ctx → error.
    var c = alloc(64);
    var cctx = stream_compress_init(FORMAT_GZIP, 6, c, 64);
    assert(stream_decompress_finish_inc(cctx) == 0 - ERR_INVALID_INPUT,
    "INC finish on compress ctx");
    stream_compress_finish(cctx);
    return 0;
}

