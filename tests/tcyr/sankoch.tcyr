# sankoch — full test suite
# Covers: checksums, LZ4, DEFLATE, zlib, gzip, format detection,
# compression levels, dynamic Huffman, streaming, error paths.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Checksum tests
# ================================================================

fn test_adler32_empty() {
    var buf = alloc(1);
    assert(adler32(buf, 0) == 1, "adler32 empty = 1");
    return 0;
}

fn test_adler32_hello() {
    var buf = alloc(5);
    store8(buf + 0, 72); store8(buf + 1, 101); store8(buf + 2, 108);
    store8(buf + 3, 108); store8(buf + 4, 111);
    # Round-trip validates checksum internally; verify non-zero here
    var result = adler32(buf, 5);
    assert(result > 0, "adler32 Hello non-zero");
    return 0;
}

fn test_adler32_single_byte() {
    var buf = alloc(1);
    store8(buf, 0);
    assert(adler32(buf, 1) == 65537, "adler32 single zero byte");
    store8(buf, 255);
    assert(adler32(buf, 1) == 16777472, "adler32 single 0xFF byte");
    return 0;
}

fn test_adler32_large() {
    # Test NMAX boundary crossing — 6000 bytes
    var buf = alloc(6000);
    var i = 0;
    while (i < 6000) { store8(buf + i, 65); i = i + 1; }
    var result = adler32(buf, 6000);
    assert(result > 0, "adler32 large must be positive");
    # Verify consistency: two calls return same value
    var result2 = adler32(buf, 6000);
    assert(result == result2, "adler32 large deterministic");
    return 0;
}

fn test_crc32_empty() {
    crc32_init_table();
    var buf = alloc(1);
    assert(crc32(buf, 0) == 0, "crc32 empty = 0");
    return 0;
}

fn test_crc32_known() {
    crc32_init_table();
    var buf = alloc(9);
    store8(buf + 0, 49); store8(buf + 1, 50); store8(buf + 2, 51);
    store8(buf + 3, 52); store8(buf + 4, 53); store8(buf + 5, 54);
    store8(buf + 6, 55); store8(buf + 7, 56); store8(buf + 8, 57);
    assert(crc32(buf, 9) == 3421780262, "crc32 '123456789'");
    return 0;
}

# ================================================================
# LZ4 tests
# ================================================================

fn test_lz4_roundtrip_empty() {
    var src = alloc(1);
    var c = alloc(64);
    var d = alloc(64);
    var clen = lz4_compress(src, 0, c, 64);
    assert(clen >= 0, "lz4 compress empty");
    var dlen = lz4_decompress(c, clen, d, 64);
    assert(dlen == 0, "lz4 decompress empty");
    return 0;
}

fn test_lz4_roundtrip_1byte() {
    var src = alloc(1);
    store8(src, 42);
    var c = alloc(64);
    var d = alloc(64);
    var clen = lz4_compress(src, 1, c, 64);
    assert(clen > 0, "lz4 compress 1 byte");
    var dlen = lz4_decompress(c, clen, d, 64);
    assert(dlen == 1, "lz4 roundtrip 1 byte size");
    assert(load8(d) == 42, "lz4 roundtrip 1 byte value");
    return 0;
}

fn test_lz4_roundtrip_small() {
    var src = alloc(16);
    var i = 0;
    while (i < 16) { store8(src + i, i + 65); i = i + 1; }
    var c = alloc(64);
    var d = alloc(64);
    var clen = lz4_compress(src, 16, c, 64);
    assert(clen > 0, "lz4 compress 16 bytes");
    var dlen = lz4_decompress(c, clen, d, 64);
    assert(dlen == 16, "lz4 roundtrip 16 bytes size");
    i = 0;
    while (i < 16) {
        assert(load8(d + i) == load8(src + i), "lz4 roundtrip 16 content");
        i = i + 1;
    }
    return 0;
}

fn test_lz4_roundtrip_repetitive() {
    var src = alloc(256);
    var i = 0;
    while (i < 256) { store8(src + i, i % 4); i = i + 1; }
    var c = alloc(512);
    var d = alloc(512);
    var clen = lz4_compress(src, 256, c, 512);
    assert(clen > 0, "lz4 compress repetitive succeeds");
    var dlen = lz4_decompress(c, clen, d, 512);
    assert(dlen == 256, "lz4 roundtrip repetitive size");
    i = 0;
    while (i < 256) { assert(load8(d + i) == load8(src + i), "lz4 rep content"); i = i + 1; }
    return 0;
}

fn test_lz4_roundtrip_all_same() {
    var src = alloc(128);
    var i = 0;
    while (i < 128) { store8(src + i, 42); i = i + 1; }
    var c = alloc(256);
    var d = alloc(256);
    var clen = lz4_compress(src, 128, c, 256);
    assert(clen > 0, "lz4 compress all-same succeeds");
    var dlen = lz4_decompress(c, clen, d, 256);
    assert(dlen == 128, "lz4 all-same size");
    i = 0;
    while (i < 128) { assert(load8(d + i) == 42, "lz4 all-same content"); i = i + 1; }
    return 0;
}

fn test_lz4_roundtrip_random() {
    var src = alloc(512);
    var state = 12345;
    var i = 0;
    while (i < 512) {
        state = state * 6364136223846793005 + 1;
        store8(src + i, (state >> 33) & 255);
        i = i + 1;
    }
    var c = alloc(1024);
    var d = alloc(512);
    var clen = lz4_compress(src, 512, c, 1024);
    assert(clen > 0, "lz4 compress random data");
    var dlen = lz4_decompress(c, clen, d, 512);
    assert(dlen == 512, "lz4 roundtrip random size");
    i = 0;
    while (i < 512) { assert(load8(d + i) == load8(src + i), "lz4 random content"); i = i + 1; }
    return 0;
}

fn test_lz4_roundtrip_1kb() {
    var src = alloc(1024);
    var i = 0;
    while (i < 1024) { store8(src + i, 65 + (i % 26)); i = i + 1; }
    var c = alloc(2048);
    var d = alloc(1024);
    var clen = lz4_compress(src, 1024, c, 2048);
    assert(clen > 0, "lz4 compress 1KB");
    var dlen = lz4_decompress(c, clen, d, 1024);
    assert(dlen == 1024, "lz4 roundtrip 1KB size");
    i = 0;
    while (i < 1024) { assert(load8(d + i) == load8(src + i), "lz4 1KB content"); i = i + 1; }
    return 0;
}

fn test_lz4_buffer_too_small() {
    var src = alloc(16);
    var i = 0;
    while (i < 16) { store8(src + i, 42); i = i + 1; }
    var c = alloc(64);
    var clen = lz4_compress(src, 16, c, 64);
    assert(clen > 0, "lz4 compress for buf test");
    var tiny = alloc(4);
    assert(lz4_decompress(c, clen, tiny, 4) < 0, "lz4 decompress tiny buf should fail");
    return 0;
}

# ================================================================
# xxHash32 known-vector tests — verify against reference (xxh32sum)
# Required for LZ4 Frame content-checksum compatibility.
# ================================================================

# Fill buf with the ASCII bytes of s (up to len); caller supplies bytes.
fn _put_str(buf, s, len) {
    var i = 0;
    while (i < len) { store8(buf + i, load8(s + i)); i = i + 1; }
    return 0;
}

fn test_xxhash32_known_vectors() {
    var buf = alloc(64);

    # Empty — 0x02CC5D05 (short path, no tail)
    assert(xxhash32(buf, 0) == 46947589, "xxh32 empty");

    # "a" (1 byte) — 0x550D7456 (short path, byte tail only)
    store8(buf, 97);
    assert(xxhash32(buf, 1) == 1426945110, "xxh32 'a'");

    # "abc" (3 bytes) — 0x32D153FF (short path, byte tail only)
    store8(buf, 97); store8(buf + 1, 98); store8(buf + 2, 99);
    assert(xxhash32(buf, 3) == 852579327, "xxh32 'abc'");

    # "abcd" (4 bytes) — 0xA3643705 (exercises 4-byte tail — catches PRIME2/PRIME4 bug)
    store8(buf, 97); store8(buf + 1, 98); store8(buf + 2, 99); store8(buf + 3, 100);
    assert(xxhash32(buf, 4) == 2741253893, "xxh32 'abcd'");

    # "abcdefg" (7 bytes) — 0x9DD093B3 (4-byte tail once + byte tail)
    var j = 0;
    while (j < 7) { store8(buf + j, 97 + j); j = j + 1; }
    assert(xxhash32(buf, 7) == 2647692211, "xxh32 'abcdefg'");

    # "abcdefghijklmno" (15 bytes) — 0xB918A375 (short path, 4-byte tail x3 + byte tail x3)
    j = 0;
    while (j < 15) { store8(buf + j, 97 + j); j = j + 1; }
    assert(xxhash32(buf, 15) == 3105399669, "xxh32 'abcdef…mno'");

    # 16 zero bytes — 0x8E022B3A (first stripe-path case: exactly one 16-byte stripe)
    j = 0;
    while (j < 16) { store8(buf + j, 0); j = j + 1; }
    assert(xxhash32(buf, 16) == 2382506810, "xxh32 16×0x00");

    # "Nobody inspects the spammish repetition" (39 bytes) — 0xE2293B2F
    # Exercises: 2 full stripes (32 bytes) + 4-byte tail (4 bytes) + byte tail (3 bytes)
    var s[40];
    store8(&s+0,78); store8(&s+1,111); store8(&s+2,98); store8(&s+3,111);
    store8(&s+4,100); store8(&s+5,121); store8(&s+6,32); store8(&s+7,105);
    store8(&s+8,110); store8(&s+9,115); store8(&s+10,112); store8(&s+11,101);
    store8(&s+12,99); store8(&s+13,116); store8(&s+14,115); store8(&s+15,32);
    store8(&s+16,116); store8(&s+17,104); store8(&s+18,101); store8(&s+19,32);
    store8(&s+20,115); store8(&s+21,112); store8(&s+22,97); store8(&s+23,109);
    store8(&s+24,109); store8(&s+25,105); store8(&s+26,115); store8(&s+27,104);
    store8(&s+28,32); store8(&s+29,114); store8(&s+30,101); store8(&s+31,112);
    store8(&s+32,101); store8(&s+33,116); store8(&s+34,105); store8(&s+35,116);
    store8(&s+36,105); store8(&s+37,111); store8(&s+38,110);
    assert(xxhash32(&s, 39) == 3794352943, "xxh32 'Nobody inspects…'");

    j = 0;
    while (j < 64) { store8(buf + j, 0); j = j + 1; }
    assert(xxhash32(buf, 64) == 1446152080, "xxh32 64×0x00");

    return 0;
}

fn test_adler32_incremental() {
    # Byte-at-a-time and varied-chunk updates must match batch adler32.
    var buf = alloc(150);
    var j = 0;
    while (j < 150) { store8(buf + j, (j * 19 + 7) % 256); j = j + 1; }

    # Empty
    var st = adler32_init();
    assert(adler32_final(st) == adler32(buf, 0), "adler32 inc empty");

    # 1..65 bytes, byte-at-a-time — crosses NMAX is not relevant here, but
    # spans both small and medium sizes for robustness.
    j = 0;
    while (j <= 65) {
        st = adler32_init();
        var k = 0;
        while (k < j) { adler32_update(st, buf + k, 1); k = k + 1; }
        assert(adler32_final(st) == adler32(buf, j), "adler32 inc byte-at-a-time");
        j = j + 1;
    }

    # Varied chunks totaling 150
    st = adler32_init();
    adler32_update(st, buf, 7);
    adler32_update(st, buf + 7, 53);
    adler32_update(st, buf + 60, 90);
    assert(adler32_final(st) == adler32(buf, 150), "adler32 inc varied");
    return 0;
}

fn test_crc32_incremental() {
    crc32_init_table();
    var buf = alloc(150);
    var j = 0;
    while (j < 150) { store8(buf + j, (j * 37 + 11) % 256); j = j + 1; }

    var st = crc32_init();
    assert(crc32_final(st) == crc32(buf, 0), "crc32 inc empty");

    j = 0;
    while (j <= 40) {
        st = crc32_init();
        var k = 0;
        while (k < j) { crc32_update(st, buf + k, 1); k = k + 1; }
        assert(crc32_final(st) == crc32(buf, j), "crc32 inc byte-at-a-time");
        j = j + 1;
    }

    st = crc32_init();
    crc32_update(st, buf, 7);
    crc32_update(st, buf + 7, 8);     # just past the 8-byte unroll boundary
    crc32_update(st, buf + 15, 135);
    assert(crc32_final(st) == crc32(buf, 150), "crc32 inc varied");
    return 0;
}

fn test_xxhash32_incremental() {
    # Streaming xxhash32 must match batch for every input size, regardless
    # of how the bytes are fed in. Boundary cases around 16-byte stripe.
    var buf = alloc(200);
    var j = 0;
    while (j < 200) { store8(buf + j, (j * 37 + 11) % 256); j = j + 1; }

    # 1. Total all at once (update with full len)
    var st = xxhash32_init();
    xxhash32_update(st, buf, 67);
    assert(xxhash32_final(st) == xxhash32(buf, 67), "xxh32 inc one-shot 67B");

    # 2. Byte-at-a-time for sizes spanning the stripe boundary.
    j = 0;
    while (j <= 40) {
        st = xxhash32_init();
        var k = 0;
        while (k < j) { xxhash32_update(st, buf + k, 1); k = k + 1; }
        assert(xxhash32_final(st) == xxhash32(buf, j), "xxh32 inc byte-at-a-time");
        j = j + 1;
    }

    # 3. Varied chunk sizes totaling 150B (multiple stripes + tail).
    st = xxhash32_init();
    xxhash32_update(st, buf + 0, 5);       # short of stripe
    xxhash32_update(st, buf + 5, 12);      # fills + part of second stripe
    xxhash32_update(st, buf + 17, 16);     # exactly one stripe
    xxhash32_update(st, buf + 33, 100);    # multiple stripes
    xxhash32_update(st, buf + 133, 17);    # stripe + tail
    assert(xxhash32_final(st) == xxhash32(buf, 150), "xxh32 inc varied chunks");

    return 0;
}

# ================================================================
# LZ4 frame format tests
# ================================================================

fn test_deflate_enc_smoke() {
    # Level 6 dynamic path — write 5 bytes, decompress, verify.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var ctx = deflate_enc_init(6, c, 64);
    assert(ctx != 0, "enc_init returns ctx");
    assert(deflate_enc_write(ctx, src, 5) == 0, "enc_write 5B");
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "enc_finish returns length");

    var d = alloc(64);
    var dlen = deflate_decompress(c, clen, d, 64);
    assert(dlen == 5, "enc rt dlen");
    assert(load8(d + 0) == 72 && load8(d + 1) == 101 && load8(d + 2) == 108
    && load8(d + 3) == 108 && load8(d + 4) == 111, "enc rt content");
    return 0;
}

fn test_deflate_enc_chunked() {
    # Same 5 bytes but in 5 separate enc_write calls (byte-at-a-time).
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var ctx = deflate_enc_init(6, c, 64);
    assert(ctx != 0, "enc_chunked init");
    var i = 0;
    while (i < 5) {
        assert(deflate_enc_write(ctx, src + i, 1) == 0, "enc_write 1B");
        i = i + 1;
    }
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "enc_chunked finish");

    var d = alloc(64);
    var dlen = deflate_decompress(c, clen, d, 64);
    assert(dlen == 5, "enc_chunked dlen");
    i = 0;
    while (i < 5) { assert(load8(d + i) == load8(src + i), "enc_chunked content"); i = i + 1; }
    return 0;
}

fn test_deflate_enc_empty() {
    # Zero bytes → enc_init + enc_finish must emit a valid empty stream.
    var c = alloc(16);
    var ctx = deflate_enc_init(6, c, 16);
    assert(ctx != 0, "enc_empty init");
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "enc_empty finish");

    var d = alloc(16);
    assert(deflate_decompress(c, clen, d, 16) == 0, "enc_empty decompress empty");
    return 0;
}

fn test_deflate_enc_slide() {
    # 100K input — crosses the 64K window boundary, exercises slide+rebase.
    var N = 100000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 65 + (j % 17)); j = j + 1; }
    var c = alloc(N + 4096);
    var ctx = deflate_enc_init(6, c, N + 4096);
    assert(ctx != 0, "enc_slide init");
    # Feed in 4 KB chunks to force multiple consumes + at least one slide.
    var fed = 0;
    while (fed < N) {
        var take = N - fed;
        if (take > 4096) { take = 4096; }
        assert(deflate_enc_write(ctx, src + fed, take) == 0, "enc_slide write chunk");
        fed = fed + take;
    }
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "enc_slide finish");

    var d = alloc(N);
    var dlen = deflate_decompress(c, clen, d, N);
    assert(dlen == N, "enc_slide rt dlen");
    j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), "enc_slide rt content"); j = j + 1; }
    return 0;
}

fn test_deflate_enc_fixed() {
    # Level 1 (fixed path) — verify the BFINAL=0 block + BFINAL=1 stored trailer works.
    var src = alloc(120);
    var j = 0;
    while (j < 120) { store8(src + j, 65 + (j % 3)); j = j + 1; }
    var c = alloc(256);
    var ctx = deflate_enc_init(1, c, 256);
    assert(ctx != 0, "enc_fixed init");
    assert(deflate_enc_write(ctx, src, 120) == 0, "enc_fixed write");
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "enc_fixed finish");

    var d = alloc(128);
    var dlen = deflate_decompress(c, clen, d, 128);
    assert(dlen == 120, "enc_fixed rt dlen");
    j = 0;
    while (j < 120) { assert(load8(d + j) == load8(src + j), "enc_fixed rt content"); j = j + 1; }
    return 0;
}

# Shared helper: compress `src[0..N)` via enc API in chunks of `chunk_sz`,
# decompress, and assert every byte round-trips. `label` tags asserts.
fn _enc_rt(src, N, level, chunk_sz, c, c_cap, d, d_cap, label) {
    var ctx = deflate_enc_init(level, c, c_cap);
    assert(ctx != 0, label);
    var fed = 0;
    while (fed < N) {
        var take = N - fed;
        if (take > chunk_sz) { take = chunk_sz; }
        assert(deflate_enc_write(ctx, src + fed, take) == 0, label);
        fed = fed + take;
    }
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, label);
    var dlen = deflate_decompress(c, clen, d, d_cap);
    assert(dlen == N, label);
    var j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), label); j = j + 1; }
    return clen;
}

fn test_deflate_enc_levels() {
    # Same 10KB text at each level — all must round-trip, and compressed
    # size should not *grow* relative to the batch API for the same level.
    var N = 10000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 65 + (j % 26)); j = j + 1; }
    var c = alloc(N + 1024);
    var d = alloc(N);
    _enc_rt(src, N, 1, N, c, N + 1024, d, N, "enc_levels L1");
    _enc_rt(src, N, 3, N, c, N + 1024, d, N, "enc_levels L3");
    _enc_rt(src, N, 6, N, c, N + 1024, d, N, "enc_levels L6");
    _enc_rt(src, N, 9, N, c, N + 1024, d, N, "enc_levels L9");
    return 0;
}

fn test_deflate_enc_window_boundary() {
    # Exactly 65536 bytes — one full window, no slide needed.
    # Then 65537 bytes — one byte past, forces the slide path.
    var N = 65537;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 65 + (j % 23)); j = j + 1; }
    var c = alloc(N + 2048);
    var d = alloc(N);
    _enc_rt(src, 65536, 6, 8192, c, N + 2048, d, N, "enc 65536B");
    _enc_rt(src, 65537, 6, 8192, c, N + 2048, d, N, "enc 65537B");
    return 0;
}

fn test_deflate_enc_varied_chunks() {
    # 80K text — feed in wildly varied chunk sizes to stress write-boundary
    # interactions with LZ77 lookahead reserve + sub-block flush.
    var N = 80000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 32 + (j * 37 + j / 11) % 95); j = j + 1; }
    var c = alloc(N + 4096);
    var d = alloc(N);
    # Chunk sizes: 1, 258 (= LOOKAHEAD), 259, 1000, 4096, rest
    var chunks[6];
    store64(&chunks + 0 * 8, 1);
    store64(&chunks + 1 * 8, 258);
    store64(&chunks + 2 * 8, 259);
    store64(&chunks + 3 * 8, 1000);
    store64(&chunks + 4 * 8, 4096);
    store64(&chunks + 5 * 8, N);
    var ctx = deflate_enc_init(6, c, N + 4096);
    assert(ctx != 0, "varied_chunks init");
    var fed = 0;
    var ci = 0;
    while (fed < N) {
        var take = load64(&chunks + (ci % 6) * 8);
        if (take > N - fed) { take = N - fed; }
        assert(deflate_enc_write(ctx, src + fed, take) == 0, "varied_chunks write");
        fed = fed + take;
        ci = ci + 1;
    }
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "varied_chunks finish");
    var dlen = deflate_decompress(c, clen, d, N);
    assert(dlen == N, "varied_chunks dlen");
    j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), "varied_chunks content"); j = j + 1; }
    return 0;
}

fn test_zlib_enc_roundtrip() {
    # 80K text fed in varied chunks, decoded via zlib_decompress.
    var N = 80000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 32 + (j * 13 + j / 7) % 95); j = j + 1; }
    var c = alloc(N + 2048);
    var d = alloc(N);
    var ctx = zlib_enc_init(6, c, N + 2048);
    assert(ctx != 0, "zlib_enc init");
    # CMF=0x78, FLG=0x01 header bytes written up front
    assert(load8(c) == 120 && load8(c + 1) == 1, "zlib_enc header");
    var chunks[4];
    store64(&chunks + 0 * 8, 1);
    store64(&chunks + 1 * 8, 1024);
    store64(&chunks + 2 * 8, 4096);
    store64(&chunks + 3 * 8, N);
    var fed = 0;
    var ci = 0;
    while (fed < N) {
        var take = load64(&chunks + (ci % 4) * 8);
        if (take > N - fed) { take = N - fed; }
        assert(zlib_enc_write(ctx, src + fed, take) == 0, "zlib_enc write");
        fed = fed + take;
        ci = ci + 1;
    }
    var clen = zlib_enc_finish(ctx);
    assert(clen > 0, "zlib_enc finish");

    var dlen = zlib_decompress(c, clen, d, N);
    assert(dlen == N, "zlib_enc rt dlen");
    j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), "zlib_enc rt content"); j = j + 1; }
    return 0;
}

fn test_lz4f_enc_roundtrip() {
    var N = 80000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 32 + (j * 19 + j / 3) % 95); j = j + 1; }
    var c = alloc(N + 4096);
    var d = alloc(N);
    var ctx = lz4f_enc_init(c, N + 4096);
    assert(ctx != 0, "lz4f_enc init");
    # Magic 0x184D2204 little-endian = 04 22 4D 18
    assert(load8(c) == 4 && load8(c + 1) == 34 && load8(c + 2) == 77 && load8(c + 3) == 24,
    "lz4f_enc magic");
    var fed = 0;
    while (fed < N) {
        var take = 3000;
        if (take > N - fed) { take = N - fed; }
        assert(lz4f_enc_write(ctx, src + fed, take) == 0, "lz4f_enc write");
        fed = fed + take;
    }
    var clen = lz4f_enc_finish(ctx);
    assert(clen > 0, "lz4f_enc finish");

    var dlen = lz4f_decompress(c, clen, d, N);
    assert(dlen == N, "lz4f_enc rt dlen");
    j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), "lz4f_enc rt content"); j = j + 1; }
    return 0;
}

