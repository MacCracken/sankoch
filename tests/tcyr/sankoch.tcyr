fn test_compress_dispatch_lz4f() {
    # Batch compress(FORMAT_LZ4F, ...) — new dispatch added with 1.7.0.
    var src = alloc(64);
    var j = 0;
    while (j < 64) { store8(src + j, 65 + (j % 26)); j = j + 1; }
    var c = alloc(128);
    var d = alloc(128);
    var clen = compress(FORMAT_LZ4F, src, 64, c, 128);
    assert(clen > 0, "compress FORMAT_LZ4F");
    assert(decompress(FORMAT_LZ4F, c, clen, d, 128) == 64, "decompress FORMAT_LZ4F");
    j = 0;
    while (j < 64) { assert(load8(d + j) == load8(src + j), "lz4f dispatch content"); j = j + 1; }
    return 0;
}

fn test_enc_error_paths() {
    # Poisoned encoder: second enc_write after a dst-overflow error returns
    # the same sticky error, finish releases the lock and returns it too.
    # (Give a tiny dst that can't hold the output of a 20 KB input.)
    var src = alloc(20000);
    var j = 0;
    while (j < 20000) { store8(src + j, 32 + (j * 13) % 95); j = j + 1; }

    # Need enough for the frame header + bw_init bookkeeping; too small
    # for the compressed body. 128 bytes is comfortably under 20 KB output.
    var c = alloc(128);
    var ctx = deflate_enc_init(1, c, 128);   # level 1 fixed to force expansion
    assert(ctx != 0, "err_paths init");
    var rc1 = deflate_enc_write(ctx, src, 20000);
    assert(rc1 < 0, "err_paths first write overflows");
    # Poisoned: next write returns same error without corrupting further state
    var rc2 = deflate_enc_write(ctx, src, 100);
    assert(rc2 < 0 && rc2 == rc1, "err_paths sticky error");
    # Finish propagates the error and releases the mutex
    var fin = deflate_enc_finish(ctx);
    assert(fin < 0, "err_paths finish returns error");
    # Another compress after error must still work (mutex was released)
    var c2 = alloc(64);
    var d = alloc(64);
    var small[5];
    store8(&small, 65); store8(&small + 1, 66); store8(&small + 2, 67);
    store8(&small + 3, 68); store8(&small + 4, 69);
    var clen = deflate_compress(&small, 5, c2, 64);
    assert(clen > 0, "err_paths: can compress after error release");
    return 0;
}

fn test_enc_zero_write() {
    # stream_write / enc_write with len=0 must be a no-op and return 0.
    var c = alloc(128);
    var ctx = deflate_enc_init(6, c, 128);
    assert(ctx != 0, "zero_write init");
    var nothing = alloc(1);
    assert(deflate_enc_write(ctx, nothing, 0) == 0, "enc_write 0 bytes");
    # Write real data; finish; decompress.
    var src = alloc(5);
    store8(src, 72); store8(src + 1, 73); store8(src + 2, 73);
    store8(src + 3, 74); store8(src + 4, 75);
    assert(deflate_enc_write(ctx, src, 5) == 0, "zero_write real");
    var clen = deflate_enc_finish(ctx);
    var d = alloc(8);
    assert(deflate_decompress(c, clen, d, 8) == 5, "zero_write rt");
    return 0;
}

fn test_stream_mode_mismatch() {
    # Calling stream_compress_finish on a decompress ctx (or vice versa)
    # must return -ERR_INVALID_INPUT, not crash.
    var c = alloc(64);
    var dctx = stream_decompress_init(FORMAT_GZIP);
    assert(stream_compress_finish(dctx) == 0 - ERR_INVALID_INPUT, "compress_finish on dec ctx");

    var cctx = stream_compress_init(FORMAT_GZIP, 6, c, 64);
    var d = alloc(64);
    assert(stream_decompress_finish(cctx, d, 64) == 0 - ERR_INVALID_INPUT, "decompress_finish on enc ctx");
    # Still need to finish the enc ctx to release its mutex.
    stream_compress_finish(cctx);
    return 0;
}

fn test_stream_format_dispatch() {
    # stream_compress_init must dispatch correctly for every supported
    # format. Round-trip 12 bytes via each format's streaming path.
    var src = alloc(12);
    var i = 0;
    while (i < 12) { store8(src + i, 65 + i); i = i + 1; }
    var c = alloc(256);
    var d = alloc(64);

    # DEFLATE
    var ctx = stream_compress_init(FORMAT_DEFLATE, 6, c, 256);
    assert(ctx != 0, "stream dispatch DEFLATE");
    stream_write(ctx, src, 12);
    var clen = stream_compress_finish(ctx);
    assert(clen > 0, "stream DEFLATE finish");
    assert(deflate_decompress(c, clen, d, 64) == 12, "stream DEFLATE rt");

    # ZLIB
    ctx = stream_compress_init(FORMAT_ZLIB, 6, c, 256);
    assert(ctx != 0, "stream dispatch ZLIB");
    stream_write(ctx, src, 12);
    clen = stream_compress_finish(ctx);
    assert(clen > 0, "stream ZLIB finish");
    assert(zlib_decompress(c, clen, d, 64) == 12, "stream ZLIB rt");

    # GZIP
    ctx = stream_compress_init(FORMAT_GZIP, 6, c, 256);
    assert(ctx != 0, "stream dispatch GZIP");
    stream_write(ctx, src, 12);
    clen = stream_compress_finish(ctx);
    assert(clen > 0, "stream GZIP finish");
    assert(gzip_decompress(c, clen, d, 64) == 12, "stream GZIP rt");

    # LZ4F
    ctx = stream_compress_init(FORMAT_LZ4F, 6, c, 256);
    assert(ctx != 0, "stream dispatch LZ4F");
    stream_write(ctx, src, 12);
    clen = stream_compress_finish(ctx);
    assert(clen > 0, "stream LZ4F finish");
    assert(lz4f_decompress(c, clen, d, 64) == 12, "stream LZ4F rt");

    # FORMAT_LZ4 (raw block) — unsupported for streaming
    assert(stream_compress_init(FORMAT_LZ4, 6, c, 256) == 0, "stream LZ4 raw unsupported");
    return 0;
}

fn test_lz4f_enc_multiblock() {
    # 150 KB — crosses the 64 KB block boundary multiple times, tests
    # per-block emit + incremental content-checksum across blocks.
    var N = 150000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 65 + (j % 17)); j = j + 1; }
    var c = alloc(N + 4096);
    var d = alloc(N);
    var ctx = lz4f_enc_init(c, N + 4096);
    # Varied chunk sizes force cross-block buffer boundaries.
    var fed = 0;
    while (fed < N) {
        var take = 7777;
        if (take > N - fed) { take = N - fed; }
        assert(lz4f_enc_write(ctx, src + fed, take) == 0, "lz4f_enc mb write");
        fed = fed + take;
    }
    var clen = lz4f_enc_finish(ctx);
    assert(clen > 0, "lz4f_enc mb finish");
    var dlen = lz4f_decompress(c, clen, d, N);
    assert(dlen == N, "lz4f_enc mb rt dlen");
    j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), "lz4f_enc mb rt content"); j = j + 1; }
    return 0;
}

fn test_gzip_enc_roundtrip() {
    var N = 80000;
    var src = alloc(N);
    var j = 0;
    while (j < N) { store8(src + j, 32 + (j * 41 + j / 5) % 95); j = j + 1; }
    var c = alloc(N + 2048);
    var d = alloc(N);
    var ctx = gzip_enc_init(6, c, N + 2048);
    assert(ctx != 0, "gzip_enc init");
    # Magic bytes 0x1f 0x8b
    assert(load8(c) == 31 && load8(c + 1) == 139, "gzip_enc magic");
    var fed = 0;
    while (fed < N) {
        var take = 3000;
        if (take > N - fed) { take = N - fed; }
        assert(gzip_enc_write(ctx, src + fed, take) == 0, "gzip_enc write");
        fed = fed + take;
    }
    var clen = gzip_enc_finish(ctx);
    assert(clen > 0, "gzip_enc finish");

    var dlen = gzip_decompress(c, clen, d, N);
    assert(dlen == N, "gzip_enc rt dlen");
    j = 0;
    while (j < N) { assert(load8(d + j) == load8(src + j), "gzip_enc rt content"); j = j + 1; }
    return 0;
}

