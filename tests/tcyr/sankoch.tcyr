fn test_zlib_rt_hello() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var d = alloc(64);
    var clen = zlib_compress(src, 5, c, 128);
    assert(clen > 0, "zlib compress Hello");
    assert((load8(c) & 15) == 8, "zlib header CM=8");
    assert(((load8(c) * 256 + load8(c + 1)) % 31) == 0, "zlib header check");
    assert(zlib_decompress(c, clen, d, 64) == 5, "zlib rt Hello");
    assert(load8(d) == 72 && load8(d + 4) == 111, "zlib rt Hello content");
    return 0;
}

fn test_zlib_rt_via_api() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var d = alloc(64);
    var clen = compress(FORMAT_ZLIB, src, 5, c, 128);
    assert(clen > 0, "zlib api compress");
    assert(decompress(FORMAT_ZLIB, c, clen, d, 64) == 5, "zlib api decompress");
    return 0;
}

fn test_zlib_corrupt_checksum() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var clen = zlib_compress(src, 5, c, 128);
    assert(clen > 0, "zlib compress for corrupt test");
    store8(c + clen - 1, load8(c + clen - 1) ^ 1);
    var d = alloc(64);
    assert(zlib_decompress(c, clen, d, 64) < 0, "zlib corrupt checksum should fail");
    return 0;
}

fn test_zlib_fdict() {
    # zlib stream with FDICT=1, dictionary="The quick brown fox "
    # data="fox jumps over the lazy dog" (compressed without dict refs)
    var stream = alloc(39);
    store8(stream+0,120); store8(stream+1,187);
    store8(stream+2,76); store8(stream+3,98); store8(stream+4,7); store8(stream+5,52);
    store8(stream+6,75); store8(stream+7,203); store8(stream+8,175); store8(stream+9,80);
    store8(stream+10,200); store8(stream+11,42); store8(stream+12,205); store8(stream+13,45);
    store8(stream+14,40); store8(stream+15,86); store8(stream+16,200); store8(stream+17,47);
    store8(stream+18,75); store8(stream+19,45); store8(stream+20,82); store8(stream+21,40);
    store8(stream+22,201); store8(stream+23,72); store8(stream+24,85); store8(stream+25,200);
    store8(stream+26,73); store8(stream+27,172); store8(stream+28,170); store8(stream+29,84);
    store8(stream+30,72); store8(stream+31,201); store8(stream+32,79); store8(stream+33,7);
    store8(stream+34,0); store8(stream+35,142); store8(stream+36,154); store8(stream+37,10);
    store8(stream+38,20);

    # Dictionary: "The quick brown fox " (20 bytes)
    var dict = alloc(20);
    store8(dict+0,84); store8(dict+1,104); store8(dict+2,101); store8(dict+3,32);
    store8(dict+4,113); store8(dict+5,117); store8(dict+6,105); store8(dict+7,99);
    store8(dict+8,107); store8(dict+9,32); store8(dict+10,98); store8(dict+11,114);
    store8(dict+12,111); store8(dict+13,119); store8(dict+14,110); store8(dict+15,32);
    store8(dict+16,102); store8(dict+17,111); store8(dict+18,120); store8(dict+19,32);

    var d = alloc(64);
    # Without dict should fail (FDICT requires dictionary)
    assert(zlib_decompress(stream, 39, d, 64) < 0, "zlib fdict without dict rejects");

    # With correct dict should succeed
    var dlen = zlib_decompress_dict(stream, 39, d, 64, dict, 20);
    assert(dlen == 27, "zlib fdict decompress size");
    # "fox" = 102 111 120
    assert(load8(d) == 102 && load8(d+1) == 111 && load8(d+2) == 120, "zlib fdict content");

    # With wrong dict should fail (Adler-32 mismatch)
    store8(dict, 0);
    assert(zlib_decompress_dict(stream, 39, d, 64, dict, 20) < 0, "zlib fdict wrong dict rejects");
    return 0;
}

# ================================================================
# gzip wrapper tests
# ================================================================

fn test_gzip_rt_hello() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var d = alloc(64);
    var clen = gzip_compress(src, 5, c, 128);
    assert(clen > 0, "gzip compress Hello");
    assert(load8(c) == 31 && load8(c + 1) == 139 && load8(c + 2) == 8, "gzip header");
    assert(gzip_decompress(c, clen, d, 64) == 5, "gzip rt Hello");
    assert(load8(d) == 72 && load8(d + 4) == 111, "gzip rt Hello content");
    return 0;
}

fn test_gzip_rt_via_api() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var d = alloc(64);
    var clen = compress(FORMAT_GZIP, src, 5, c, 128);
    assert(clen > 0, "gzip api compress");
    assert(decompress(FORMAT_GZIP, c, clen, d, 64) == 5, "gzip api decompress");
    return 0;
}

fn test_gzip_corrupt_crc() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var clen = gzip_compress(src, 5, c, 128);
    store8(c + clen - 5, load8(c + clen - 5) ^ 1);
    var d = alloc(64);
    assert(gzip_decompress(c, clen, d, 64) < 0, "gzip corrupt CRC should fail");
    return 0;
}

fn test_gzip_truncated() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(128);
    var clen = gzip_compress(src, 5, c, 128);
    var d = alloc(64);
    assert(gzip_decompress(c, 10, d, 64) < 0, "gzip truncated should fail");
    return 0;
}

fn test_gzip_concat() {
    # Compress two separate payloads, concatenate, decompress as one stream
    var s1 = alloc(5);
    store8(s1+0,72); store8(s1+1,101); store8(s1+2,108);
    store8(s1+3,108); store8(s1+4,111);
    var s2 = alloc(5);
    store8(s2+0,87); store8(s2+1,111); store8(s2+2,114);
    store8(s2+3,108); store8(s2+4,100);
    var c1 = alloc(128);
    var c2 = alloc(128);
    var clen1 = gzip_compress(s1, 5, c1, 128);
    var clen2 = gzip_compress(s2, 5, c2, 128);
    assert(clen1 > 0 && clen2 > 0, "gzip concat compress");
    # Concatenate into one buffer
    var cat = alloc(256);
    var i = 0;
    while (i < clen1) { store8(cat + i, load8(c1 + i)); i = i + 1; }
    i = 0;
    while (i < clen2) { store8(cat + clen1 + i, load8(c2 + i)); i = i + 1; }
    var d = alloc(64);
    var dlen = gzip_decompress(cat, clen1 + clen2, d, 64);
    assert(dlen == 10, "gzip concat total size");
    assert(load8(d) == 72 && load8(d + 4) == 111, "gzip concat part 1");
    assert(load8(d + 5) == 87 && load8(d + 9) == 100, "gzip concat part 2");
    return 0;
}

# ================================================================
# Format auto-detection round-trip
# ================================================================

fn test_format_detect_roundtrip() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var zc = alloc(128);
    var gc = alloc(128);
    var zlen = zlib_compress(src, 5, zc, 128);
    var glen = gzip_compress(src, 5, gc, 128);
    assert(detect_format(zc, zlen) == FORMAT_ZLIB, "detect zlib output");
    assert(detect_format(gc, glen) == FORMAT_GZIP, "detect gzip output");
    return 0;
}

# ================================================================
# Compression levels
# ================================================================

fn test_levels_deflate() {
    var src = alloc(256);
    var i = 0;
    while (i < 256) { store8(src + i, 65 + (i % 10)); i = i + 1; }
    var c1 = alloc(512);
    var c9 = alloc(512);
    var d = alloc(256);
    var len1 = compress_level(FORMAT_DEFLATE, src, 256, c1, 512, 1);
    var len9 = compress_level(FORMAT_DEFLATE, src, 256, c9, 512, 9);
    assert(len1 > 0 && len9 > 0, "both levels compress");
    assert(decompress(FORMAT_DEFLATE, c1, len1, d, 256) == 256, "level 1 rt");
    i = 0;
    while (i < 256) { assert(load8(d + i) == load8(src + i), "level 1 content"); i = i + 1; }
    assert(decompress(FORMAT_DEFLATE, c9, len9, d, 256) == 256, "level 9 rt");
    i = 0;
    while (i < 256) { assert(load8(d + i) == load8(src + i), "level 9 content"); i = i + 1; }
    return 0;
}

fn test_levels_zlib() {
    var src = alloc(120);
    var i = 0;
    while (i < 120) { store8(src + i, 65 + (i % 3)); i = i + 1; }
    var c = alloc(256);
    var d = alloc(256);
    var clen = compress_level(FORMAT_ZLIB, src, 120, c, 256, 9);
    assert(clen > 0, "zlib level 9");
    assert(decompress(FORMAT_ZLIB, c, clen, d, 256) == 120, "zlib level 9 rt");
    return 0;
}

# ================================================================
# Dynamic Huffman
# ================================================================

fn test_dynamic_huffman_rt() {
    var src = alloc(256);
    var i = 0;
    while (i < 256) { store8(src + i, 65 + (i % 10)); i = i + 1; }
    var c = alloc(512);
    var d = alloc(512);
    var clen = deflate_compress_level(src, 256, c, 512, 6);
    assert(clen > 0 && clen < 256, "dynamic huffman compresses");
    assert((load8(c) & 7) == 5, "BTYPE=10 dynamic block");
    assert(deflate_decompress(c, clen, d, 512) == 256, "dynamic huffman rt");
    i = 0;
    while (i < 256) { assert(load8(d + i) == load8(src + i), "dynamic content"); i = i + 1; }
    return 0;
}

fn test_dynamic_vs_fixed() {
    var src = alloc(512);
    var i = 0;
    while (i < 512) {
        if ((i % 10) == 0) { store8(src + i, 66 + (i % 5)); }
        else { store8(src + i, 65); }
        i = i + 1;
    }
    var cf = alloc(1024);
    var cd = alloc(1024);
    var d = alloc(512);
    var lf = deflate_compress_level(src, 512, cf, 1024, 1);
    var ld = deflate_compress_level(src, 512, cd, 1024, 6);
    assert(lf > 0 && ld > 0, "both fixed and dynamic compress");
    assert(deflate_decompress(cd, ld, d, 512) == 512, "dynamic decompress");
    i = 0;
    while (i < 512) { assert(load8(d + i) == load8(src + i), "dynamic vs fixed content"); i = i + 1; }
    return 0;
}

# ================================================================
# Streaming API
# ================================================================

fn test_stream_compress() {
    # "Hello, world" (12 bytes) split across two stream_write calls,
    # now using the incremental encoder dispatch via stream.cyr.
    var out = alloc(128);
    var ctx = stream_compress_init(FORMAT_ZLIB, 6, out, 128);
    var c1 = alloc(5);
    store8(c1 + 0, 72); store8(c1 + 1, 101); store8(c1 + 2, 108);
    store8(c1 + 3, 108); store8(c1 + 4, 111);
    var c2 = alloc(7);
    store8(c2 + 0, 44); store8(c2 + 1, 32); store8(c2 + 2, 119);
    store8(c2 + 3, 111); store8(c2 + 4, 114); store8(c2 + 5, 108); store8(c2 + 6, 100);
    stream_write(ctx, c1, 5);
    stream_write(ctx, c2, 7);
    var clen = stream_compress_finish(ctx);
    assert(clen > 0, "stream compress finish");
    var d = alloc(64);
    assert(decompress(FORMAT_ZLIB, out, clen, d, 64) == 12, "stream compress rt");
    assert(load8(d) == 72 && load8(d + 11) == 100, "stream compress content");
    return 0;
}

fn test_stream_decompress() {
    var src = alloc(12);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111); store8(src + 5, 44);
    store8(src + 6, 32); store8(src + 7, 119); store8(src + 8, 111);
    store8(src + 9, 114); store8(src + 10, 108); store8(src + 11, 100);
    var c = alloc(128);
    var clen = gzip_compress(src, 12, c, 128);
    var ctx = stream_decompress_init(FORMAT_GZIP);
    var half = clen / 2;
    stream_write(ctx, c, half);
    stream_write(ctx, c + half, clen - half);
    var d = alloc(64);
    assert(stream_decompress_finish(ctx, d, 64) == 12, "stream decompress rt");
    assert(load8(d) == 72 && load8(d + 11) == 100, "stream decompress content");
    return 0;
}

fn test_stream_reset() {
    # stream_reset is meaningful only on decompress contexts now
    # (compressors can't be rewound — output has already been emitted).
    # Verify reset empties the decompress input buffer.
    var src = alloc(8);
    var i = 0;
    while (i < 8) { store8(src + i, i + 65); i = i + 1; }
    var c = alloc(64);
    var clen = gzip_compress(src, 8, c, 64);

    var ctx = stream_decompress_init(FORMAT_GZIP);
    stream_write(ctx, c, clen);
    assert(stream_buffered(ctx) == clen, "dec buffered before reset");
    stream_reset(ctx);
    assert(stream_buffered(ctx) == 0, "dec buffered after reset");

    # After reset, we can reuse the context for a fresh stream.
    stream_write(ctx, c, clen);
    var d = alloc(64);
    assert(stream_decompress_finish(ctx, d, 64) == 8, "dec rt after reset");
    return 0;
}

