    var i = 0;
    while (i < 6200) {
        assert(load8(out + i) == load8(exp + i), "xz_multiblock byte");
        i = i + 1;
    }
    return 0;
}

# corruption rejection - flipped payload byte / truncation must error
fn test_xz_corruption() {
    var cbuf = alloc(116);
    store8(cbuf + 0, 253); store8(cbuf + 1, 55); store8(cbuf + 2, 122); store8(cbuf + 3, 88);
    store8(cbuf + 4, 90); store8(cbuf + 5, 0); store8(cbuf + 6, 0); store8(cbuf + 7, 4);
    store8(cbuf + 8, 230); store8(cbuf + 9, 214); store8(cbuf + 10, 180); store8(cbuf + 11, 70);
    store8(cbuf + 12, 4); store8(cbuf + 13, 192); store8(cbuf + 14, 55); store8(cbuf + 15, 51);
    store8(cbuf + 16, 33); store8(cbuf + 17, 1); store8(cbuf + 18, 22); store8(cbuf + 19, 0);
    store8(cbuf + 20, 0); store8(cbuf + 21, 0); store8(cbuf + 22, 0); store8(cbuf + 23, 0);
    store8(cbuf + 24, 0); store8(cbuf + 25, 0); store8(cbuf + 26, 0); store8(cbuf + 27, 0);
    store8(cbuf + 28, 121); store8(cbuf + 29, 90); store8(cbuf + 30, 244); store8(cbuf + 31, 160);
    store8(cbuf + 32, 1); store8(cbuf + 33, 0); store8(cbuf + 34, 50); store8(cbuf + 35, 99);
    store8(cbuf + 36, 111); store8(cbuf + 37, 114); store8(cbuf + 38, 114); store8(cbuf + 39, 117);
    store8(cbuf + 40, 112); store8(cbuf + 41, 116); store8(cbuf + 42, 105); store8(cbuf + 43, 111);
    store8(cbuf + 44, 110); store8(cbuf + 45, 32); store8(cbuf + 46, 114); store8(cbuf + 47, 101);
    store8(cbuf + 48, 106); store8(cbuf + 49, 101); store8(cbuf + 50, 99); store8(cbuf + 51, 116);
    store8(cbuf + 52, 105); store8(cbuf + 53, 111); store8(cbuf + 54, 110); store8(cbuf + 55, 32);
    store8(cbuf + 56, 116); store8(cbuf + 57, 101); store8(cbuf + 58, 115); store8(cbuf + 59, 116);
    store8(cbuf + 60, 32); store8(cbuf + 61, 112); store8(cbuf + 62, 97); store8(cbuf + 63, 121);
    store8(cbuf + 64, 108); store8(cbuf + 65, 111); store8(cbuf + 66, 97); store8(cbuf + 67, 100);
    store8(cbuf + 68, 32); store8(cbuf + 69, 97); store8(cbuf + 70, 98); store8(cbuf + 71, 99);
    store8(cbuf + 72, 100); store8(cbuf + 73, 101); store8(cbuf + 74, 102); store8(cbuf + 75, 103);
    store8(cbuf + 76, 32); store8(cbuf + 77, 49); store8(cbuf + 78, 50); store8(cbuf + 79, 51);
    store8(cbuf + 80, 52); store8(cbuf + 81, 53); store8(cbuf + 82, 54); store8(cbuf + 83, 55);
    store8(cbuf + 84, 56); store8(cbuf + 85, 57); store8(cbuf + 86, 0); store8(cbuf + 87, 0);
    store8(cbuf + 88, 47); store8(cbuf + 89, 246); store8(cbuf + 90, 136); store8(cbuf + 91, 137);
    store8(cbuf + 92, 129); store8(cbuf + 93, 43); store8(cbuf + 94, 240); store8(cbuf + 95, 166);
    store8(cbuf + 96, 0); store8(cbuf + 97, 1); store8(cbuf + 98, 83); store8(cbuf + 99, 51);
    store8(cbuf + 100, 170); store8(cbuf + 101, 218); store8(cbuf + 102, 192); store8(cbuf + 103, 14);
    store8(cbuf + 104, 31); store8(cbuf + 105, 182); store8(cbuf + 106, 243); store8(cbuf + 107, 125);
    store8(cbuf + 108, 1); store8(cbuf + 109, 0); store8(cbuf + 110, 0); store8(cbuf + 111, 0);
    store8(cbuf + 112, 0); store8(cbuf + 113, 4); store8(cbuf + 114, 89); store8(cbuf + 115, 90);
    var out = alloc(51);
    assert(xz_decompress(cbuf, 116, out, 51) == 51, "xz_corruption baseline");
    var saved = load8(cbuf + 58);
    store8(cbuf + 58, saved ^ 255);
    assert(xz_decompress(cbuf, 116, out, 51) < 0, "xz_corruption flipped byte rejected");
    store8(cbuf + 58, saved);
    var m = load8(cbuf + 1);
    store8(cbuf + 1, m ^ 255);
    assert(xz_decompress(cbuf, 116, out, 51) == 0 - ERR_CORRUPT_DATA, "xz_corruption bad magic");
    store8(cbuf + 1, m);
    assert(xz_decompress(cbuf, 20, out, 51) < 0, "xz_corruption truncated rejected");
    assert(xz_decompress(cbuf, 116, out, 4) < 0, "xz_corruption small dst rejected");
    return 0;
}

# ================================================================
# main
# ================================================================

# Pre-allocate shared test buffers to avoid heap exhaustion.
# Tests reuse these instead of calling alloc() individually.
var _tb_small = 0;   # 64 bytes
var _tb_med = 0;     # 512 bytes
var _tb_large = 0;   # 8192 bytes

fn _init_test_bufs() {
    _tb_small = alloc(64);
    _tb_med = alloc(512);
    _tb_large = alloc(8192);
    return 0;
}

fn main() {
    # Custom heap init: 4MB instead of default 1MB
    _heap_base = syscall(12, 0);
    _heap_end = _heap_base + 4194304;
    syscall(12, _heap_end);
    _heap_ptr = _heap_base;
    _init_test_bufs();

    test_adler32_empty();
    test_adler32_hello();
    test_adler32_single_byte();
    test_adler32_large();
    test_crc32_empty();
    test_crc32_known();
