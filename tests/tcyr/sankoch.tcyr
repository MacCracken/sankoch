# ================================================================
# 2.2.0 — preset dictionary in streaming encoders.
# `*_enc_init_dict(level, dst, dst_cap, dict, dict_len)` mirrors the
# decode-side dict semantics: encoder window is preloaded with `dict`
# bytes, hash table seeded so back-references can reach into dict
# territory. Decoder must apply the same dict via the matching
# `*_decompress_dict` (or `zlib_decompress_dict` for FDICT streams).
# ================================================================

# Common dict + input — input has heavy overlap with dict so the
# dict-warmed encoder reaches into the dict via match references.
fn _dict_test_dict() {
    # 45 bytes of pangram text
    var s = "the quick brown fox jumps over the lazy dog. ";
    return s;
}

fn _dict_test_input() {
    # 89 bytes — repeats most of the dict content
    var s = "the quick brown fox jumps over the lazy dog. the quick brown fox went home tonight.";
    return s;
}

fn test_deflate_enc_dict_roundtrip() {
    var dict = _dict_test_dict();
    var input = _dict_test_input();
    var dict_len = strlen(dict);
    var input_len = strlen(input);

    var dst = alloc(512);
    var ctx = deflate_enc_init_dict(6, dst, 512, dict, dict_len);
    assert(ctx != 0, "deflate_enc_init_dict ctx");
    assert(deflate_enc_write(ctx, input, input_len) == 0, "deflate_enc_write dict");
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "deflate_enc_finish dict clen>0");

    var out = alloc(256);
    var dlen = deflate_decompress_dict(dst, clen, out, 256, dict, dict_len);
    assert(dlen == input_len, "deflate dict roundtrip len");
    var i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "deflate dict roundtrip byte");
        i = i + 1;
    }
    return 0;
}

fn test_deflate_enc_dict_levels() {
    # Same roundtrip across the level boundaries that switch fixed/
    # dynamic encoder paths.
    var dict = _dict_test_dict();
    var input = _dict_test_input();
    var dict_len = strlen(dict);
    var input_len = strlen(input);

    var levels[4];
    store64(&levels + 0, 1);   # fixed
    store64(&levels + 8, 3);   # fixed
    store64(&levels + 16, 6);  # dynamic
    store64(&levels + 24, 9);  # dynamic / deepest chain

    var li = 0;
    while (li < 4) {
        var level = load64(&levels + li * 8);
        var dst = alloc(512);
        var ctx = deflate_enc_init_dict(level, dst, 512, dict, dict_len);
        assert(ctx != 0, "deflate dict ctx (level)");
        assert(deflate_enc_write(ctx, input, input_len) == 0, "deflate dict write (level)");
        var clen = deflate_enc_finish(ctx);
        assert(clen > 0, "deflate dict clen>0 (level)");

        var out = alloc(256);
        var dlen = deflate_decompress_dict(dst, clen, out, 256, dict, dict_len);
        assert(dlen == input_len, "deflate dict roundtrip len (level)");
        var i = 0;
        while (i < input_len) {
            assert(load8(out + i) == load8(input + i), "deflate dict roundtrip byte (level)");
            i = i + 1;
        }
        li = li + 1;
    }
    return 0;
}

fn test_zlib_enc_dict_roundtrip() {
    var dict = _dict_test_dict();
    var input = _dict_test_input();
    var dict_len = strlen(dict);
    var input_len = strlen(input);

    var dst = alloc(512);
    var ctx = zlib_enc_init_dict(6, dst, 512, dict, dict_len);
    assert(ctx != 0, "zlib_enc_init_dict ctx");
    assert(zlib_enc_write(ctx, input, input_len) == 0, "zlib_enc_write dict");
    var clen = zlib_enc_finish(ctx);
    assert(clen > 6, "zlib dict clen > 6 (header+trailer)");

    # Header: CMF=0x78, FLG=0x20 (FDICT=1)
    assert(load8(dst) == 120, "zlib dict CMF=0x78");
    assert(load8(dst + 1) == 32, "zlib dict FLG=0x20 (FDICT)");
    # DICTID: 4-byte big-endian Adler-32 of dict
    var did = adler32(dict, dict_len);
    var stored = (load8(dst + 2) << 24) | (load8(dst + 3) << 16) |
    (load8(dst + 4) << 8) | load8(dst + 5);
    assert(stored == did, "zlib dict DICTID == adler32(dict)");

    var out = alloc(256);
    var dlen = zlib_decompress_dict(dst, clen, out, 256, dict, dict_len);
    assert(dlen == input_len, "zlib dict roundtrip len");
    var i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "zlib dict roundtrip byte");
        i = i + 1;
    }
    return 0;
}

fn test_zlib_dec_dict_streaming() {
    # 2.3.6: streaming decode of an FDICT zlib stream. The input overlaps
    # the dict heavily, so the encoder emits back-references INTO the dict
    # — exercising the dict-aware match-copy (negative source offsets).
    var dict = _dict_test_dict();
    var input = _dict_test_input();
    var dict_len = strlen(dict);
    var input_len = strlen(input);

    var enc = alloc(512);
    var ec = zlib_enc_init_dict(6, enc, 512, dict, dict_len);
    assert(ec != 0, "zdec dict enc init");
    assert(zlib_enc_write(ec, input, input_len) == 0, "zdec dict enc write");
    var clen = zlib_enc_finish(ec);
    assert(clen > 6, "zdec dict enc clen");

    # Streaming decode (whole) with the matching dict.
    var d = alloc(256);
    var ctx = zlib_dec_init_dict(d, 256, dict, dict_len);
    assert(ctx != 0, "zdec dict init");
    assert(zlib_dec_write(ctx, enc, clen) >= 0, "zdec dict write");
    assert(zlib_dec_finish(ctx) == input_len, "zdec dict len");
    var i = 0;
    while (i < input_len) {
        assert(load8(d + i) == load8(input + i), "zdec dict content");
        i = i + 1;
    }

    # Streaming byte-at-a-time — DICTID + dict match-copy across chunks.
    var d2 = alloc(256);
    var ctx2 = zlib_dec_init_dict(d2, 256, dict, dict_len);
    assert(ctx2 != 0, "zdec dict baat init");
    var k = 0;
    while (k < clen) {
        assert(zlib_dec_write(ctx2, enc + k, 1) >= 0, "zdec dict baat write");
        k = k + 1;
    }
    assert(zlib_dec_finish(ctx2) == input_len, "zdec dict baat len");
    i = 0;
    while (i < input_len) {
        assert(load8(d2 + i) == load8(input + i), "zdec dict baat content");
        i = i + 1;
    }

    # Wrong dict (same length, different content) → DICTID mismatch.
    var wrong = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    var d3 = alloc(256);
    var ctx3 = zlib_dec_init_dict(d3, 256, wrong, dict_len);
    var rc3 = zlib_dec_write(ctx3, enc, clen);
    var fin3 = zlib_dec_finish(ctx3);
    assert(rc3 < 0 || fin3 < 0, "zdec wrong dict rejected");

    # FDICT stream through the no-dict zlib_dec_init → rejected.
    var d4 = alloc(256);
    var ctx4 = zlib_dec_init(d4, 256);
    var rc4 = zlib_dec_write(ctx4, enc, clen);
    var fin4 = zlib_dec_finish(ctx4);
    assert(rc4 < 0 || fin4 < 0, "zdec FDICT without dict rejected");
    return 0;
}

fn test_zlib_enc_dict_wrong_dict_rejected() {
    # Encode with dict A; decompress claiming dict B → DICTID mismatch.
    var dict_a = "abcdefghijklmnop";
    var dict_b = "ZZZZZZZZZZZZZZZZ";
    var input = "hello world";
    var input_len = strlen(input);

    var dst = alloc(256);
    var ctx = zlib_enc_init_dict(6, dst, 256, dict_a, 16);
    zlib_enc_write(ctx, input, input_len);
    var clen = zlib_enc_finish(ctx);
    assert(clen > 0, "zlib dict_a clen>0");

    var out = alloc(64);
    var rc = zlib_decompress_dict(dst, clen, out, 64, dict_b, 16);
    assert(rc < 0, "zlib decompress with wrong dict must reject");
    return 0;
}

# gzip's wire format has no FDICT, so a dict-warmed gzip stream is a
# private contract between matching encoder/decoder pairs. Sankoch's
# `gzip_decompress` does not (currently) take a dict; for round-trip
# coverage we strip the gzip envelope manually and feed the inner
# DEFLATE payload to `deflate_decompress_dict`.
fn test_gzip_enc_dict_roundtrip() {
    var dict = _dict_test_dict();
    var input = _dict_test_input();
    var dict_len = strlen(dict);
    var input_len = strlen(input);

    var dst = alloc(512);
    var ctx = gzip_enc_init_dict(6, dst, 512, dict, dict_len);
    assert(ctx != 0, "gzip_enc_init_dict ctx");
    assert(gzip_enc_write(ctx, input, input_len) == 0, "gzip_enc_write dict");
    var total = gzip_enc_finish(ctx);
    assert(total > 18, "gzip dict total > 18 (header+trailer)");

    # Magic bytes still 0x1F 0x8B regardless of dict.
    assert(load8(dst) == 31, "gzip dict ID1");
    assert(load8(dst + 1) == 139, "gzip dict ID2");
    # FLG byte should still be 0 (no FDICT, no other flags).
    assert(load8(dst + 3) == 0, "gzip dict FLG = 0");

    # Strip 10-byte header + 8-byte trailer; feed inner DEFLATE to
    # deflate_decompress_dict.
    var deflate_len = total - 18;
    var out = alloc(256);
    var dlen = deflate_decompress_dict(dst + 10, deflate_len, out, 256, dict, dict_len);
    assert(dlen == input_len, "gzip dict inner-DEFLATE roundtrip len");
    var i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "gzip dict inner-DEFLATE byte");
        i = i + 1;
    }
    return 0;
}

fn test_enc_dict_invalid_args() {
    var dict = "abc";
    var dst = alloc(64);
    # dict_len > DEFLATE_WINDOW_SIZE (32768) — reject
    assert(deflate_enc_init_dict(6, dst, 64, dict, 32769) == 0,
    "deflate dict_len>32768 rejected");
    assert(zlib_enc_init_dict(6, dst, 64, dict, 32769) == 0,
    "zlib dict_len>32768 rejected");
    assert(gzip_enc_init_dict(6, dst, 64, dict, 32769) == 0,
    "gzip dict_len>32768 rejected");
    # dict_len < 0 — reject
    assert(deflate_enc_init_dict(6, dst, 64, dict, 0 - 1) == 0,
    "deflate dict_len<0 rejected");
    # dict == 0 with dict_len > 0 — reject
    assert(deflate_enc_init_dict(6, dst, 64, 0, 5) == 0,
    "deflate null dict + nonzero len rejected");
    return 0;
}

# 2.2.3 P(-1) closeout — dict boundary cases surfaced by audit.

fn test_enc_dict_max_len_32768() {
    # Largest legal dict — exactly DEFLATE_WINDOW_SIZE. Hash-seed loop
    # runs from j=0 to j=32765 (32,766 inserts). Round-trip must work.
    #
    # `dst_cap` for the decompress side has to be >= dict_len because
    # `_deflate_decompress_dict_inner` stages the dict prefix into
    # dst[0..dict_len] before decoding the payload (then moves output
    # back to dst[0..]). 65 KB covers the 32 KB dict prefix + the
    # short payload.
    var dict = alloc(32768);
    var i = 0;
    while (i < 32768) { store8(dict + i, (i * 7 + 11) & 255); i = i + 1; }

    var input = "PAYLOAD-AT-MAX-DICT-BOUNDARY";
    var input_len = strlen(input);

    var dst = alloc(65536);
    var ctx = deflate_enc_init_dict(6, dst, 65536, dict, 32768);
    assert(ctx != 0, "deflate dict_len=32768 ctx");
    deflate_enc_write(ctx, input, input_len);
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "deflate dict_len=32768 clen>0");

    var out = alloc(65536);
    var dlen = deflate_decompress_dict(dst, clen, out, 65536, dict, 32768);
    assert(dlen == input_len, "deflate dict_len=32768 roundtrip len");
    i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "deflate dict_len=32768 roundtrip byte");
        i = i + 1;
    }
    return 0;
}

fn test_enc_dict_min_match_len_3() {
    # Exactly LZ77_MIN_MATCH — hash-seed loop runs once (j=0).
    var dict = "abc";
    var input = "abcdefgh";
    var input_len = strlen(input);

    var dst = alloc(256);
    var ctx = deflate_enc_init_dict(6, dst, 256, dict, 3);
    assert(ctx != 0, "deflate dict_len=3 ctx");
    deflate_enc_write(ctx, input, input_len);
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "deflate dict_len=3 clen>0");

    var out = alloc(64);
    var dlen = deflate_decompress_dict(dst, clen, out, 64, dict, 3);
    assert(dlen == input_len, "deflate dict_len=3 roundtrip len");
    var i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "deflate dict_len=3 roundtrip byte");
        i = i + 1;
    }
    return 0;
}

fn test_enc_dict_below_min_match_len_2() {
    # Below LZ77_MIN_MATCH — hash-seed loop never runs. Dict bytes
    # still copied to the window (decoder needs them prefixed for
    # consistent abs-position semantics) but no matches reach into
    # dict territory. Round-trip must still work.
    var dict = "ab";
    var input = "abcdefgh";
    var input_len = strlen(input);

    var dst = alloc(256);
    var ctx = deflate_enc_init_dict(6, dst, 256, dict, 2);
    assert(ctx != 0, "deflate dict_len=2 ctx");
    deflate_enc_write(ctx, input, input_len);
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "deflate dict_len=2 clen>0");

    var out = alloc(64);
    var dlen = deflate_decompress_dict(dst, clen, out, 64, dict, 2);
    assert(dlen == input_len, "deflate dict_len=2 roundtrip len");
    var i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "deflate dict_len=2 roundtrip byte");
        i = i + 1;
    }
    return 0;
}

fn test_enc_dict_zero_len_equals_no_dict() {
    # dict_len == 0 should behave identically to the no-dict path.
    # We can't byte-compare against a fresh _enc_init stream because
    # the static-data encoder state is shared and timing-sensitive,
    # but we can confirm round-trip via the no-dict decompressor.
    var input = "hello world";
    var input_len = strlen(input);

    var dst = alloc(256);
    var ctx = deflate_enc_init_dict(6, dst, 256, 0, 0);
    assert(ctx != 0, "dict_len=0 ctx (deflate)");
    deflate_enc_write(ctx, input, input_len);
    var clen = deflate_enc_finish(ctx);
    assert(clen > 0, "dict_len=0 clen>0 (deflate)");

    var out = alloc(64);
    var dlen = deflate_decompress(dst, clen, out, 64);
    assert(dlen == input_len, "dict_len=0 roundtrip len");
    var i = 0;
    while (i < input_len) {
        assert(load8(out + i) == load8(input + i), "dict_len=0 roundtrip byte");
        i = i + 1;
    }
    return 0;
}

# ================================================================
# 2.1.3 P(-1) hardening — regression coverage for the audit findings.
# Each test confirms that a malformed input the pre-2.1.3 parser would
# have either accepted (spec non-compliance) or read past the source
# buffer for (HIGH-1) is now rejected with a negative error.
# ================================================================

# HIGH-1: stored block declares LEN > bytes remaining in stream.
# Header: BFINAL=1, BTYPE=00 (stored) = 0x01 in byte 0.
# After br_align, LEN (LE u16) = 100, NLEN = 65435 (~LEN). NLEN check
# passes; previously the raw-byte copy would walk 100 bytes past the
# 5-byte source buffer. Now the bound check rejects.
fn test_err_deflate_stored_oob() {
    var src = alloc(5);
    store8(src + 0, 1);              # BFINAL=1, BTYPE=00
    store8(src + 1, 100);             # LEN low
    store8(src + 2, 0);               # LEN high
    store8(src + 3, 155);             # NLEN low  (~100 & 0xFF = 0x9B = 155)
    store8(src + 4, 255);             # NLEN high (~0   & 0xFF = 0xFF = 255)
    var dst = alloc(256);
    assert(deflate_decompress(src, 5, dst, 256) < 0,
    "deflate stored len>remaining must reject");
    return 0;
}

# MED-1: dynamic block with HLIT field encoding > 29.
# Byte 0 = 0b11110101 = 0xF5: BFINAL=1 (bit 0), BTYPE=10 dynamic (bits
# 1-2), HLIT field bits 3-7 = 0b11110 = 30 (LSB-first), giving
# hlit count = 30 + 257 = 287 > 286 — invalid per RFC 1951 §3.2.7.
# Trailing bytes are present so any failure here is HLIT-cap rejection
# (or downstream parse failure if the cap weren't enforced); either
# way the call must fail negatively without UB.
fn test_err_deflate_hlit_overflow() {
    var src = alloc(8);
    store8(src + 0, 245);    # 0xF5 — HLIT=30 in the encoded field
    var i = 1;
    while (i < 8) { store8(src + i, 0); i = i + 1; }
    var dst = alloc(64);
    assert(deflate_decompress(src, 8, dst, 64) < 0,
    "deflate hlit>29 (count>286) must reject");
    return 0;
}

# LOW-1: zlib header with CINFO > 7 (window > 32K — disallowed by
# RFC 1950 §2.2).
# CMF = 0x88 (CINFO=8, CM=8), FLG=0x1C — chosen so
# (0x88*256 + 0x1C) % 31 == 0 (FCHECK passes).
fn test_err_zlib_cinfo_overflow() {
    var src = alloc(6);
    store8(src + 0, 136);   # CMF: CINFO=8, CM=8
    store8(src + 1, 28);    # FLG: FCHECK chosen so the % 31 == 0
    store8(src + 2, 3); store8(src + 3, 0); store8(src + 4, 0); store8(src + 5, 0);
    var dst = alloc(64);
    assert(zlib_decompress(src, 6, dst, 64) < 0,
    "zlib CINFO>7 must reject");
    return 0;
}

# LOW-2: gzip header with a reserved FLG bit set (bits 5-7 must be
# zero per RFC 1952 §2.3.1.2).
fn test_err_gzip_reserved_flg() {
    var src = alloc(18);
    store8(src + 0, 31);    # ID1 0x1F
    store8(src + 1, 139);   # ID2 0x8B
    store8(src + 2, 8);     # CM = 8 (deflate)
    store8(src + 3, 32);    # FLG = 0x20 — reserved bit 5 set
    var i = 4;
    while (i < 18) { store8(src + i, 0); i = i + 1; }
    var dst = alloc(64);
    assert(gzip_decompress(src, 18, dst, 64) < 0,
    "gzip reserved FLG bit set must reject");
    return 0;
}

# ================================================================
# 2.3.0 bite-1: streaming DEFLATE decoder — stored blocks only
# ================================================================
#
# Stored-block wire format (RFC 1951 §3.2.4):
#   header byte  = (BTYPE << 1) | BFINAL  in low 3 bits, rest padding
#   LEN  (2 bytes LE) — payload byte count
#   NLEN (2 bytes LE) — one's complement of LEN (validate via XOR)
#   payload (LEN bytes verbatim)
#
# Bite-1 hand-crafts the wire bytes because the batch compressor never
# emits pure stored output. The empty-stream test below is the one
# tight round-trip against `deflate_enc_*` (the encoder's empty path
# emits exactly a BFINAL=1 stored LEN=0 trailer).

fn test_dec_stream_empty_bfinal_stored() {
    # 5-byte stream: BFINAL=1, BTYPE=00, LEN=0, NLEN=0xFFFF.
    var src = alloc(5);
    store8(src + 0, 1);          # 0b00000001
    store8(src + 1, 0); store8(src + 2, 0);    # LEN=0
    store8(src + 3, 255); store8(src + 4, 255);# NLEN=0xFFFF
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "dec_init returns ctx");
    assert(deflate_dec_write(ctx, src, 5) >= 0, "dec_write empty stored");
    var n = deflate_dec_finish(ctx);
    assert(n == 0, "dec_finish returns 0 for empty stored");
    return 0;
}

fn test_dec_stream_single_stored_block() {
    # BFINAL=1, BTYPE=00, LEN=5, NLEN=0xFFFA, then "Hello".
    var src = alloc(10);
    store8(src + 0, 1);
    store8(src + 1, 5); store8(src + 2, 0);
    store8(src + 3, 250); store8(src + 4, 255);
    store8(src + 5, 72); store8(src + 6, 101); store8(src + 7, 108);
    store8(src + 8, 108); store8(src + 9, 111);
    var dst = alloc(16);
    var ctx = deflate_dec_init(dst, 16);
    assert(ctx != 0, "single stored init");
    assert(deflate_dec_write(ctx, src, 10) >= 0, "single stored write");
    var n = deflate_dec_finish(ctx);
    assert(n == 5, "single stored finish len");
    assert(load8(dst + 0) == 72 && load8(dst + 4) == 111, "single stored content");
    return 0;
}

fn test_dec_stream_byte_at_a_time() {
    # Same 10-byte stream as above, fed one byte per dec_write call.
    # Exercises state-machine suspension at every possible point
    # (header straddles, LEN straddles, NLEN straddles, data straddles).
    var src = alloc(10);
    store8(src + 0, 1);
    store8(src + 1, 5); store8(src + 2, 0);
    store8(src + 3, 250); store8(src + 4, 255);
    store8(src + 5, 72); store8(src + 6, 101); store8(src + 7, 108);
    store8(src + 8, 108); store8(src + 9, 111);
    var dst = alloc(16);
    var ctx = deflate_dec_init(dst, 16);
    assert(ctx != 0, "byte-at-a-time init");
    var i = 0;
    while (i < 10) {
        assert(deflate_dec_write(ctx, src + i, 1) >= 0, "byte-at-a-time write");
        i = i + 1;
    }
    var n = deflate_dec_finish(ctx);
    assert(n == 5, "byte-at-a-time len");
    i = 0;
    while (i < 5) {
        assert(load8(dst + i) == load8(src + 5 + i), "byte-at-a-time content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_multi_block_stored() {
    # Block 1: BFINAL=0, BTYPE=00, LEN=2, NLEN=0xFFFD, "AB".
    # Block 2: BFINAL=1, BTYPE=00, LEN=2, NLEN=0xFFFD, "CD".
    var src = alloc(14);
    store8(src +  0, 0);                              # BFINAL=0 BTYPE=00
    store8(src +  1, 2); store8(src +  2, 0);
    store8(src +  3, 253); store8(src +  4, 255);
    store8(src +  5, 65); store8(src +  6, 66);       # "AB"
    store8(src +  7, 1);                              # BFINAL=1 BTYPE=00
    store8(src +  8, 2); store8(src +  9, 0);
    store8(src + 10, 253); store8(src + 11, 255);
    store8(src + 12, 67); store8(src + 13, 68);       # "CD"
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "multi-block init");
    assert(deflate_dec_write(ctx, src, 14) >= 0, "multi-block write");
    var n = deflate_dec_finish(ctx);
    assert(n == 4, "multi-block len");
    assert(load8(dst + 0) == 65 && load8(dst + 1) == 66
    && load8(dst + 2) == 67 && load8(dst + 3) == 68, "multi-block content");
    return 0;
}

fn test_dec_stream_nlen_mismatch() {
    # Same as single_stored but NLEN=0x0000 (not the complement of LEN=5).
    var src = alloc(10);
    store8(src + 0, 1);
    store8(src + 1, 5); store8(src + 2, 0);
    store8(src + 3, 0); store8(src + 4, 0);   # NLEN wrong
    store8(src + 5, 72); store8(src + 6, 101); store8(src + 7, 108);
    store8(src + 8, 108); store8(src + 9, 111);
    var dst = alloc(16);
    var ctx = deflate_dec_init(dst, 16);
    assert(ctx != 0, "nlen mismatch init");
    var rc = deflate_dec_write(ctx, src, 10);
    assert(rc < 0, "nlen mismatch rejected");
    var fin = deflate_dec_finish(ctx);
    assert(fin < 0, "finish propagates error");
    return 0;
}

fn test_dec_stream_fixed_eob_only() {
    # Hand-crafted BFINAL=1, BTYPE=01, EOB (7-bit code 0000000), padded.
    # Byte 0 = 0b00000011 = 3 (BFINAL=1, BTYPE=01, first 5 bits of EOB).
    # Byte 1 = 0 (last 2 bits of EOB, 6 trailing padding bits).
    var src = alloc(2);
    store8(src + 0, 3);
    store8(src + 1, 0);
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "fixed EOB-only init");
    assert(deflate_dec_write(ctx, src, 2) >= 0, "fixed EOB-only write");
    var n = deflate_dec_finish(ctx);
    assert(n == 0, "fixed EOB-only emits zero bytes");
    return 0;
}

fn test_dec_stream_fixed_short_literal_roundtrip() {
    # Encoder at level 1 routes through the fixed-Huffman path. Compress
    # "Hello" and round-trip through the streaming decoder.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = deflate_compress_level(src, 5, c, 64, 1);
    assert(clen > 0, "fixed short rt compress");

    var d = alloc(16);
    var ctx = deflate_dec_init(d, 16);
    assert(ctx != 0, "fixed short rt init");
    assert(deflate_dec_write(ctx, c, clen) >= 0, "fixed short rt write");
    var n = deflate_dec_finish(ctx);
    assert(n == 5, "fixed short rt len");
    var i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "fixed short rt content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_fixed_byte_at_a_time() {
    # Same level-1 compress of "Hello", but feed the compressed bytes
    # one at a time. Exercises mid-symbol state-machine suspension
    # across every chunk boundary in the litlen / EOB sequence.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = deflate_compress_level(src, 5, c, 64, 1);
    assert(clen > 0, "fixed BAAT compress");

    var d = alloc(16);
    var ctx = deflate_dec_init(d, 16);
    assert(ctx != 0, "fixed BAAT init");
    var i = 0;
    while (i < clen) {
        assert(deflate_dec_write(ctx, c + i, 1) >= 0, "fixed BAAT write");
        i = i + 1;
    }
    var n = deflate_dec_finish(ctx);
    assert(n == 5, "fixed BAAT len");
    i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "fixed BAAT content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_fixed_with_backref() {
    # Level-1 compress an input long enough to produce LZ77 back-
    # references (length code + distance code), then round-trip via
    # the streaming decoder. "abcdefghijabcdefghij" — 20 bytes, the
    # second half matches the first at distance=10, length=10.
    var src = alloc(20);
    var k = 0;
    while (k < 20) {
        store8(src + k, 97 + (k % 10));   # 'a'..'j' repeated
        k = k + 1;
    }
    var c = alloc(64);
    var clen = deflate_compress_level(src, 20, c, 64, 1);
    assert(clen > 0, "fixed backref compress");

    var d = alloc(32);
    var ctx = deflate_dec_init(d, 32);
    assert(ctx != 0, "fixed backref init");
    assert(deflate_dec_write(ctx, c, clen) >= 0, "fixed backref write");
    var n = deflate_dec_finish(ctx);
    assert(n == 20, "fixed backref len");
    var i = 0;
    while (i < 20) {
        assert(load8(d + i) == load8(src + i), "fixed backref content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_fixed_rle_distance_1() {
    # Run-length encoding via distance=1: encoder back-references the
    # immediately preceding byte. Compressor at level 1 emits a length
    # code + dist=1 for a long run. "aaaa....a" (20 'a's).
    var src = alloc(20);
    var k = 0;
    while (k < 20) { store8(src + k, 97); k = k + 1; }
    var c = alloc(64);
    var clen = deflate_compress_level(src, 20, c, 64, 1);
    assert(clen > 0, "fixed RLE compress");

    var d = alloc(32);
    var ctx = deflate_dec_init(d, 32);
    assert(ctx != 0, "fixed RLE init");
    assert(deflate_dec_write(ctx, c, clen) >= 0, "fixed RLE write");
    var n = deflate_dec_finish(ctx);
    assert(n == 20, "fixed RLE len");
    var i = 0;
    while (i < 20) {
        assert(load8(d + i) == 97, "fixed RLE content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_fixed_1kb_roundtrip() {
    # Longer round-trip — 1024 bytes of mixed text with patterns the
    # level-1 fixed-Huffman path can compress via both literals and
    # back-references. Feeds the compressed stream in chunks of 16
    # bytes (forces multiple suspension/resume cycles).
    var src = alloc(1024);
    var k = 0;
    while (k < 1024) {
        store8(src + k, 65 + (k % 26));   # 'A'..'Z' cycling
        k = k + 1;
    }
    var c = alloc(2048);
    var clen = deflate_compress_level(src, 1024, c, 2048, 1);
    assert(clen > 0, "fixed 1kb compress");

    var d = alloc(1024);
    var ctx = deflate_dec_init(d, 1024);
    assert(ctx != 0, "fixed 1kb init");
    var off = 0;
    while (off < clen) {
        var step = 16;
        if (off + step > clen) { step = clen - off; }
        assert(deflate_dec_write(ctx, c + off, step) >= 0,
        "fixed 1kb chunk write");
        off = off + step;
    }
    var n = deflate_dec_finish(ctx);
    assert(n == 1024, "fixed 1kb len");
    var i = 0;
    while (i < 1024) {
        assert(load8(d + i) == load8(src + i), "fixed 1kb content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_fixed_buffer_too_small() {
    # Level-1 compress "Hello", attempt to decode into a 3-byte dst.
    # The decoder must error (BUFFER_TOO_SMALL) instead of overrunning.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = deflate_compress_level(src, 5, c, 64, 1);
    assert(clen > 0, "fixed too-small compress");

    var d = alloc(3);
    var ctx = deflate_dec_init(d, 3);
    assert(ctx != 0, "fixed too-small init");
    var rc = deflate_dec_write(ctx, c, clen);
    var fin = deflate_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "fixed too-small rejected");
    return 0;
}

fn test_dec_stream_dynamic_short_roundtrip() {
    # Level 6 routes through the dynamic-Huffman encoder. Round-trip
    # "Hello" — the simplest dynamic-block stream.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = deflate_compress_level(src, 5, c, 64, 6);
    assert(clen > 0, "dyn short rt compress");

    var d = alloc(16);
    var ctx = deflate_dec_init(d, 16);
    assert(ctx != 0, "dyn short rt init");
    assert(deflate_dec_write(ctx, c, clen) >= 0, "dyn short rt write");
    var n = deflate_dec_finish(ctx);
    assert(n == 5, "dyn short rt len");
    var i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "dyn short rt content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_dynamic_byte_at_a_time() {
    # Level-6 compress of "Hello world!", fed one byte per dec_write.
    # Exercises mid-symbol suspension across the dynamic-header parse
    # (HLIT/HDIST/HCLEN, CL_LENS loop, AL_SYM/AL_EXTRA loop) and the
    # subsequent litlen/dist decode path.
    var src = alloc(12);
    store8(src +  0,  72); store8(src +  1, 101); store8(src +  2, 108);
    store8(src +  3, 108); store8(src +  4, 111); store8(src +  5,  32);
    store8(src +  6, 119); store8(src +  7, 111); store8(src +  8, 114);
    store8(src +  9, 108); store8(src + 10, 100); store8(src + 11,  33);
    var c = alloc(64);
    var clen = deflate_compress_level(src, 12, c, 64, 6);
    assert(clen > 0, "dyn BAAT compress");

    var d = alloc(32);
    var ctx = deflate_dec_init(d, 32);
    assert(ctx != 0, "dyn BAAT init");
    var i = 0;
    while (i < clen) {
        assert(deflate_dec_write(ctx, c + i, 1) >= 0, "dyn BAAT write");
        i = i + 1;
    }
    var n = deflate_dec_finish(ctx);
    assert(n == 12, "dyn BAAT len");
    i = 0;
    while (i < 12) {
        assert(load8(d + i) == load8(src + i), "dyn BAAT content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_dynamic_with_backref() {
    # Level-6 compress of a repeating pattern to exercise the dynamic
    # tree with back-references. Drives the LEN_EXTRA / DIST_EXTRA
    # state arms through dynamic-table symbols.
    var src = alloc(40);
    var k = 0;
    while (k < 40) {
        store8(src + k, 97 + (k % 10));   # 'a'..'j' repeated 4 times
        k = k + 1;
    }
    var c = alloc(128);
    var clen = deflate_compress_level(src, 40, c, 128, 6);
    assert(clen > 0, "dyn backref compress");

    var d = alloc(64);
    var ctx = deflate_dec_init(d, 64);
    assert(ctx != 0, "dyn backref init");
    assert(deflate_dec_write(ctx, c, clen) >= 0, "dyn backref write");
    var n = deflate_dec_finish(ctx);
    assert(n == 40, "dyn backref len");
    var i = 0;
    while (i < 40) {
        assert(load8(d + i) == load8(src + i), "dyn backref content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_dynamic_1kb_chunked() {
    # 1024 bytes, level-6 dynamic, fed in 8-byte chunks. Many
    # suspension/resume cycles across both header parse and symbol
    # decode.
    var src = alloc(1024);
    var k = 0;
    while (k < 1024) {
        store8(src + k, 65 + (k % 26));
        k = k + 1;
    }
    var c = alloc(2048);
    var clen = deflate_compress_level(src, 1024, c, 2048, 6);
    assert(clen > 0, "dyn 1kb compress");

    var d = alloc(1024);
    var ctx = deflate_dec_init(d, 1024);
    assert(ctx != 0, "dyn 1kb init");
    var off = 0;
    while (off < clen) {
        var step = 8;
        if (off + step > clen) { step = clen - off; }
        assert(deflate_dec_write(ctx, c + off, step) >= 0,
        "dyn 1kb chunk write");
        off = off + step;
    }
    var n = deflate_dec_finish(ctx);
    assert(n == 1024, "dyn 1kb len");
    var i = 0;
    while (i < 1024) {
        assert(load8(d + i) == load8(src + i), "dyn 1kb content");
        i = i + 1;
    }
    return 0;
}

fn test_dec_stream_dynamic_levels() {
    # Round-trip a small input across every level in the dynamic band
    # (4..9). Each level may pick slightly different tree shapes; all
    # must round-trip cleanly.
    var src = alloc(32);
    var k = 0;
    while (k < 32) {
        store8(src + k, 97 + (k % 16));   # 'a'..'p' repeated
        k = k + 1;
    }
    var lvl = 4;
    while (lvl <= 9) {
        var c = alloc(128);
        var clen = deflate_compress_level(src, 32, c, 128, lvl);
        assert(clen > 0, "dyn levels compress");

        var d = alloc(64);
        var ctx = deflate_dec_init(d, 64);
        assert(ctx != 0, "dyn levels init");
        assert(deflate_dec_write(ctx, c, clen) >= 0, "dyn levels write");
        var n = deflate_dec_finish(ctx);
        assert(n == 32, "dyn levels len");
        var i = 0;
        while (i < 32) {
            assert(load8(d + i) == load8(src + i), "dyn levels content");
            i = i + 1;
        }
        lvl = lvl + 1;
    }
    return 0;
}

fn test_dec_stream_dynamic_hlit_overflow() {
    # MED-01 regression: HLIT field 30 encodes count 287 (out of spec).
    # The dynamic-header parser must reject the stream cleanly instead
    # of building a malformed table.
    # Bit layout (LSB-first within each byte):
    #   bit 0 = BFINAL = 1
    #   bits 1-2 = BTYPE = 10 (dynamic)
    #   bits 3-7 = HLIT_LSB = 30 -> binary 11110
    # Byte 0 = 0b11110101 = 245.
    var src = alloc(1);
    store8(src + 0, 245);
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "dyn HLIT overflow init");
    var rc = deflate_dec_write(ctx, src, 1);
    var fin = deflate_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "dyn HLIT > 286 rejected");
    return 0;
}

fn test_dec_stream_reserved_block_type() {
    # BTYPE=11 (reserved) is invalid even after Huffman support lands.
    var src = alloc(1);
    store8(src + 0, 7);   # BFINAL=1, BTYPE=11
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "reserved btype init");
    var rc = deflate_dec_write(ctx, src, 1);
    assert(rc < 0, "BTYPE=11 rejected");
    var fin = deflate_dec_finish(ctx);
    assert(fin < 0, "reserved finish error");
    return 0;
}

fn test_dec_stream_incomplete_stream() {
    # Header byte only — never a BFINAL=1 EOB seen. finish must error.
    var src = alloc(1);
    store8(src + 0, 0);   # BFINAL=0
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "incomplete init");
    assert(deflate_dec_write(ctx, src, 1) >= 0, "incomplete partial write");
    var fin = deflate_dec_finish(ctx);
    assert(fin < 0, "incomplete stream rejected at finish");
    return 0;
}

fn test_dec_stream_buffer_too_small() {
    # 5-byte payload into a 3-byte dst — must error at NLEN read.
    var src = alloc(10);
    store8(src + 0, 1);
    store8(src + 1, 5); store8(src + 2, 0);
    store8(src + 3, 250); store8(src + 4, 255);
    store8(src + 5, 72); store8(src + 6, 101); store8(src + 7, 108);
    store8(src + 8, 108); store8(src + 9, 111);
    var dst = alloc(3);
    var ctx = deflate_dec_init(dst, 3);
    assert(ctx != 0, "too-small dst init");
    var rc = deflate_dec_write(ctx, src, 10);
    assert(rc < 0, "too-small dst rejected");
    var fin = deflate_dec_finish(ctx);
    assert(fin < 0, "too-small finish error");
    return 0;
}

fn test_dec_stream_post_done_writes_noop() {
    # After BFINAL=1 EOB seen, further writes return 0 with no error.
    var src = alloc(5);
    store8(src + 0, 1);
    store8(src + 1, 0); store8(src + 2, 0);
    store8(src + 3, 255); store8(src + 4, 255);
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "post-done init");
    assert(deflate_dec_write(ctx, src, 5) >= 0, "complete stream");
    var trailing = alloc(3);
    store8(trailing + 0, 99); store8(trailing + 1, 99); store8(trailing + 2, 99);
    assert(deflate_dec_write(ctx, trailing, 3) == 0, "post-done writes no-op");
    var n = deflate_dec_finish(ctx);
    assert(n == 0, "post-done finish");
    return 0;
}

fn test_dec_stream_finish_releases_lock() {
    # After dec_finish, an unrelated public API call must succeed
    # (proves the mutex was released).
    var src = alloc(5);
    store8(src + 0, 1);
    store8(src + 1, 0); store8(src + 2, 0);
    store8(src + 3, 255); store8(src + 4, 255);
    var dst = alloc(8);
    var ctx = deflate_dec_init(dst, 8);
    assert(ctx != 0, "lock-release init");
    deflate_dec_write(ctx, src, 5);
    deflate_dec_finish(ctx);

    # If the mutex were still held, this batch call would deadlock.
    # `_sankoch_lock` is non-reentrant in the single-threaded contract,
    # but a follow-up call from the same thread MUST succeed because
    # finish released the lock.
    var src2 = alloc(2);
    store8(src2 + 0, 65); store8(src2 + 1, 66);
    var c2 = alloc(32);
    var n = deflate_compress(src2, 2, c2, 32);
    assert(n > 0, "follow-up compress succeeds (lock was released)");
    return 0;
}

fn test_dec_stream_encoder_empty_roundtrip() {
    # End-to-end check: deflate_enc_* at level 1 (fixed path) with zero
    # writes emits a single BFINAL=1 stored-LEN=0 block — the one
    # codec-emitted shape bite-1 supports. (Level >= 4 emits a dynamic
    # block instead, which lands in bite-3.)
    var c = alloc(16);
    var enc = deflate_enc_init(1, c, 16);
    assert(enc != 0, "empty rt enc_init");
    var clen = deflate_enc_finish(enc);
    assert(clen > 0, "empty rt enc_finish");

    var d = alloc(8);
    var dec = deflate_dec_init(d, 8);
    assert(dec != 0, "empty rt dec_init");
    assert(deflate_dec_write(dec, c, clen) >= 0, "empty rt dec_write");
    var n = deflate_dec_finish(dec);
    assert(n == 0, "empty rt dec_finish returns 0");
    return 0;
}

# ================================================================
# 2.3.0 bite-4: streaming zlib + gzip wrappers
# ================================================================

fn test_zdec_short_roundtrip() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = zlib_compress_level(src, 5, c, 64, 6);
    assert(clen > 0, "zdec short compress");

    var d = alloc(16);
    var ctx = zlib_dec_init(d, 16);
    assert(ctx != 0, "zdec short init");
    var rc = zlib_dec_write(ctx, c, clen);
    assert(rc >= 0, "zdec short write");
    var n = zlib_dec_finish(ctx);
    assert(n == 5, "zdec short len");
    var i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "zdec short content");
        i = i + 1;
    }
    return 0;
}

fn test_zdec_level_1_roundtrip() {
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = zlib_compress_level(src, 5, c, 64, 1);
    assert(clen > 0, "zdec L1 compress");

    var d = alloc(16);
    var ctx = zlib_dec_init(d, 16);
    assert(ctx != 0, "zdec L1 init");
    var rc = zlib_dec_write(ctx, c, clen);
    assert(rc >= 0, "zdec L1 write");
    var n = zlib_dec_finish(ctx);
    assert(n == 5, "zdec L1 len");
    var i = 0;
    while (i < 5) {
        assert(load8(d + i) == load8(src + i), "zdec L1 content");
        i = i + 1;
    }
    return 0;
}

fn test_zdec_byte_at_a_time() {
    var src = alloc(20);
    var k = 0;
    while (k < 20) {
        store8(src + k, 97 + (k % 10));
        k = k + 1;
    }
    var c = alloc(64);
    var clen = zlib_compress_level(src, 20, c, 64, 6);
    assert(clen > 0, "zdec BAAT compress");

    var d = alloc(32);
    var ctx = zlib_dec_init(d, 32);
    assert(ctx != 0, "zdec BAAT init");
    var i = 0;
    while (i < clen) {
        assert(zlib_dec_write(ctx, c + i, 1) >= 0, "zdec BAAT write");
        i = i + 1;
    }
    var n = zlib_dec_finish(ctx);
    assert(n == 20, "zdec BAAT len");
    i = 0;
    while (i < 20) {
        assert(load8(d + i) == load8(src + i), "zdec BAAT content");
        i = i + 1;
    }
    return 0;
}

fn test_zdec_1kb_chunked() {
    var src = alloc(1024);
    var k = 0;
    while (k < 1024) {
        store8(src + k, 65 + (k % 26));
        k = k + 1;
    }
    var c = alloc(2048);
    var clen = zlib_compress_level(src, 1024, c, 2048, 6);
    assert(clen > 0, "zdec 1kb compress");

    var d = alloc(1024);
    var ctx = zlib_dec_init(d, 1024);
    assert(ctx != 0, "zdec 1kb init");
    var off = 0;
    while (off < clen) {
        var step = 16;
        if (off + step > clen) { step = clen - off; }
        assert(zlib_dec_write(ctx, c + off, step) >= 0, "zdec 1kb chunk");
        off = off + step;
    }
    var n = zlib_dec_finish(ctx);
    assert(n == 1024, "zdec 1kb len");
    var i = 0;
    while (i < 1024) {
        assert(load8(d + i) == load8(src + i), "zdec 1kb content");
        i = i + 1;
    }
    return 0;
}

fn test_zdec_bad_fcheck() {
    # Hand-crafted: CMF=0x78, FLG=0x02 → (0x78*256 + 0x02) % 31 = 1, not 0.
    var src = alloc(8);
    store8(src + 0, 120); store8(src + 1, 2);  # bad FCHECK
    var dst = alloc(8);
    var ctx = zlib_dec_init(dst, 8);
    assert(ctx != 0, "bad FCHECK init");
    var rc = zlib_dec_write(ctx, src, 2);
    var fin = zlib_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad FCHECK rejected");
    return 0;
}

fn test_zdec_fdict_rejected() {
    # Use zlib_enc_init_dict to produce a FDICT-bearing stream; the
    # bite-4 streaming decoder rejects FDICT with -ERR_UNSUPPORTED_FORMAT.
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var dict = alloc(3);
    store8(dict + 0, 97); store8(dict + 1, 98); store8(dict + 2, 99);
    var c = alloc(64);
    var enc = zlib_enc_init_dict(6, c, 64, dict, 3);
    assert(enc != 0, "FDICT compress init");
    assert(zlib_enc_write(enc, src, 5) >= 0, "FDICT compress write");
    var clen = zlib_enc_finish(enc);
    assert(clen > 0, "FDICT compress finish");

    var d = alloc(16);
    var ctx = zlib_dec_init(d, 16);
    assert(ctx != 0, "FDICT decode init");
    var rc = zlib_dec_write(ctx, c, clen);
    var fin = zlib_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "FDICT rejected");
    return 0;
}

fn test_zdec_bad_trailer() {
    # Compress, then corrupt the final 4 bytes (Adler-32 trailer).
    var src = alloc(5);
    store8(src + 0, 72); store8(src + 1, 101); store8(src + 2, 108);
    store8(src + 3, 108); store8(src + 4, 111);
    var c = alloc(64);
    var clen = zlib_compress_level(src, 5, c, 64, 6);
    assert(clen > 5, "bad trailer compress");
    store8(c + clen - 1, load8(c + clen - 1) ^ 1);

    var d = alloc(16);
    var ctx = zlib_dec_init(d, 16);
    assert(ctx != 0, "bad trailer init");
    var rc = zlib_dec_write(ctx, c, clen);
    var fin = zlib_dec_finish(ctx);
    assert(rc < 0 || fin < 0, "bad Adler-32 rejected");
    return 0;
}

