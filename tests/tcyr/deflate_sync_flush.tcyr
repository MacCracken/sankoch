# sankoch — DEFLATE sync flush (RFC 7692 `permessage-deflate`)
#
# Part of the split test suite (see _harness.tcyr). Run with:
#   cyrius test tests/tcyr/deflate_sync_flush.tcyr
#
# Covers the 2.7.9 surface: `deflate_enc_flush`, `deflate_enc_reset_context`,
# and `deflate_dec_produced`. Filed as
# docs/development/issues/2026-08-23-bote-rfc7692-needs-public-sync-flush.md.
#
# The load-bearing case is `test_rfc7692_framing`, which runs the actual
# RFC 7692 §7.2.1 wire algorithm — flush per message, strip the trailing
# `00 00 FF FF`, re-append it on receive — across a decoder ctx that is
# never allowed to reach a BFINAL=1 block.

include "tests/tcyr/_harness.tcyr"

# The four bytes RFC 7692 §7.2.1 strips from each frame's tail.
var _sf_tail = 0;

fn _sf_init_tail() {
    if (_sf_tail == 0) {
        _sf_tail = alloc(4);
        store8(_sf_tail + 0, 0);
        store8(_sf_tail + 1, 0);
        store8(_sf_tail + 2, 255);
        store8(_sf_tail + 3, 255);
    }
    return 0;
}

# Write a JSON-RPC-shaped message into buf and return its length. `seq`
# varies only the id digit, so successive messages share ~all of their
# bytes — which is the traffic shape context takeover exists for.
fn _sf_msg(buf, seq) {
    # {"jsonrpc":"2.0","id":N,"method":"tools/call","params":{"x":1}}
    var s = 0;
    store8(buf + 0, 123); store8(buf + 1, 34); store8(buf + 2, 106);
    store8(buf + 3, 115); store8(buf + 4, 111); store8(buf + 5, 110);
    store8(buf + 6, 114); store8(buf + 7, 112); store8(buf + 8, 99);
    store8(buf + 9, 34); store8(buf + 10, 58); store8(buf + 11, 34);
    store8(buf + 12, 50); store8(buf + 13, 46); store8(buf + 14, 48);
    store8(buf + 15, 34); store8(buf + 16, 44); store8(buf + 17, 34);
    store8(buf + 18, 105); store8(buf + 19, 100); store8(buf + 20, 34);
    store8(buf + 21, 58); store8(buf + 22, 48 + seq); store8(buf + 23, 44);
    store8(buf + 24, 34); store8(buf + 25, 109); store8(buf + 26, 101);
    store8(buf + 27, 116); store8(buf + 28, 104); store8(buf + 29, 111);
    store8(buf + 30, 100); store8(buf + 31, 34); store8(buf + 32, 58);
    store8(buf + 33, 34); store8(buf + 34, 116); store8(buf + 35, 111);
    store8(buf + 36, 111); store8(buf + 37, 108); store8(buf + 38, 115);
    store8(buf + 39, 47); store8(buf + 40, 99); store8(buf + 41, 97);
    store8(buf + 42, 108); store8(buf + 43, 108); store8(buf + 44, 34);
    store8(buf + 45, 44); store8(buf + 46, 34); store8(buf + 47, 112);
    store8(buf + 48, 97); store8(buf + 49, 114); store8(buf + 50, 97);
    store8(buf + 51, 109); store8(buf + 52, 115); store8(buf + 53, 34);
    store8(buf + 54, 58); store8(buf + 55, 123); store8(buf + 56, 34);
    store8(buf + 57, 120); store8(buf + 58, 34); store8(buf + 59, 58);
    store8(buf + 60, 49); store8(buf + 61, 125); store8(buf + 62, 125);
    s = 63;
    return s;
}

# Assert that c[end-4 .. end) is the `00 00 FF FF` sync-flush marker.
fn _sf_assert_tail(c, end, label) {
    assert(end >= 4, label);
    assert(load8(c + end - 4) == 0, label);
    assert(load8(c + end - 3) == 0, label);
    assert(load8(c + end - 2) == 255, label);
    assert(load8(c + end - 1) == 255, label);
    return 0;
}

# ================================================================
# deflate_enc_flush — marker, framing, stream continuity
# ================================================================

fn test_flush_emits_marker() {
    # A flush must land the stream byte-aligned and end in 00 00 FF FF —
    # the four bytes RFC 7692 §7.2.1 strips.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(512);
    var ctx = deflate_enc_init(6, c, 512);
    assert(ctx != 0, "flush marker init");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "flush marker write");
    var t = deflate_enc_flush(ctx);
    assert(t > 4, "flush marker returns total");
    _sf_assert_tail(c, t, "flush marker tail");
    deflate_enc_finish(ctx);
    return 0;
}

fn test_flush_returns_running_total() {
    # The return is the cumulative dst length, not this call's delta —
    # so a caller can slice dst[prev..cur) as the frame it just closed.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(2048);
    var ctx = deflate_enc_init(6, c, 2048);
    assert(ctx != 0, "flush total init");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "flush total w1");
    var t1 = deflate_enc_flush(ctx);
    assert(deflate_enc_write(ctx, src, mlen) == 0, "flush total w2");
    var t2 = deflate_enc_flush(ctx);
    assert(t2 > t1, "flush total is monotonic");
    _sf_assert_tail(c, t1, "flush total tail1");
    _sf_assert_tail(c, t2, "flush total tail2");
    var total = deflate_enc_finish(ctx);
    assert(total >= t2, "finish total >= last flush");
    return 0;
}

fn test_flush_then_finish_roundtrips() {
    # Flushing mid-stream must not disturb the stream a batch decoder
    # sees: flush, write more, finish → one valid DEFLATE stream whose
    # payload is every byte written, in order.
    var src = alloc(256);
    var i = 0;
    while (i < 200) { store8(src + i, 97 + (i % 7)); i = i + 1; }
    var c = alloc(2048);
    var d = alloc(512);

    var lvl = 1;
    while (lvl <= 9) {
        var ctx = deflate_enc_init(lvl, c, 2048);
        assert(ctx != 0, "flush+finish init");
        assert(deflate_enc_write(ctx, src, 100) == 0, "flush+finish w1");
        var t = deflate_enc_flush(ctx);
        assert(t > 0, "flush+finish flush rc");
        _sf_assert_tail(c, t, "flush+finish tail");
        assert(deflate_enc_write(ctx, src + 100, 100) == 0, "flush+finish w2");
        var clen = deflate_enc_finish(ctx);
        assert(clen > t, "flush+finish clen");

        var dlen = deflate_decompress(c, clen, d, 512);
        assert(dlen == 200, "flush+finish dlen");
        var j = 0;
        while (j < 200) {
            assert(load8(d + j) == load8(src + j), "flush+finish content");
            j = j + 1;
        }
        lvl = lvl + 1;
    }
    return 0;
}

fn test_flush_empty_stream() {
    # Flush with nothing written: no block is open on either path, so the
    # marker stands alone and finish still terminates a valid empty stream.
    var c = alloc(64);
    var d = alloc(16);

    var lvl = 1;
    while (lvl <= 9) {
        var ctx = deflate_enc_init(lvl, c, 64);
        assert(ctx != 0, "flush empty init");
        var t = deflate_enc_flush(ctx);
        assert(t > 0, "flush empty rc");
        _sf_assert_tail(c, t, "flush empty tail");
        var clen = deflate_enc_finish(ctx);
        assert(clen > 0, "flush empty finish");
        assert(deflate_decompress(c, clen, d, 16) == 0, "flush empty dlen");
        lvl = lvl + 4;
    }
    return 0;
}

fn test_flush_repeated_no_data() {
    # Back-to-back flushes with no intervening write. Each must emit only
    # the bare marker — no dynamic header carrying nothing but EOB — and
    # the stream must stay decodable.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(1024);
    var d = alloc(256);
    var ctx = deflate_enc_init(6, c, 1024);
    assert(ctx != 0, "flush repeat init");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "flush repeat write");
    var t1 = deflate_enc_flush(ctx);
    var t2 = deflate_enc_flush(ctx);
    var t3 = deflate_enc_flush(ctx);
    # A data-free flush is exactly the 5-byte empty stored block
    # (aligned header byte + LEN + NLEN).
    assert(t2 - t1 == 5, "flush repeat is bare marker");
    assert(t3 - t2 == 5, "flush repeat stays bare");
    _sf_assert_tail(c, t3, "flush repeat tail");
    var clen = deflate_enc_finish(ctx);
    assert(deflate_decompress(c, clen, d, 256) == mlen, "flush repeat dlen");
    var j = 0;
    while (j < mlen) {
        assert(load8(d + j) == load8(src + j), "flush repeat content");
        j = j + 1;
    }
    return 0;
}

fn test_flush_buffer_too_small() {
    # A flush that cannot fit the marker must report the overflow and
    # poison the ctx rather than writing past dst.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(8);
    var ctx = deflate_enc_init(6, c, 8);
    assert(ctx != 0, "flush small init");
    deflate_enc_write(ctx, src, mlen);
    assert(deflate_enc_flush(ctx) < 0, "flush small errors");
    assert(deflate_enc_finish(ctx) < 0, "flush small sticky");
    return 0;
}

# ================================================================
# RFC 7692 §7.2.1 — the wire algorithm end to end
# ================================================================

fn test_rfc7692_framing() {
    # Three messages, each framed the way RFC 7692 §7.2.1 specifies:
    # compress, sync flush, drop the trailing 00 00 FF FF. The receiver
    # appends those four bytes back and inflates — against a decoder ctx
    # that never sees a BFINAL=1 block, because the stream is deliberately
    # never ended. `deflate_dec_produced` is the only way to read each
    # message's length out of that ctx.
    _sf_init_tail();
    var m0 = alloc(64); var l0 = _sf_msg(m0, 1);
    var m1 = alloc(64); var l1 = _sf_msg(m1, 2);
    var m2 = alloc(64); var l2 = _sf_msg(m2, 3);

    var c = alloc(2048);
    var ctx = deflate_enc_init(6, c, 2048);
    assert(ctx != 0, "rfc7692 enc init");
    assert(deflate_enc_write(ctx, m0, l0) == 0, "rfc7692 w0");
    var t0 = deflate_enc_flush(ctx);
    assert(deflate_enc_write(ctx, m1, l1) == 0, "rfc7692 w1");
    var t1 = deflate_enc_flush(ctx);
    assert(deflate_enc_write(ctx, m2, l2) == 0, "rfc7692 w2");
    var t2 = deflate_enc_flush(ctx);
    assert(t0 > 0 && t1 > t0 && t2 > t1, "rfc7692 frame offsets");
    # Encoder must release _sankoch_mtx before the decoder can take it.
    deflate_enc_finish(ctx);

    _sf_assert_tail(c, t0, "rfc7692 tail0");
    _sf_assert_tail(c, t1, "rfc7692 tail1");
    _sf_assert_tail(c, t2, "rfc7692 tail2");

    var d = alloc(512);
    var dctx = deflate_dec_init(d, 512);
    assert(dctx != 0, "rfc7692 dec init");

    # --- frame 0 ---
    assert(deflate_dec_write(dctx, c, t0 - 4) == t0 - 4, "rfc7692 f0 body");
    assert(deflate_dec_write(dctx, _sf_tail, 4) == 4, "rfc7692 f0 tail");
    var p0 = deflate_dec_produced(dctx);
    assert(p0 == l0, "rfc7692 f0 produced");
    var j = 0;
    while (j < l0) { assert(load8(d + j) == load8(m0 + j), "rfc7692 f0 bytes"); j = j + 1; }

    # --- frame 1 ---
    assert(deflate_dec_write(dctx, c + t0, t1 - t0 - 4) == t1 - t0 - 4, "rfc7692 f1 body");
    assert(deflate_dec_write(dctx, _sf_tail, 4) == 4, "rfc7692 f1 tail");
    var p1 = deflate_dec_produced(dctx);
    assert(p1 - p0 == l1, "rfc7692 f1 produced");
    j = 0;
    while (j < l1) { assert(load8(d + p0 + j) == load8(m1 + j), "rfc7692 f1 bytes"); j = j + 1; }

    # --- frame 2 ---
    assert(deflate_dec_write(dctx, c + t1, t2 - t1 - 4) == t2 - t1 - 4, "rfc7692 f2 body");
    assert(deflate_dec_write(dctx, _sf_tail, 4) == 4, "rfc7692 f2 tail");
    var p2 = deflate_dec_produced(dctx);
    assert(p2 - p1 == l2, "rfc7692 f2 produced");
    j = 0;
    while (j < l2) { assert(load8(d + p1 + j) == load8(m2 + j), "rfc7692 f2 bytes"); j = j + 1; }

    # The stream never reached BFINAL=1, so dec_finish reports the
    # incomplete stream — its job here is releasing _sankoch_mtx. A
    # permessage-deflate consumer calls it for the unlock and ignores
    # the return; `deflate_dec_produced` is the length oracle.
    assert(deflate_dec_finish(dctx) == 0 - ERR_CORRUPT_DATA, "rfc7692 finish unlocks");
    return 0;
}

fn test_context_takeover_shrinks_repeats() {
    # The point of not ending the stream: message 2 is byte-identical to
    # message 1, so with the window retained it must encode far smaller.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(2048);
    var ctx = deflate_enc_init(6, c, 2048);
    assert(ctx != 0, "takeover init");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "takeover w1");
    var t1 = deflate_enc_flush(ctx);
    assert(deflate_enc_write(ctx, src, mlen) == 0, "takeover w2");
    var t2 = deflate_enc_flush(ctx);
    deflate_enc_finish(ctx);

    var f1 = t1;
    var f2 = t2 - t1;
    assert(f2 < f1, "takeover: repeat frame is smaller");
    # A 63-byte repeat should collapse to a back-reference plus the
    # marker — well under half the first frame.
    assert(f2 * 2 < f1, "takeover: repeat frame is much smaller");
    return 0;
}

# ================================================================
# deflate_enc_reset_context
# ================================================================

fn test_reset_context_drops_history() {
    # With the context reset between messages (RFC 7692
    # `*_no_context_takeover`), the identical repeat must NOT shrink —
    # it costs the same as the first message did.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(2048);
    var ctx = deflate_enc_init(6, c, 2048);
    assert(ctx != 0, "reset init");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "reset w1");
    var t1 = deflate_enc_flush(ctx);
    assert(deflate_enc_reset_context(ctx) == 0, "reset rc");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "reset w2");
    var t2 = deflate_enc_flush(ctx);
    deflate_enc_finish(ctx);

    var f1 = t1;
    var f2 = t2 - t1;
    assert(f2 == f1, "reset: repeat frame costs the same");
    return 0;
}

fn test_reset_context_roundtrips() {
    # A reset must not corrupt the bitstream — the whole thing still
    # decodes to every byte written, in order.
    var m0 = alloc(64); var l0 = _sf_msg(m0, 1);
    var m1 = alloc(64); var l1 = _sf_msg(m1, 2);
    var c = alloc(2048);
    var d = alloc(512);

    var lvl = 1;
    while (lvl <= 9) {
        var ctx = deflate_enc_init(lvl, c, 2048);
        assert(ctx != 0, "reset rt init");
        assert(deflate_enc_write(ctx, m0, l0) == 0, "reset rt w0");
        deflate_enc_flush(ctx);
        assert(deflate_enc_reset_context(ctx) == 0, "reset rt reset");
        assert(deflate_enc_write(ctx, m1, l1) == 0, "reset rt w1");
        var clen = deflate_enc_finish(ctx);
        assert(clen > 0, "reset rt clen");

        assert(deflate_decompress(c, clen, d, 512) == l0 + l1, "reset rt dlen");
        var j = 0;
        while (j < l0) { assert(load8(d + j) == load8(m0 + j), "reset rt m0"); j = j + 1; }
        j = 0;
        while (j < l1) { assert(load8(d + l0 + j) == load8(m1 + j), "reset rt m1"); j = j + 1; }
        lvl = lvl + 5;
    }
    return 0;
}

fn test_reset_context_rejects_open_block() {
    # Resetting mid-block would strand symbols that reference history the
    # reset discards. Both paths must refuse, and refuse without damage:
    # the stream still finishes and round-trips.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(1024);
    var d = alloc(256);

    var lvl = 1;
    while (lvl <= 6) {
        var ctx = deflate_enc_init(lvl, c, 1024);
        assert(ctx != 0, "reset guard init");
        assert(deflate_enc_write(ctx, src, mlen) == 0, "reset guard write");
        assert(deflate_enc_reset_context(ctx) == 0 - ERR_INVALID_INPUT,
          "reset guard rejects open block");
        var clen = deflate_enc_finish(ctx);
        assert(deflate_decompress(c, clen, d, 256) == mlen, "reset guard undamaged");
        lvl = lvl + 5;
    }
    return 0;
}

fn test_reset_context_before_first_write() {
    # Nothing buffered, nothing open: a reset is a no-op that must be
    # allowed, so a consumer can apply the negotiated parameter
    # unconditionally at the top of its send loop.
    var src = alloc(64);
    var mlen = _sf_msg(src, 1);
    var c = alloc(1024);
    var d = alloc(256);
    var ctx = deflate_enc_init(6, c, 1024);
    assert(ctx != 0, "reset first init");
    assert(deflate_enc_reset_context(ctx) == 0, "reset before first write");
    assert(deflate_enc_write(ctx, src, mlen) == 0, "reset first write");
    var clen = deflate_enc_finish(ctx);
    assert(deflate_decompress(c, clen, d, 256) == mlen, "reset first rt");
    return 0;
}

# ================================================================
# deflate_dec_produced
# ================================================================

fn test_dec_produced_tracks_output() {
    # The cursor must advance with the decoder, be readable mid-stream,
    # and agree with dec_finish once the stream does end.
    var src = alloc(256);
    var i = 0;
    while (i < 200) { store8(src + i, 97 + (i % 11)); i = i + 1; }
    var c = alloc(1024);
    var clen = deflate_compress(src, 200, c, 1024);
    assert(clen > 0, "produced setup clen");

    var d = alloc(512);
    var dctx = deflate_dec_init(d, 512);
    assert(dctx != 0, "produced init");
    assert(deflate_dec_produced(dctx) == 0, "produced starts at 0");

    var fed = 0;
    var last = 0;
    while (fed < clen) {
        var take = clen - fed;
        if (take > 8) { take = 8; }
        deflate_dec_write(dctx, c + fed, take);
        var p = deflate_dec_produced(dctx);
        assert(p >= last, "produced is monotonic");
        assert(p <= 200, "produced never overruns");
        last = p;
        fed = fed + take;
    }
    assert(last == 200, "produced reaches full length");
    assert(deflate_dec_finish(dctx) == 200, "produced agrees with finish");
    return 0;
}

fn test_dec_produced_reports_error() {
    # A poisoned ctx must surface the sticky error, not a stale cursor —
    # otherwise a consumer would read a length out of a dead stream.
    var c = alloc(8);
    store8(c + 0, 7); store8(c + 1, 0); store8(c + 2, 0);
    store8(c + 3, 0); store8(c + 4, 0); store8(c + 5, 0);
    var d = alloc(64);
    var dctx = deflate_dec_init(d, 64);
    assert(dctx != 0, "produced err init");
    assert(deflate_dec_write(dctx, c, 6) < 0, "produced err write");
    assert(deflate_dec_produced(dctx) < 0, "produced surfaces error");
    deflate_dec_finish(dctx);
    return 0;
}

# ================================================================
# main
# ================================================================

fn main() {
    _test_init();
    test_flush_emits_marker();
    test_flush_returns_running_total();
    test_flush_then_finish_roundtrips();
    test_flush_empty_stream();
    test_flush_repeated_no_data();
    test_flush_buffer_too_small();
    test_rfc7692_framing();
    test_context_takeover_shrinks_repeats();
    test_reset_context_drops_history();
    test_reset_context_roundtrips();
    test_reset_context_rejects_open_block();
    test_reset_context_before_first_write();
    test_dec_produced_tracks_output();
    test_dec_produced_reports_error();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
