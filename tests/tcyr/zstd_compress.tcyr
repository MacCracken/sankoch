# sankoch — zstd — compress (store-mode encode: Raw/RLE blocks, round-trip)
#
# 2.5.5 bite 1: `zstd_compress` emits valid RFC-8878 frames (single_segment,
# Raw + RLE blocks). This suite round-trips encode → `zstd_decompress` →
# byte-identical (no reference-tool dependency, so it runs in CI). Reference
# `zstd -d` interop is covered by `scripts/zstd-encode-smoke.sh`.
#
# Part of the split test suite (see _harness.tcyr). Run with:
#   cyrius test tests/tcyr/zstd_compress.tcyr

include "tests/tcyr/_harness.tcyr"

# Compress src[0..n) with zstd_compress, decode with zstd_decompress, assert
# the result is byte-identical to src. Returns the compressed length.
fn _z_rt(src, n, label) {
    var comp = alloc(n * 2 + 4096);
    var clen = zstd_compress(src, n, comp, n * 2 + 4096);
    assert(clen > 0 || n == 0, "zstd_compress produced a stream");
    if (clen < 0) { assert(0 == 1, label); return clen; }
    var dec = alloc(n + 16);
    var dl = zstd_decompress(comp, clen, dec, n + 16);
    assert(dl == n, label);
    var i = 0;
    var ok = 1;
    while (i < n) {
        if (load8(dec + i) != load8(src + i)) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, label);
    return clen;
}

# Same, but compress at an explicit level via zstd_compress_level.
fn _z_rt_lvl(src, n, level, label) {
    var comp = alloc(n * 2 + 4096);
    var clen = zstd_compress_level(src, n, comp, n * 2 + 4096, level);
    if (clen < 0) { assert(0 == 1, label); return clen; }
    var dec = alloc(n + 16);
    var dl = zstd_decompress(comp, clen, dec, n + 16);
    assert(dl == n, label);
    var i = 0;
    var ok = 1;
    while (i < n) {
        if (load8(dec + i) != load8(src + i)) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, label);
    return clen;
}

# Empty input → a valid empty frame that decodes to 0 bytes.
fn test_zc_empty() {
    var src = alloc(1);
    _z_rt(src, 0, "zstd_encode empty");
    return 0;
}

# A single byte.
fn test_zc_one() {
    var src = alloc(1);
    store8(src, 65);
    _z_rt(src, 1, "zstd_encode one byte");
    return 0;
}

# All-zeros small → RLE block.
fn test_zc_rle_small() {
    var n = 1000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 0); i = i + 1; }
    var clen = _z_rt(src, n, "zstd_encode zeros -> RLE");
    assert(clen < 20, "zstd_encode RLE is tiny (header + 1 byte)");
    return 0;
}

# A run of a non-zero byte, at the RLE/raw boundary sizes.
fn test_zc_rle_const() {
    var n = 255;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 88); i = i + 1; }
    _z_rt(src, n, "zstd_encode const 255 -> RLE (1-byte fcs)");
    var n2 = 256;
    var src2 = alloc(n2);
    i = 0;
    while (i < n2) { store8(src2 + i, 88); i = i + 1; }
    _z_rt(src2, n2, "zstd_encode const 256 -> RLE (2-byte fcs)");
    return 0;
}

# Compressible text → Raw block (store mode doesn't Huffman yet, but must
# still round-trip exactly).
fn test_zc_text() {
    var n = 4000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 97 + (i % 26)); i = i + 1; }
    _z_rt(src, n, "zstd_encode text -> Raw");
    return 0;
}

# Incompressible random → Raw block.
fn test_zc_random() {
    var n = 4096;
    var src = alloc(n);
    var st = 88172645463325252;
    var i = 0;
    while (i < n) {
        st = st * 6364136223846793005 + 1442695040888963407;
        store8(src + i, (st >> 33) & 255);
        i = i + 1;
    }
    _z_rt(src, n, "zstd_encode random -> Raw");
    return 0;
}

# Block-boundary sizes: exactly 128 KiB (one block) and just over (two blocks).
fn test_zc_block_boundary() {
    var n = 131072;
    var src = alloc(n + 64);
    var i = 0;
    while (i < n + 64) { store8(src + i, 97 + (i % 26)); i = i + 1; }
    _z_rt(src, n, "zstd_encode exactly 128 KiB (1 block)");
    _z_rt(src, n + 1, "zstd_encode 128 KiB + 1 (2 blocks)");
    _z_rt(src, n + 50, "zstd_encode 128 KiB + 50 (2 blocks)");
    return 0;
}

# Multi-block all-zeros → RLE blocks across the 128 KiB boundary.
fn test_zc_multiblock_rle() {
    var n = 300000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 0); i = i + 1; }
    var clen = _z_rt(src, n, "zstd_encode 300 KB zeros -> multi RLE");
    assert(clen < 40, "zstd_encode multi-RLE stays tiny");
    return 0;
}

# Compressible small text (<= 1023) → Huffman Compressed block; must both
# round-trip and actually shrink (2.5.5 bite 2).
fn test_zc_huff_text() {
    var n = 900;
    var src = alloc(n);
    var i = 0;
    while (i < n) {
        var b = 97 + (i % 12);       # 12-symbol low-entropy text
        if ((i % 5) == 0) { b = 32; }
        store8(src + i, b);
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode text -> Huffman");
    assert(clen < n, "zstd_encode Huffman actually compresses text");
    return 0;
}

# Skewed (Fibonacci) frequencies force a Huffman tree deeper than 11 bits,
# exercising the length-limiter's Kraft-exact repair. Must round-trip.
fn test_zc_huff_length_limit() {
    var src = alloc(1100);
    var n = 0;
    var a = 1; var b = 1;
    var s = 0;
    while (s < 14) {
        var r = 0;
        while (r < a && n < 1000) { store8(src + n, 65 + s); n = n + 1; r = r + 1; }
        var t = a + b; a = b; b = t;
        s = s + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode deep tree -> length limiter");
    assert(clen < n, "zstd_encode Huffman compresses skewed input");
    return 0;
}

# A spread of small random-ish distributions must all round-trip (self-check
# for the entropy path; reference-zstd interop lives in the smoke script).
fn test_zc_huff_random_spread() {
    var st = 1234567;
    var trial = 0;
    while (trial < 12) {
        var n = 16 + (trial * 83);
        if (n > 1000) { n = 1000; }
        var src = alloc(n);
        var kk = 2 + (trial % 60);          # alphabet size
        var i = 0;
        while (i < n) {
            st = st * 6364136223846793005 + 1442695040888963407;
            var v = (st >> 40) % (kk * kk);
            if (v >= kk) { v = v % kk; }     # bias toward low symbols
            store8(src + i, 40 + v);
            i = i + 1;
        }
        _z_rt(src, n, "zstd_encode random spread round-trip");
        trial = trial + 1;
    }
    return 0;
}

# Large compressible text (> 1023) uses 4-stream Huffman literals (one shared
# table). Must round-trip and shrink (2.5.5 bite 3a).
fn test_zc_huff_4stream() {
    var n = 8000;
    var src = alloc(n);
    var i = 0;
    while (i < n) {
        var b = 97 + (i % 16);
        if ((i % 9) == 0) { b = 32; }
        store8(src + i, b);
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode 4-stream Huffman");
    assert(clen < (n * 3) / 4, "zstd_encode 4-stream compresses text >= 25%");
    return 0;
}

# A full 128 KiB block Huffman-compressed as a single 4-stream literals
# section (exercises the largest single-table path + sizefmt 3).
fn test_zc_huff_128k() {
    var n = 131072;
    var src = alloc(n);
    var i = 0;
    while (i < n) {
        var b = 97 + (i % 20);
        if ((i % 11) == 0) { b = 32; }
        store8(src + i, b);
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode 128 KiB 4-stream");
    assert(clen < n, "zstd_encode 128 KiB block compresses");
    return 0;
}

# Wide alphabet, INCOMPRESSIBLE (random full range): Huffman can't help, so this
# falls back to a store block and must still round-trip byte-exact. Compressible
# wide-alphabet literals (maxsym>128) take the FSE-weight path — see
# test_zc_fse_weights.
fn test_zc_wide_alphabet() {
    var n = 4000;
    var src = alloc(n);
    var st = 777;
    var i = 0;
    while (i < n) {
        st = st * 6364136223846793005 + 1442695040888963407;
        store8(src + i, (st >> 40) & 255);   # full 0..255 range
        i = i + 1;
    }
    _z_rt(src, n, "zstd_encode wide alphabet -> store, round-trips");
    return 0;
}

# Skewed distribution over the FULL byte range (2.5.6 FSE-compressed literal
# weights). 75% of bytes fall in {0..7}; 25% spread over {128..255}, so the
# max symbol value exceeds 128 — the direct weight table (header 127+nw, nw<=128)
# can't represent it, forcing the FSE-compressed weight path. The skew keeps
# literal entropy well under 8 bits, so the Huffman literals block must win.
# Round-trips through our decoder; reference `zstd -d` interop is in the smoke.
fn test_zc_fse_weights() {
    var n = 12000;
    var src = alloc(n);
    var st = 424242;
    var i = 0;
    while (i < n) {
        st = st * 6364136223846793005 + 1442695040888963407;
        if (((st >> 33) & 3) == 0) {
            store8(src + i, 128 + ((st >> 40) & 127));   # 25% -> 128..255 (maxsym > 128)
        } else {
            store8(src + i, (st >> 40) & 7);             # 75% -> 0..7 (skew)
        }
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode FSE literal weights (maxsym>128)");
    assert(clen < (n * 7) / 10, "zstd_encode FSE-weight literals compress");
    return 0;
}

# Repetitive input with clear matches → an LZ77 + FSE-sequences Compressed
# block (2.5.5 bite 3b-2). Must round-trip and compress hard.
fn test_zc_seq_matches() {
    var n = 6000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 97 + (i % 40)); i = i + 1; }   # period 40 -> long matches
    var clen = _z_rt(src, n, "zstd_encode LZ77+FSE sequences");
    assert(clen * 8 < n, "zstd_encode sequences compress repetitive > 8:1");
    return 0;
}

# Literals interleaved with matches — exercises many sequences with varied
# LL/ML/OF codes + trailing literals.
fn test_zc_seq_mixed() {
    var n = 5000;
    var src = alloc(n);
    var st = 12345;
    var i = 0;
    while (i < n) {
        if ((i % 100) < 60 && i > 100) {
            store8(src + i, load8(src + i - 80));            # copy-y region -> matches
        } else {
            st = st * 6364136223846793005 + 1442695040888963407;
            store8(src + i, 97 + ((st >> 40) % 20));         # literal noise
        }
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode mixed literals+matches");
    assert(clen < n, "zstd_encode mixed compresses");
    return 0;
}

# Decoder robustness (2.5.6 hardening). Hostile / truncated inputs must return a
# negative error, never crash or hang. These run in-process, so a crash would abort
# the whole suite — surviving to the assert IS the memory-safety guarantee. The
# fuzz harness (fuzz/fuzz_zstd.fcyr) covers this broadly; these lock in specific
# regressions, notably the 34-byte raw-block-overflow that motivated the hardening.
fn _z_expect_err(src, n, label) {
    var dst = alloc(8192);
    var r = zstd_decompress(src, n, dst, 8192);   # bounded dst -> overflows must be caught
    assert(r < 0, label);
    return 0;
}

fn test_zc_malformed_survive() {
    # Exact 34-byte repro: raw block header decodes bsize ~2M; the copy used to read
    # past the input and write past dst before the (too-late) capacity check.
    var c = alloc(64);
    store8(c + 0, 0x28); store8(c + 1, 0xB5); store8(c + 2, 0x2F); store8(c + 3, 0xFD);
    store8(c + 4, 0xA1); store8(c + 5, 0x28); store8(c + 6, 0xB1); store8(c + 7, 0xF4);
    store8(c + 8, 0x51); store8(c + 9, 0xFF); store8(c + 10, 0xF4); store8(c + 11, 0xB7);
    store8(c + 12, 0xCE); store8(c + 13, 0x74); store8(c + 14, 0x2D); store8(c + 15, 0x45);
    store8(c + 16, 0x43); store8(c + 17, 0xBE); store8(c + 18, 0xED); store8(c + 19, 0x2C);
    store8(c + 20, 0x4A); store8(c + 21, 0xA2); store8(c + 22, 0x36); store8(c + 23, 0xD3);
    store8(c + 24, 0xCB); store8(c + 25, 0x81); store8(c + 26, 0xF6); store8(c + 27, 0x60);
    store8(c + 28, 0x62); store8(c + 29, 0x8A); store8(c + 30, 0xD8); store8(c + 31, 0x0B);
    store8(c + 32, 0xDF); store8(c + 33, 0x00);
    _z_expect_err(c, 34, "zstd_decode 34-byte raw-overflow repro survives");

    # magic only + one FHD byte, nothing after -> truncated frame header
    var t = alloc(8);
    store8(t + 0, 0x28); store8(t + 1, 0xB5); store8(t + 2, 0x2F); store8(t + 3, 0xFD);
    store8(t + 4, 0x00);
    _z_expect_err(t, 5, "zstd_decode truncated header survives");

    # valid single-segment header, then a Raw block header claiming a huge size with no body
    var g = alloc(16);
    store8(g + 0, 0x28); store8(g + 1, 0xB5); store8(g + 2, 0x2F); store8(g + 3, 0xFD);
    store8(g + 4, 0x20);                                   # FHD: single-segment, fcs_flag=0 -> fcs 1 byte
    store8(g + 5, 0x00);                                   # frame content size byte
    store8(g + 6, 0xF9); store8(g + 7, 0xFF); store8(g + 8, 0xFF);   # block hdr: last, Raw, bsize huge
    _z_expect_err(g, 9, "zstd_decode huge raw block header survives");

    # magic + FHD + Compressed block header with truncated literals section
    var k = alloc(16);
    store8(k + 0, 0x28); store8(k + 1, 0xB5); store8(k + 2, 0x2F); store8(k + 3, 0xFD);
    store8(k + 4, 0x00);                                   # FHD: window-descriptor present
    store8(k + 5, 0x00);                                   # window descriptor
    store8(k + 6, 0x15); store8(k + 7, 0x00); store8(k + 8, 0x00);   # block hdr: last, Compressed, small
    store8(k + 9, 0xFF); store8(k + 10, 0xFF);             # bogus literals header, then EOF
    _z_expect_err(k, 11, "zstd_decode truncated compressed block survives");
    return 0;
}

# Repeat-offset codes (2.5.6). Records of a varying 5-byte prefix + an 11-byte
# constant tail: the tail recurs at a fixed offset every 16 bytes, so hundreds of
# short matches share one offset. Each after the first is emitted as Offset_Value 1
# (offset code 0, zero extra bits) rather than a literal offset — a silent regression
# to literal offsets would inflate the offset stream and break the ratio bound.
fn test_zc_repeat_offsets() {
    var n = 16000;
    var src = alloc(n);
    var st = 99;
    var i = 0;
    while (i < n) {
        if ((i % 16) < 5) {
            st = st * 6364136223846793005 + 1442695040888963407;
            store8(src + i, 65 + ((st >> 40) % 26));    # varying prefix -> literals
        } else {
            store8(src + i, 100 + (i % 16));            # constant tail -> match at offset 16
        }
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode repeat-offset recurring matches");
    assert(clen * 2 < n, "zstd_encode repeat offsets compress recurring-offset data");
    return 0;
}

# Compression-level knob (2.5.6). The same semi-compressible input at every level
# 1..9 must round-trip byte-exact, and a deeper level must never compress worse than
# a shallower one (level 9 <= level 1) — a monotonicity check on the match-finder knob.
fn test_zc_level_knob() {
    var n = 20000;
    var src = alloc(n);
    var st = 7;
    var i = 0;
    while (i < n) {
        if ((i % 20) < 12 && i > 40) {
            store8(src + i, load8(src + i - 37));           # recurring fragment -> matches
        } else {
            st = st * 6364136223846793005 + 1442695040888963407;
            store8(src + i, 97 + ((st >> 40) % 24));        # literal noise
        }
        i = i + 1;
    }
    var c1 = _z_rt_lvl(src, n, 1, "zstd_encode level 1 round-trips");
    _z_rt_lvl(src, n, 3, "zstd_encode level 3 round-trips");
    _z_rt_lvl(src, n, 6, "zstd_encode level 6 round-trips");
    var c9 = _z_rt_lvl(src, n, 9, "zstd_encode level 9 round-trips");
    assert(c9 <= c1, "zstd_encode deeper level compresses at least as well");
    return 0;
}

# Adaptive FSE sequence tables (2.5.7). Structured records — 6 varying digits + 34
# constant bytes per 40-byte record — produce hundreds of sequences with sharply
# skewed LL/ML/OF distributions. The Predefined tables code these generically; the
# adaptive FSE_Compressed tables fit the actual histogram and compress ~2× tighter.
# A regression to Predefined-only would blow past the ratio bound. Reference-`zstd -d`
# interop for the FSE-table wire format is in scripts/zstd-encode-smoke.sh.
fn test_zc_adaptive_fse() {
    var n = 40000;
    var src = alloc(n);
    var st = 12345;
    var i = 0;
    while (i < n) {
        var col = i % 40;
        if (col < 6) {
            st = st * 6364136223846793005 + 1442695040888963407;
            store8(src + i, 48 + ((st >> 40) % 10));      # varying digits
        } else {
            store8(src + i, 65 + col);                    # constant record body
        }
        i = i + 1;
    }
    var clen = _z_rt(src, n, "zstd_encode adaptive FSE sequence tables");
    assert(clen * 8 < n, "zstd_encode adaptive FSE tables compress structured data");
    return 0;
}

# ---- 2.5.8 priced-parse regression fixtures --------------------------------
# Shared scratch for _zt_dec (one lazy alloc — the harness heap is 4 MB and these
# builders run thousands of iterations).
var _zt_dbuf = 0;

# Append `v` as decimal digits at dst+off (zero-padded to width `w`; natural width
# when w == 0). Returns the new offset.
fn _zt_dec(dst, off, v, w) {
    if (_zt_dbuf == 0) { _zt_dbuf = alloc(32); }
    var k = 0;
    var x = v;
    if (x == 0) { store8(_zt_dbuf, 48); k = 1; }
    while (x > 0) { store8(_zt_dbuf + k, 48 + x % 10); k = k + 1; x = x / 10; }
    while (k < w) { store8(_zt_dbuf + k, 48); k = k + 1; }
    var j = k - 1;
    while (j >= 0) { store8(dst + off, load8(_zt_dbuf + j)); off = off + 1; j = j - 1; }
    return off;
}

# Append `n` bytes of a deterministic printable constant run (the invariant part of
# a record, e.g. the `,"name":"item-` between two varying fields).
fn _zt_const(dst, off, p, n) {
    var k = 0;
    while (k < n) {
        store8(dst + off, 32 + ((p + k) * 7) % 90);
        off = off + 1;
        k = k + 1;
    }
    return off;
}

# Record-structured data: constant field separators around a MONOTONICALLY DRIFTING
# counter plus two cycling fields, spanning more than one 128 KiB block. This is the
# shape the 2.5.7 encoder handled worst. Its greedy-longest parse matched the record
# body at an offset that grew by exactly one per record, so the offset never equalled
# a recent offset and every record paid a full ~16-bit literal offset. The 2.5.8
# priced parse (`_ze_mvalue`) spends one extra literal instead and lands on a repeat
# code, which costs ~0 offset bits (16.47x here, against 2.5.7's 16.05x).
#
# The bound below is deliberately slack — it catches a gross parse regression, not the
# 2.5.7 defect specifically. `test_zc_lazy_beats_greedy` is the sharp tripwire for that.
fn test_zc_record_parse() {
    var cap = 262144;
    var src = alloc(cap);
    var off = 0;
    var i = 0;
    while (i < 3000 && off + 96 < cap) {
        off = _zt_const(src, off, 0, 10);
        off = _zt_dec(src, off, i, 0);          # drifting counter -> a far, +1 offset
        off = _zt_const(src, off, 10, 22);
        off = _zt_dec(src, off, i % 733, 4);    # cycling field
        off = _zt_const(src, off, 32, 10);
        off = _zt_dec(src, off, i % 90, 0);
        off = _zt_const(src, off, 42, 18);
        i = i + 1;
    }
    var c = _z_rt(src, off, "zstd_encode record-structured data round-trips");
    assert(c * 15 < off, "zstd_encode prices record-structured data past 15x");
    return 0;
}

# Ascending decimal integers — the pathological input for a LENGTH-based lazy accept
# test. At 2.5.7 merely turning the lookahead on (level 1 -> level 2) made this input
# ~67 % BIGGER, because a one-byte-longer match at a fresh 16-bit offset outranked a
# repeat code and broke the repcode run that let the offset stream encode as RLE. The
# priced accept test makes the deeper levels monotone here, so both assertions below
# are regression tripwires for that defect: 2.5.7 fails both.
fn test_zc_lazy_beats_greedy() {
    var cap = 120000;
    var src = alloc(cap);
    var off = 0;
    var i = 1;
    while (i < 20000 && off + 8 < cap) {
        off = _zt_dec(src, off, i, 0);
        store8(src + off, 32);
        off = off + 1;
        i = i + 1;
    }
    var c1 = _z_rt_lvl(src, off, 1, "zstd_encode ascending integers level 1");
    var c2 = _z_rt_lvl(src, off, 2, "zstd_encode ascending integers level 2");
    var c6 = _z_rt_lvl(src, off, 6, "zstd_encode ascending integers level 6");
    assert(c2 <= c1, "zstd_encode lazy parse never loses to greedy on regular data");
    assert(c6 <= c1, "zstd_encode default level never loses to greedy on regular data");
    return 0;
}

fn main() {
    _test_init();
    test_zc_record_parse();
    test_zc_lazy_beats_greedy();
    test_zc_malformed_survive();
    test_zc_repeat_offsets();
    test_zc_level_knob();
    test_zc_adaptive_fse();
    test_zc_seq_matches();
    test_zc_seq_mixed();
    test_zc_empty();
    test_zc_one();
    test_zc_rle_small();
    test_zc_rle_const();
    test_zc_text();
    test_zc_random();
    test_zc_block_boundary();
    test_zc_multiblock_rle();
    test_zc_huff_text();
    test_zc_huff_length_limit();
    test_zc_huff_random_spread();
    test_zc_huff_4stream();
    test_zc_huff_128k();
    test_zc_wide_alphabet();
    test_zc_fse_weights();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
