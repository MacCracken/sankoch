# sankoch — bzip2 — decompress (real `bzip2` fixtures, corruption)
#
# Part of the split test suite (see _harness.tcyr). Run with:
#   cyrius test tests/tcyr/bzip2_decompress.tcyr

include "tests/tcyr/_harness.tcyr"

# small text (61 compressed -> 19 bytes)
fn test_bzip2_dec_hello() {
    var comp = alloc(61);
    store8(comp + 0, 66); store8(comp + 1, 90); store8(comp + 2, 104); store8(comp + 3, 57);
    store8(comp + 4, 49); store8(comp + 5, 65); store8(comp + 6, 89); store8(comp + 7, 38);
    store8(comp + 8, 83); store8(comp + 9, 89); store8(comp + 10, 174); store8(comp + 11, 7);
    store8(comp + 12, 65); store8(comp + 13, 97); store8(comp + 14, 0); store8(comp + 15, 0);
    store8(comp + 16, 2); store8(comp + 17, 157); store8(comp + 18, 128); store8(comp + 19, 96);
    store8(comp + 20, 4); store8(comp + 21, 16); store8(comp + 22, 0); store8(comp + 23, 0);
    store8(comp + 24, 64); store8(comp + 25, 22); store8(comp + 26, 36); store8(comp + 27, 208);
    store8(comp + 28, 144); store8(comp + 29, 32); store8(comp + 30, 0); store8(comp + 31, 49);
    store8(comp + 32, 76); store8(comp + 33, 0); store8(comp + 34, 1); store8(comp + 35, 8);
    store8(comp + 36, 30); store8(comp + 37, 166); store8(comp + 38, 105); store8(comp + 39, 54);
    store8(comp + 40, 166); store8(comp + 41, 116); store8(comp + 42, 13); store8(comp + 43, 1);
    store8(comp + 44, 80); store8(comp + 45, 175); store8(comp + 46, 219); store8(comp + 47, 100);
    store8(comp + 48, 140); store8(comp + 49, 47); store8(comp + 50, 139); store8(comp + 51, 185);
    store8(comp + 52, 34); store8(comp + 53, 156); store8(comp + 54, 40); store8(comp + 55, 72);
    store8(comp + 56, 87); store8(comp + 57, 3); store8(comp + 58, 160); store8(comp + 59, 176);
    store8(comp + 60, 128);
    var out = alloc(19);
    var dlen = bzip2_decompress(comp, 61, out, 19);
    assert(dlen == 19, "bzip2_dec_hello dlen");
    var exp = alloc(19);
    store8(exp + 0, 72); store8(exp + 1, 101); store8(exp + 2, 108); store8(exp + 3, 108);
    store8(exp + 4, 111); store8(exp + 5, 44); store8(exp + 6, 32); store8(exp + 7, 98);
    store8(exp + 8, 122); store8(exp + 9, 105); store8(exp + 10, 112); store8(exp + 11, 50);
    store8(exp + 12, 32); store8(exp + 13, 119); store8(exp + 14, 111); store8(exp + 15, 114);
    store8(exp + 16, 108); store8(exp + 17, 100); store8(exp + 18, 33);
    var i = 0;
    while (i < 19) {
        assert(load8(out + i) == load8(exp + i), "bzip2_dec_hello byte");
        i = i + 1;
    }
    return 0;
}

