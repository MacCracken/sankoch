# corruption rejection — bad level / flipped byte / truncation must error
fn test_bzip2_dec_corruption() {
    var cbuf = alloc(88);
    store8(cbuf + 0, 66); store8(cbuf + 1, 90); store8(cbuf + 2, 104); store8(cbuf + 3, 57);
    store8(cbuf + 4, 49); store8(cbuf + 5, 65); store8(cbuf + 6, 89); store8(cbuf + 7, 38);
    store8(cbuf + 8, 83); store8(cbuf + 9, 89); store8(cbuf + 10, 142); store8(cbuf + 11, 69);
    store8(cbuf + 12, 143); store8(cbuf + 13, 58); store8(cbuf + 14, 0); store8(cbuf + 15, 0);
    store8(cbuf + 16, 11); store8(cbuf + 17, 25); store8(cbuf + 18, 128); store8(cbuf + 19, 64);
    store8(cbuf + 20, 0); store8(cbuf + 21, 127); store8(cbuf + 22, 224); store8(cbuf + 23, 63);
    store8(cbuf + 24, 53); store8(cbuf + 25, 214); store8(cbuf + 26, 48); store8(cbuf + 27, 32);
    store8(cbuf + 28, 0); store8(cbuf + 29, 84); store8(cbuf + 30, 81); store8(cbuf + 31, 161);
    store8(cbuf + 32, 160); store8(cbuf + 33, 0); store8(cbuf + 34, 0); store8(cbuf + 35, 8);
    store8(cbuf + 36, 167); store8(cbuf + 37, 164); store8(cbuf + 38, 222); store8(cbuf + 39, 168);
    store8(cbuf + 40, 109); store8(cbuf + 41, 38); store8(cbuf + 42, 77); store8(cbuf + 43, 30);
    store8(cbuf + 44, 132); store8(cbuf + 45, 54); store8(cbuf + 46, 147); store8(cbuf + 47, 141);
    store8(cbuf + 48, 118); store8(cbuf + 49, 55); store8(cbuf + 50, 139); store8(cbuf + 51, 238);
    store8(cbuf + 52, 56); store8(cbuf + 53, 130); store8(cbuf + 54, 71); store8(cbuf + 55, 153);
    store8(cbuf + 56, 37); store8(cbuf + 57, 211); store8(cbuf + 58, 173); store8(cbuf + 59, 104);
    store8(cbuf + 60, 170); store8(cbuf + 61, 245); store8(cbuf + 62, 181); store8(cbuf + 63, 125);
    store8(cbuf + 64, 31); store8(cbuf + 65, 19); store8(cbuf + 66, 57); store8(cbuf + 67, 164);
    store8(cbuf + 68, 88); store8(cbuf + 69, 193); store8(cbuf + 70, 33); store8(cbuf + 71, 205);
    store8(cbuf + 72, 140); store8(cbuf + 73, 32); store8(cbuf + 74, 163); store8(cbuf + 75, 163);
    store8(cbuf + 76, 63); store8(cbuf + 77, 139); store8(cbuf + 78, 185); store8(cbuf + 79, 34);
    store8(cbuf + 80, 156); store8(cbuf + 81, 40); store8(cbuf + 82, 72); store8(cbuf + 83, 71);
    store8(cbuf + 84, 34); store8(cbuf + 85, 199); store8(cbuf + 86, 157); store8(cbuf + 87, 0);
    var out = alloc(52);
    assert(bzip2_decompress(cbuf, 88, out, 52) == 52, "bzip2 corruption baseline");
    # corrupt the level digit (offset 3) -> first-stream header invalid
    var lv = load8(cbuf + 3);
    store8(cbuf + 3, 88);
    assert(bzip2_decompress(cbuf, 88, out, 52) < 0, "bzip2 bad level rejected");
    store8(cbuf + 3, lv);
    # flip a payload byte -> block CRC mismatch / huffman error
    var mid = 44;
    var sv = load8(cbuf + mid);
    store8(cbuf + mid, sv ^ 255);
    assert(bzip2_decompress(cbuf, 88, out, 52) < 0, "bzip2 flipped byte rejected");
    store8(cbuf + mid, sv);
    assert(bzip2_decompress(cbuf, 12, out, 52) < 0, "bzip2 truncated rejected");
    assert(bzip2_decompress(cbuf, 88, out, 4) < 0, "bzip2 small dst rejected");
    return 0;
}

# public compress-API dispatch + detect_format
fn test_bzip2_dec_public_api() {
    var comp = alloc(104);
    store8(comp + 0, 66); store8(comp + 1, 90); store8(comp + 2, 104); store8(comp + 3, 57);
    store8(comp + 4, 49); store8(comp + 5, 65); store8(comp + 6, 89); store8(comp + 7, 38);
    store8(comp + 8, 83); store8(comp + 9, 89); store8(comp + 10, 8); store8(comp + 11, 183);
    store8(comp + 12, 23); store8(comp + 13, 20); store8(comp + 14, 0); store8(comp + 15, 0);
    store8(comp + 16, 39); store8(comp + 17, 159); store8(comp + 18, 128); store8(comp + 19, 64);
    store8(comp + 20, 0); store8(comp + 21, 16); store8(comp + 22, 0); store8(comp + 23, 32);
    store8(comp + 24, 129); store8(comp + 25, 136); store8(comp + 26, 0); store8(comp + 27, 58);
    store8(comp + 28, 109); store8(comp + 29, 206); store8(comp + 30, 16); store8(comp + 31, 32);
    store8(comp + 32, 0); store8(comp + 33, 96); store8(comp + 34, 41); store8(comp + 35, 85);
    store8(comp + 36, 1); store8(comp + 37, 166); store8(comp + 38, 35); store8(comp + 39, 65);
    store8(comp + 40, 232); store8(comp + 41, 133); store8(comp + 42, 26); store8(comp + 43, 50);
    store8(comp + 44, 6); store8(comp + 45, 141); store8(comp + 46, 50); store8(comp + 47, 52);
    store8(comp + 48, 194); store8(comp + 49, 104); store8(comp + 50, 158); store8(comp + 51, 83);
    store8(comp + 52, 170); store8(comp + 53, 102); store8(comp + 54, 158); store8(comp + 55, 147);
    store8(comp + 56, 242); store8(comp + 57, 100); store8(comp + 58, 158); store8(comp + 59, 19);
    store8(comp + 60, 52); store8(comp + 61, 209); store8(comp + 62, 53); store8(comp + 63, 76);
    store8(comp + 64, 39); store8(comp + 65, 100); store8(comp + 66, 221); store8(comp + 67, 57);
    store8(comp + 68, 39); store8(comp + 69, 132); store8(comp + 70, 221); store8(comp + 71, 54);
    store8(comp + 72, 77); store8(comp + 73, 147); store8(comp + 74, 84); store8(comp + 75, 194);
    store8(comp + 76, 112); store8(comp + 77, 156); store8(comp + 78, 38); store8(comp + 79, 19);
    store8(comp + 80, 9); store8(comp + 81, 194); store8(comp + 82, 104); store8(comp + 83, 156);
    store8(comp + 84, 211); store8(comp + 85, 82); store8(comp + 86, 112); store8(comp + 87, 155);
    store8(comp + 88, 39); store8(comp + 89, 52); store8(comp + 90, 209); store8(comp + 91, 50);
    store8(comp + 92, 79); store8(comp + 93, 226); store8(comp + 94, 238); store8(comp + 95, 72);
    store8(comp + 96, 167); store8(comp + 97, 10); store8(comp + 98, 18); store8(comp + 99, 1);
    store8(comp + 100, 22); store8(comp + 101, 226); store8(comp + 102, 226); store8(comp + 103, 128);
    var out = alloc(400);
    var clen = 104;
    assert(detect_format(comp, clen) == FORMAT_BZIP2, "bzip2 detect");
    var dlen = decompress(FORMAT_BZIP2, comp, clen, out, 400);
    assert(dlen == 360, "bzip2 public decompress");
    return 0;
}

# ================================================================
# main
# ================================================================

fn main() {
    _test_init();
    test_bzip2_dec_hello();
    test_bzip2_dec_rep();
    test_bzip2_dec_text();
    test_bzip2_dec_empty();
    test_bzip2_dec_rle();
    test_bzip2_dec_binary();
    test_bzip2_dec_corruption();
    test_bzip2_dec_public_api();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
