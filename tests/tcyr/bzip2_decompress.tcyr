}

# empty input (14 compressed -> 0 bytes)
fn test_bzip2_dec_empty() {
    var comp = alloc(14);
    store8(comp + 0, 66); store8(comp + 1, 90); store8(comp + 2, 104); store8(comp + 3, 57);
    store8(comp + 4, 23); store8(comp + 5, 114); store8(comp + 6, 69); store8(comp + 7, 56);
    store8(comp + 8, 80); store8(comp + 9, 144); store8(comp + 10, 0); store8(comp + 11, 0);
    store8(comp + 12, 0); store8(comp + 13, 0);
    var out = alloc(1);
    var dlen = bzip2_decompress(comp, 14, out, 1);
    assert(dlen == 0, "bzip2_dec_empty dlen");
    return 0;
}

