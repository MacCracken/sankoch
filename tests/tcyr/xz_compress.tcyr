# sankoch — xz / LZMA — compress (optimal-parse encode, round-trip)
#
# Part of the split test suite (see _harness.tcyr). Run with:
#   cyrius test tests/tcyr/xz_compress.tcyr

include "tests/tcyr/_harness.tcyr"

fn test_xz_encode_empty() {
    var src = alloc(1);
    var clen = _xz_rt(src, 0, "xz_encode empty");
    assert(clen > 0, "xz_encode empty produces a stream");
    return 0;
}

fn test_xz_encode_small() {
    var src = alloc(64);
    var s = "Hello, xz encoder! Hello, xz encoder!";   # 37 bytes, repetitive
    var i = 0;
    while (i < 37) { store8(src + i, load8(s + i)); i = i + 1; }
    var clen = _xz_rt(src, 37, "xz_encode small");
    assert(clen < 37 + 80, "xz_encode small bounded");
    return 0;
}

fn test_xz_encode_allsame() {
    var n = 4000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 65); i = i + 1; }   # all 'A'
    var clen = _xz_rt(src, n, "xz_encode allsame");
    # Highly compressible → must shrink dramatically (rep matches).
    assert(clen < 200, "xz_encode allsame ratio");
    return 0;
}

fn test_xz_encode_periodic() {
    var n = 6000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 97 + (i % 7)); i = i + 1; }   # period 7
    var clen = _xz_rt(src, n, "xz_encode periodic");
    assert(clen < n / 4, "xz_encode periodic compresses");
    return 0;
}

fn test_xz_encode_text() {
    var n = 5000;
    var src = alloc(n);
    var w = "the quick brown fox jumps over the lazy dog ";   # 44 bytes
    var i = 0;
    while (i < n) { store8(src + i, load8(w + (i % 44))); i = i + 1; }
    var clen = _xz_rt(src, n, "xz_encode text");
    assert(clen < n / 2, "xz_encode text compresses");
    return 0;
}

fn test_xz_encode_pseudorandom() {
    var n = 3000;
    var src = alloc(n);
    var st = 2463534242;
    var i = 0;
    while (i < n) {
        st = st ^ (st << 13);
        st = st ^ ((st >> 7) & 0x1FFFFFFFFFFFFFF);
        st = st ^ (st << 17);
        store8(src + i, st & 255);
        i = i + 1;
    }
    # Incompressible: just assert round-trip (ratio not guaranteed).
    _xz_rt(src, n, "xz_encode pseudorandom");
    return 0;
}

fn test_xz_encode_large() {
    # ~90 KB → spans many DP windows; mixed structure.
    var n = 90000;
    var src = alloc(n);
    var i = 0;
    while (i < n) {
        var v = (i % 251);
        if ((i % 5) == 0) { v = 88; }   # inject repetition
        store8(src + i, v & 255);
        i = i + 1;
    }
    var clen = _xz_rt(src, n, "xz_encode large");
    assert(clen < n, "xz_encode large compresses");
    return 0;
}

fn test_xz_encode_public_api() {
    var n = 2000;
    var src = alloc(n);
    var w = "AGNOS sankoch xz public api round trip ";   # 39 bytes
    var i = 0;
    while (i < n) { store8(src + i, load8(w + (i % 39))); i = i + 1; }

    var cap = n + 8192;
    var comp = alloc(cap);
    var clen = compress(FORMAT_XZ, src, n, comp, cap);
    assert(clen > 0, "xz public compress");
    # detect_format must recognize the .xz magic we emitted.
    assert(detect_format(comp, clen) == FORMAT_XZ, "xz public detect");
    var out = alloc(n + 16);
    var dlen = decompress(FORMAT_XZ, comp, clen, out, n + 16);
    assert(dlen == n, "xz public decompress len");
    i = 0;
    while (i < n) {
        assert(load8(out + i) == load8(src + i), "xz public byte");
        i = i + 1;
    }
    return 0;
}

# ================================================================
# main
# ================================================================

# 2.8.6 (closeout review): the encoder's chunking and window invariants had no test. The largest
# input was 90,000 bytes: nothing crossed the 2,000,000-byte uncompressed or ~60 KB compressed chunk
# cut, the 256 KiB window, or 2 MiB. Self round-trips catch an over-reaching match only since the
# decoder enforces the declared dictionary (2.8.6), as liblzma does.

# Round-trip one input, one verdict per check (not one assertion per byte). Returns clen.
fn _xz_rt_once(src, n, label) {
    var cap = n + n / 50 + 8192;
    var comp = alloc(cap);
    var clen = xz_compress(src, n, comp, cap);
    assert(clen > 0, label);
    var out = alloc(n + 16);
    assert_eq(xz_decompress(comp, clen, out, n + 16), n, label);
    assert_eq(crc32(out, n), crc32(src, n), label);
    return clen;
}

# LZMA2 chunks in the one-block stream at comp: the count, and whether every chunk after the first
# continues the state (control 0x80..0x9F) rather than resetting it.
var _xz_chunks_continue = 0;
fn _xz_chunk_count(comp) {
    var p = 12 + (load8(comp + 12) + 1) * 4;
    var n = 0;
    _xz_chunks_continue = 1;
    loop {
        var c = load8(comp + p);
        if (c == 0) { break; }
        if (c < 0x80) { return 0 - 1; }   # the encoder writes no uncompressed chunks
        if (n > 0 && c >= 0xA0) { _xz_chunks_continue = 0; }
        var packed = ((load8(comp + p + 3) << 8) | load8(comp + p + 4)) + 1;
        var h = 5;
        if (c >= 0xC0) { h = 6; }
        p = p + h + packed;
        n = n + 1;
    }
    return n;
}

fn test_xz_encode_chunks_and_window() {
    # 2,200,000 zeros: past the 2,000,000-byte uncompressed chunk cut.
    var n = 2200000;
    var z = alloc(n);
    var i = 0;
    while (i < n) { store8(z + i, 0); i = i + 1; }
    var cap = n + 8192;
    var comp = alloc(cap);
    var clen = xz_compress(z, n, comp, cap);
    assert(clen > 0, "xz enc: 2.2 MB of zeros");
    assert_eq(_xz_chunk_count(comp), 2, "xz enc: 2.2 MB of zeros is two chunks");
    assert_eq(_xz_chunks_continue, 1, "xz enc: the second chunk continues the state");
    _xz_rt_once(z, n, "xz enc: 2.2 MB of zeros round-trips");

    # 300,000 pseudo-random bytes: several chunks cut at the compressed soft cap.
    var r = alloc(300000);
    var x = 0x2545F491;
    i = 0;
    while (i < 300000) {
        x = (x * 6364136223846793005 + 1442695040888963407);
        store8(r + i, (x >> 33) & 255);
        i = i + 1;
    }
    clen = xz_compress(r, 300000, comp, cap);
    assert(clen > 0, "xz enc: 300 KB random");
    assert(_xz_chunk_count(comp) >= 4, "xz enc: 300 KB random spans at least four chunks");
    assert_eq(_xz_chunks_continue, 1, "xz enc: every later chunk continues the state");
    _xz_rt_once(r, 300000, "xz enc: 300 KB random round-trips");

    # The window edge: 262,144 random bytes, then their first 4,096 again, at distance exactly
    # 262,144 (the window and the declared 256 KiB dictionary). The match must be taken: the
    # repeat costs far less than 4,096 bytes.
    var w = alloc(266240);
    i = 0;
    while (i < 262144) { store8(w + i, load8(r + i)); i = i + 1; }
    while (i < 266240) { store8(w + i, load8(w + i - 262144)); i = i + 1; }
    var cw = _xz_rt_once(w, 266240, "xz enc: a repeat at the window distance round-trips");
    var cr = _xz_rt_once(w, 262144, "xz enc: the random half alone");
    assert(cw - cr < 200, "xz enc: the 4,096-byte repeat at distance 262,144 is matched");

    # Just past it: a repeat at distance 264,000 is out of the window, so it must NOT be matched
    # (it would exceed the declared dictionary, which `xz -d` and, since 2.8.6, sankoch reject).
    var v = alloc(268096);
    i = 0;
    while (i < 264000) { store8(v + i, load8(r + (i % 300000))); i = i + 1; }
    while (i < 268096) { store8(v + i, load8(v + i - 264000)); i = i + 1; }
    _xz_rt_once(v, 268096, "xz enc: a repeat beyond the window round-trips");
    return 0;
}

fn main() {
    _test_init();
    test_xz_encode_empty();
    test_xz_encode_small();
    test_xz_encode_allsame();
    test_xz_encode_periodic();
    test_xz_encode_text();
    test_xz_encode_pseudorandom();
    test_xz_encode_large();
    test_xz_encode_public_api();
    test_xz_encode_chunks_and_window();
    return assert_summary();
}

var exit_code = main();
if (exit_code != 0) { exit_code = 1; }   # exit keeps 8 bits: 256 failures would read as 0
syscall(60, exit_code);
