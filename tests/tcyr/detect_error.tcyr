fn main() {
    _test_init();
    test_enc_error_paths();
    test_enc_zero_write();
    test_detect_gzip();
    test_detect_zlib();
    test_detect_short_input();
    test_detect_unknown();
    test_format_detect_roundtrip();
    test_err_negative_len();
    test_err_unsupported_format();
    test_enc_dict_invalid_args();
    test_enc_dict_zero_len_equals_no_dict();
    test_oom_compress_sweep();
    test_oom_decompress_sweep();
    test_alloc_fail_deflate_ctx();
    test_alloc_fail_deflate_window();
    test_alloc_fail_deflate_bw();
    test_alloc_fail_zlib_ctx();
    test_alloc_fail_zlib_adler();
    test_alloc_fail_gzip_ctx();
    test_alloc_fail_lz4f_ctx();
    test_alloc_fail_lz4f_block_buf();
    test_alloc_fail_lz4f_xxh32();
    test_alloc_fail_gzip_crc32();
    test_enc_dict_max_len_32768();
    test_enc_dict_min_match_len_3();
    test_enc_dict_below_min_match_len_2();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
