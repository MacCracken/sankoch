# sankoch — ZIP container (2.6.0): reader + writer round-trips, guards, malformed input
#
# Part of the split test suite (see _harness.tcyr). Run with:
#   cyrius test tests/tcyr/zip.tcyr
#
# Reference-CLI parity (`unzip -t` / Python `zipfile`) is covered by
# scripts/zip-smoke.sh — this suite is the self-contained CI half.

include "tests/tcyr/_harness.tcyr"

# Build a buffer of `n` bytes with a compressible repeating pattern.
fn _zt_fill(buf, n, seedch) {
    var i = 0;
    while (i < n) {
        store8(buf + i, seedch + (i % 17));
        i = i + 1;
    }
    return 0;
}

fn _zt_eq(a, b, n) {
    var i = 0;
    while (i < n) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Write two members, read them back, verify names, sizes and bytes.
fn test_zip_roundtrip() {
    var big = 4000;
    var a = alloc(big);
    _zt_fill(a, big, 65);
    var b = alloc(64);
    _zt_fill(b, 64, 97);

    var cap = 65536;
    var arc = alloc(cap);
    var w = zip_writer_init(arc, cap);
    assert(w != 0, "zip writer init");
    assert(zip_add(w, "manifest.json", b, 64, ZIP_DEFLATE) == 0, "zip_add small");
    assert(zip_add(w, "definitions/a.json", a, big, ZIP_DEFLATE) == 0, "zip_add big");
    var total = zip_writer_finish(w);
    assert(total > 0, "zip_writer_finish");
    assert(total < big, "zip DEFLATE actually compresses the archive below raw size");

    var z = zip_open(arc, total);
    assert(z != 0, "zip_open on our own archive");
    assert(zip_count(z) == 2, "zip entry count");

    var i0 = zip_find(z, "manifest.json");
    var i1 = zip_find(z, "definitions/a.json");
    assert(i0 >= 0, "zip_find manifest");
    assert(i1 >= 0, "zip_find nested name");
    assert(zip_find(z, "absent.json") < 0, "zip_find miss returns -1");

    assert(zip_entry_size(z, i0) == 64, "entry size small");
    assert(zip_entry_size(z, i1) == big, "entry size big");

    var o0 = alloc(256);
    assert(zip_extract(z, i0, o0, 256) == 64, "extract small");
    assert(_zt_eq(o0, b, 64) == 1, "extract small content");

    var o1 = alloc(big + 16);
    assert(zip_extract(z, i1, o1, big + 16) == big, "extract big");
    assert(_zt_eq(o1, a, big) == 1, "extract big content");
    return 0;
}

# STORE method: content must survive verbatim, and the member must report method 0.
fn test_zip_store_method() {
    var n = 300;
    var src = alloc(n);
    var st = 12345;
    var i = 0;
    while (i < n) {
        st = st * 6364136223846793005 + 1442695040888963407;
        store8(src + i, (st >> 40) & 0xFF);      # incompressible -> STORE is honest
        i = i + 1;
    }
    var cap = 4096;
    var arc = alloc(cap);
    var w = zip_writer_init(arc, cap);
    assert(zip_add(w, "raw.bin", src, n, ZIP_STORE) == 0, "zip_add store");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    assert(z != 0, "zip_open store archive");
    assert(zip_entry_method(z, 0) == ZIP_STORE, "stored member reports method 0");
    var out = alloc(n + 16);
    assert(zip_extract(z, 0, out, n + 16) == n, "extract stored");
    assert(_zt_eq(out, src, n) == 1, "stored content verbatim");
    return 0;
}

# An archive with no members is legal: just an EOCD.
fn test_zip_empty_archive() {
    var arc = alloc(256);
    var w = zip_writer_init(arc, 256);
    var total = zip_writer_finish(w);
    assert(total == 22, "empty archive is exactly one 22-byte EOCD");
    var z = zip_open(arc, total);
    assert(z != 0, "zip_open empty archive");
    assert(zip_count(z) == 0, "empty archive has 0 entries");
    assert(zip_find(z, "anything") < 0, "find in empty archive");
    return 0;
}

# A zero-length member round-trips (agnosai writes empty definition files).
fn test_zip_empty_member() {
    var arc = alloc(4096);
    var w = zip_writer_init(arc, 4096);
    var dummy = alloc(1);
    assert(zip_add(w, "empty.json", dummy, 0, ZIP_DEFLATE) == 0, "zip_add empty member");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    assert(z != 0, "zip_open empty-member archive");
    assert(zip_entry_size(z, 0) == 0, "empty member size 0");
    var out = alloc(16);
    assert(zip_extract(z, 0, out, 16) == 0, "extract empty member");
    return 0;
}

# Zip-slip: every escaping name shape must be refused at extract, and refused on write.
fn test_zip_slip_guards() {
    var arc = alloc(4096);
    var w = zip_writer_init(arc, 4096);
    var d = alloc(8);
    _zt_fill(d, 8, 65);
    # The writer refuses to even record an unsafe name.
    assert(zip_add(w, "../evil.txt", d, 8, ZIP_STORE) == 0 - ERR_UNSAFE_PATH, "writer rejects ..");
    assert(zip_add(w, "/etc/evil", d, 8, ZIP_STORE) == 0 - ERR_UNSAFE_PATH, "writer rejects absolute");
    assert(zip_add(w, "a\\b.txt", d, 8, ZIP_STORE) == 0 - ERR_UNSAFE_PATH, "writer rejects backslash");
    assert(zip_add(w, "a//b.txt", d, 8, ZIP_STORE) == 0 - ERR_UNSAFE_PATH, "writer rejects empty component");
    assert(zip_add(w, "ok/../../x", d, 8, ZIP_STORE) == 0 - ERR_UNSAFE_PATH, "writer rejects interior ..");
    assert(zip_add(w, "", d, 8, ZIP_STORE) == 0 - ERR_UNSAFE_PATH, "writer rejects empty name");
    # A legitimate nested name still works.
    assert(zip_add(w, "definitions/ok.json", d, 8, ZIP_STORE) == 0, "writer accepts nested name");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    assert(zip_count(z) == 1, "only the safe member was recorded");
    return 0;
}

# The per-member expansion cap folds into ERR_RATIO_LIMIT.
fn test_zip_ratio_cap() {
    var n = 200000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 0); i = i + 1; }   # compresses enormously
    var cap = 262144;
    var arc = alloc(cap);
    var w = zip_writer_init(arc, cap);
    assert(zip_add(w, "bomb.bin", src, n, ZIP_DEFLATE) == 0, "zip_add bomb");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    assert(z != 0, "zip_open bomb archive");
    var out = alloc(n + 16);
    # A tight cap must trip; no cap must decode.
    assert(zip_extract_capped(z, 0, out, n + 16, 10) == 0 - ERR_RATIO_LIMIT,
    "ratio cap trips on a high-expansion member");
    assert(zip_extract_capped(z, 0, out, n + 16, 0) == n, "uncapped extract succeeds");
    return 0;
}

# A single flipped byte in a STORED payload decodes fine but must fail CRC-32.
fn test_zip_crc_detects_corruption() {
    var n = 64;
    var src = alloc(n);
    _zt_fill(src, n, 65);
    var arc = alloc(4096);
    var w = zip_writer_init(arc, 4096);
    assert(zip_add(w, "s.txt", src, n, ZIP_STORE) == 0, "zip_add for crc test");
    var total = zip_writer_finish(w);
    var out = alloc(n + 16);
    var z0 = zip_open(arc, total);
    assert(zip_extract(z0, 0, out, n + 16) == n, "clean extract before corruption");
    # local header is at offset 0: data begins after 30 + name length ("s.txt" = 5)
    var dataoff = 30 + 5;
    store8(arc + dataoff, (load8(arc + dataoff) & 0xFF) ^ 0xFF);
    var z1 = zip_open(arc, total);
    assert(z1 != 0, "archive still parses after payload corruption");
    assert(zip_extract(z1, 0, out, n + 16) == 0 - ERR_CHECKSUM_MISMATCH,
    "CRC-32 catches a flipped stored byte");
    return 0;
}

# Malformed containers must be refused by zip_open, never mis-parsed.
fn test_zip_malformed() {
    var buf = alloc(512);
    var i = 0;
    while (i < 512) { store8(buf + i, 65 + (i % 26)); i = i + 1; }
    assert(zip_open(buf, 512) == 0, "garbage is not a zip");
    assert(zip_open(buf, 0) == 0, "zero length rejected");
    assert(zip_open(buf, 4) == 0, "too short for an EOCD rejected");

    # Truncate a real archive to just past its local header.
    var arc = alloc(4096);
    var w = zip_writer_init(arc, 4096);
    var d = alloc(32);
    _zt_fill(d, 32, 65);
    zip_add(w, "x.txt", d, 32, ZIP_STORE);
    var total = zip_writer_finish(w);
    assert(zip_open(arc, 40) == 0, "truncated archive rejected");
    assert(zip_open(arc, total) != 0, "control: full archive still opens");
    return 0;
}

# Out-of-range indices must return errors, never read out of bounds.
fn test_zip_index_bounds() {
    var arc = alloc(4096);
    var w = zip_writer_init(arc, 4096);
    var d = alloc(16);
    _zt_fill(d, 16, 65);
    zip_add(w, "a.txt", d, 16, ZIP_STORE);
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    var out = alloc(64);
    assert(zip_entry_name(z, 5) == 0, "name of out-of-range index is 0");
    assert(zip_entry_size(z, 5) < 0, "size of out-of-range index is negative");
    assert(zip_entry_size(z, 0 - 1) < 0, "negative index rejected");
    assert(zip_extract(z, 5, out, 64) < 0, "extract out-of-range index errors");
    assert(zip_extract(z, 0 - 1, out, 64) < 0, "extract negative index errors");
    return 0;
}

# A too-small destination must be refused rather than overrun.
fn test_zip_dst_too_small() {
    var n = 500;
    var src = alloc(n);
    _zt_fill(src, n, 65);
    var arc = alloc(8192);
    var w = zip_writer_init(arc, 8192);
    zip_add(w, "a.bin", src, n, ZIP_DEFLATE);
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    var small = alloc(64);
    assert(zip_extract(z, 0, small, 64) == 0 - ERR_BUFFER_TOO_SMALL,
    "extract into an undersized buffer is refused");
    return 0;
}

# The writer must refuse to run past its own output buffer.
fn test_zip_writer_bounds() {
    var n = 4000;
    var src = alloc(n);
    var st = 999;
    var i = 0;
    while (i < n) {
        st = st * 6364136223846793005 + 1442695040888963407;
        store8(src + i, (st >> 40) & 0xFF);       # incompressible: cannot fit a tiny buffer
        i = i + 1;
    }
    var arc = alloc(128);
    var w = zip_writer_init(arc, 128);
    assert(w != 0, "writer init with a small buffer");
    var r = zip_add(w, "big.bin", src, n, ZIP_STORE);
    assert(r == 0 - ERR_BUFFER_TOO_SMALL, "zip_add refuses to overrun dst");
    assert(zip_writer_finish(w) < 0, "finish reports the sticky error");
    return 0;
}

# 2.6.1: every method sankoch owns round-trips through the writer and reader, and the
# member's declared method survives. STORE is the fallback when a codec cannot shrink the
# data, so use a compressible payload where a real method is expected.
fn test_zip_all_methods() {
    var n = 20000;
    var src = alloc(n);
    _zt_fill(src, n, 97);

    var cap = 262144;
    var arc = alloc(cap);
    var w = zip_writer_init(arc, cap);
    assert(w != 0, "all-methods writer init");
    assert(zip_add_any(w, "m00.txt", src, n, ZIP_STORE) == 0, "add store");
    assert(zip_add_any(w, "m08.txt", src, n, ZIP_DEFLATE) == 0, "add deflate");
    assert(zip_add_any(w, "m12.txt", src, n, ZIP_BZIP2) == 0, "add bzip2");
    assert(zip_add_any(w, "m93.txt", src, n, ZIP_ZSTD) == 0, "add zstd");
    assert(zip_add_any(w, "m95.txt", src, n, ZIP_XZ) == 0, "add xz");
    var total = zip_writer_finish(w);
    assert(total > 0, "all-methods finish");

    var z = zip_open(arc, total);
    assert(z != 0, "all-methods reopen");
    assert(zip_count(z) == 5, "five members");

    var out = alloc(n + 64);
    var idx = 0;
    while (idx < 5) {
        var got = zip_extract_any(z, idx, out, n + 64);
        assert(got == n, "all-methods extract length");
        assert(_zt_eq(out, src, n) == 1, "all-methods extract content");
        idx = idx + 1;
    }
    # Each member kept the method it was written with (the payload compressed, so no
    # STORE fallback fired for 8/12/93/95).
    assert(zip_entry_method(z, zip_find(z, "m00.txt")) == ZIP_STORE, "m00 method preserved");
    assert(zip_entry_method(z, zip_find(z, "m08.txt")) == ZIP_DEFLATE, "m08 method preserved");
    assert(zip_entry_method(z, zip_find(z, "m12.txt")) == ZIP_BZIP2, "m12 method preserved");
    assert(zip_entry_method(z, zip_find(z, "m93.txt")) == ZIP_ZSTD, "m93 method preserved");
    assert(zip_entry_method(z, zip_find(z, "m95.txt")) == ZIP_XZ, "m95 method preserved");
    return 0;
}

# The lean reader (`zip_extract`) handles only the methods zip.cyr itself carries; the
# extra methods must be refused there rather than mis-decoded. This is the contract that
# keeps the `[lib.zip]` distlib profile free of xz/bzip2/zstd.
fn test_zip_lean_refuses_extra_methods() {
    var n = 4000;
    var src = alloc(n);
    _zt_fill(src, n, 97);
    var arc = alloc(65536);
    var w = zip_writer_init(arc, 65536);
    assert(zip_add_any(w, "b.txt", src, n, ZIP_BZIP2) == 0, "add bzip2 for lean check");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    var out = alloc(n + 64);
    assert(zip_extract(z, 0, out, n + 64) == 0 - ERR_UNSUPPORTED_FORMAT,
    "zip_extract refuses a method zip.cyr does not carry");
    assert(zip_extract_any(z, 0, out, n + 64) == n,
    "zip_extract_any handles it");
    return 0;
}

# Method support predicate + rejection of a method sankoch does not implement.
fn test_zip_method_support() {
    assert(zip_method_supported(ZIP_STORE) == 1, "store supported");
    assert(zip_method_supported(ZIP_DEFLATE) == 1, "deflate supported");
    assert(zip_method_supported(ZIP_BZIP2) == 1, "bzip2 supported");
    assert(zip_method_supported(ZIP_ZSTD) == 1, "zstd supported");
    assert(zip_method_supported(ZIP_XZ) == 1, "xz supported");
    assert(zip_method_supported(14) == 0, "method 14 (LZMA alone) is a non-goal");
    assert(zip_method_supported(99) == 0, "unknown method unsupported");
    var d = alloc(16);
    _zt_fill(d, 16, 65);
    var arc = alloc(4096);
    var w = zip_writer_init(arc, 4096);
    assert(zip_add_any(w, "x.txt", d, 16, 14) == 0 - ERR_UNSUPPORTED_FORMAT,
    "writer refuses method 14");
    return 0;
}

# The ratio cap and the zip-slip guard apply on the extra-method path too.
fn test_zip_any_guards() {
    var n = 100000;
    var src = alloc(n);
    var i = 0;
    while (i < n) { store8(src + i, 0); i = i + 1; }
    var arc = alloc(262144);
    var w = zip_writer_init(arc, 262144);
    assert(zip_add_any(w, "../evil", src, 16, ZIP_BZIP2) == 0 - ERR_UNSAFE_PATH,
    "zip_add_any rejects an unsafe name");
    assert(zip_add_any(w, "bomb.bin", src, n, ZIP_XZ) == 0, "add xz bomb");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    var out = alloc(n + 64);
    assert(zip_extract_any_capped(z, 0, out, n + 64, 10) == 0 - ERR_RATIO_LIMIT,
    "ratio cap trips on the extra-method path");
    assert(zip_extract_any_capped(z, 0, out, n + 64, 0) == n,
    "uncapped extra-method extract succeeds");
    return 0;
}

# Regression (2.6.2): the writer must COPY each member name, not alias the caller's
# buffer. The central directory is not emitted until zip_writer_finish, so holding the
# pointer meant a caller formatting names into ONE reusable buffer — the natural way to
# add many members — silently got the last name on every entry, with valid CRCs and a
# reference-tool-clean archive hiding it. Found while writing the 70,000-entry zip64 test.
fn test_zip_name_not_aliased() {
    var arc = alloc(65536);
    var w = zip_writer_init(arc, 65536);
    assert(w != 0, "aliasing test: writer init");
    var d = alloc(4);
    _zt_fill(d, 4, 65);
    var nm = alloc(16);                     # ONE buffer, rewritten every iteration
    var i = 0;
    while (i < 5) {
        store8(nm + 0, 102);                # 'f'
        store8(nm + 1, 48 + i);             # '0'..'4'
        store8(nm + 2, 0);
        assert(zip_add(w, nm, d, 4, ZIP_STORE) == 0, "aliasing test: add");
        i = i + 1;
    }
    # Scribble over the buffer before finishing — a correct writer is unaffected.
    store8(nm + 0, 90); store8(nm + 1, 90); store8(nm + 2, 0);
    var total = zip_writer_finish(w);
    assert(total > 0, "aliasing test: finish");

    var z = zip_open(arc, total);
    assert(z != 0, "aliasing test: reopen");
    assert(zip_count(z) == 5, "aliasing test: five members");
    i = 0;
    while (i < 5) {
        var nm2 = zip_entry_name(z, i);
        assert(strlen(nm2) == 2, "aliasing test: name length");
        assert((load8(nm2 + 0) & 0xFF) == 102, "aliasing test: name prefix");
        assert((load8(nm2 + 1) & 0xFF) == 48 + i, "aliasing test: name is per-entry, not the last one");
        i = i + 1;
    }
    # And each is findable by its own name.
    var probe = alloc(8);
    store8(probe + 0, 102); store8(probe + 1, 51); store8(probe + 2, 0);   # "f3"
    assert(zip_find(z, probe) == 3, "aliasing test: find by distinct name");
    return 0;
}

# 2.6.3: per-entry Unix metadata round-trips — mode (with type bits), mtime in Unix
# seconds, and the symlink convention (S_IFLNK + target as content), matching what
# bsdtar/Info-ZIP write so a consumer gets tar-parity extraction.
fn test_zip_metadata() {
    var arc = alloc(65536);
    var w = zip_writer_init(arc, 65536);
    var body = alloc(64);
    _zt_fill(body, 40, 65);
    var T = 1623760496;                       # 2021-06-15 12:34:56 UTC
    assert(zip_add_meta(w, "f.txt", body, 40, ZIP_STORE, 0x81EC, T) == 0, "meta: add file");
    var tgt = alloc(16);
    store8(tgt + 0, 102); store8(tgt + 1, 46); store8(tgt + 2, 116);
    store8(tgt + 3, 120); store8(tgt + 4, 116); store8(tgt + 5, 0);   # "f.txt"
    assert(zip_add_meta(w, "link.txt", tgt, 5, ZIP_STORE, 0xA1FF, T) == 0, "meta: add symlink");
    assert(zip_add_meta(w, "d/", body, 0, ZIP_STORE, 0x41ED, T) == 0, "meta: add dir");
    # A member added without metadata must report none, not a fabricated mode.
    assert(zip_add(w, "plain.txt", body, 40, ZIP_STORE) == 0, "meta: add plain");
    var total = zip_writer_finish(w);
    assert(total > 0, "meta: finish");

    var z = zip_open(arc, total);
    assert(z != 0, "meta: reopen");
    var fi = zip_find(z, "f.txt");
    var li = zip_find(z, "link.txt");
    var di = zip_find(z, "d/");
    var pi = zip_find(z, "plain.txt");
    assert(zip_entry_mode(z, fi) == 0x81EC, "meta: file mode round-trips");
    assert(zip_entry_mode(z, li) == 0xA1FF, "meta: symlink mode round-trips");
    assert(zip_entry_mode(z, di) == 0x41ED, "meta: dir mode round-trips");
    assert(zip_entry_mode(z, pi) == 0, "meta: no metadata reports mode 0");
    assert(zip_entry_is_symlink(z, li) == 1, "meta: symlink detected");
    assert(zip_entry_is_symlink(z, fi) == 0, "meta: file is not a symlink");
    # MS-DOS time has 2-second resolution, so the stamp round-trips to within 2s.
    var dt = zip_entry_mtime(z, fi) - T;
    assert(dt >= 0 - 2 && dt <= 2, "meta: mtime round-trips within DOS resolution");
    assert(zip_entry_mtime(z, pi) == 0, "meta: absent mtime reads as 0");
    # The symlink's target is its content.
    var out = alloc(64);
    assert(zip_extract(z, li, out, 64) == 5, "meta: symlink target length");
    assert(_zt_eq(out, tgt, 5) == 1, "meta: symlink target content");
    return 0;
}

# MS-DOS <-> Unix time conversion must be exact at known points (the helper underpins
# every mtime the reader and writer exchange).
fn test_zip_dos_time() {
    var o[16];
    # 1980-01-01 00:00:00 is the format's epoch: date 0x21, time 0.
    _zip_unix_to_dos(315532800, &o);
    assert(load64(&o + 8) == 0x21, "dos: 1980-01-01 date encodes to 0x21");
    # Round-trip a known instant.
    _zip_unix_to_dos(1623760496, &o);
    var back = _zip_dos_to_unix(load64(&o + 0), load64(&o + 8));
    assert(back == 1623760496, "dos: 2021-06-15 12:34:56 round-trips exactly");
    # Pre-epoch and unset clamp to the floor rather than wrapping.
    _zip_unix_to_dos(0, &o);
    assert(load64(&o + 0) == 0 && load64(&o + 8) == 0x21, "dos: unset clamps to the 1980 floor");
    _zip_unix_to_dos(0 - 100000, &o);
    assert(load64(&o + 8) == 0x21, "dos: pre-1980 clamps to the floor");
    # The floor stamp reads back as "absent", not as a real 1980 timestamp.
    assert(_zip_dos_to_unix(0, 0x21) == 0, "dos: floor stamp reads as absent");
    return 0;
}

# 2.6.3 streaming write: bit-3 local header + trailing data descriptor, fed in chunks.
fn test_zip_streaming_write() {
    var arc = alloc(262144);
    var w = zip_writer_init(arc, 262144);
    assert(w != 0, "stream: writer init");
    var chunk = alloc(1000);
    _zt_fill(chunk, 1000, 97);

    assert(zip_enc_begin(w, "s.txt", ZIP_DEFLATE, 0x81A4, 1623760496) == 0, "stream: begin");
    var i = 0;
    while (i < 10) {
        assert(zip_enc_write(w, chunk, 1000) == 0, "stream: write chunk");
        i = i + 1;
    }
    assert(zip_enc_end(w) == 0, "stream: end");
    # A streamed member and a normal one must coexist.
    assert(zip_add(w, "p.txt", chunk, 1000, ZIP_DEFLATE) == 0, "stream: plain member alongside");
    var total = zip_writer_finish(w);
    assert(total > 0, "stream: finish");

    # The local header must carry general-purpose bit 3.
    assert((_zip_le16(arc + 6) & 8) == 8, "stream: local header sets bit 3");

    var z = zip_open(arc, total);
    assert(z != 0, "stream: reopen");
    assert(zip_count(z) == 2, "stream: two members");
    var si = zip_find(z, "s.txt");
    assert(zip_entry_size(z, si) == 10000, "stream: streamed size recorded");
    assert(zip_entry_mode(z, si) == 0x81A4, "stream: metadata survives streaming");
    var out = alloc(16384);
    assert(zip_extract(z, si, out, 16384) == 10000, "stream: extract streamed member");
    var k = 0;
    var ok = 1;
    while (k < 10000) {
        if ((load8(out + k) & 0xFF) != (load8(chunk + (k % 1000)) & 0xFF)) { ok = 0; break; }
        k = k + 1;
    }
    assert(ok == 1, "stream: streamed content is byte-identical");
    return 0;
}

# Streaming misuse must be refused, not allowed to emit a corrupt archive.
fn test_zip_streaming_guards() {
    var arc = alloc(65536);
    var w = zip_writer_init(arc, 65536);
    var d = alloc(16);
    _zt_fill(d, 16, 65);
    # write/end before begin
    assert(zip_enc_write(w, d, 16) == 0 - ERR_INVALID_INPUT, "stream: write before begin");
    assert(zip_enc_end(w) == 0 - ERR_INVALID_INPUT, "stream: end before begin");
    assert(zip_enc_begin(w, "a.txt", ZIP_STORE, 0, 0) == 0, "stream: begin ok");
    # nested begin
    assert(zip_enc_begin(w, "b.txt", ZIP_STORE, 0, 0) == 0 - ERR_INVALID_INPUT,
    "stream: nested begin refused");
    # Finishing with a member still open is refused AND abandons that member — releasing
    # its encoder lock (for DEFLATE) so the refusal can never deadlock the library (2.6.4).
    # The half-written member is dropped; a following zip_enc_end sees nothing open.
    assert(zip_writer_finish(w) == 0 - ERR_INVALID_INPUT, "stream: finish with member open refused");
    assert(zip_enc_end(w) == 0 - ERR_INVALID_INPUT, "stream: the open member was abandoned by finish");
    assert(zip_writer_finish(w) > 0, "stream: finish now succeeds (empty archive)");
    # unsafe names and unsupported methods are refused at begin
    var w2 = zip_writer_init(alloc(4096), 4096);
    assert(zip_enc_begin(w2, "../evil", ZIP_STORE, 0, 0) == 0 - ERR_UNSAFE_PATH,
    "stream: begin rejects unsafe name");
    assert(zip_enc_begin(w2, "x.txt", ZIP_BZIP2, 0, 0) == 0 - ERR_UNSUPPORTED_FORMAT,
    "stream: begin rejects a non-streamable method");
    return 0;
}

# Security (2.6.4): a member written THROUGH a symlink another member declares must be
# refused — the cross-entry escape that per-entry name checks cannot see, and the exact
# class the 2.5.9 audit found in the tar cursor. 2.6.3 gave ZIP symlinks, reopening it;
# bsdtar and unzip both refuse this, and now so does sankoch.
fn test_zip_symlink_chain_escape() {
    var arc = alloc(8192);
    var w = zip_writer_init(arc, 8192);
    var up = alloc(4);
    store8(up + 0, 46); store8(up + 1, 46); store8(up + 2, 0);       # ".."
    # esc -> ..   (a symlink whose target escapes the extraction root)
    assert(zip_add_meta(w, "esc", up, 2, ZIP_STORE, 0xA1FF, 0) == 0, "slip: add symlink");
    var body = alloc(8);
    _zt_fill(body, 5, 65);
    # a plain file written THROUGH esc/
    assert(zip_add(w, "esc/pwned.txt", body, 5, ZIP_STORE) == 0, "slip: add member under symlink");
    var total = zip_writer_finish(w);
    assert(total > 0, "slip: finish");

    var z = zip_open(arc, total);
    assert(z != 0, "slip: reopen");
    var out = alloc(64);
    var ei = zip_find(z, "esc");
    var pi = zip_find(z, "esc/pwned.txt");
    # the symlink itself is a legitimate member; extracting it is fine
    assert(zip_extract(z, ei, out, 64) == 2, "slip: the symlink member extracts");
    # but a member written THROUGH it must be refused
    assert(zip_extract_any(z, pi, out, 64) == 0 - ERR_UNSAFE_PATH,
    "slip: member through an escaping symlink is refused");
    assert(zip_extract(z, pi, out, 64) == 0 - ERR_UNSAFE_PATH,
    "slip: refused on the lean path too");
    return 0;
}

# A member written ONTO an existing symlink path (open resolves the final component) is
# also refused; a benign symlink with no member under it stays extractable.
fn test_zip_symlink_onto_and_benign() {
    var arc = alloc(8192);
    var w = zip_writer_init(arc, 8192);
    var t = alloc(8);
    store8(t + 0, 46); store8(t + 1, 46); store8(t + 2, 0);          # ".."
    assert(zip_add_meta(w, "s", t, 2, ZIP_STORE, 0xA1FF, 0) == 0, "onto: add escaping symlink s");
    var d = alloc(8);
    _zt_fill(d, 4, 65);
    assert(zip_add(w, "s", d, 4, ZIP_STORE) == 0, "onto: add a file also named s");
    # a benign in-root symlink with nothing written through it
    var bt = alloc(8);
    store8(bt + 0, 100); store8(bt + 1, 0);                          # "d"
    assert(zip_add_meta(w, "link", bt, 1, ZIP_STORE, 0xA1FF, 0) == 0, "onto: benign symlink");
    var total = zip_writer_finish(w);
    var z = zip_open(arc, total);
    var out = alloc(64);
    # the file member sharing the escaping symlink's path is refused
    var refused = 0;
    var i = 0;
    while (i < zip_count(z)) {
        var nm = zip_entry_name(z, i);
        if (strlen(nm) == 1) {
            if (load8(nm) == 115) {                                  # 's'
                if (zip_entry_is_symlink(z, i) == 0) {
                    if (zip_extract_any(z, i, out, 64) == 0 - ERR_UNSAFE_PATH) { refused = 1; }
                }
            }
        }
        i = i + 1;
    }
    assert(refused == 1, "onto: a file onto an escaping symlink path is refused");
    # the benign symlink still extracts
    assert(zip_extract(z, zip_find(z, "link"), out, 64) == 1, "onto: benign symlink still extracts");
    return 0;
}

# 2.6.4: a streamed DEFLATE member holds the API lock (deflate_enc_init .. finish). If an
# error abandons it without releasing, the NEXT sankoch call deadlocks. Force a
# deflate_enc_write overflow, then do more locked work — completing this test at all is the
# no-deadlock proof (a leaked lock would hang here forever).
fn test_zip_stream_no_deadlock() {
    var src = alloc(64);
    _zt_fill(src, 40, 65);
    var dst = alloc(256);

    # Path (a): zip_writer_finish while a DEFLATE member is open. The member holds the API
    # lock (deflate_enc_init) — finish must abandon it AND release the lock, or the next
    # locked call hangs forever. Reaching the compress assert at all is the no-deadlock proof.
    var a1 = alloc(4096);
    var w1 = zip_writer_init(a1, 4096);
    assert(zip_enc_begin(w1, "m.bin", ZIP_DEFLATE, 0, 0) == 0, "deadlock-a: begin");
    assert(zip_writer_finish(w1) == 0 - ERR_INVALID_INPUT, "deadlock-a: finish refuses the open member");
    assert(deflate_compress(src, 40, dst, 256) > 0, "deadlock-a: a later locked call still works");

    # Path (b): a single oversized streamed write overflows the archive buffer, so
    # deflate_enc_write errors — the error path must release the lock too.
    var a2 = alloc(256);
    var w2 = zip_writer_init(a2, 256);
    assert(zip_enc_begin(w2, "big.bin", ZIP_DEFLATE, 0, 0) == 0, "deadlock-b: begin");
    var big = alloc(30016);
    var st = 5;
    var i = 0;
    while (i < 30000) {
        st = st * 6364136223846793005 + 1442695040888963407;
        store8(big + i, (st >> 40) & 0xFF);      # incompressible: one write overflows 256 B
        i = i + 1;
    }
    assert(zip_enc_write(w2, big, 30000) < 0, "deadlock-b: the oversized write errors");
    assert(deflate_compress(src, 40, dst, 256) > 0, "deadlock-b: a later locked call still works");

    # A fresh writer still works end to end after both abandonments.
    var arc3 = alloc(4096);
    var w3 = zip_writer_init(arc3, 4096);
    assert(zip_add(w3, "ok.txt", src, 40, ZIP_DEFLATE) == 0, "deadlock: fresh writer add");
    assert(zip_writer_finish(w3) > 0, "deadlock: fresh writer finish");
    return 0;
}

# A batch add while a streamed member is open would clobber the open member's header at the
# stale write cursor — refuse it (2.6.4).
fn test_zip_add_while_streaming() {
    var arc = alloc(8192);
    var w = zip_writer_init(arc, 8192);
    var d = alloc(16);
    _zt_fill(d, 16, 65);
    assert(zip_enc_begin(w, "s.txt", ZIP_STORE, 0, 0) == 0, "mix: begin");
    assert(zip_add(w, "p.txt", d, 16, ZIP_STORE) == 0 - ERR_INVALID_INPUT,
    "mix: zip_add refused while a streamed member is open");
    assert(zip_add_any(w, "q.txt", d, 16, ZIP_BZIP2) == 0 - ERR_INVALID_INPUT,
    "mix: zip_add_any refused while a streamed member is open");
    # Closing the member re-enables batch adds.
    assert(zip_enc_end(w) == 0, "mix: end");
    assert(zip_add(w, "p.txt", d, 16, ZIP_STORE) == 0, "mix: zip_add works after end");
    assert(zip_writer_finish(w) > 0, "mix: finish");
    return 0;
}

# A name longer than the u16 name-length field must be refused, not silently truncated
# into a self-desynced central directory (2.6.4).
fn test_zip_long_name_refused() {
    var arc = alloc(131072);
    var w = zip_writer_init(arc, 131072);
    var d = alloc(8);
    _zt_fill(d, 4, 65);
    var big = alloc(70016);
    var i = 0;
    while (i < 70000) { store8(big + i, 97); i = i + 1; }   # 70000 'a's, no NUL/slash
    store8(big + 70000, 0);
    assert(zip_add(w, big, d, 4, ZIP_STORE) == 0 - ERR_INVALID_INPUT, "longname: zip_add refused");
    assert(zip_enc_begin(w, big, ZIP_STORE, 0, 0) == 0 - ERR_INVALID_INPUT, "longname: zip_enc_begin refused");
    # A 65535-byte name is exactly at the limit and is accepted.
    store8(big + 65535, 0);
    assert(zip_add(w, big, d, 4, ZIP_STORE) == 0, "longname: 65535 accepted");
    return 0;
}

# 2.6.4: attacker-controlled Zip64 i64 fields must not overflow the additive bounds
# checks in zip_open — a 42-byte / 98-byte archive drove a wild pointer to a SIGSEGV. Both
# must be REJECTED, not crash. Built byte-by-byte since the writer never emits these.
fn _zt_put32(p, v) {
    store8(p, v & 0xFF); store8(p + 1, (v >> 8) & 0xFF);
    store8(p + 2, (v >> 16) & 0xFF); store8(p + 3, (v >> 24) & 0xFF);
    return 0;
}
fn _zt_put64_hi(p, lo, hi) {
    _zt_put32(p, lo); _zt_put32(p + 4, hi);
    return 0;
}
fn test_zip_zip64_overflow_bounds() {
    # (a) Zip64 locator whose EOCD-offset field = 0x7FFFFFFFFFFFFFE2: z64 + 56 wraps
    # negative past `> len`. 42 bytes = 20-byte locator + 22-byte EOCD.
    var a = alloc(64);
    var i = 0;
    while (i < 42) { store8(a + i, 0); i = i + 1; }
    _zt_put32(a + 0, 0x07064b50);                       # locator signature
    _zt_put64_hi(a + 8, 0xFFFFFFE2, 0x7FFFFFFF);        # z64-EOCD offset = 2^63 - 30
    _zt_put32(a + 12, 1);                               # total disks
    _zt_put32(a + 20, 0x06054b50);                      # EOCD signature (comment_len 0 -> ends at 42)
    assert(zip_open(a, 42) == 0, "overflow: zip64 locator offset near 2^63 is rejected, not crashed");

    # (b) Zip64 EOCD with cd_off near 2^63 so cd_off + cd_size wraps negative. 98 bytes =
    # 56-byte zip64 EOCD + 20-byte locator + 22-byte EOCD.
    var b = alloc(128);
    i = 0;
    while (i < 98) { store8(b + i, 0); i = i + 1; }
    _zt_put32(b + 0, 0x06064b50);                       # zip64 EOCD signature
    _zt_put64_hi(b + 4, 44, 0);                         # size of record - 12
    store8(b + 12, 45); store8(b + 14, 45);             # version made/needed
    _zt_put64_hi(b + 24, 1, 0);                         # total entries this disk
    _zt_put64_hi(b + 32, 1, 0);                         # total entries
    _zt_put64_hi(b + 40, 100, 0);                       # cd_size
    _zt_put64_hi(b + 48, 0xFFFFFFF6, 0x7FFFFFFF);       # cd_off = 2^63 - 10
    _zt_put32(b + 56, 0x07064b50);                      # locator signature
    _zt_put64_hi(b + 64, 0, 0);                         # locator -> zip64 EOCD at offset 0
    _zt_put32(b + 72, 1);                               # total disks
    _zt_put32(b + 76, 0x06054b50);                      # EOCD signature
    store8(b + 84, 0xFF); store8(b + 85, 0xFF);         # entry count sentinel
    _zt_put32(b + 88, 0xFFFFFFFF);                      # cd_size sentinel
    _zt_put32(b + 92, 0xFFFFFFFF);                      # cd_off sentinel
    assert(zip_open(b, 98) == 0, "overflow: zip64 cd_off near 2^63 is rejected, not crashed");
    return 0;
}

fn main() {
    _test_init();
    test_zip_roundtrip();
    test_zip_store_method();
    test_zip_empty_archive();
    test_zip_empty_member();
    test_zip_slip_guards();
    test_zip_ratio_cap();
    test_zip_crc_detects_corruption();
    test_zip_malformed();
    test_zip_index_bounds();
    test_zip_dst_too_small();
    test_zip_writer_bounds();
    test_zip_all_methods();
    test_zip_lean_refuses_extra_methods();
    test_zip_method_support();
    test_zip_any_guards();
    test_zip_name_not_aliased();
    test_zip_metadata();
    test_zip_dos_time();
    test_zip_streaming_write();
    test_zip_streaming_guards();
    test_zip_symlink_chain_escape();
    test_zip_symlink_onto_and_benign();
    test_zip_stream_no_deadlock();
    test_zip_add_while_streaming();
    test_zip_long_name_refused();
    test_zip_zip64_overflow_bounds();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
